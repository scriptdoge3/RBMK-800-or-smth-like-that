        <Properties>
          <string name="Name">AlarmList</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Every annunciator window in the control room: id, panel, legend.
-- The server decides when each one is in alarm (see Sim/Alarms); the client
-- only needs the legends and where to draw them.
local AlarmList = {}

export type Alarm = { id: string, panel: string, text: string }

local list: { Alarm } = {}
local function add(panel: string, id: string, text: string)
	table.insert(list, { id = id, panel = panel, text = text })
end

-- P1: reactor auxiliaries and emergency cooling
add("P1", "rs.press", "REACTOR SPACE\nPRESSURE HIGH")
add("P1", "chan.rupture", "FUEL CHANNEL\nRUPTURE")
add("P1", "rad.gas", "GAS CIRCUIT\nACTIVITY HIGH")
add("P1", "cps.flow", "ROD COOLING\nFLOW LOW")
add("P1", "cps.tank", "ROD COOLING\nTANK LEVEL LOW")
add("P1", "cps.temp", "ROD COOLING\nTEMP HIGH")
add("P1", "eccs", "ECCS\nACTUATED")
add("P1", "eccs.off", "ECCS AUTO\nDISABLED")
add("P1", "eccs.accum", "ECCS ACCUMULATORS\nLOW")
add("P1", "srv.open", "SAFETY VALVE\nOPEN")
add("P1", "pool.temp", "SUPPRESSION POOL\nTEMP HIGH")
add("P1", "leak", "PRIMARY LEAK\nDETECTED")

-- P2: main circulation
add("P2", "mcp.trip", "MAIN CIRC PUMP\nTRIP")
add("P2", "mcp.cav", "MAIN CIRC PUMP\nCAVITATION")
add("P2", "loop1.flow", "LOOP A\nFLOW LOW")
add("P2", "loop2.flow", "LOOP B\nFLOW LOW")
add("P2", "lvl1.low", "DRUM A\nLEVEL LOW")
add("P2", "lvl1.high", "DRUM A\nLEVEL HIGH")
add("P2", "lvl2.low", "DRUM B\nLEVEL LOW")
add("P2", "lvl2.high", "DRUM B\nLEVEL HIGH")
add("P2", "press.high", "DRUM PRESSURE\nHIGH")
add("P2", "press.low", "DRUM PRESSURE\nLOW")
add("P2", "heatup", "HEATUP / COOLDOWN\nRATE HIGH")
add("P2", "subcool", "PUMP SUCTION\nSUBCOOLING LOW")

-- P3: reactor control
add("P3", "az5", "AZ-5\nREACTOR SCRAM")
add("P3", "az4", "AZ-4\nROD INSERTION")
add("P3", "az3", "AZ-3\nRUNBACK TO 20%")
add("P3", "az2", "AZ-2\nRUNBACK TO 50%")
add("P3", "az1", "AZ-1\nRUNBACK TO 60%")
add("P3", "power.high", "NEUTRON POWER\nHIGH")
add("P3", "period.short", "REACTOR PERIOD\nSHORT")
add("P3", "rod.block", "ROD WITHDRAWAL\nBLOCK")
add("P3", "orm.low", "REACTIVITY MARGIN\nBELOW 26 RODS")
add("P3", "orm.lowlow", "REACTIVITY MARGIN\nBELOW 15 RODS")
add("P3", "ar.limit", "AUTO REGULATOR\nRODS AT LIMIT")
add("P3", "ar.dev", "AUTO REGULATOR\nPOWER DEVIATION")
add("P3", "lar.limit", "LOCAL REGULATOR\nROD AT LIMIT")
add("P3", "lar.dropout", "LOCAL REGULATORS\nDROPPED OUT")
add("P3", "rod.stuck", "ROD DRIVE\nFAULT")
add("P3", "chan.margin", "CHANNEL DRYOUT\nMARGIN LOW")
add("P3", "fuel.temp", "FUEL TEMPERATURE\nHIGH")
add("P3", "tilt", "RADIAL POWER\nTILT HIGH")
add("P3", "axial", "AXIAL POWER\nOFFSET HIGH")
add("P3", "kom", "KOM: ROD CLUTCHES\nDE-ENERGISED")
add("P3", "prot.bypass", "PROTECTION\nBYPASSED")
add("P3", "chan.flow", "CHANNEL FLOW\nLOW")
add("P3", "regs.off", "NO REGULATOR\nIN AUTO")
add("P3", "core.damage", "CORE\nDAMAGE")

-- P4: feedwater and condensate
add("P4", "fw.pump", "FEED PUMP\nTRIP")
add("P4", "fw.low", "FEEDWATER FLOW\nLOW")
add("P4", "fw.temp", "FEEDWATER TEMP\nLOW")
add("P4", "da.low", "DEAERATOR LEVEL\nLOW")
add("P4", "da.high", "DEAERATOR LEVEL\nHIGH")
add("P4", "cond.pump", "CONDENSATE PUMP\nTRIP")
add("P4", "afw", "EMERGENCY FEED\nRUNNING")
add("P4", "lvl.manual", "LEVEL CONTROL\nIN MANUAL")

-- P5: turbine-generators
add("P5", "tg.1.trip", "TURBINE 1\nTRIP")
add("P5", "tg.2.trip", "TURBINE 2\nTRIP")
add("P5", "tg1.vac", "CONDENSER 1\nVACUUM LOW")
add("P5", "tg2.vac", "CONDENSER 2\nVACUUM LOW")
add("P5", "tg1.vib", "TURBINE 1\nVIBRATION HIGH")
add("P5", "tg2.vib", "TURBINE 2\nVIBRATION HIGH")
add("P5", "tg1.lube", "TURBINE 1\nLUBE OIL LOW")
add("P5", "tg2.lube", "TURBINE 2\nLUBE OIL LOW")
add("P5", "tg1.stress", "TURBINE 1\nTHERMAL STRESS")
add("P5", "tg2.stress", "TURBINE 2\nTHERMAL STRESS")
add("P5", "bypass.open", "TURBINE BYPASS\nOPEN")
add("P5", "ehc.manual", "PRESSURE REGULATOR\nOUT OF SERVICE")

-- P6: electrical
add("P6", "gen.1.fault", "GENERATOR 1\nFAULT")
add("P6", "gen.2.fault", "GENERATOR 2\nFAULT")
add("P6", "bus.dead", "AUXILIARY BUS\nUNDERVOLTAGE")
add("P6", "bus.reserve", "BUS TRANSFERRED\nTO RESERVE")
add("P6", "dg.run", "DIESEL GENERATOR\nRUNNING")
add("P6", "dg.fail", "DIESEL GENERATOR\nFAILED TO START")
add("P6", "grid", "LOSS OF\nOFFSITE POWER")
add("P6", "gen.island", "UNIT ISLANDED\nFROM GRID")

AlarmList.list = list
AlarmList.index = {} :: { [string]: number }
for i, a in list do
	AlarmList.index[a.id] = i
end

function AlarmList.forPanel(panel: string): { Alarm }
	local out = {}
	for _, a in list do
		if a.panel == panel then
			table.insert(out, a)
		end
	end
	return out
end

return AlarmList
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Design data for the RBMK-800 unit. Everything tunable lives here.
--
-- The unit is a full-size RBMK core (1661 fuel channels, 211 control rods)
-- derated to 2560 MW thermal / 800 MW electric, with two 400 MWe 1800 rpm
-- turbine-generators on a 60 Hz grid. Units are SI: MPa absolute, degC,
-- kg/s internally (displays convert to t/h and m3/h), metres, seconds.
local Config = {}

Config.NOMINAL_THERMAL = 2560e6 -- W
Config.NOMINAL_ELECTRIC = 800e6 -- W gross
Config.GRID_HZ = 60
Config.TURBINE_RPM = 1800

Config.Core = {
	GRID = 48, -- lattice is GRID x GRID cells, 0.25 m pitch
	NZ = 14, -- axial layers, 0.5 m each, index 1 = top
	HEIGHT = 7.0, -- m
	PITCH = 0.25, -- m
	N_FUEL = 1661,
	N_RODS = 211,

	-- One-group diffusion. M2 is the migration area in m2.
	M2 = 0.040,
	EXTRAP_RADIAL = 0.40, -- m, reflector-equivalent extrapolation distances
	EXTRAP_AXIAL = 0.30,

	-- Relative absorption of a rod-channel cell (a fuel cell is 1.0).
	ABS_ABSORBER = 1.45,
	ABS_GRAPHITE = 0.02,
	ABS_WATER = 0.47,
	ABS_STEAM = 0.02,

	-- Point kinetics.
	BETA = 0.0050,
	LAMBDA_PROMPT = 8.0e-4, -- s
	SOURCE = 6.0e2, -- W/s equivalent neutron source (sets shutdown count rate)

	-- Reactivity coefficients (delta-k).
	DOPPLER = 1.25e-3, -- per sqrt(K); about -2e-5 /K at operating fuel temperature
	GRAPHITE = 2.2e-5, -- per K, positive
	VOID_YOUNG = 0.004, -- delta-k for 100% coolant density loss, fresh core loaded with absorbers
	VOID_AGED = 0.032, -- same, equilibrium burnup core
	VOID_ROD_SUPPRESSION = 1.25, -- nearby inserted absorber pulls the local void effect down
	XENON_WORTH = 0.028, -- delta-k of equilibrium xenon at nominal flux
	T_REF = 40, -- degC reference for cold reactivity

	-- Fuel / graphite node thermal data (per 0.5 m node).
	FUEL_R = 3.6e-3, -- K/W fuel-to-coolant
	FUEL_C = 3.3e3, -- J/K
	GRAPHITE_R = 0.050, -- K/W graphite-to-coolant
	GRAPHITE_C = 6.5e4, -- J/K; with GRAPHITE_R the stack takes about 50 minutes to soak, as it really does
	GRAPHITE_HEAT_FRACTION = 0.055,

	-- Xenon / iodine.
	LAMBDA_I = 2.87e-5,
	LAMBDA_XE = 2.09e-5,
	GAMMA_I = 0.061,
	GAMMA_XE = 0.003,
	XE_BURN = 8.5e-5, -- 1/s burnout rate at nominal average flux

	-- Decay heat groups: fraction of fission power and time constant (s).
	DECAY = {
		{ 0.012, 5 },
		{ 0.013, 50 },
		{ 0.012, 500 },
		{ 0.010, 5000 },
		{ 0.0075, 50000 },
		{ 0.0055, 500000 },
	},

	-- Channel hydraulics and limits.
	CHANNEL_HEAT_CAP = 6.0e4, -- J/K, cladding + tube hot-spot heat capacity
	RUPTURE_TEMP = 650, -- degC tube wall at 7 MPa, new tube
	FUEL_MELT = 2850, -- degC
	CLAD_FAIL = 1200, -- degC
}

Config.Rods = {
	STROKE = 6.5, -- m, absorber tip travel below the top of the core
	ABSORBER_LEN = 6.2,
	LINK_LEN = 1.25, -- water-filled gap between absorber and displacer
	DISPLACER_LEN = 4.5,
	USP_STROKE = 3.5,
	USP_ABSORBER_LEN = 3.05,
	SPEED_MANUAL = 0.4, -- m/s
	SPEED_AUTO = 0.2,
	SPEED_AZ = 0.4,
	SPEED_GRAVITY = 0.45,
	MAX_SELECTED = 8,
	COUNTS = { AR = 12, LAR = 12, AZ = 24, USP = 24 }, -- the remaining 139 are manual (RR)
}

Config.Primary = {
	N_LOOPS = 2,
	PUMPS_PER_LOOP = 4,
	PUMP_RATED_FLOW = 1390, -- kg/s per pump (about 6800 m3/h)
	PUMP_SHUTOFF_HEAD = 1.95, -- MPa at rated speed
	PUMP_RATED_HEAD = 1.45, -- MPa at rated flow
	PUMP_COASTDOWN = 28, -- s, time for speed to halve after trip
	PUMP_MOTOR_MW = 5.2,
	LOOP_RATED_FLOW = 4165, -- kg/s with three pumps
	DRUM_ELEVATION_HEAD = 0.30, -- MPa static head at pump suction
	RISER_HEAD = 0.18, -- MPa static head of the risers above the channels
	THERMAL_MASS = 0.45e9, -- J/K of water and steel (well under the real figure so heatup fits a session; the graphite adds its own)
	DRUM_AREA = 55, -- m2 water surface per loop
	DRUM_NOMINAL_MASS = 1.6e5, -- kg of water per loop at zero level, hot
	NOMINAL_PRESSURE = 6.9,
	HEATUP_LIMIT = 10 / 60, -- K/s administrative limit (10 degC per minute)
}

Config.Secondary = {
	STEAM_NOMINAL = 1250, -- kg/s total at full power
	TURBINE_STEAM = 625, -- kg/s per turbine at 400 MWe
	BYPASS_CAPACITY = 0.30, -- fraction of nominal steam flow per turbine bypass
	FEEDWATER_TEMP = 165, -- degC at full load
	FEED_PUMP_FLOW = 450, -- kg/s per main feed pump
	N_FEED_PUMPS = 4,
	N_AUX_FEED_PUMPS = 3,
	AUX_FEED_FLOW = 70,
	N_COND_PUMPS = 3,
	COND_PUMP_FLOW = 700,
	SAFETY_VALVE_SETPOINTS = { 7.45, 7.55, 7.65 }, -- MPa, three groups
	SAFETY_VALVE_CAPACITY = 0.35, -- fraction of nominal steam per group
}

Config.Protection = {
	OVERPOWER = 1.10, -- fraction of nominal (or of setpoint in the low range)
	PERIOD_TRIP = 10, -- s
	PERIOD_ALARM = 20,
	PRESSURE_HIGH = 7.35,
	LEVEL_LOW = -600, -- mm
	LEVEL_HIGH = 400,
	ORM_ADMIN_LIMIT = 26, -- equivalent rods, needs chief engineer permission
	ORM_SHUTDOWN_LIMIT = 15,
}

-- Sounds ship with the Roblox client, so no asset uploads are needed.
-- Swap these for your own asset ids if you want different audio.
Config.Sounds = {
	CLICK = "rbxasset://sounds/switch.wav",
	BUTTON = "rbxasset://sounds/button.wav",
	ALARM = "rbxasset://sounds/electronicpingshort.wav",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">CoreLayout</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Deterministic core map: which lattice cell holds a fuel channel and which
-- holds a control rod, and what kind of rod it is. Server and client both
-- build this from the same code so they agree on every index.
local Config = require(script.Parent.Config)

local CoreLayout = {}

export type Rod = {
	index: number,
	cell: number,
	kind: string, -- "RR" | "AR" | "LAR" | "AZ" | "USP"
	group: number, -- AR regulator number 1..3, LAR zone 1..12, otherwise 0
	label: string,
	gx: number,
	gy: number,
}

export type Layout = {
	grid: number,
	nCells: number,
	nFuel: number,
	nRods: number,
	cellX: { number }, -- lattice units from core centre
	cellY: { number },
	cellGX: { number }, -- 1..grid
	cellGY: { number },
	cellKind: { number }, -- 1 fuel, 2 rod
	cellRef: { number }, -- index into fuel list or rod list
	cellLoop: { number }, -- 1 = loop A (west half), 2 = loop B
	cellZone: { number }, -- LAR zone 1..12 for fuel cells
	neighbors: { number }, -- 4 per cell, 0 where the reflector is
	fuelCells: { number },
	rods: { Rod },
	gridToCell: { number }, -- (gy-1)*grid + gx -> cell or 0
	rodsNear: { { number } }, -- per fuel index: rods within 3 lattice pitches
}

local cached: Layout? = nil

local function label(gx: number, gy: number): string
	return string.format("%02d-%02d", gx, gy)
end

function CoreLayout.get(): Layout
	if cached then
		return cached
	end

	local G = Config.Core.GRID
	local half = (G + 1) / 2
	local wantTotal = Config.Core.N_FUEL + Config.Core.N_RODS

	-- Take the cells nearest the centre. Ties are broken by angle so the
	-- result is stable.
	local cand = {}
	for gy = 1, G do
		for gx = 1, G do
			local x, y = gx - half, gy - half
			table.insert(cand, { gx = gx, gy = gy, x = x, y = y, r2 = x * x + y * y, a = math.atan2(y, x) })
		end
	end
	table.sort(cand, function(p, q)
		if p.r2 ~= q.r2 then
			return p.r2 < q.r2
		end
		return p.a < q.a
	end)
	local chosen = {}
	for i = 1, wantTotal do
		chosen[i] = cand[i]
	end
	-- Index cells in raster order so neighbours are close in memory.
	table.sort(chosen, function(p, q)
		if p.gy ~= q.gy then
			return p.gy < q.gy
		end
		return p.gx < q.gx
	end)

	local L = {
		grid = G,
		nCells = wantTotal,
		nFuel = 0,
		nRods = 0,
		cellX = {},
		cellY = {},
		cellGX = {},
		cellGY = {},
		cellKind = {},
		cellRef = {},
		cellLoop = {},
		cellZone = {},
		neighbors = {},
		fuelCells = {},
		rods = {},
		gridToCell = table.create(G * G, 0),
		rodsNear = {},
	} :: Layout

	local maxR = 0
	for i, c in chosen do
		L.cellX[i] = c.x
		L.cellY[i] = c.y
		L.cellGX[i] = c.gx
		L.cellGY[i] = c.gy
		L.cellKind[i] = 1
		L.cellRef[i] = 0
		L.cellLoop[i] = if c.x < 0 then 1 else 2
		L.cellZone[i] = 0
		L.gridToCell[(c.gy - 1) * G + c.gx] = i
		maxR = math.max(maxR, math.sqrt(c.r2))
	end
	for i = 1, L.nCells do
		local gx, gy = L.cellGX[i], L.cellGY[i]
		local function at(x: number, y: number): number
			if x < 1 or x > G or y < 1 or y > G then
				return 0
			end
			return L.gridToCell[(y - 1) * G + x]
		end
		local q = (i - 1) * 4
		L.neighbors[q + 1] = at(gx - 1, gy)
		L.neighbors[q + 2] = at(gx + 1, gy)
		L.neighbors[q + 3] = at(gx, gy - 1)
		L.neighbors[q + 4] = at(gx, gy + 1)
	end

	-- Rod sites sit on a centred-square sub-lattice with a pitch of 4 cells,
	-- which is the real RBMK arrangement. Keep the innermost N_RODS of them
	-- and leave a ring of fuel outside the last rod.
	local sites = {}
	for i = 1, L.nCells do
		local gx, gy = L.cellGX[i], L.cellGY[i]
		local onA = (gx % 4 == 1) and (gy % 4 == 1)
		local onB = (gx % 4 == 3) and (gy % 4 == 3)
		if onA or onB then
			local r = math.sqrt(L.cellX[i] ^ 2 + L.cellY[i] ^ 2)
			if r < maxR - 1.2 then
				table.insert(sites, { cell = i, r = r, a = math.atan2(L.cellY[i], L.cellX[i]) })
			end
		end
	end
	table.sort(sites, function(p, q)
		if p.r ~= q.r then
			return p.r < q.r
		end
		return p.a < q.a
	end)
	local nRods = math.min(Config.Core.N_RODS, #sites)
	local rodSites = {}
	for i = 1, nRods do
		rodSites[i] = sites[i]
	end

	-- Assign special rod types by picking the free site nearest to each
	-- target point on a ring.
	local kindOf: { [number]: string } = {}
	local groupOf: { [number]: number } = {}
	local function claim(rFrac: number, angle: number, kind: string, group: number)
		local tx, ty = rFrac * maxR * math.cos(angle), rFrac * maxR * math.sin(angle)
		local best, bestD = 0, math.huge
		for _, s in rodSites do
			if not kindOf[s.cell] then
				local dx, dy = L.cellX[s.cell] - tx, L.cellY[s.cell] - ty
				local d = dx * dx + dy * dy
				if d < bestD then
					best, bestD = s.cell, d
				end
			end
		end
		if best > 0 then
			kindOf[best] = kind
			groupOf[best] = group
		end
	end
	local tau = 2 * math.pi
	-- Automatic regulators: three sets of four, each set spread around the core.
	for set = 1, 3 do
		for k = 0, 3 do
			claim(0.46, (k / 4 + (set - 1) / 12) * tau + 0.26, "AR", set)
		end
	end
	-- Local automatic regulators: one per zone, 4 inner zones and 8 outer.
	for k = 0, 3 do
		claim(0.30, (k / 4 + 0.125) * tau, "LAR", k + 1)
	end
	for k = 0, 7 do
		claim(0.72, (k / 8 + 0.0625) * tau, "LAR", k + 5)
	end
	-- Emergency protection (shutdown) rods.
	for k = 0, 7 do
		claim(0.38, (k / 8) * tau + 0.05, "AZ", 0)
	end
	for k = 0, 15 do
		claim(0.80, (k / 16) * tau + 0.10, "AZ", 0)
	end
	-- Shortened absorber rods entering from below.
	for k = 0, 7 do
		claim(0.22, (k / 8) * tau + 0.39, "USP", 0)
	end
	for k = 0, 15 do
		claim(0.60, (k / 16) * tau + 0.20, "USP", 0)
	end

	-- Number rods in raster order.
	table.sort(rodSites, function(p, q)
		return p.cell < q.cell
	end)
	for i, s in rodSites do
		local c = s.cell
		L.cellKind[c] = 2
		L.cellRef[c] = i
		L.rods[i] = {
			index = i,
			cell = c,
			kind = kindOf[c] or "RR",
			group = groupOf[c] or 0,
			label = label(L.cellGX[c], L.cellGY[c]),
			gx = L.cellGX[c],
			gy = L.cellGY[c],
		}
	end
	L.nRods = #L.rods

	-- Fuel list, LAR zone of each fuel cell, and the rods close to it.
	local larRods = {}
	for _, r in L.rods do
		if r.kind == "LAR" then
			table.insert(larRods, r)
		end
	end
	for c = 1, L.nCells do
		if L.cellKind[c] == 1 then
			table.insert(L.fuelCells, c)
			local f = #L.fuelCells
			L.cellRef[c] = f
			local bestZ, bestD = 1, math.huge
			for _, r in larRods do
				local dx, dy = L.cellX[c] - L.cellX[r.cell], L.cellY[c] - L.cellY[r.cell]
				local d = dx * dx + dy * dy
				if d < bestD then
					bestZ, bestD = r.group, d
				end
			end
			L.cellZone[c] = bestZ
			local near = {}
			for _, r in L.rods do
				local dx, dy = L.cellX[c] - L.cellX[r.cell], L.cellY[c] - L.cellY[r.cell]
				if dx * dx + dy * dy <= 9.5 then
					table.insert(near, r.index)
				end
			end
			L.rodsNear[f] = near
		end
	end
	L.nFuel = #L.fuelCells

	cached = L
	return L
end

return CoreLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">PanelLayout</string>
          <string name="Source"><![CDATA[--!nonstrict
-- The control room, as data.
--
-- Six benchboard sections stand in a horseshoe around the operators, in the
-- style of a boiling-water-reactor control room: a sloping bench of controls,
-- a vertical board of meters and recorders behind it, and a row of
-- annunciator windows on top. Each widget names the plant signal it shows
-- (`sig`) and the operator command it sends (`cmd`); the server and the
-- client both read this one description, so they cannot drift apart.
--
-- Positions are in studs on the face, measured from its top-left corner.
local AlarmList = require(script.Parent.AlarmList)

local PanelLayout = {}

PanelLayout.PANEL_WIDTH = 16
PanelLayout.BENCH_DEPTH = 5
PanelLayout.BENCH_FRONT_HEIGHT = 3.1
PanelLayout.BENCH_SLOPE = math.rad(22)
PanelLayout.VERT_HEIGHT = 6.6
PanelLayout.ANN_HEIGHT = 2.2
PanelLayout.BACK_WALL_Z = -36 -- bench front edge of the back wall of panels
PanelLayout.CORNER_X = -36 -- where the left wing meets the back wall, at a right angle
PanelLayout.WING_PANELS = 2 -- panels on the wing; the rest run along the back wall
PanelLayout.PIXELS_PER_STUD = 80
PanelLayout.FACE_THICKNESS = 0.3

export type Widget = { [string]: any }
export type Panel = { id: string, title: string, index: number, widgets: { Widget } }

local panels: { Panel } = {}
local current: Panel

local function panel(id: string, title: string)
	current = { id = id, title = title, index = #panels + 1, widgets = {} }
	table.insert(panels, current)
end

local function add(w: Widget): Widget
	table.insert(current.widgets, w)
	return w
end

local function section(face: string, x: number, y: number, w: number, h: number, title: string)
	add({ kind = "section", face = face, x = x, y = y, w = w, h = h, label = title })
end

local function meter(face: string, x: number, y: number, label: string, sig: string, lo: number, hi: number, unit: string, opts: any?)
	local o = opts or {}
	add({ kind = "meter", face = face, x = x, y = y, w = 0.8, h = 2.5, label = label, sig = sig, lo = lo, hi = hi, unit = unit, fmt = o.fmt or "%.0f", red = o.red, amber = o.amber, low = o.low, tip = o.tip })
end

local function digital(face: string, x: number, y: number, label: string, sig: string, fmt: string, unit: string, w: number?)
	add({ kind = "digital", face = face, x = x, y = y, w = w or 1.35, h = 0.8, label = label, sig = sig, fmt = fmt, unit = unit })
end

-- A lamp is lit when the signal is above `gt` (default 0.5) or, with `eq`,
-- when it equals that value.
local function lamp(face: string, x: number, y: number, label: string, sig: string, color: string, opts: any?)
	local o = opts or {}
	add({ kind = "lamp", face = face, x = x, y = y, w = o.w or 1.2, h = o.h or 0.36, label = label, sig = sig, color = color, gt = o.gt, eq = o.eq, lt = o.lt })
end

local function button(face: string, x: number, y: number, label: string, cmd: string, opts: any?)
	local o = opts or {}
	add({ kind = "button", face = face, x = x, y = y, w = o.w or 0.9, h = o.h or 1.0, label = label, cmd = cmd, value = o.value or 1, hold = o.hold, color = o.color or "black", lit = o.lit, litEq = o.litEq, big = o.big })
end

local function toggle(face: string, x: number, y: number, label: string, cmd: string, sig: string, opts: any?)
	local o = opts or {}
	local compact = o.compact
	add({ kind = "toggle", face = face, x = x, y = y, w = if compact then 0.9 else 1.0, h = if compact then 1.1 else 1.25, label = label, cmd = cmd, sig = sig, positions = o.labels or { "OFF", "ON" }, key = o.key, compact = compact })
end

-- Rotary selector. The value sent and shown is the position number counted
-- from `base` (0 unless given).
local function selector(face: string, x: number, y: number, label: string, cmd: string, sig: string, positions: { string }, base: number?, width: number?)
	add({ kind = "selector", face = face, x = x, y = y, w = width or 1.3, h = 1.25, label = label, cmd = cmd, sig = sig, positions = positions, base = base or 0 })
end

-- Motor control switch with red (running) and green (stopped) lamps.
local function pump(face: string, x: number, y: number, label: string, cmd: string, sig: string)
	add({ kind = "pump", face = face, x = x, y = y, w = 1.0, h = 1.55, label = label, cmd = cmd, sig = sig })
end

-- Lower / raise pushbuttons with a readout between them.
local function jog(face: string, x: number, y: number, label: string, cmd: string, sig: string, fmt: string, unit: string)
	add({ kind = "jog", face = face, x = x, y = y, w = 1.5, h = 1.25, label = label, cmd = cmd, sig = sig, fmt = fmt, unit = unit })
end

local function recorder(face: string, x: number, y: number, w: number, h: number, label: string, pens: { any })
	add({ kind = "recorder", face = face, x = x, y = y, w = w, h = h, label = label, pens = pens })
end

local function annunciators()
	add({ kind = "ann", face = "ann", x = 0, y = 0, w = PanelLayout.PANEL_WIDTH, h = PanelLayout.ANN_HEIGHT, alarms = AlarmList.forPanel(current.id) })
	add({ kind = "label", face = "vert", x = 0.2, y = 0.08, w = 15.6, h = 0.42, label = current.id .. "  " .. current.title, title = true })
end

-- ------------------------------------------------------------------ P1
panel("P1", "REACTOR AUXILIARIES AND EMERGENCY COOLING")
annunciators()
section("vert", 0.3, 0.7, 4.3, 3.2, "REACTOR SPACE")
meter("vert", 0.6, 1.1, "SPACE\nPRESS", "rs.press", 0, 200, "kPa", { red = 5, tip = "Reactor space pressure. Any reading means a fuel channel is leaking into the graphite stack." })
meter("vert", 1.6, 1.1, "GAS\nACTIVITY", "rad.gas", 0, 100, "", { red = 20 })
meter("vert", 2.6, 1.1, "POOL\nTEMP", "pool.temp", 0, 100, "C", { red = 45 })
digital("vert", 0.6, 4.1, "RUPTURED CHANNELS", "core.ruptured", "%.0f", "", 1.9)
digital("vert", 2.7, 4.1, "FUEL DAMAGED", "core.damaged", "%.0f", "", 1.7)
section("vert", 4.9, 0.7, 4.3, 3.2, "ROD CHANNEL COOLING")
meter("vert", 5.2, 1.1, "FLOW", "cps.flow", 0, 100, "%", { low = 50 })
meter("vert", 6.2, 1.1, "TANK\nLEVEL", "cps.tank", 0, 100, "%", { low = 60 })
meter("vert", 7.2, 1.1, "WATER\nTEMP", "cps.temp", 0, 150, "C", { amber = 90 })
section("vert", 9.5, 0.7, 6.2, 3.2, "EMERGENCY CORE COOLING")
meter("vert", 9.8, 1.1, "ACCUM\nLEVEL", "eccs.accum", 0, 100, "%")
meter("vert", 10.8, 1.1, "INJECT\nFLOW", "eccs.flow", 0, 2500, "t/h")
lamp("vert", 12.0, 1.3, "ECCS ACTUATED", "eccs.active", "red", { w = 1.6 })
lamp("vert", 12.0, 2.0, "AUTO ARMED", "eccs.auto", "green", { w = 1.6 })
lamp("vert", 13.8, 1.3, "PUMP 1", "eccs.pump.1.run", "red", { w = 1.2 })
lamp("vert", 13.8, 2.0, "PUMP 2", "eccs.pump.2.run", "red", { w = 1.2 })
lamp("vert", 13.8, 2.7, "PUMP 3", "eccs.pump.3.run", "red", { w = 1.2 })
recorder("vert", 5.0, 4.1, 6.2, 2.3, "DRUM PRESSURE (MPa) / CIRCUIT TEMP (x50 C)", {
	{ sig = "pri.press", lo = 0, hi = 8, color = "red" },
	{ sig = "pri.temp", lo = 0, hi = 400, color = "blue" },
})
section("bench", 0.3, 0.2, 4.4, 2.0, "ROD CHANNEL COOLING")
pump("bench", 0.6, 0.55, "PUMP 1", "cps.pump.1", "cps.pump.1.run")
pump("bench", 1.8, 0.55, "PUMP 2", "cps.pump.2", "cps.pump.2.run")
toggle("bench", 3.2, 0.7, "TANK\nMAKEUP", "cps.makeup", "cps.makeup", { labels = { "SHUT", "OPEN" } })
section("bench", 5.0, 0.2, 7.0, 2.0, "EMERGENCY CORE COOLING")
toggle("bench", 5.3, 0.7, "AUTO\nACTUATION", "eccs.auto", "eccs.auto", { labels = { "OFF", "ARMED" }, key = true })
button("bench", 6.6, 0.7, "MANUAL\nINITIATE", "eccs.manual", { color = "red" })
button("bench", 7.7, 0.7, "ECCS\nRESET", "eccs.reset", { color = "black" })
toggle("bench", 8.9, 0.7, "PUMP 1", "eccs.pump.1", "eccs.pump.1.sw", { labels = { "AUTO", "RUN" } })
toggle("bench", 9.9, 0.7, "PUMP 2", "eccs.pump.2", "eccs.pump.2.sw", { labels = { "AUTO", "RUN" } })
toggle("bench", 10.9, 0.7, "PUMP 3", "eccs.pump.3", "eccs.pump.3.sw", { labels = { "AUTO", "RUN" } })
section("bench", 12.3, 0.2, 3.4, 2.0, "SHUTDOWN COOLING")
toggle("bench", 12.6, 0.7, "COOLDOWN\nSYSTEM", "pri.cooldown", "pri.cooldown")
digital("bench", 13.9, 0.9, "CIRCUIT TEMP", "pri.temp", "%.0f", "C", 1.5)
section("bench", 0.3, 2.6, 6.2, 2.2, "MAIN SAFETY VALVES")
for g = 1, 3 do
	toggle("bench", 0.6 + (g - 1) * 1.9, 3.1, "GROUP " .. g, "srv." .. g, "srv." .. g .. ".sw", { labels = { "AUTO", "OPEN" } })
	lamp("bench", 1.65 + (g - 1) * 1.9, 3.5, "OPEN", "srv." .. g .. ".open", "red", { w = 0.8 })
end
section("bench", 6.9, 2.6, 8.8, 2.2, "ANNUNCIATORS")
button("bench", 7.3, 3.1, "ALARM\nACK", "ann.ack", { color = "yellow", w = 1.2 })
add({ kind = "label", face = "bench", x = 8.8, y = 3.0, w = 6.6, h = 1.5, label = "A flashing window is a new alarm.\nACK silences the horn and steadies the window.\nIt goes dark when the condition clears.", small = true })

-- ------------------------------------------------------------------ P2
panel("P2", "MAIN CIRCULATION")
annunciators()
for l = 1, 2 do
	local x0 = if l == 1 then 0.3 else 9.9
	local name = if l == 1 then "A" else "B"
	local k = "loop." .. l
	section("vert", x0, 0.7, 5.8, 3.2, "LOOP " .. name .. " (" .. (if l == 1 then "WEST" else "EAST") .. " HALF)")
	meter("vert", x0 + 0.3, 1.1, "DRUM\nLEVEL", k .. ".level", -600, 600, "mm", { tip = "Narrow-range drum level, the one the level controller uses. Scram at -600 and +400 mm." })
	meter("vert", x0 + 1.3, 1.1, "LEVEL\nWIDE", k .. ".levelWide", -1500, 1500, "mm")
	meter("vert", x0 + 2.3, 1.1, "LOOP\nFLOW", k .. ".flow", 0, 20000, "t/h")
	meter("vert", x0 + 3.3, 1.1, "INLET\nSUBCOOL", k .. ".subcool", 0, 40, "C", { fmt = "%.1f", tip = "How far below boiling the water entering the core is. Feedwater flow is what provides it." })
	meter("vert", x0 + 4.3, 1.1, "SUCTION\nMARGIN", k .. ".npsh", 0, 2, "MPa", { fmt = "%.2f", low = 0.13, tip = "Pump suction margin. Below the red mark the pumps cavitate: throttle them or restore feedwater." })
end
section("vert", 6.4, 0.7, 3.2, 3.2, "DRUM SEPARATORS")
meter("vert", 6.6, 1.1, "PRESS", "pri.press", 0, 10, "MPa", { fmt = "%.2f", red = 7.35 })
meter("vert", 7.6, 1.1, "TEMP", "pri.temp", 0, 350, "C")
meter("vert", 8.6, 1.1, "HEATUP\nRATE", "pri.heatup", -20, 20, "C/min", { fmt = "%.1f", red = 10 })
recorder("vert", 0.4, 4.1, 7.4, 2.3, "DRUM LEVEL A (red) / B (blue), mm", {
	{ sig = "loop.1.level", lo = -600, hi = 600, color = "red" },
	{ sig = "loop.2.level", lo = -600, hi = 600, color = "blue" },
})
recorder("vert", 8.2, 4.1, 7.4, 2.3, "TOTAL CORE FLOW (red, 0-40000 t/h) / STEAM FLOW (blue, 0-5000 t/h)", {
	{ sig = "pri.flow", lo = 0, hi = 40000, color = "red" },
	{ sig = "steam.total", lo = 0, hi = 5000, color = "blue" },
})
for l = 1, 2 do
	local x0 = if l == 1 then 0.2 else 8.1
	section("bench", x0, 0.15, 7.7, 4.7, "LOOP " .. (if l == 1 then "A" else "B") .. " MAIN CIRCULATION PUMPS")
	for i = 1, 4 do
		local key = string.format("mcp.%d%d", l, i)
		local x = x0 + 0.25 + (i - 1) * 1.55
		pump("bench", x + 0.15, 0.5, string.format("MCP-%d%d", l, i), key .. ".sw", key .. ".run")
		lamp("bench", x + 0.1, 2.1, "CAVIT", key .. ".cav", "amber", { w = 1.2 })
		digital("bench", x, 2.75, "FLOW", key .. ".flow", "%.0f", "m3/h", 1.4)
		jog("bench", x - 0.05, 3.55, "THROTTLE", key .. ".valve", key .. ".valve", "%.0f", "%")
	end
	jog("bench", x0 + 6.3, 0.6, "BLOWDOWN", "loop." .. l .. ".blowdown", "loop." .. l .. ".blowdown", "%.0f", "%")
	toggle("bench", x0 + 6.5, 2.2, "LETDOWN\nAUTO", "loop." .. l .. ".letdownAuto", "loop." .. l .. ".letdownAuto")
end

-- ------------------------------------------------------------------ P3
panel("P3", "REACTOR CONTROL")
annunciators()
add({ kind = "coremap", face = "vert", x = 0.3, y = 0.62, w = 5.85, h = 5.85, label = "CORE MAP" })
add({ kind = "axial", face = "vert", x = 6.3, y = 0.62, w = 1.3, h = 5.85, label = "AXIAL" })
section("vert", 7.8, 0.62, 7.9, 3.05, "NEUTRON MONITORING")
meter("vert", 8.0, 1.0, "SOURCE\nRANGE", "n.logcps", 0, 6, "log cps", { fmt = "%.1f", tip = "Source range count rate, log scale. Watch it double as rods come out on the approach to criticality." })
meter("vert", 9.0, 1.0, "INTERM\nRANGE", "n.log", -9, 1, "log P", { fmt = "%.1f", tip = "Intermediate range: log10 of reactor power as a fraction of nominal." })
meter("vert", 10.0, 1.0, "POWER\nRANGE", "n.power", 0, 125, "%", { fmt = "%.1f", red = 110, amber = 100 })
meter("vert", 11.0, 1.0, "STARTUP\nRATE", "n.sur", -1, 3, "dec/min", { fmt = "%.2f", red = 2.6, amber = 1.3, tip = "Startup rate in decades per minute. 1.3 is a 20 s period (rod block), 2.6 is a 10 s period (scram)." })
meter("vert", 12.0, 1.0, "AR\nERROR", "ar.error", -10, 10, "%", { fmt = "%.1f", tip = "Reactor power minus regulator setpoint. Null this before switching a regulator in." })
digital("vert", 13.1, 1.05, "THERMAL POWER", "n.thermal", "%.0f", "MW", 2.4)
digital("vert", 13.1, 1.9, "PERIOD", "n.period", "%.0f", "s", 1.0)
digital("vert", 14.15, 1.9, "REACTIVITY", "n.rho", "%+.2f", "beta", 1.35)
digital("vert", 13.1, 2.75, "MARGIN (ORM)", "core.orm", "%.0f", "rods", 2.4)
add({ kind = "computer", face = "vert", x = 7.8, y = 3.8, w = 7.9, h = 2.67, label = "UNIT COMPUTER" })

add({ kind = "rodmatrix", face = "bench", x = 0.25, y = 0.25, w = 4.5, h = 4.5, label = "ROD SELECT" })
section("bench", 5.0, 0.15, 5.3, 2.35, "ROD MOTION")
button("bench", 5.15, 0.5, "WITHDRAW", "rod.move", { value = -1, hold = true, color = "white", w = 1.1 })
button("bench", 6.3, 0.5, "INSERT", "rod.move", { value = 1, hold = true, color = "white", w = 1.1 })
button("bench", 7.45, 0.5, "CLEAR\nSELECT", "rod.clear", { color = "black" })
toggle("bench", 8.4, 0.45, "SELECT", "rod.quad", "rod.quad", { labels = { "ONE", "FOUR" } })
digital("bench", 5.15, 1.62, "SELECTED", "rod.selCount", "%.0f", "", 0.95)
digital("bench", 6.15, 1.62, "DEPTH", "rod.selPos", "%.2f", "m", 1.25)
lamp("bench", 7.5, 1.78, "ROD BLOCK", "rod.block", "amber", { w = 1.3 })
lamp("bench", 8.85, 1.78, "AZ RODS OUT", "rod.azOut", "green", { w = 1.4 })
section("bench", 5.0, 2.65, 5.3, 2.25, "GROUPS AND INTERLOCKS")
button("bench", 5.15, 2.92, "SELECT\nAZ RODS", "rod.group", { value = 1, color = "red" })
button("bench", 6.1, 2.92, "SELECT\nUSP", "rod.group", { value = 2, color = "blue" })
button("bench", 7.05, 2.92, "SELECT\nAR", "rod.group", { value = 3, color = "green" })
button("bench", 8.0, 2.92, "SELECT\nLAR", "rod.group", { value = 4, color = "yellow" })
digital("bench", 5.15, 4.0, "RR MEAN", "rod.meanRR", "%.2f", "m", 1.2)
digital("bench", 6.4, 4.0, "AZ MEAN", "rod.meanAZ", "%.2f", "m", 1.2)
digital("bench", 7.65, 4.0, "USP MEAN", "rod.meanUSP", "%.2f", "m", 1.2)
toggle("bench", 9.25, 2.72, "BLOCK", "rod.blockBypass", "rod.blockBypass", { labels = { "NORM", "BYP" }, key = true, compact = true })
toggle("bench", 9.25, 3.84, "AZ INTLK", "rod.azInterlockBypass", "rod.azInterlockBypass", { labels = { "NORM", "BYP" }, key = true, compact = true })

section("bench", 10.5, 0.15, 5.3, 1.9, "EMERGENCY PROTECTION")
button("bench", 10.65, 0.45, "AZ-5", "az5.button", { color = "red", big = true, w = 1.3, h = 1.45 })
button("bench", 12.05, 0.6, "AZ\nRESET", "az.reset", { color = "black" })
toggle("bench", 13.05, 0.5, "KOM\nCLUTCHES", "kom", "kom", { labels = { "NORM", "DROP" }, key = true })
for n = 1, 5 do
	lamp("bench", 14.2, 0.42 + (5 - n) * 0.31, "AZ-" .. n, "az" .. n .. ".active", "red", { w = 1.4, h = 0.3 })
end
section("bench", 10.5, 2.15, 5.3, 1.35, "")
selector("bench", 10.6, 2.2, "REGULATOR", "ar.mode", "ar.mode", { "OFF", "AR-1", "AR-2", "AR-3" })
jog("bench", 11.95, 2.2, "SETPOINT", "ar.sp", "ar.setpoint", "%.2f", "%")
toggle("bench", 13.5, 2.2, "LOCAL REG", "lar.sw", "lar.on", { labels = { "OFF", "ON" } })
selector("bench", 14.5, 2.2, "MAP SHOWS", "map.mode", "map.mode", { "FLUX", "POWER", "MARGIN", "FLOW", "QUAL", "FUEL T", "XENON", "GRAPH" }, 1)
section("bench", 10.5, 3.58, 5.3, 1.4, "PROTECTION BYPASS KEYS")
do
	local keys = { { "period", "PERIOD" }, { "press", "PRESS" }, { "level", "LEVEL" }, { "feed", "FEED" }, { "mcp", "MCP" }, { "turbines", "2 TG" }, { "cps", "CPS" } }
	for i, k in keys do
		add({ kind = "toggle", face = "bench", x = 10.55 + (i - 1) * 0.74, y = 3.84, w = 0.72, h = 1.12, label = k[2], cmd = "prot.bypass." .. k[1], sig = "prot.bypass." .. k[1], positions = { "", "BYP" }, key = true, compact = true })
	end
end

-- ------------------------------------------------------------------ P4
panel("P4", "FEEDWATER AND CONDENSATE")
annunciators()
section("vert", 0.3, 0.7, 6.3, 3.2, "FEEDWATER")
meter("vert", 0.5, 1.1, "FEED\nFLOW A", "loop.1.feed", 0, 2500, "t/h")
meter("vert", 1.5, 1.1, "STEAM\nFLOW A", "loop.1.steam", 0, 2500, "t/h")
meter("vert", 2.5, 1.1, "FEED\nFLOW B", "loop.2.feed", 0, 2500, "t/h")
meter("vert", 3.5, 1.1, "STEAM\nFLOW B", "loop.2.steam", 0, 2500, "t/h")
meter("vert", 4.5, 1.1, "HEADER\nPRESS", "fw.header", 0, 12, "MPa", { fmt = "%.1f" })
meter("vert", 5.5, 1.1, "FEED\nTEMP", "fw.temp", 0, 200, "C")
section("vert", 6.9, 0.7, 4.3, 3.2, "DEAERATOR AND CONDENSATE")
meter("vert", 7.1, 1.1, "DEAER\nLEVEL", "da.level", 0, 100, "%", { low = 25 })
meter("vert", 8.1, 1.1, "COND\nFLOW", "cond.flow", 0, 5000, "t/h")
meter("vert", 9.1, 1.1, "HOTWELL\n1", "tg.1.hotwell", 0, 100, "%")
meter("vert", 10.1, 1.1, "HOTWELL\n2", "tg.2.hotwell", 0, 100, "%")
section("vert", 11.5, 0.7, 4.2, 3.2, "DRUM LEVEL")
meter("vert", 11.8, 1.1, "DRUM A", "loop.1.level", -600, 600, "mm")
meter("vert", 12.8, 1.1, "DRUM B", "loop.2.level", -600, 600, "mm")
meter("vert", 13.8, 1.1, "VALVE A", "lvl.1.valve", 0, 100, "%")
meter("vert", 14.8, 1.1, "VALVE B", "lvl.2.valve", 0, 100, "%")
recorder("vert", 0.4, 4.1, 15.2, 2.3, "TOTAL FEEDWATER (red) / TOTAL STEAM (blue), 0-5000 t/h", {
	{ sig = "fw.total", lo = 0, hi = 5000, color = "red" },
	{ sig = "steam.total", lo = 0, hi = 5000, color = "blue" },
})
section("bench", 0.2, 0.15, 5.0, 2.3, "MAIN FEEDWATER PUMPS")
for i = 1, 4 do
	pump("bench", 0.45 + (i - 1) * 1.2, 0.5, "FWP-" .. i, "fw.pump." .. i, "fw.pump." .. i .. ".run")
end
section("bench", 5.4, 0.15, 5.1, 2.3, "EMERGENCY FEEDWATER PUMPS")
for i = 1, 3 do
	pump("bench", 5.65 + (i - 1) * 1.2, 0.5, "AFWP-" .. i, "afw.pump." .. i, "afw.pump." .. i .. ".run")
end
toggle("bench", 9.3, 0.6, "AUTO\nSTART", "afw.auto", "afw.auto")
section("bench", 10.7, 0.15, 5.1, 2.3, "CONDENSATE PUMPS")
for i = 1, 3 do
	pump("bench", 10.95 + (i - 1) * 1.2, 0.5, "CP-" .. i, "cond.pump." .. i, "cond.pump." .. i .. ".run")
end
digital("bench", 14.4, 0.9, "RUNNING", "cond.running", "%.0f", "", 1.2)
for l = 1, 2 do
	local x0 = if l == 1 then 0.2 else 5.4
	section("bench", x0, 2.6, 5.0, 2.25, "DRUM " .. (if l == 1 then "A" else "B") .. " LEVEL CONTROL")
	toggle("bench", x0 + 0.3, 3.05, "CONTROLLER", "lvl." .. l .. ".auto", "lvl." .. l .. ".auto", { labels = { "MAN", "AUTO" } })
	jog("bench", x0 + 1.5, 3.05, "FEED VALVE", "lvl." .. l .. ".valve", "lvl." .. l .. ".valve", "%.0f", "%")
	digital("bench", x0 + 3.3, 3.25, "LEVEL", "loop." .. l .. ".level", "%.0f", "mm", 1.4)
end
section("bench", 10.7, 2.6, 5.1, 2.25, "DEAERATOR")
toggle("bench", 10.95, 3.05, "PEGGING\nSTEAM", "da.peg", "da.peg")
toggle("bench", 12.05, 3.05, "LEVEL\nCONTROL", "da.levelAuto", "da.levelAuto", { labels = { "MAN", "AUTO" } })
jog("bench", 13.2, 3.05, "COND VALVE", "da.valve", "da.valve", "%.0f", "%")
digital("bench", 14.75, 3.25, "TEMP", "da.temp", "%.0f", "C", 0.95)

-- ------------------------------------------------------------------ P5
panel("P5", "TURBINE-GENERATORS")
annunciators()
for k = 1, 2 do
	local x0 = if k == 1 then 0.2 else 8.6
	local key = "tg." .. k
	section("vert", x0, 0.7, 7.2, 3.2, "TURBINE " .. k)
	meter("vert", x0 + 0.2, 1.1, "SPEED", key .. ".rpm", 0, 2200, "rpm", { red = 1980 })
	meter("vert", x0 + 1.07, 1.1, "CONTROL\nVALVES", key .. ".cv", 0, 110, "%")
	meter("vert", x0 + 1.94, 1.1, "BYPASS", key .. ".bypass", 0, 100, "%")
	meter("vert", x0 + 2.81, 1.1, "COND\nPRESS", key .. ".vac", 0, 105, "kPa", { fmt = "%.1f", red = 30, amber = 15, tip = "Condenser absolute pressure. About 5 kPa is good vacuum; the turbine trips at 30." })
	meter("vert", x0 + 3.68, 1.1, "VIBRA-\nTION", key .. ".vib", 0, 15, "mm/s", { fmt = "%.1f", red = 11.8, amber = 7.1 })
	meter("vert", x0 + 4.55, 1.1, "METAL\nTEMP", key .. ".metal", 0, 300, "C")
	meter("vert", x0 + 5.42, 1.1, "THERMAL\nSTRESS", key .. ".stress", 0, 150, "", { red = 60, tip = "Steam-to-metal temperature difference weighted by steam flow. Above the red mark the turbine is being damaged: slow down." })
	meter("vert", x0 + 6.29, 1.1, "LUBE\nOIL", key .. ".lube", 0, 0.3, "MPa", { fmt = "%.2f", low = 0.12 })
end
section("vert", 7.5, 0.7, 1.0, 3.2, "")
digital("vert", 0.3, 4.15, "STEAM PRESSURE", "pri.press", "%.2f", "MPa", 2.2)
digital("vert", 2.6, 4.15, "PRESSURE SETPOINT", "ehc.pressSet", "%.2f", "MPa", 2.2)
digital("vert", 0.3, 5.05, "STEAM DEMAND", "ehc.demand", "%.0f", "%", 2.2)
digital("vert", 2.6, 5.05, "TOTAL STEAM", "steam.total", "%.0f", "t/h", 2.2)
recorder("vert", 5.1, 4.1, 10.6, 2.3, "TURBINE 1 SPEED (red) / TURBINE 2 SPEED (blue), 0-2000 rpm", {
	{ sig = "tg.1.rpm", lo = 0, hi = 2000, color = "red" },
	{ sig = "tg.2.rpm", lo = 0, hi = 2000, color = "blue" },
})
section("bench", 6.9, 0.15, 2.2, 4.7, "PRESSURE REG")
toggle("bench", 7.5, 0.5, "REGULATOR", "ehc.pressAuto", "ehc.pressAuto", { labels = { "OUT", "IN" } })
jog("bench", 7.25, 2.0, "PRESS SET", "ehc.press", "ehc.pressSet", "%.2f", "")
digital("bench", 7.3, 3.6, "DEMAND", "ehc.demand", "%.0f", "%", 1.4)
for k = 1, 2 do
	local x0 = if k == 1 then 0.15 else 9.25
	local key = "tg." .. k
	section("bench", x0, 0.15, 6.6, 4.7, "TURBINE " .. k)
	button("bench", x0 + 0.15, 0.5, "TRIP", key .. ".trip", { color = "red" })
	button("bench", x0 + 1.05, 0.5, "RESET\nLATCH", key .. ".reset", { color = "green" })
	lamp("bench", x0 + 0.1, 1.6, "TRIPPED", key .. ".trip", "red", { w = 0.95 })
	lamp("bench", x0 + 1.05, 1.6, "LATCHED", key .. ".stop", "green", { w = 0.95 })
	jog("bench", x0 + 2.05, 0.4, "STEAM ISOL", key .. ".iso", key .. ".iso", "%.0f", "%")
	selector("bench", x0 + 3.65, 0.4, "SPEED SET", key .. ".speed", key .. ".speedTarget", { "STOP", "500", "1800" })
	jog("bench", x0 + 5.0, 0.4, "LOAD SET", key .. ".load", key .. ".load", "%.0f", "%")
	toggle("bench", x0 + 2.15, 1.85, "BYPASS", key .. ".bypassAuto", key .. ".bypassAuto", { labels = { "MAN", "AUTO" } })
	jog("bench", x0 + 3.3, 1.85, "BYPASS VLV", key .. ".bypass", key .. ".bypass", "%.0f", "%")
	digital("bench", x0 + 5.0, 2.05, "GEN MW", "gen." .. k .. ".mw", "%.0f", "", 1.4)
	local row = {
		{ "LUBE\nOIL PUMP", ".lube", ".lubeAC" },
		{ "TURNING\nGEAR", ".tgear", ".tgear" },
		{ "GLAND\nSTEAM", ".gland", ".gland" },
		{ "CIRC\nPUMP A", ".cw1", ".cw1" },
		{ "CIRC\nPUMP B", ".cw2", ".cw2" },
		{ "VACUUM\nPUMP", ".vacPump", ".vacPump" },
		{ "STEAM\nEJECTOR", ".sjae", ".sjae" },
	}
	for i, r in row do
		toggle("bench", x0 + 0.08 + (i - 1) * 0.93, 3.55, r[1], key .. r[2], key .. r[3], { compact = true })
	end
	toggle("bench", x0 + 0.55, 2.2, "VAC BREAKER", key .. ".vacBreaker", key .. ".vacBreaker", { labels = { "SHUT", "OPEN" }, compact = true })
end

-- ------------------------------------------------------------------ P6
panel("P6", "ELECTRICAL")
annunciators()
for k = 1, 2 do
	local x0 = if k == 1 then 0.2 else 4.6
	local key = "gen." .. k
	section("vert", x0, 0.7, 4.2, 3.2, "GENERATOR " .. k)
	meter("vert", x0 + 0.2, 1.1, "MW", key .. ".mw", 0, 450, "MW")
	meter("vert", x0 + 1.2, 1.1, "MVAR", key .. ".mvar", -200, 200, "MVAr")
	meter("vert", x0 + 2.2, 1.1, "VOLTS", key .. ".kv", 0, 26, "kV", { fmt = "%.1f" })
	meter("vert", x0 + 3.2, 1.1, "FREQ", key .. ".hz", 55, 65, "Hz", { fmt = "%.2f" })
end
add({ kind = "sync", face = "vert", x = 9.1, y = 0.7, w = 3.2, h = 3.2, label = "SYNCHROSCOPE" })
section("vert", 12.6, 0.7, 3.2, 3.2, "UNIT OUTPUT")
digital("vert", 12.8, 1.05, "GROSS", "plant.gross", "%.0f", "MW", 2.8)
digital("vert", 12.8, 1.95, "AUXILIARIES", "plant.aux", "%.1f", "MW", 2.8)
digital("vert", 12.8, 2.85, "NET TO GRID", "plant.net", "%.0f", "MW", 2.8)
section("vert", 0.2, 4.1, 9.0, 2.3, "BUSES")
do
	local names = { "1A", "1B", "2A", "2B" }
	for i, name in names do
		local x = 0.4 + (i - 1) * 1.55
		lamp("vert", x, 4.5, "BUS " .. name, "bus." .. name .. ".live", "red", { w = 1.4 })
		lamp("vert", x, 5.05, "ON RESERVE", "bus." .. name .. ".reserve", "amber", { w = 1.4 })
		digital("vert", x, 5.55, "LOAD", "bus." .. name .. ".mw", "%.1f", "MW", 1.4)
	end
	for i = 1, 3 do
		local x = 6.7 + (i - 1) * 0.83
		lamp("vert", x, 4.5, "E" .. i, "ebus." .. i .. ".live", "red", { w = 0.8 })
		lamp("vert", x, 5.05, "DG" .. i, "dg." .. i .. ".run", "amber", { w = 0.8 })
		lamp("vert", x, 5.6, "BKR", "dg." .. i .. ".bkr", "red", { w = 0.8 })
	end
end
recorder("vert", 9.5, 4.1, 6.2, 2.3, "GROSS GENERATION, 0-900 MW", { { sig = "plant.gross", lo = 0, hi = 900, color = "red" } })
for k = 1, 2 do
	local x0 = if k == 1 then 0.15 else 5.0
	local key = "gen." .. k
	section("bench", x0, 0.15, 4.75, 2.3, "GENERATOR " .. k)
	toggle("bench", x0 + 0.1, 0.6, "FIELD\nBREAKER", key .. ".field", key .. ".field")
	jog("bench", x0 + 1.12, 0.6, "VOLTAGE", key .. ".volt", key .. ".kv", "%.1f", "kV")
	toggle("bench", x0 + 2.65, 0.6, "GEN\nBREAKER", key .. ".gcb", key .. ".gcb", { labels = { "TRIP", "CLOSE" } })
	toggle("bench", x0 + 3.68, 0.6, "YARD\nBREAKER", key .. ".yard", key .. ".yard", { labels = { "TRIP", "CLOSE" } })
end
section("bench", 9.85, 0.15, 2.65, 2.3, "SYNCHRONISING")
selector("bench", 9.95, 0.6, "SCOPE", "sync.select", "sync.select", { "OFF", "GEN 1", "GEN 2" }, 0, 1.25)
toggle("bench", 11.3, 0.6, "SYNC\nCHECK", "sync.bypass", "sync.bypass", { labels = { "NORM", "BYP" }, key = true })
section("bench", 12.6, 0.15, 3.3, 2.3, "DIESEL GENERATORS")
for i = 1, 3 do
	selector("bench", 12.65 + (i - 1) * 1.08, 0.6, "DG-" .. i, "dg." .. i .. ".mode", "dg." .. i .. ".mode", { "OFF", "AUTO", "RUN" }, 0, 1.05)
end
section("bench", 0.15, 2.6, 12.35, 2.25, "6.9 kV AUXILIARY BUSES")
do
	local names = { "1A", "1B", "2A", "2B" }
	for i, name in names do
		local x = 0.3 + (i - 1) * 3.05
		toggle("bench", x, 3.05, name .. "\nNORMAL", "bus." .. name .. ".normal", "bus." .. name .. ".normal", { labels = { "TRIP", "CLOSE" } })
		toggle("bench", x + 1.0, 3.05, name .. "\nRESERVE", "bus." .. name .. ".reserve", "bus." .. name .. ".reserve", { labels = { "TRIP", "CLOSE" } })
		toggle("bench", x + 2.0, 3.05, "AUTO\nTRANSFER", "bus." .. name .. ".ats", "bus." .. name .. ".ats")
	end
end
section("bench", 12.6, 2.6, 3.3, 2.25, "EMERGENCY BUS TIES")
for i = 1, 3 do
	toggle("bench", 12.65 + (i - 1) * 1.07, 3.05, "E" .. i .. " TIE", "ebus." .. i .. ".tie", "ebus." .. i .. ".tie", { labels = { "OPEN", "CLOSE" } })
end

PanelLayout.panels = panels

-- ------------------------------------------------------------------ signals and commands
-- Every signal the control room displays, in a fixed order. The server
-- packs a snapshot in this order; the client unpacks it the same way.
local signalIndex: { [string]: number } = {}
local signalList: { string } = {}
local commandSet: { [string]: boolean } = {}
local holdSet: { [string]: boolean } = {}

local function needSignal(name: string?)
	if name and name ~= "" and not signalIndex[name] then
		table.insert(signalList, name)
		signalIndex[name] = #signalList
	end
end

for _, p in panels do
	for _, w in p.widgets do
		needSignal(w.sig)
		needSignal(w.lit)
		if w.pens then
			for _, pen in w.pens do
				needSignal(pen.sig)
			end
		end
		if w.cmd then
			commandSet[w.cmd] = true
			if w.hold or w.kind == "jog" then
				holdSet[w.cmd] = true
			end
		end
	end
end
-- Signals used by the special displays and the client itself.
for _, name in {
	"horn", "time", "n.power", "n.thermal", "n.period", "n.rho", "n.log", "core.orm", "core.xenon", "core.void", "core.kr", "core.kz", "core.offset",
	"core.tilt", "core.maxFuel", "core.maxClad", "core.minMargin", "core.maxChannel", "core.fuelT", "core.graphT", "core.fluxPeak", "core.destroyed",
	"core.ruptured", "map.mode", "pri.press", "pri.temp", "plant.gross", "plant.net", "ar.setpoint", "ar.mode", "lar.on", "rod.selFirst", "rod.selCount",
	"sync.angle", "sync.df", "sync.dv", "sync.ok", "sync.on", "sync.select", "prot.firstOut", "stats.energy", "stats.scrams", "ar.pos1", "ar.pos2", "ar.pos3",
	"rod.meanLAR", "steam.total", "fw.total",
} do
	needSignal(name)
end
for z = 1, 14 do
	needSignal("core.ax" .. z)
end
for z = 1, 12 do
	needSignal("core.zone" .. z)
end
-- Commands with no panel widget of their own.
for _, name in { "rod.select", "map.mode", "ann.ack" } do
	commandSet[name] = true
end

PanelLayout.signals = signalList
PanelLayout.signalIndex = signalIndex
PanelLayout.commands = commandSet
PanelLayout.holdCommands = holdSet

-- ------------------------------------------------------------------ geometry
export type Face = { center: Vector3, right: Vector3, up: Vector3, normal: Vector3, width: number, height: number }

-- Where a panel stands: its origin is the floor point under the middle of
-- the bench's front edge; x is the operator's right, z points back at them.
--
-- The boards form an L, as in a classic control room: P1 and P2 stand on a
-- wing along the left wall, the run turns a square corner, and P3 to P6 fill
-- the back wall. The reactor panel, P3, is the one at the corner.
function PanelLayout.panelFrame(index: number): (Vector3, Vector3, Vector3)
	local W = PanelLayout.PANEL_WIDTH
	local z = PanelLayout.BACK_WALL_Z
	local cx = PanelLayout.CORNER_X
	local wing = PanelLayout.WING_PANELS
	if index <= wing then
		-- On the wing, facing east; panel `wing` is the one next to the corner.
		local fromCorner = (wing - index + 0.5) * W
		return Vector3.new(cx, 0, z + fromCorner), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0)
	end
	return Vector3.new(cx + (index - wing - 0.5) * W, 0, z), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1)
end

function PanelLayout.face(index: number, face: string): Face
	local origin, right, back = PanelLayout.panelFrame(index)
	local up = Vector3.new(0, 1, 0)
	local s = PanelLayout.BENCH_SLOPE
	local depth = PanelLayout.BENCH_DEPTH
	local h0 = PanelLayout.BENCH_FRONT_HEIGHT
	local backY = h0 + depth * math.sin(s)
	local backZ = -depth * math.cos(s)
	local function at(y: number, z: number): Vector3
		return origin + up * y + back * z
	end
	if face == "bench" then
		return {
			center = at(h0 + depth / 2 * math.sin(s), -depth / 2 * math.cos(s)),
			right = right,
			up = up * math.sin(s) - back * math.cos(s),
			normal = up * math.cos(s) + back * math.sin(s),
			width = PanelLayout.PANEL_WIDTH,
			height = depth,
		}
	elseif face == "vert" then
		return {
			center = at(backY + PanelLayout.VERT_HEIGHT / 2, backZ),
			right = right,
			up = up,
			normal = back,
			width = PanelLayout.PANEL_WIDTH,
			height = PanelLayout.VERT_HEIGHT,
		}
	else
		return {
			center = at(backY + PanelLayout.VERT_HEIGHT + PanelLayout.ANN_HEIGHT / 2, backZ),
			right = right,
			up = up,
			normal = back,
			width = PanelLayout.PANEL_WIDTH,
			height = PanelLayout.ANN_HEIGHT,
		}
	end
end

-- World position of a point on a face, `lift` studs proud of the surface.
function PanelLayout.toWorld(f: Face, x: number, y: number, lift: number?): Vector3
	return f.center + f.right * (x - f.width / 2) + f.up * (f.height / 2 - y) + f.normal * (PanelLayout.FACE_THICKNESS / 2 + (lift or 0))
end

-- Face coordinates of a world point (the inverse of toWorld).
function PanelLayout.toFace(f: Face, p: Vector3): (number, number)
	local d = p - f.center
	return d:Dot(f.right) + f.width / 2, f.height / 2 - d:Dot(f.up)
end

-- CFrame for a part whose Front face is the display surface.
function PanelLayout.faceCFrame(f: Face): CFrame
	-- Part axes: +Z is the back of the part, so it points into the panel.
	local z = -f.normal
	local y = f.up
	local x = y:Cross(z)
	return CFrame.fromMatrix(f.center, x, y, z)
end

return PanelLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Procedures</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Operating procedures shown in the in-game binder (press P).
-- Lines starting with "[ ]" are checklist steps the player can tick off.
local Procedures = {}

Procedures.pages = {
	{
		title = "1  Read this first",
		lines = {
			"RBMK-800: a graphite-moderated channel reactor, 2560 MW thermal, 800 MW electric,",
			"with the reactor of 1986 and the control room of an American boiling-water plant.",
			"",
			"The boards form an L. On the left wing: P1 auxiliaries and emergency cooling, then",
			"P2 main circulation. At the corner, on the back wall: P3 reactor control. Along the",
			"back wall from there: P4 feedwater, P5 turbines, P6 electrical.",
			"",
			"Walk up to a panel and press E to sit at it. A and D move along the row, W and S",
			"switch between the bench, the vertical board and a wide view. Hover over anything",
			"for its name and reading. Raise/lower buttons act for as long as you hold them.",
			"",
			"Time is real. Xenon takes hours. A careful cold start takes 60 to 90 minutes;",
			"it can be done in 20 if you ignore the limits and accept what that does to the plant.",
			"",
			"What this reactor does that others do not:",
			"  - Boiling ADDS reactivity (positive void coefficient). The fewer control rods in",
			"    the core, the stronger the effect. Below about 20% power it wins outright and",
			"    the reactor is unstable.",
			"  - The rods take 16 seconds to go in, and each carries a graphite follower. From",
			"    fully withdrawn, the first second or two of insertion pushes water out of the",
			"    bottom of the core and ADDS reactivity there. With few rods in and the power",
			"    low in the core, AZ-5 can briefly make things worse. Keep the margin up.",
			"  - The reactivity margin (ORM on the unit computer) is the number of rods' worth",
			"    still in the core. Below 26 needs a very good reason. Below 15: shut down.",
		},
	},
	{
		title = "2  Cold startup",
		lines = {
			"AUXILIARIES",
			"[ ] P6: confirm buses 1A 1B 2A 2B live on the reserve feed",
			"[ ] P1: rod channel cooling pump running, tank level normal",
			"[ ] P4: start one condensate pump; deaerator level control in AUTO",
			"[ ] P5 (each turbine): both circ pumps ON, lube oil pump ON, turning gear ON,",
			"    vacuum breaker SHUT, vacuum pump ON",
			"[ ] P2: letdown AUTO on both loops (holds drum level as the water expands)",
			"",
			"MAIN CIRCULATION",
			"[ ] P2: lower each MCP throttle to about 35% (cold water gives little suction head)",
			"[ ] P2: start three MCPs in each loop, one at a time; leave the fourth as standby",
			"[ ] P2: no CAVIT lamps, suction margin clear of the red mark",
			"[ ] P1: cooldown system OFF",
			"",
			"APPROACH TO CRITICALITY",
			"[ ] P3: AZ RESET; confirm no AZ lamps lit",
			"[ ] P3: SELECT AZ RODS, hold WITHDRAW until AZ RODS OUT lights, CLEAR SELECT",
			"[ ] P3: withdraw manual (white) rods a few at a time. Use the FLUX cartogram: pull",
			"    rods where the lamps are darkest, and spread each group across the core",
			"[ ] Watch the source range meter. As it starts to climb on its own, slow down:",
			"    single rods, a metre at a time, and wait for the count rate to settle",
			"[ ] Keep the startup rate under 1 decade/min (rod block at 1.3, scram at 2.6)",
			"[ ] Raise the regulator SETPOINT to 0.02%, switch REGULATOR to AR-3. It will catch",
			"    the power there. Expect roughly three quarters of the manual rods to be out",
			"",
			"HEATUP",
			"[ ] P3: raise the setpoint slowly to 3 or 4%. Keep the regulator's rods mid-travel",
			"    by moving manual rods a metre at a time",
			"[ ] P2: hold the heatup rate under 10 C/min. Faster weakens every pressure tube",
			"[ ] Do not let the channels boil at low pressure: keep power low until pressure rises",
			"[ ] At 0.6 MPa: P5 gland steam ON.  At 1.2 MPa: steam ejectors ON, vacuum pumps OFF",
			"[ ] At 1 MPa: P4 start one feed pump, both drum level controllers to AUTO",
			"[ ] Open the MCP throttles as pressure rises; watch the suction margin",
			"[ ] At 6.9 MPa the bypass valves open by themselves and hold pressure",
			"",
			"TURBINES",
			"[ ] P4: pegging steam ON (warms the feedwater with spare steam; it only works above 6 MPa)",
			"[ ] P3: raise the setpoint to 6%, null the AR ERROR meter, switch to AR-1,",
			"    then raise to about 15%. Stay under 25% until a generator is on the grid",
			"[ ] P5: RESET LATCH turbine 1, open STEAM ISOL fully, SPEED SET 500, soak two minutes",
			"[ ] P5: SPEED SET 1800. Do not linger near 1000 rpm (critical speed)",
			"[ ] P6: FIELD BREAKER closed, SCOPE to GEN 1, close GEN BREAKER with IN SYNC lit",
			"[ ] P5: raise LOAD SET to about 10%, soak two minutes, then raise it to 100%",
			"    (the pressure regulator, not the load set, then decides the load)",
			"[ ] Repeat for turbine 2. Stay under 50% until both generators are on the grid",
			"",
			"POWER ASCENSION",
			"[ ] P4: second feed pump and second condensate pump before 30%, third before 60%",
			"[ ] P3: above 10%, LOCAL REG ON to hold the power shape",
			"[ ] P3: raise the setpoint in steps to 100%, pausing to rebalance rods",
			"[ ] Watch: channel dryout margin above 1.3, radial tilt, drum levels, ORM",
			"[ ] P6 (optional): move the buses to their unit transformers (NORMAL closed,",
			"    RESERVE tripped)",
		},
	},
	{
		title = "3  At power",
		lines = {
			"Xenon builds for the first 30 to 40 hours at power: the margin falls and rods must",
			"come out to compensate. After a power reduction it gets worse before it gets better",
			"(peak about 8 hours later). If the margin heads for 15 rods, shut down and wait.",
			"",
			"The automatic regulator moves only its own four rods. When AUTO REGULATOR RODS AT",
			"LIMIT alarms, move manual rods to bring it back to mid-travel.",
			"",
			"The setpoint does not follow the reactor when a regulator is off. Always null the",
			"AR ERROR meter before switching one in, or it will drag the power to wherever the",
			"setpoint happens to be.",
			"",
			"The core is very large and loosely coupled. A single rod moved its full stroke shifts",
			"a tenth of the power to another quadrant, and the shift slowly grows on its own.",
			"The local regulators correct it; without them, watch the map and trim by hand.",
			"",
			"Low feedwater flow means little subcooling at the pump suction: the MCPs cavitate",
			"and the core boils from the bottom. At low power, throttle the pumps.",
			"",
			"Automatic runbacks:  AZ-1 to 60% (an MCP or feed pump lost),  AZ-2 to 50% (one",
			"turbine out),  AZ-3 to 20% (no generator on the grid).  AZ-4 inserts every rod for",
			"as long as its signal lasts.  AZ-5 is a full scram.",
		},
	},
	{
		title = "4  Shutdown",
		lines = {
			"[ ] P3: lower the setpoint in steps to 20%",
			"[ ] P5: lower LOAD SET on one turbine to zero, open its GEN BREAKER, TRIP it",
			"[ ] P5: same for the second turbine; the bypass valves take the steam",
			"[ ] P3: press AZ-5. Confirm every rod in and power falling",
			"[ ] P5: turning gear ON for both turbines as they stop; lube oil stays ON",
			"[ ] P5: lower PRESS SET slowly to cool down (under 10 C/min)",
			"[ ] P4: keep feeding to hold drum level as the water shrinks",
			"[ ] Below 150 C: P1 cooldown system ON; stop all but one MCP per loop",
			"[ ] Below 80 C with every rod in, maintenance repairs burst channels, blocked",
			"    inlet valves and seized rod drives after about three minutes",
		},
	},
	{
		title = "5  Emergencies",
		lines = {
			"FUEL CHANNEL RUPTURE (reactor space pressure, gas activity)",
			"  AZ-5 if not already in. One burst tube is survivable; three at once lift the",
			"  reactor lid. Cool down and depressurise to slow the leak. Feed to hold level.",
			"",
			"CHANNEL DRYOUT MARGIN LOW / CHANNEL FLOW LOW",
			"  One channel is short of water. Reduce power NOW or insert rods beside it.",
			"  A channel in dryout bursts within tens of seconds.",
			"",
			"MAIN CIRCULATION PUMP TRIP",
			"  Start the standby pump in that loop. Fewer than two pumps in a loop scrams.",
			"",
			"LOSS OF FEEDWATER",
			"  Start another feed pump. Emergency feed pumps start by themselves at -500 mm.",
			"  Reduce power. Scram at -600 mm.",
			"",
			"ROD COOLING LOST",
			"  Start the other pump; open tank makeup if the tank is falling. If the rod",
			"  channels boil dry the core GAINS reactivity and the rods seize. Shut down first.",
			"",
			"LOSS OF OFFSITE POWER",
			"  Diesels start in 12 seconds and pick up the emergency buses. The reactor scrams",
			"  on loss of the auxiliary buses. Reclose the yard breakers when power returns.",
			"",
			"RUNAWAY (power rising, short period, at low power with few rods in)",
			"  This is the accident. AZ-5 may add reactivity for the first seconds. The only",
			"  real defence is never to be there: keep the margin, keep feedwater on, and do",
			"  not sit below 20% power in a xenon pit with the rods out.",
			"",
			"KOM releases the rod drive clutches so the rods fall by gravity. Use it if the",
			"drives have no power or a rod group will not drive in.",
		},
	},
	{
		title = "6  Limits",
		lines = {
			"Reactor power                 110% scram, 105% rod block",
			"Startup rate (below 10%)      1.3 dec/min rod block, 1.7 AZ-4, 2.6 scram",
			"Drum pressure                 6.9 MPa normal, 7.35 scram, safety valves 7.45/7.55/7.65",
			"Drum level                    0 normal, -300/+250 alarm, -600/+400 scram",
			"Heatup and cooldown           10 C/min",
			"Reactivity margin             26 rods administrative, 15 rods shut down",
			"Channel dryout margin         1.3 alarm; below 1.0 the channel is in dryout",
			"Fuel temperature              1800 C alarm, 2850 C melts",
			"Reactor space pressure        5 kPa scram, 180 kPa lifts the lid",
			"Condenser pressure            15 kPa alarm, 30 kPa turbine trip, 40 kPa bypass blocked",
			"Turbine speed                 1800 rpm, overspeed trip 1980",
			"Turbine vibration             7.1 mm/s alarm, 11.8 trip",
			"Power without a generator on  25%;  with one generator: 52%",
			"MCPs per loop                 three normally; fewer than two scrams",
		},
	},
}

return Procedures
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Steam</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Saturated water / steam properties from a compact table, interpolated.
-- Pressures are MPa absolute, temperatures degC, enthalpies J/kg, densities kg/m3.
local Util = require(script.Parent.Util)

local Steam = {}

-- P, Tsat, hf (kJ/kg), hfg (kJ/kg), rho_f, rho_g
local T = {
	{ 0.001, 7.0, 29.3, 2484.9, 999.9, 0.0077 },
	{ 0.00234, 20.0, 83.9, 2454.1, 998.2, 0.0173 },
	{ 0.005, 32.9, 137.8, 2423.0, 994.7, 0.0355 },
	{ 0.01, 45.8, 191.8, 2392.1, 989.8, 0.0682 },
	{ 0.02, 60.1, 251.4, 2357.5, 983.1, 0.1308 },
	{ 0.05, 81.3, 340.5, 2304.7, 970.9, 0.3086 },
	{ 0.1, 99.6, 417.5, 2257.5, 958.6, 0.590 },
	{ 0.2, 120.2, 504.7, 2201.6, 942.9, 1.129 },
	{ 0.5, 151.8, 640.1, 2108.0, 915.3, 2.669 },
	{ 1.0, 179.9, 762.6, 2014.6, 887.1, 5.145 },
	{ 2.0, 212.4, 908.6, 1889.8, 849.8, 10.04 },
	{ 3.0, 233.9, 1008.4, 1794.9, 821.9, 15.00 },
	{ 4.0, 250.4, 1087.4, 1713.5, 798.4, 20.09 },
	{ 5.0, 263.9, 1154.5, 1639.7, 777.4, 25.35 },
	{ 6.0, 275.6, 1213.7, 1570.9, 757.9, 30.82 },
	{ 7.0, 285.8, 1267.4, 1505.1, 739.4, 36.52 },
	{ 8.0, 295.0, 1317.1, 1441.3, 721.5, 42.51 },
	{ 9.0, 303.3, 1363.7, 1378.9, 704.1, 48.80 },
	{ 10.0, 311.0, 1407.9, 1317.1, 688.4, 55.46 },
	{ 12.0, 324.7, 1491.3, 1193.5, 654.7, 70.1 },
	{ 15.0, 342.2, 1610.2, 1000.5, 603.5, 96.7 },
}

local lnP, Ts, hf, hfg, rf, rg = {}, {}, {}, {}, {}, {}
for i, row in T do
	lnP[i] = math.log(row[1])
	Ts[i] = row[2]
	hf[i] = row[3] * 1000
	hfg[i] = row[4] * 1000
	rf[i] = row[5]
	rg[i] = row[6]
end

Steam.P_MIN = T[1][1]
Steam.P_MAX = T[#T][1]

local interp = Util.interp

function Steam.tsat(p: number): number
	return interp(lnP, Ts, math.log(math.max(p, 0.001)))
end

function Steam.psat(t: number): number
	return math.exp(interp(Ts, lnP, t))
end

function Steam.hf(p: number): number
	return interp(lnP, hf, math.log(math.max(p, 0.001)))
end

function Steam.hfg(p: number): number
	return interp(lnP, hfg, math.log(math.max(p, 0.001)))
end

function Steam.rhof(p: number): number
	return interp(lnP, rf, math.log(math.max(p, 0.001)))
end

function Steam.rhog(p: number): number
	return interp(lnP, rg, math.log(math.max(p, 0.001)))
end

-- All saturation properties at once: tsat, hf, hfg, rhof, rhog.
function Steam.sat(p: number): (number, number, number, number, number)
	local l = math.log(math.max(p, 0.001))
	return interp(lnP, Ts, l), interp(lnP, hf, l), interp(lnP, hfg, l), interp(lnP, rf, l), interp(lnP, rg, l)
end

-- Subcooled liquid is treated as saturated liquid at its own temperature.
function Steam.hLiquid(t: number): number
	return interp(Ts, hf, t)
end

function Steam.tLiquid(h: number): number
	return interp(hf, Ts, h)
end

function Steam.rhoLiquid(t: number): number
	return interp(Ts, rf, t)
end

return Steam
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Small helpers shared by the simulation, the layout code and the client.
local Util = {}

function Util.clamp(x: number, lo: number, hi: number): number
	if x < lo then
		return lo
	elseif x > hi then
		return hi
	end
	return x
end

function Util.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- Move `x` toward `target` by at most `maxStep`.
function Util.approach(x: number, target: number, maxStep: number): number
	if x < target then
		x += maxStep
		if x > target then
			x = target
		end
	elseif x > target then
		x -= maxStep
		if x < target then
			x = target
		end
	end
	return x
end

-- First-order lag toward `target` with time constant `tau` over step `dt`.
function Util.lag(x: number, target: number, dt: number, tau: number): number
	if tau <= 0 then
		return target
	end
	local f = dt / (tau + dt)
	return x + (target - x) * f
end

-- Deterministic Park-Miller generator. Roblox's Random is not available in
-- the headless test runtime, and the simulation must be reproducible there.
export type Rng = {
	seed: number,
	next: (self: Rng) -> number,
	range: (self: Rng, lo: number, hi: number) -> number,
	int: (self: Rng, lo: number, hi: number) -> number,
}

function Util.rng(seed: number): Rng
	local self = { seed = (math.floor(seed) % 2147483646) + 1 } :: any
	function self.next(s: Rng): number
		s.seed = (s.seed * 16807) % 2147483647
		return s.seed / 2147483647
	end
	function self.range(s: Rng, lo: number, hi: number): number
		return lo + (hi - lo) * s:next()
	end
	function self.int(s: Rng, lo: number, hi: number): number
		return lo + math.floor(s:next() * (hi - lo + 1))
	end
	-- Discard the first few outputs so nearby seeds decorrelate.
	for _ = 1, 8 do
		self:next()
	end
	return self
end

-- Piecewise-linear interpolation over ascending xs.
function Util.interp(xs: { number }, ys: { number }, x: number): number
	local n = #xs
	if x <= xs[1] then
		return ys[1]
	end
	if x >= xs[n] then
		return ys[n]
	end
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if xs[mid] <= x then
			lo = mid
		else
			hi = mid
		end
	end
	local t = (x - xs[lo]) / (xs[hi] - xs[lo])
	return ys[lo] + (ys[hi] - ys[lo]) * t
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
