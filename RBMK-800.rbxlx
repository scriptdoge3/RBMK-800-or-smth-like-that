  <Item class="ServerScriptService" referent="12">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="13">
      <Properties>
        <string name="Name">RBMKServer</string>
      </Properties>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- Server entry point: builds the room, runs the plant simulation, and
-- keeps every client's control room in step with it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("RBMK")
local Config = require(Shared.Config)
local PanelLayout = require(Shared.PanelLayout)
local AlarmList = require(Shared.AlarmList)
local RoomBuilder = require(script.Parent.RoomBuilder)
local Plant = require(script.Parent.Sim.Plant)

local STEP = 0.1 -- plant time step, seconds
local SNAPSHOT_PERIOD = 0.2
local MAP_PERIOD = 1.0
local REBUILD_DELAY = 75 -- seconds a destroyed unit stays before a new one is commissioned

local remotes = Instance.new("Folder")
remotes.Name = "RBMKRemotes"
local function remote(className: string, name: string): any
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local commandEvent: RemoteEvent = remote("RemoteEvent", "Command")
local snapshotEvent: RemoteEvent = remote("RemoteEvent", "Snapshot")
local mapEvent: RemoteEvent = remote("RemoteEvent", "CoreMap")
local alarmEvent: RemoteEvent = remote("RemoteEvent", "Alarm")
local logEvent: RemoteEvent = remote("RemoteEvent", "Log")
local helloFunction: RemoteFunction = remote("RemoteFunction", "Hello")
remotes.Parent = ReplicatedStorage

print("[RBMK-800] version " .. Config.VERSION)

-- An earlier version modelled the panel hardware in Blender, and the place
-- may still hold that import: a model called RBMKModels (in the Workspace
-- or ReplicatedStorage) or its meshes loose. The hardware is built from
-- parts now, so take any of it out of the game before it can show up in
-- the room.
do
	local OLD_MESHES = {
		PushCap = true, PushCollar = true, MushroomCap = true, MushroomCollar = true,
		LampBezel = true, LampLens = true, SwitchHub = true, PistolGrip = true,
		KeyLock = true, Key = true, KeyBow = true, Knob = true, KnobPointer = true,
		GuardBase = true, GuardCover = true, GuardBaseLarge = true, GuardCoverLarge = true,
		ProbeO = true, ProbeX = true, ProbeY = true, ProbeZ = true,
	}
	local removed = 0
	for _, root in { workspace, ReplicatedStorage } do
		for _, d in root:GetDescendants() do
			if d.Parent and (d.Name == "RBMKModels" or (d:IsA("MeshPart") and OLD_MESHES[d.Name])) then
				d:Destroy()
				removed += 1
			end
		end
	end
	if removed > 0 then
		warn("[RBMK-800] Took the old Blender panel models (RBMKModels) out of the game. They are still saved in this place: delete RBMKModels in Studio's Explorer and save to get rid of them for good.")
	end
end

RoomBuilder.build()

local plant: any = nil
local building = false
local unitNumber = 0
local lastLogSeq = 0

local function commission()
	if building then
		return
	end
	building = true
	plant = nil
	task.spawn(function()
		unitNumber += 1
		local started = os.clock()
		local fresh = Plant.new({
			seed = (os.time() + unitNumber * 7919) % 1000000,
			yield = function()
				task.wait()
			end,
		})
		lastLogSeq = 0
		plant = fresh
		building = false
		print(string.format("[RBMK-800] unit %d ready after %.1f s", unitNumber, os.clock() - started))
		-- Give every client the clean annunciator board of the new unit.
		for i in AlarmList.list do
			alarmEvent:FireAllClients(i, 0)
		end
	end)
end
commission()

-- A client asks for the standing state when it joins.
helloFunction.OnServerInvoke = function(_player: Player)
	if not plant then
		return { ready = false }
	end
	local lines = {}
	for i = math.max(1, #plant.logLines - 40), #plant.logLines do
		local l = plant.logLines[i]
		table.insert(lines, { t = l.t, text = l.text })
	end
	return { ready = true, alarms = table.clone(plant.alarms.state), log = lines, unit = unitNumber }
end

-- Operator commands. Only commands that exist on a panel are accepted, and
-- each player is limited to a sensible rate.
local NOTABLE = {
	["az5.button"] = "pressed AZ-5",
	["eccs.manual"] = "initiated ECCS manually",
	["tg.1.trip"] = "tripped turbine 1",
	["tg.2.trip"] = "tripped turbine 2",
}
local budget: { [Player]: number } = {}
commandEvent.OnServerEvent:Connect(function(player: Player, name: any, value: any)
	if not plant or type(name) ~= "string" or type(value) ~= "number" or value ~= value then
		return
	end
	if not PanelLayout.commands[name] then
		return
	end
	local left = budget[player] or 40
	if left <= 0 then
		return
	end
	budget[player] = left - 1
	value = math.clamp(value, -100000, 100000)
	if PanelLayout.holdCommands[name] then
		plant:hold(name, value, player)
	else
		plant:command(name, value, player)
		local what = NOTABLE[name]
		if what then
			plant:log(player.Name .. " " .. what)
		elseif string.sub(name, 1, 12) == "prot.bypass." or name == "kom" then
			plant:log(string.format("%s set %s to %d", player.Name, name, value))
		end
	end
end)
Players.PlayerRemoving:Connect(function(player: Player)
	budget[player] = nil
end)

local signals = PanelLayout.signals
local snapshot = buffer.create(#signals * 4)
local stepClock, snapshotClock, mapClock, budgetClock, destroyedClock = 0, 0, 0, 0, 0

RunService.Heartbeat:Connect(function(dt: number)
	budgetClock += dt
	if budgetClock >= 1 then
		budgetClock = 0
		table.clear(budget)
	end
	if not plant then
		return
	end
	local p = plant

	-- Fixed-step simulation in real time; never more than two steps a frame.
	stepClock += math.min(dt, 0.25)
	local steps = 0
	while stepClock >= STEP and steps < 2 do
		p:step(STEP)
		stepClock -= STEP
		steps += 1
	end
	if stepClock > 3 * STEP then
		stepClock = 0
	end

	snapshotClock += dt
	if snapshotClock >= SNAPSHOT_PERIOD then
		snapshotClock = 0
		local S = p.S
		for i, name in signals do
			buffer.writef32(snapshot, (i - 1) * 4, S[name] or 0)
		end
		snapshotEvent:FireAllClients(snapshot)
		-- Annunciator changes and new log lines ride along at the same rate.
		local changed = p.alarms.changed
		if #changed > 0 then
			for _, index in changed do
				alarmEvent:FireAllClients(index, p.alarms.state[index])
			end
			table.clear(changed)
		end
		local lines = p.logLines
		local last = lines[#lines]
		if last and last.seq > lastLogSeq then
			local fresh = {}
			for i = #lines, 1, -1 do
				if lines[i].seq <= lastLogSeq then
					break
				end
				table.insert(fresh, 1, { t = lines[i].t, text = lines[i].text })
			end
			lastLogSeq = last.seq
			logEvent:FireAllClients(fresh)
		end
	end

	mapClock += dt
	if mapClock >= MAP_PERIOD then
		mapClock = 0
		mapEvent:FireAllClients(p:mapBuffer())
	end

	-- A wrecked unit is replaced by a new one after a pause.
	if p.core.destroyed then
		destroyedClock += dt
		if destroyedClock > REBUILD_DELAY then
			destroyedClock = 0
			commission()
		end
	else
		destroyedClock = 0
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">RoomBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Builds the control room shell on the server: floor, walls, ceiling, the
-- run of benchboard cabinets and the operators' console. The cabinet faces
-- are plain parts with known names; each client dresses them with
-- instruments and controls from the shared layout.
--
-- The look follows the Soviet RBMK unit control rooms, given a moody,
-- atmospheric art direction rather than a flat or photo-real one: warm
-- beige boards and consoles packed with instruments, in an L around a
-- square corner with the reactor panel set across the corner itself, light
-- boxes along the top that stay dark until they light, a bright ceiling of
-- square luminous panels over a dim room, warm gray walls, a dark floor
-- with yellow and black hazard stripes along the boards, and plain office
-- furniture: two operators' desks with rotary telephones, the SKALA
-- computer's console with its two displays, the alarm printer, the shift
-- supervisor's desk, shelving of procedures and a chalkboard. The lighting
-- and colour grade that finish the look are in default.project.json.
--
-- Everything is laid out in board units (see PanelLayout) and scaled to
-- studs at the end, so the room comes out life-size around a standard
-- character: bench front at hip height, desks at 0.76 m, ceiling at 3.8 m.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local PanelLayout = require(Shared.PanelLayout)

local RoomBuilder = {}

-- Board units per metre.
local M = 5.5

-- Boards and consoles in putty beige, with dark trim along the consoles and
-- a dark kick strip.
local PANEL_COLOR = Color3.fromRGB(194, 188, 168)
local BENCH_COLOR = Color3.fromRGB(188, 182, 162)
local CABINET_COLOR = Color3.fromRGB(150, 144, 126)
local BASE_COLOR = Color3.fromRGB(128, 122, 106)
local CAP_COLOR = Color3.fromRGB(60, 58, 54)
local RUBBER = Color3.fromRGB(54, 50, 44)
local ANN_COLOR = Color3.fromRGB(36, 34, 30)
local DARK = Color3.fromRGB(38, 36, 34)
-- A dark floor with hazard stripes along the boards, dark gray walls with a
-- darker band to shoulder height, a ceiling of luminous panels.
local FLOOR_TILE = Color3.fromRGB(52, 51, 50)
local WALL = Color3.fromRGB(78, 76, 72)
local DADO = Color3.fromRGB(58, 56, 53)
local TILE = Color3.fromRGB(150, 148, 140)
local HAZARD_YELLOW = Color3.fromRGB(226, 182, 40)
local HAZARD_BLACK = Color3.fromRGB(28, 28, 28)
-- Office furniture: beige-gray enamel with wood-veneer tops.
local LAMINATE = Color3.fromRGB(150, 102, 64)
local DESK_STEEL = Color3.fromRGB(176, 170, 152)
local STEEL = Color3.fromRGB(150, 152, 150)
local CHROME = Color3.fromRGB(196, 198, 200)

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function prop(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = part(parent, name, size, cf, color, material)
	p.CanCollide = false
	return p
end

local function cylinderProp(parent: Instance, name: string, diameter: number, length: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	-- A cylinder's axis is its X axis.
	local p = prop(parent, name, Vector3.new(length, diameter, diameter), cf, color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- Text on the front of a part.
local function sign(target: BasePart, str: string, textSize: number, color: Color3, pixelsPerUnit: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerUnit or 30
	gui.LightInfluence = 0.6
	gui.Parent = target
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.Oswald
	t.TextSize = textSize
	t.TextColor3 = color
	t.TextWrapped = true
	t.Text = str
	t.Parent = gui
	return t
end

-- An office swivel chair: seat and back in brown vinyl, arms, a column and
-- a five-star base. `at` is the floor point under the seat; the sitter
-- faces -Z.
local function chair(parent: Instance, at: CFrame, fabric: Color3?)
	fabric = fabric or Color3.fromRGB(116, 58, 42)
	local seatY = 0.47 * M
	prop(parent, "ChairSeat", Vector3.new(0.48 * M, 0.08 * M, 0.46 * M), at * CFrame.new(0, seatY - 0.04 * M, 0), fabric)
	prop(parent, "ChairBack", Vector3.new(0.44 * M, 0.5 * M, 0.07 * M), at * CFrame.new(0, seatY + 0.33 * M, 0.25 * M) * CFrame.Angles(math.rad(-10), 0, 0), fabric)
	for _, side in { -1, 1 } do
		prop(parent, "ChairArm", Vector3.new(0.05 * M, 0.04 * M, 0.3 * M), at * CFrame.new(side * 0.26 * M, seatY + 0.2 * M, 0.02 * M), DARK)
		prop(parent, "ChairArmPost", Vector3.new(0.04 * M, 0.2 * M, 0.04 * M), at * CFrame.new(side * 0.26 * M, seatY + 0.1 * M, 0.08 * M), DARK)
	end
	prop(parent, "ChairColumn", Vector3.new(0.06 * M, seatY - 0.1 * M, 0.06 * M), at * CFrame.new(0, (seatY - 0.1 * M) / 2 + 0.05 * M, 0), CHROME, Enum.Material.Metal)
	for k = 0, 4 do
		prop(parent, "ChairLeg", Vector3.new(0.05 * M, 0.04 * M, 0.32 * M), at * CFrame.new(0, 0.06 * M, 0) * CFrame.Angles(0, k * math.pi * 2 / 5, 0) * CFrame.new(0, 0, 0.16 * M), DARK)
		prop(parent, "ChairCaster", Vector3.new(0.05 * M, 0.05 * M, 0.05 * M), at * CFrame.new(0, 0.025 * M, 0) * CFrame.Angles(0, k * math.pi * 2 / 5, 0) * CFrame.new(0, 0, 0.3 * M), DARK)
	end
end

-- The SKALA computer's operator console: a desk-height cabinet with a
-- sloping keyboard shelf and a hood carrying two green-phosphor displays. The client puts the unit summary on the left screen
-- and the alarm summary on the right. `at` is the floor point under the
-- middle of its front edge; the operator stands or sits on its +Z side.
local function computerConsole(parent: Instance, at: CFrame)
	local w, d = 1.5 * M, 0.75 * M
	local body = Color3.fromRGB(178, 180, 168)
	prop(parent, "ComputerBase", Vector3.new(w, 0.72 * M, d), at * CFrame.new(0, 0.36 * M, -d / 2), body)
	prop(parent, "ComputerKick", Vector3.new(w - 0.04 * M, 0.08 * M, d - 0.06 * M), at * CFrame.new(0, 0.04 * M, -d / 2 - 0.02 * M), RUBBER)
	-- Keyboard shelf, sloping toward the operator.
	prop(parent, "ComputerShelf", Vector3.new(w, 0.04 * M, 0.34 * M), at * CFrame.new(0, 0.76 * M, -0.17 * M) * CFrame.Angles(math.rad(-8), 0, 0), Color3.fromRGB(90, 92, 90))
	for k, x in { -0.37 * M, 0.37 * M } do
		prop(parent, "ComputerKeyboard", Vector3.new(0.5 * M, 0.035 * M, 0.2 * M), at * CFrame.new(x, 0.8 * M, -0.17 * M) * CFrame.Angles(math.rad(-8), 0, 0), Color3.fromRGB(196, 190, 170))
		prop(parent, "ComputerKeys", Vector3.new(0.44 * M, 0.012 * M, 0.15 * M), at * CFrame.new(x, 0.822 * M, -0.17 * M) * CFrame.Angles(math.rad(-8), 0, 0), Color3.fromRGB(70, 66, 60))
		-- The CRT in its hood, tipped back toward the operator's eyes.
		local hood = at * CFrame.new(x, 1.06 * M, -0.52 * M) * CFrame.Angles(math.rad(-12), 0, 0)
		prop(parent, "ComputerHood", Vector3.new(0.7 * M, 0.5 * M, 0.42 * M), hood, body)
		prop(parent, "ComputerBezel", Vector3.new(0.5 * M, 0.38 * M, 0.02 * M), hood * CFrame.new(0, 0, 0.21 * M), Color3.fromRGB(36, 36, 38))
		local screen = prop(parent, "DeskScreen" .. k, Vector3.new(0.34 * M, 0.26 * M, 0.01 * M), hood * CFrame.new(0, 0, 0.222 * M) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(8, 22, 12))
		screen:SetAttribute("DeskScreen", k)
	end
	local tag = prop(parent, "ComputerTag", Vector3.new(0.9 * M, 0.06 * M, 0.01 * M), at * CFrame.new(0, 1.36 * M, -0.36 * M) * CFrame.Angles(math.rad(-12), math.pi, 0), Color3.fromRGB(24, 24, 26))
	sign(tag, "SKALA", 18, Color3.fromRGB(236, 236, 228), 60)
end

-- An office desk: a wood-veneer top, a light gray enamel body, a modesty
-- panel and a three-drawer pedestal on the right.
-- `at` is the floor point under the middle of the desk; the user sits on
-- its +Z side.
local function steelDesk(parent: Instance, at: CFrame, length: number, depth: number)
	local h = 0.74 * M
	local top = 0.03 * M
	prop(parent, "DeskTop", Vector3.new(length, top, depth), at * CFrame.new(0, h - top / 2, 0), LAMINATE, Enum.Material.Wood).CanCollide = true
	prop(parent, "DeskEdge", Vector3.new(length + 0.01 * M, top + 0.004 * M, 0.012 * M), at * CFrame.new(0, h - top / 2, depth / 2), Color3.fromRGB(96, 62, 38), Enum.Material.Wood)
	prop(parent, "DeskModesty", Vector3.new(length - 0.04 * M, h - top - 0.12 * M, 0.02 * M), at * CFrame.new(0, (h - top) / 2 + 0.06 * M, -depth / 2 + 0.04 * M), DESK_STEEL, Enum.Material.Metal)
	local pw = 0.4 * M
	local px = length / 2 - pw / 2
	part(parent, "DeskPedestal", Vector3.new(pw, h - top, depth - 0.02 * M), at * CFrame.new(px, (h - top) / 2, 0), DESK_STEEL, Enum.Material.Metal)
	prop(parent, "DeskLeg", Vector3.new(0.04 * M, h - top, depth - 0.04 * M), at * CFrame.new(-length / 2 + 0.02 * M, (h - top) / 2, 0), DESK_STEEL, Enum.Material.Metal)
	for k = 0, 2 do
		prop(parent, "DrawerFront", Vector3.new(pw - 0.04 * M, 0.2 * M, 0.012 * M), at * CFrame.new(px, 0.13 * M + k * 0.22 * M, depth / 2 - 0.004 * M), Color3.fromRGB(184, 188, 180), Enum.Material.Metal)
		prop(parent, "DrawerPull", Vector3.new(0.14 * M, 0.02 * M, 0.02 * M), at * CFrame.new(px, 0.19 * M + k * 0.22 * M, depth / 2 + 0.006 * M), CHROME, Enum.Material.Metal)
	end
end

-- A desk telephone of the period: a body with a sloping front carrying the
-- rotary dial, and the handset across the cradle. The red one is the
-- direct line, with no dial. `at` is the desk-top point under it; it faces
-- +Z.
local function telephone(parent: Instance, at: CFrame, color: Color3, hotline: boolean?)
	prop(parent, "Phone", Vector3.new(0.22 * M, 0.07 * M, 0.24 * M), at * CFrame.new(0, 0.035 * M, -0.01 * M), color)
	prop(parent, "PhoneFront", Vector3.new(0.2 * M, 0.04 * M, 0.14 * M), at * CFrame.new(0, 0.075 * M, 0.04 * M) * CFrame.Angles(math.rad(-22), 0, 0), color)
	if not hotline then
		cylinderProp(parent, "PhoneDial", 0.12 * M, 0.012 * M, at * CFrame.new(0, 0.1 * M, 0.045 * M) * CFrame.Angles(math.rad(-22), 0, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(236, 234, 224))
		cylinderProp(parent, "PhoneDialHub", 0.04 * M, 0.016 * M, at * CFrame.new(0, 0.102 * M, 0.045 * M) * CFrame.Angles(math.rad(-22), 0, 0) * CFrame.Angles(0, 0, math.pi / 2), color)
	end
	prop(parent, "PhoneHandset", Vector3.new(0.24 * M, 0.045 * M, 0.06 * M), at * CFrame.new(0, 0.12 * M, -0.07 * M), color)
	for _, side in { -1, 1 } do
		prop(parent, "PhoneEarpiece", Vector3.new(0.06 * M, 0.04 * M, 0.08 * M), at * CFrame.new(side * 0.1 * M, 0.11 * M, -0.07 * M), color)
	end
	prop(parent, "PhoneCord", Vector3.new(0.02 * M, 0.02 * M, 0.12 * M), at * CFrame.new(-0.12 * M, 0.06 * M, -0.08 * M), DARK)
end

-- The alarm printer: a printing terminal on its pedestal, which prints
-- every event on fan-fold paper. `at` is the floor point under it; the
-- keyboard faces +Z.
local function teleprinter(parent: Instance, at: CFrame)
	local case = Color3.fromRGB(196, 196, 184)
	local h = 0.72 * M
	prop(parent, "PrinterStand", Vector3.new(0.7 * M, h, 0.55 * M), at * CFrame.new(0, h / 2, 0), Color3.fromRGB(84, 80, 74))
	prop(parent, "PrinterBody", Vector3.new(0.72 * M, 0.16 * M, 0.6 * M), at * CFrame.new(0, h + 0.08 * M, 0), case)
	prop(parent, "PrinterCover", Vector3.new(0.68 * M, 0.08 * M, 0.26 * M), at * CFrame.new(0, h + 0.2 * M, -0.14 * M), Color3.fromRGB(96, 88, 78))
	local badge = prop(parent, "PrinterBadge", Vector3.new(0.2 * M, 0.04 * M, 0.005 * M), at * CFrame.new(0.2 * M, h + 0.11 * M, 0.302 * M) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(40, 40, 40))
	sign(badge, "ALARM PRINTER", 12, Color3.fromRGB(230, 230, 220), 120)
	prop(parent, "PrinterKeys", Vector3.new(0.56 * M, 0.02 * M, 0.18 * M), at * CFrame.new(0, h + 0.17 * M, 0.18 * M) * CFrame.Angles(math.rad(8), 0, 0), Color3.fromRGB(52, 54, 52))
	-- The sheet rises out of the platen and leans back over the cover.
	local paper = prop(parent, "PrinterPaper", Vector3.new(0.58 * M, 0.42 * M, 0.005 * M), at * CFrame.new(0, h + 0.44 * M, -0.12 * M) * CFrame.Angles(math.rad(-12), math.pi, 0), Color3.fromRGB(240, 238, 224))
	paper:SetAttribute("PrinterPaper", true)
	prop(parent, "PaperStack", Vector3.new(0.6 * M, 0.12 * M, 0.42 * M), at * CFrame.new(0, 0.06 * M, -0.05 * M), Color3.fromRGB(236, 234, 220))
end

-- A row of upright binders on a surface, `at` under the first one; the
-- spines face +Z.
local function binders(parent: Instance, at: CFrame, count: number, seed: number)
	local colors = { Color3.fromRGB(30, 54, 110), Color3.fromRGB(150, 30, 30), Color3.fromRGB(28, 28, 30), Color3.fromRGB(30, 90, 60), Color3.fromRGB(96, 60, 30), Color3.fromRGB(40, 40, 46), Color3.fromRGB(200, 200, 190) }
	local x = 0
	for i = 1, count do
		local w = (0.05 + ((i * 7 + seed) % 4) * 0.012) * M
		local h = (0.29 + ((i * 3 + seed) % 2) * 0.03) * M
		prop(parent, "Binder", Vector3.new(w, h, 0.26 * M), at * CFrame.new(x + w / 2, h / 2, 0), colors[(i * 5 + seed) % #colors + 1])
		x += w + 0.004 * M
	end
end

-- Scale every part, light and sign in the room by `k` about the origin.
local function scaleRoom(room: Instance, k: number)
	for _, d in room:GetDescendants() do
		if d:IsA("BasePart") then
			local cf = d.CFrame
			d.Size *= k
			d.CFrame = cf - cf.Position + cf.Position * k
		elseif d:IsA("SurfaceLight") or d:IsA("PointLight") or d:IsA("SpotLight") then
			d.Range *= k
		elseif d:IsA("SurfaceGui") and d.SizingMode == Enum.SurfaceGuiSizingMode.PixelsPerStud then
			d.PixelsPerStud /= k
		end
	end
end

function RoomBuilder.build(): Folder
	local room = Instance.new("Folder")
	room.Name = "ControlRoom"

	-- Shell: about 15 by 14 metres and 3.8 metres to the ceiling tiles.
	local west, east, north, south = -50, 38, -50, 28
	local width, length, height = east - west, south - north, 3.8 * M
	local cx, cz = (west + east) / 2, (north + south) / 2
	local floor = part(room, "Floor", Vector3.new(width, 1, length), CFrame.new(cx, -0.5, cz), FLOOR_TILE)
	floor.Reflectance = 0.04
	-- Floor tiles in 0.6 m squares.
	local tileJoint = Color3.fromRGB(42, 41, 40)
	local ft = 0.6 * M
	for x = west + ft, east - 0.1, ft do
		prop(room, "FloorJoint", Vector3.new(0.05, 0.02, length), CFrame.new(x, 0.01, cz), tileJoint)
	end
	for z = north + ft, south - 0.1, ft do
		prop(room, "FloorJoint", Vector3.new(width, 0.02, 0.05), CFrame.new(cx, 0.01, z), tileJoint)
	end
	part(room, "Ceiling", Vector3.new(width, 1, length), CFrame.new(cx, height + 0.5, cz), TILE, Enum.Material.Plaster)
	part(room, "WallNorth", Vector3.new(width, height, 1), CFrame.new(cx, height / 2, north - 0.5), WALL, Enum.Material.Plaster)
	part(room, "WallSouth", Vector3.new(width, height, 1), CFrame.new(cx, height / 2, south + 0.5), WALL, Enum.Material.Plaster)
	part(room, "WallWest", Vector3.new(1, height, length), CFrame.new(west - 0.5, height / 2, cz), WALL, Enum.Material.Plaster)
	part(room, "WallEast", Vector3.new(1, height, length), CFrame.new(east + 0.5, height / 2, cz), WALL, Enum.Material.Plaster)
	-- Walls in two tones: a darker band to 1.6 m with a dark line above it,
	-- lighter to the ceiling; a dark skirting at the floor.
	local dadoH = 1.6 * M
	for _, z in { north + 0.04, south - 0.04 } do
		prop(room, "Dado", Vector3.new(width, dadoH, 0.08), CFrame.new(cx, dadoH / 2, z), DADO)
		prop(room, "DadoLine", Vector3.new(width, 0.12, 0.1), CFrame.new(cx, dadoH, z), Color3.fromRGB(62, 58, 50))
		prop(room, "Skirting", Vector3.new(width, 0.5, 0.12), CFrame.new(cx, 0.25, z), DARK)
	end
	for _, x in { west + 0.04, east - 0.04 } do
		prop(room, "Dado", Vector3.new(0.08, dadoH, length), CFrame.new(x, dadoH / 2, cz), DADO)
		prop(room, "DadoLine", Vector3.new(0.1, 0.12, length), CFrame.new(x, dadoH, cz), Color3.fromRGB(62, 58, 50))
		prop(room, "Skirting", Vector3.new(0.12, 0.5, length), CFrame.new(x, 0.25, cz), DARK)
	end

	-- A luminous ceiling: square diffuser panels in a dark grid, the
	-- brightest thing in the room. The room light comes from fittings
	-- hidden behind them.
	local nx, nz = math.floor(width / (1.2 * M) + 0.5), math.floor(length / (1.2 * M) + 0.5)
	local mx, mz = width / nx, length / nz
	local grid = Color3.fromRGB(44, 44, 44)
	for ix = 0, nx - 1 do
		for iz = 0, nz - 1 do
			prop(room, "CeilingPanel", Vector3.new(mx - 0.32, 0.06, mz - 0.32), CFrame.new(west + (ix + 0.5) * mx, height - 0.12, north + (iz + 0.5) * mz), Color3.fromRGB(146, 148, 138), Enum.Material.Neon)
		end
	end
	for ix = 0, nx do
		prop(room, "CeilingGrid", Vector3.new(0.32, 0.26, length), CFrame.new(west + ix * mx, height - 0.18, cz), grid)
	end
	for iz = 0, nz do
		prop(room, "CeilingGrid", Vector3.new(width, 0.26, 0.32), CFrame.new(cx, height - 0.18, north + iz * mz), grid)
	end
	local tileSize = 0.61 * M
	for ix = 0, 6 do
		for iz = 0, 5 do
			local x = west + tileSize * (1.5 + ix * 4)
			local z = north + tileSize * (2 + iz * 4)
			if x < east - tileSize and z < south - tileSize then
				local light = prop(room, "Light", Vector3.new(tileSize, 0.05, 2 * tileSize), CFrame.new(x, height - 0.06, z), TILE)
				light.Transparency = 1
				local glow = Instance.new("SurfaceLight")
				glow.Face = Enum.NormalId.Bottom
				glow.Angle = 140
				glow.Range = 34
				glow.Brightness = 0.72
				glow.Color = Color3.fromRGB(255, 244, 226)
				glow.Shadows = false
				glow.Parent = light
			end
		end
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 0.2, 8)
	spawn.CFrame = CFrame.new(14, 0.1, 18)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Parent = room

	-- The door, a sign over it, and a clock above the boards.
	local doorX = 22
	part(room, "Door", Vector3.new(0.9 * M, 2.1 * M, 0.25), CFrame.new(doorX, 1.05 * M, south - 0.12), Color3.fromRGB(126, 96, 70), Enum.Material.Wood)
	prop(room, "DoorFrame", Vector3.new(1.0 * M, 2.16 * M, 0.15), CFrame.new(doorX, 1.08 * M, south - 0.12), DARK)
	cylinderProp(room, "DoorHandle", 0.05 * M, 0.1 * M, CFrame.new(doorX - 0.36 * M, 1.0 * M, south - 0.3) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(190, 180, 150), Enum.Material.Metal)
	local doorSign = prop(room, "DoorSign", Vector3.new(1.4 * M, 0.25 * M, 0.08), CFrame.new(doorX, 2.85 * M, south - 0.2) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(28, 52, 98))
	sign(doorSign, "UNIT 1  CONTROL ROOM", 22, Color3.fromRGB(240, 240, 230))
	local clockX, clockY, clockZ = -6, 3.25 * M, north + 0.1
	cylinderProp(room, "WallClockRim", 0.4 * M, 0.06 * M, CFrame.new(clockX, clockY, clockZ) * CFrame.Angles(0, math.pi / 2, 0), DARK)
	cylinderProp(room, "WallClock", 0.36 * M, 0.08 * M, CFrame.new(clockX, clockY, clockZ + 0.02) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(242, 240, 230))
	for i = 0, 11 do
		local a = i * math.pi / 6
		prop(room, "ClockMark", Vector3.new(0.03 * M, if i % 3 == 0 then 0.04 * M else 0.025 * M, 0.02), CFrame.new(clockX + math.sin(a) * 0.15 * M, clockY + math.cos(a) * 0.15 * M, clockZ + 0.27) * CFrame.Angles(0, 0, -a), DARK)
	end
	prop(room, "ClockHand", Vector3.new(0.02 * M, 0.12 * M, 0.02), CFrame.new(clockX, clockY + 0.05 * M, clockZ + 0.3), DARK)
	prop(room, "ClockHand", Vector3.new(0.09 * M, 0.02 * M, 0.02), CFrame.new(clockX + 0.04 * M, clockY, clockZ + 0.3), DARK)

	-- Benchboards.
	local up = Vector3.new(0, 1, 0)
	local s = PanelLayout.BENCH_SLOPE
	local depth = PanelLayout.BENCH_DEPTH
	local h0 = PanelLayout.BENCH_FRONT_HEIGHT
	local T = PanelLayout.FACE_THICKNESS
	local backY = h0 + depth * math.sin(s)
	local backZ = depth * math.cos(s)
	local top = backY + PanelLayout.VERT_HEIGHT + PanelLayout.ANN_HEIGHT
	local cabinetDepth = 3.2
	local n = #PanelLayout.panels
	for _, p in PanelLayout.panels do
		local W = p.width
		local origin, right, back = PanelLayout.designFrame(p.index)
		local function frame(x: number, y: number, z: number): CFrame
			return CFrame.fromMatrix(origin + right * x + up * y + back * z, right, up, back)
		end
		-- Cabinet: a base under the bench, a tall box behind it, and a
		-- slab under the sloping bench that closes the gap at the sides.
		part(room, p.id .. "_base", Vector3.new(W, h0 - 0.5, backZ - 0.3), frame(0, 0.5 + (h0 - 0.5) / 2, -backZ / 2 - 0.15), BASE_COLOR)
		part(room, p.id .. "_kick", Vector3.new(W, 0.5, backZ - 0.6), frame(0, 0.25, -backZ / 2 - 0.3), RUBBER)
		part(room, p.id .. "_cabinet", Vector3.new(W, top, cabinetDepth), frame(0, top / 2, -backZ - cabinetDepth / 2 - T / 2), CABINET_COLOR)
		local bench = PanelLayout.designFace(p.index, "bench")
		part(room, p.id .. "_slab", Vector3.new(W, depth, 1.6), PanelLayout.faceCFrame(bench) * CFrame.new(0, 0, T / 2 + 0.8), CABINET_COLOR)
		-- Trim: a dark edge along the console front and a darker cap over
		-- the light boxes.
		part(room, p.id .. "_lip", Vector3.new(W, 0.4, 0.45), frame(0, h0 - 0.1, 0.12), RUBBER)
		prop(room, p.id .. "_cap", Vector3.new(W, 0.3, cabinetDepth + 1.4), frame(0, top + 0.15, -backZ - cabinetDepth / 2 + 0.55), CAP_COLOR)
		-- A dark reveal between the board and the annunciator box.
		prop(room, p.id .. "_reveal", Vector3.new(W, 0.12, 0.2), frame(0, backY + PanelLayout.VERT_HEIGHT, -backZ + T / 2 + 0.06), DARK)
		for _, faceName in { "bench", "vert", "ann" } do
			local f = PanelLayout.designFace(p.index, faceName)
			local color = if faceName == "bench" then BENCH_COLOR elseif faceName == "ann" then ANN_COLOR else PANEL_COLOR
			local facePart = part(room, p.id .. "_" .. faceName, Vector3.new(f.width, f.height, T), PanelLayout.faceCFrame(f), color)
			facePart:SetAttribute("Panel", p.id)
			facePart:SetAttribute("Face", faceName)
		end

		-- Joint with the next panel: a seam strip where the run is straight,
		-- a corner filler where it turns.
		if p.index < n then
			local nOrigin, nRight, nBack = PanelLayout.designFrame(p.index + 1)
			local nW = PanelLayout.panels[p.index + 1].width
			local joint = origin + right * (W / 2)
			local turn = math.acos(math.clamp(back:Dot(nBack), -1, 1))
			if turn < 0.01 then
				prop(room, p.id .. "_seam", Vector3.new(0.1, PanelLayout.VERT_HEIGHT, 0.06), CFrame.fromMatrix(joint + up * (backY + PanelLayout.VERT_HEIGHT / 2) - back * (backZ - T / 2 - 0.03), right, up, back), DARK)
			else
				-- An inside corner. Each cabinet is carried on, blank, past
				-- the joint until it meets the other one: boards, bench,
				-- annunciator box and all. Where the two benches overlap, the
				-- higher one shows, which is exactly the mitred valley a real
				-- corner joint has.
				local half = turn / 2
				local ext = backZ * math.tan(half)
				local extCab = (backZ + cabinetDepth + T) * math.tan(half)
				for _, side in { { origin, right, back, 1, W }, { nOrigin, nRight, nBack, -1, nW } } do
					local o, r, b, dir, sw = side[1], side[2], side[3], side[4], side[5]
					local tag = p.id .. (if dir > 0 then "_cornerA" else "_cornerB")
					local function at(x: number, y: number, z: number): CFrame
						return CFrame.fromMatrix(o + r * (dir * (sw / 2 + x)) + up * y + b * z, r, up, b)
					end
					part(room, tag .. "Cabinet", Vector3.new(extCab, top, cabinetDepth), at(extCab / 2, top / 2, -backZ - cabinetDepth / 2 - T / 2), CABINET_COLOR)
					part(room, tag .. "Board", Vector3.new(ext, PanelLayout.VERT_HEIGHT, T), at(ext / 2, backY + PanelLayout.VERT_HEIGHT / 2, -backZ), PANEL_COLOR)
					part(room, tag .. "Ann", Vector3.new(ext, PanelLayout.ANN_HEIGHT, T), at(ext / 2, backY + PanelLayout.VERT_HEIGHT + PanelLayout.ANN_HEIGHT / 2, -backZ), ANN_COLOR)
					prop(room, tag .. "Reveal", Vector3.new(ext, 0.12, 0.2), at(ext / 2, backY + PanelLayout.VERT_HEIGHT, -backZ + T / 2 + 0.06), DARK)
					part(room, tag .. "Base", Vector3.new(ext, h0 - 0.1, backZ), at(ext / 2, (h0 - 0.1) / 2, -backZ / 2), BASE_COLOR)
					prop(room, tag .. "Cap", Vector3.new(extCab, 0.3, cabinetDepth + 1.4), at(extCab / 2, top + 0.15, -backZ - cabinetDepth / 2 + 0.55), CAP_COLOR)
					-- Bench carried on at the same slope.
					local slopeUp = up * math.sin(s) - b * math.cos(s)
					local slopeNormal = up * math.cos(s) + b * math.sin(s)
					local centre = o + r * (dir * (sw / 2 + ext / 2)) + up * (h0 + depth / 2 * math.sin(s)) - b * (depth / 2 * math.cos(s)) - slopeNormal * 0.6
					part(room, tag .. "Bench", Vector3.new(ext, depth, 1.2 + T), CFrame.fromMatrix(centre, slopeUp:Cross(-slopeNormal), slopeUp, -slopeNormal), BENCH_COLOR)
				end
			end
		end
	end

	-- Yellow and black hazard stripes on the floor along the boards, a little
	-- in front of the consoles, mitred where the run turns.
	do
		local gap = 0.55 * M
		local bandW = 0.14 * M
		local stripe = 0.22 * M
		local n = #PanelLayout.panels
		for _, p in PanelLayout.panels do
			local origin, right, back = PanelLayout.designFrame(p.index)
			local function cut(other: number): number
				if other < 1 or other > n then
					return 0
				end
				local _, _, otherBack = PanelLayout.designFrame(other)
				local turn = math.acos(math.clamp(back:Dot(otherBack), -1, 1))
				return gap * math.tan(turn / 2)
			end
			local x0 = -p.width / 2 + cut(p.index - 1)
			local x1 = p.width / 2 - cut(p.index + 1)
			local count = math.max(1, math.floor((x1 - x0) / stripe + 0.5))
			local step = (x1 - x0) / count
			for k = 0, count - 1 do
				local at = origin + right * (x0 + (k + 0.5) * step) + back * gap + up * 0.015
				prop(room, "HazardStripe", Vector3.new(step, 0.03, bandW), CFrame.fromMatrix(at, right, up, back), if k % 2 == 0 then HAZARD_YELLOW else HAZARD_BLACK)
			end
		end
	end

	-- Behind the corner section: the triangle between its cabinet and the
	-- square corner where the backs of the two runs meet is filled solid and
	-- capped, so the boards read as one L with a square back corner.
	do
		local cabinetBack = backZ + T / 2 + cabinetDepth
		local cOrigin, _, cBack = PanelLayout.designFrame(PanelLayout.CORNER_PANEL)
		local x0 = PanelLayout.CORNER_X - cabinetBack
		local z0 = PanelLayout.BACK_WALL_Z - cabinetBack
		-- The corner cabinet's back plane is p . cBack = k; find where it
		-- crosses the back planes of the two runs. A little extra pushes the
		-- long face of the filler inside the corner cabinet.
		local k = cOrigin:Dot(cBack) - cabinetBack
		local legX = (k - z0 * cBack.Z) / cBack.X - x0 + 0.2
		local legZ = (k - x0 * cBack.X) / cBack.Z - z0 + 0.2
		local function filler(name: string, y0: number, fillHeight: number, color: Color3, material: Enum.Material?)
			-- A wedge's right angle is at its bottom back edge; stand it on end
			-- so that edge is the vertical line of the square corner.
			local w = Instance.new("WedgePart")
			w.Name = name
			w.Anchored = true
			w.Size = Vector3.new(fillHeight, legX, legZ)
			w.CFrame = CFrame.fromMatrix(Vector3.new(x0 + legX / 2, y0 + fillHeight / 2, z0 + legZ / 2), Vector3.new(0, 1, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, -1))
			w.Color = color
			w.Material = material or Enum.Material.SmoothPlastic
			w.TopSurface = Enum.SurfaceType.Smooth
			w.BottomSurface = Enum.SurfaceType.Smooth
			w.Parent = room
		end
		filler("CornerFill", 0, top, CABINET_COLOR)
		filler("CornerCap", top, 0.3, CAP_COLOR)
	end

	-- The operators' area, facing the corner so the reactor panel is straight
	-- ahead: two steel desks side by side, the process computer's console
	-- to their left and the alarm typer to their right.
	local area = CFrame.new(PanelLayout.DESK_X, 0, PanelLayout.DESK_Z) * CFrame.Angles(0, PanelLayout.DESK_YAW, 0)
	local deskL, deskD, deskH = 1.52 * M, 0.76 * M, 0.74 * M
	for k, x in { -0.8 * M, 0.8 * M } do
		local at = area * CFrame.new(x, 0, 0)
		steelDesk(room, at, deskL, deskD)
		local top = at * CFrame.new(0, deskH, 0)
		telephone(room, top * CFrame.new(-0.5 * M, 0, -0.2 * M) * CFrame.Angles(0, 0.15, 0), Color3.fromRGB(28, 28, 30))
		if k == 1 then
			telephone(room, top * CFrame.new(0.05 * M, 0, -0.22 * M), Color3.fromRGB(160, 30, 28), true)
			prop(room, "Logbook", Vector3.new(0.3 * M, 0.03 * M, 0.38 * M), top * CFrame.new(0.15 * M, 0.015 * M, 0.12 * M) * CFrame.Angles(0, 0.1, 0), Color3.fromRGB(36, 60, 44))
			prop(room, "Papers", Vector3.new(0.21 * M, 0.006 * M, 0.3 * M), top * CFrame.new(0.55 * M, 0.003 * M, 0.05 * M) * CFrame.Angles(0, -0.12, 0), Color3.fromRGB(240, 238, 226))
			cylinderProp(room, "Mug", 0.08 * M, 0.1 * M, top * CFrame.new(-0.2 * M, 0.05 * M, 0.2 * M) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(230, 230, 226))
		else
			binders(room, top * CFrame.new(0.25 * M, 0, -0.24 * M), 6, 2)
			prop(room, "Logbook", Vector3.new(0.3 * M, 0.03 * M, 0.38 * M), top * CFrame.new(-0.05 * M, 0.015 * M, 0.12 * M) * CFrame.Angles(0, -0.15, 0), Color3.fromRGB(110, 32, 30))
			prop(room, "Clipboard", Vector3.new(0.23 * M, 0.01 * M, 0.32 * M), top * CFrame.new(-0.5 * M, 0.005 * M, 0.15 * M) * CFrame.Angles(0, 0.1, 0), Color3.fromRGB(150, 110, 70), Enum.Material.Wood)
		end
		cylinderProp(room, "Ashtray", 0.13 * M, 0.025 * M, top * CFrame.new(0.62 * M, 0.0125 * M, -0.22 * M) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(120, 86, 40), Enum.Material.Glass).Transparency = 0.2
		chair(room, at * CFrame.new(-0.1 * M, 0, deskD / 2 + 0.4 * M))
	end
	computerConsole(room, area * CFrame.new(-2.45 * M, 0, 0.55 * M) * CFrame.Angles(0, 0.45, 0))
	chair(room, area * CFrame.new(-2.2 * M, 0, 1.15 * M) * CFrame.Angles(0, 0.45, 0))
	teleprinter(room, area * CFrame.new(2.3 * M, 0, 0.35 * M) * CFrame.Angles(0, -0.5, 0))
	-- A floor-standing ashtray between the desks and the typer.
	do
		local stand = area * CFrame.new(1.75 * M, 0, 0.95 * M)
		cylinderProp(room, "SmokingStandBase", 0.3 * M, 0.03 * M, stand * CFrame.new(0, 0.015 * M, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(40, 40, 42))
		cylinderProp(room, "SmokingStandPost", 0.04 * M, 0.6 * M, stand * CFrame.new(0, 0.32 * M, 0) * CFrame.Angles(0, 0, math.pi / 2), CHROME, Enum.Material.Metal)
		cylinderProp(room, "SmokingStandTray", 0.22 * M, 0.05 * M, stand * CFrame.new(0, 0.64 * M, 0) * CFrame.Angles(0, 0, math.pi / 2), CHROME, Enum.Material.Metal)
	end

	-- The shift supervisor's desk behind the operators, facing the boards.
	do
		local ss = CFrame.new(10, 0, 10) * CFrame.Angles(0, PanelLayout.DESK_YAW, 0)
		steelDesk(room, ss, 1.52 * M, 0.76 * M)
		local top2 = ss * CFrame.new(0, deskH, 0)
		telephone(room, top2 * CFrame.new(0.5 * M, 0, -0.18 * M), Color3.fromRGB(28, 28, 30))
		prop(room, "Logbook", Vector3.new(0.3 * M, 0.03 * M, 0.38 * M), top2 * CFrame.new(-0.1 * M, 0.015 * M, 0.08 * M) * CFrame.Angles(0, 0.15, 0), Color3.fromRGB(30, 54, 110))
		prop(room, "InTray", Vector3.new(0.26 * M, 0.06 * M, 0.34 * M), top2 * CFrame.new(-0.52 * M, 0.03 * M, -0.12 * M), Color3.fromRGB(60, 60, 64))
		prop(room, "LampBase", Vector3.new(0.14 * M, 0.03 * M, 0.14 * M), top2 * CFrame.new(-0.25 * M, 0.015 * M, -0.27 * M), DARK)
		prop(room, "LampArm", Vector3.new(0.02 * M, 0.38 * M, 0.02 * M), top2 * CFrame.new(-0.25 * M, 0.2 * M, -0.27 * M), DARK)
		prop(room, "LampShade", Vector3.new(0.18 * M, 0.08 * M, 0.12 * M), top2 * CFrame.new(-0.25 * M, 0.38 * M, -0.2 * M) * CFrame.Angles(math.rad(25), 0, 0), Color3.fromRGB(40, 70, 50))
		chair(room, ss * CFrame.new(-0.1 * M, 0, 0.78 * M), Color3.fromRGB(96, 62, 40))
	end

	-- Along the south wall: steel shelving of procedures and two file
	-- cabinets.
	do
		local bx, bz = -32, south - 0.2 * M - 0.1
		local bw, bh, bd = 1.8 * M, 1.95 * M, 0.35 * M
		local shelving = Color3.fromRGB(140, 144, 138)
		local case = CFrame.new(bx, 0, bz) * CFrame.Angles(0, math.pi, 0)
		part(room, "ShelvingBack", Vector3.new(bw, bh, 0.02 * M), case * CFrame.new(0, bh / 2, bd / 2 - 0.01 * M), shelving, Enum.Material.Metal)
		for _, side in { -1, 1 } do
			part(room, "ShelvingSide", Vector3.new(0.02 * M, bh, bd), case * CFrame.new(side * (bw / 2 - 0.01 * M), bh / 2, 0), shelving, Enum.Material.Metal)
		end
		for shelf = 0, 5 do
			local y = 0.08 * M + shelf * 0.37 * M
			part(room, "Shelf", Vector3.new(bw, 0.02 * M, bd), case * CFrame.new(0, y, 0), shelving, Enum.Material.Metal)
			if shelf < 5 then
				binders(room, case * CFrame.new(-bw / 2 + 0.04 * M, y + 0.01 * M, 0.02 * M), 14 + shelf % 3, shelf * 3)
			end
		end
		for i = 0, 1 do
			local fx = bx + bw / 2 + 0.6 * M + i * 0.5 * M
			local cab = CFrame.new(fx, 0, south - 0.36 * M - 0.1) * CFrame.Angles(0, math.pi, 0)
			part(room, "FileCabinet", Vector3.new(0.46 * M, 1.33 * M, 0.7 * M), cab * CFrame.new(0, 0.665 * M, 0), Color3.fromRGB(150, 140, 112), Enum.Material.Metal)
			for d = 0, 3 do
				prop(room, "FilePull", Vector3.new(0.12 * M, 0.03 * M, 0.03 * M), cab * CFrame.new(0, 0.25 * M + d * 0.31 * M, -0.36 * M), CHROME, Enum.Material.Metal)
			end
		end
	end

	-- On the east wall: the shift chalkboard. By the door: a fire
	-- extinguisher and a lit exit sign.
	do
		local board = prop(room, "StatusBoard", Vector3.new(2.4 * M, 1.2 * M, 0.05 * M), CFrame.new(east - 0.2, 1.55 * M, -10) * CFrame.Angles(0, -math.pi / 2, 0), Color3.fromRGB(44, 72, 56))
		board:SetAttribute("StatusBoard", true)
		prop(room, "StatusBoardFrame", Vector3.new(2.46 * M, 1.26 * M, 0.03 * M), CFrame.new(east - 0.08, 1.55 * M, -10) * CFrame.Angles(0, -math.pi / 2, 0), Color3.fromRGB(176, 178, 176), Enum.Material.Metal)
		prop(room, "ChalkTray", Vector3.new(2.4 * M, 0.03 * M, 0.06 * M), CFrame.new(east - 0.35, 0.93 * M, -10) * CFrame.Angles(0, -math.pi / 2, 0), Color3.fromRGB(176, 178, 176), Enum.Material.Metal)
		prop(room, "Chalk", Vector3.new(0.08 * M, 0.012 * M, 0.012 * M), CFrame.new(east - 0.35, 0.95 * M, -12) * CFrame.Angles(0, -math.pi / 2, 0), Color3.fromRGB(246, 246, 240))
		prop(room, "Eraser", Vector3.new(0.13 * M, 0.03 * M, 0.05 * M), CFrame.new(east - 0.35, 0.96 * M, -7) * CFrame.Angles(0, -math.pi / 2, 0), Color3.fromRGB(120, 92, 60))
		local ex = CFrame.new(doorX - 1.0 * M, 0, south - 0.15 * M - 0.1)
		cylinderProp(room, "Extinguisher", 0.16 * M, 0.5 * M, ex * CFrame.new(0, 0.65 * M, 0) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(190, 24, 20))
		prop(room, "ExtinguisherHead", Vector3.new(0.06 * M, 0.1 * M, 0.06 * M), ex * CFrame.new(0, 0.95 * M, 0), DARK)
		local fireSign = prop(room, "FireSign", Vector3.new(0.3 * M, 0.15 * M, 0.02 * M), ex * CFrame.new(0, 1.3 * M, 0.12 * M) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(190, 24, 20))
		sign(fireSign, "FIRE", 18, Color3.fromRGB(255, 255, 255))
		local exit = prop(room, "ExitSign", Vector3.new(0.36 * M, 0.18 * M, 0.06 * M), CFrame.new(doorX, 2.32 * M, south - 0.25) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(30, 140, 70))
		local exitText = sign(exit, "EXIT", 26, Color3.fromRGB(250, 250, 244), 60)
		exitText.Parent.LightInfluence = 0
	end

	scaleRoom(room, PanelLayout.SCALE)
	room.Parent = workspace
	return room
end

return RoomBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Sim</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Alarms</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Annunciator logic. Each window follows the ringback sequence of ISA
-- S18.1 (1979): a new alarm flashes fast and sounds the horn until it is
-- acknowledged, then stays lit steadily. When its condition clears it
-- flashes slowly ("ringback") until the operator resets it; if the
-- condition comes back first, it alarms again.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local AlarmList = require(Shared.AlarmList)
local Config = require(Shared.Config)

local Alarms = {}
Alarms.__index = Alarms

local CLEAR, NEW, ACKED, RINGBACK = 0, 1, 2, 3

-- Conditions read the published signal table `S` (and the plant for a few
-- things that are not signals).
local function conditions(plant): { [string]: (S: { [string]: number }) -> boolean }
	local Pr = Config.Protection
	local c: { [string]: (S: { [string]: number }) -> boolean } = {}
	c["rs.press"] = function(S) return S["rs.press"] > 5 end
	c["chan.rupture"] = function(S) return S["core.ruptured"] > 0 end
	c["rad.gas"] = function(S) return S["rad.gas"] > 20 end
	c["cps.flow"] = function(S) return S["cps.flow"] < 50 end
	c["cps.tank"] = function(S) return S["cps.tank"] < 80 end
	c["cps.temp"] = function(S) return S["cps.temp"] > 90 end
	c["eccs"] = function(S) return S["eccs.active"] > 0 end
	c["eccs.off"] = function(S) return S["eccs.auto"] < 1 end
	c["eccs.accum"] = function(S) return S["eccs.accum"] < 90 end
	c["srv.open"] = function(S) return S["srv.1.open"] + S["srv.2.open"] + S["srv.3.open"] > 0 end
	c["pool.temp"] = function(S) return S["pool.temp"] > 45 end
	c["leak"] = function(S) return S["core.ruptured"] > 0 or plant.safety.compartmentLeak end

	c["mcp.cav"] = function(S)
		for l = 1, 2 do
			for i = 1, 4 do
				if S[string.format("mcp.%d%d.cav", l, i)] > 0 then
					return true
				end
			end
		end
		return false
	end
	c["loop1.flow"] = function(S) return S["n.power"] > 5 and S["loop.1.flow"] < 9000 end
	c["loop2.flow"] = function(S) return S["n.power"] > 5 and S["loop.2.flow"] < 9000 end
	c["lvl1.low"] = function(S) return S["loop.1.level"] < -300 end
	c["lvl1.high"] = function(S) return S["loop.1.level"] > 250 end
	c["lvl2.low"] = function(S) return S["loop.2.level"] < -300 end
	c["lvl2.high"] = function(S) return S["loop.2.level"] > 250 end
	c["press.high"] = function(S) return S["pri.press"] > 7.2 end
	c["press.low"] = function(S) return S["n.power"] > 20 and S["pri.press"] < 6.3 end
	c["heatup"] = function(S) return math.abs(S["pri.heatup"]) > Config.Primary.HEATUP_LIMIT * 60 * 1.05 end
	c["subcool"] = function(S)
		return (S["loop.1.npsh"] < 0.13 and S["loop.1.flow"] > 3000) or (S["loop.2.npsh"] < 0.13 and S["loop.2.flow"] > 3000)
	end

	c["az5"] = function(S) return S["az5.active"] > 0 end
	c["az4"] = function(S) return S["az4.active"] > 0 end
	c["az3"] = function(S) return S["az3.active"] > 0 end
	c["az2"] = function(S) return S["az2.active"] > 0 end
	c["az1"] = function(S) return S["az1.active"] > 0 end
	c["power.high"] = function(S) return S["n.power"] > 105 end
	c["period.short"] = function(S) return S["n.period"] > 0 and S["n.period"] < Pr.PERIOD_ALARM and S["n.power"] > 3e-6 end
	c["rod.block"] = function(S) return S["rod.block"] > 0 and S["rod.moving"] < 0 end
	c["orm.low"] = function(S) return S["n.power"] > 1 and S["core.orm"] < Pr.ORM_ADMIN_LIMIT end
	c["orm.lowlow"] = function(S) return S["n.power"] > 1 and S["core.orm"] < Pr.ORM_SHUTDOWN_LIMIT end
	c["ar.limit"] = function(S) return S["ar.limit"] > 0 end
	c["ar.dev"] = function(S) return S["ar.mode"] > 0 and math.abs(S["ar.error"]) > 3 end
	c["lar.limit"] = function(S) return S["lar.limit"] > 0 end
	c["rod.stuck"] = function(S) return S["rod.stuck"] > 0 end
	c["chan.margin"] = function(S) return S["core.minMargin"] < 1.3 end
	c["fuel.temp"] = function(S) return S["core.maxFuel"] > 1800 end
	c["tilt"] = function(S) return S["n.power"] > 10 and S["core.tilt"] > 15 end
	c["axial"] = function(S) return S["n.power"] > 10 and math.abs(S["core.offset"]) > 15 end
	c["kom"] = function(S) return S["kom"] > 0 end
	c["prot.bypass"] = function(S) return S["prot.anyBypass"] > 0 end
	c["chan.flow"] = function(S) return S["core.blocked"] > 0 end
	c["regs.off"] = function(S) return S["n.power"] > 5 and S["ar.mode"] < 1 and S["lar.on"] < 1 end
	c["core.damage"] = function(S) return S["core.damaged"] > 0 or S["core.destroyed"] > 0 end

	c["fw.low"] = function(S) return S["n.power"] > 20 and S["fw.total"] < 0.7 * S["steam.total"] end
	c["fw.temp"] = function(S) return S["n.power"] > 30 and S["fw.temp"] < 140 end
	c["da.low"] = function(S) return S["da.level"] < 25 end
	c["da.high"] = function(S) return S["da.level"] > 90 end
	c["afw"] = function(S) return S["afw.pump.1.run"] + S["afw.pump.2.run"] + S["afw.pump.3.run"] > 0 end
	c["lvl.manual"] = function(S) return S["n.power"] > 10 and (S["lvl.1.auto"] < 1 or S["lvl.2.auto"] < 1) end

	for k = 1, 2 do
		c["tg" .. k .. ".vac"] = function(S) return S["tg." .. k .. ".rpm"] > 50 and S["tg." .. k .. ".vac"] > 15 end
		c["tg" .. k .. ".vib"] = function(S) return S["tg." .. k .. ".vib"] > 7.1 end
		c["tg" .. k .. ".lube"] = function(S) return S["tg." .. k .. ".rpm"] > 20 and S["tg." .. k .. ".lube"] < 0.15 end
		c["tg" .. k .. ".stress"] = function(S) return S["tg." .. k .. ".stress"] > 60 end
	end
	c["bypass.open"] = function(S) return S["tg.1.bypass"] > 2 or S["tg.2.bypass"] > 2 end
	c["ehc.manual"] = function(S) return S["ehc.pressAuto"] < 1 end

	c["bus.dead"] = function(S) return S["bus.dead"] > 0 end
	c["dg.run"] = function(S) return S["dg.1.run"] + S["dg.2.run"] + S["dg.3.run"] > 0 end
	c["grid"] = function(S) return S["grid.live"] < 1 end
	c["gen.island"] = function(S) return S["gen.1.island"] + S["gen.2.island"] > 0 end
	return c
end

function Alarms.new(plant)
	local self = setmetatable({}, Alarms)
	self.plant = plant
	self.cond = conditions(plant)
	self.state = table.create(#AlarmList.list, CLEAR)
	self.on = table.create(#AlarmList.list, false)
	self.pulse = {} -- id -> seconds remaining, for event-type alarms
	self.changed = {} -- indices changed this tick, drained by the network layer
	self.horn = false
	plant.cmd["ann.ack"] = function()
		self:acknowledge()
	end
	plant.cmd["ann.reset"] = function()
		self:reset()
	end
	return self
end

-- Fire an event-type alarm (a pump trip, say) that has no standing condition.
function Alarms.raise(self, id: string)
	self.pulse[id] = 6
end

function Alarms.acknowledge(self)
	for i, s in self.state do
		if s == NEW then
			-- An alarm that has already cleared goes straight to ringback.
			self.state[i] = if self.on[i] then ACKED else RINGBACK
			table.insert(self.changed, i)
		end
	end
end

function Alarms.reset(self)
	for i, s in self.state do
		if s == RINGBACK then
			self.state[i] = CLEAR
			table.insert(self.changed, i)
		end
	end
end

function Alarms.step(self, dt: number)
	local S = self.plant.S
	local horn = false
	for i, alarm in AlarmList.list do
		local on = false
		local fn = self.cond[alarm.id]
		if fn then
			on = fn(S)
		end
		local p = self.pulse[alarm.id]
		if p then
			on = true
			p -= dt
			self.pulse[alarm.id] = if p > 0 then p else nil
		end
		self.on[i] = on
		local s = self.state[i]
		if on and (s == CLEAR or s == RINGBACK) then
			self.state[i] = NEW
			table.insert(self.changed, i)
			self.plant:log("ALARM: " .. string.gsub(alarm.text, "\n", " "))
		elseif not on and s == ACKED then
			self.state[i] = RINGBACK
			table.insert(self.changed, i)
		end
		if self.state[i] == NEW then
			horn = true
		end
	end
	self.horn = horn
end

-- Ids that have neither a standing condition nor are known pulse alarms.
function Alarms.unhandled(self, pulseIds: { string }): { string }
	local known = {}
	for _, id in pulseIds do
		known[id] = true
	end
	local out = {}
	for _, alarm in AlarmList.list do
		if not self.cond[alarm.id] and not known[alarm.id] then
			table.insert(out, alarm.id)
		end
	end
	return out
end

return Alarms
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Core</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- Reactor core model.
--
-- Neutronics: one-group diffusion on the real lattice (every fuel channel and
-- every rod channel is its own column) with 14 axial layers. Each tick the
-- flux shape is relaxed by one Gauss-Seidel power-iteration sweep; the
-- eigenvalue that falls out gives the reactivity seen by the current shape,
-- and six-group point kinetics advances the amplitude. Rod channels are
-- non-multiplying cells whose absorption depends on what sits at each
-- elevation: boron carbide, the graphite displacer, or a column of water.
-- That is all it takes for the pre-1986 "positive scram" to appear by itself
-- when the flux is bottom-heavy and most rods start from the top.
--
-- Thermal-hydraulics: every fuel channel marches coolant enthalpy from the
-- bottom to the top, with lagged fuel and graphite temperatures per node.
-- Coolant density (void), fuel temperature, graphite temperature and xenon
-- feed back into each node's multiplication factor.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Config = require(Shared.Config)
local CoreLayout = require(Shared.CoreLayout)
local Steam = require(Shared.Steam)
local Util = require(Shared.Util)

local C = Config.Core
local R = Config.Rods

local Core = {}
Core.__index = Core

local BETAS_U235 = { 0.000215, 0.001424, 0.001274, 0.002568, 0.000748, 0.000273 }
local LAMBDAS = { 0.0124, 0.0305, 0.111, 0.301, 1.14, 3.01 }

local STATUS_OK, STATUS_RUPTURED = 0, 1
Core.STATUS_OK = STATUS_OK
Core.STATUS_RUPTURED = STATUS_RUPTURED

export type LoopConditions = {
	pressure: { number }, -- MPa per loop
	inletEnthalpy: { number }, -- J/kg per loop
	flow: { number }, -- kg/s per loop
}

function Core.new(opts: { seed: number?, age: number? })
	local self = setmetatable({}, Core)
	local L = CoreLayout.get()
	local NC, NZ = L.nCells, C.NZ
	local N = NC * NZ
	local NF = L.nFuel
	local rng = Util.rng(opts.seed or 1)
	local age = Util.clamp(opts.age or 0.8, 0, 1)

	self.layout = L
	self.NC, self.NZ, self.N, self.NF = NC, NZ, N, NF
	self.NR = L.nRods
	self.rng = rng
	self.age = age
	self.dz = C.HEIGHT / NZ

	-- Diffusion couplings.
	local dz = self.dz
	local cr = C.M2 / (C.PITCH * C.PITCH)
	local cz = C.M2 / (dz * dz)
	local crEdge = C.M2 / (C.PITCH * (C.PITCH / 2 + C.EXTRAP_RADIAL))
	local czEdge = C.M2 / (dz * (dz / 2 + C.EXTRAP_AXIAL))
	self.cr, self.cz = cr, cz

	self.psi = table.create(N, 1)
	self.absn = table.create(N, 1) -- relative absorption
	self.kinf = table.create(N, 0)
	self.dgeo = table.create(N, 0) -- leakage part of the diagonal
	self.tf = table.create(N, C.T_REF) -- fuel temperature
	self.tg = table.create(N, C.T_REF) -- graphite temperature
	self.void = table.create(N, 0) -- coolant density deficit, 0..1
	self.xe = table.create(N, 0) -- xenon, 1 = equilibrium at nominal flux
	self.iod = table.create(N, 0)
	self.hist = table.create(N, 0) -- lagged power shape, distributes decay heat
	self.pnode = table.create(N, 0) -- W deposited per node

	for c = 1, NC do
		local nn = 0
		for d = 1, 4 do
			if L.neighbors[(c - 1) * 4 + d] > 0 then
				nn += 1
			end
		end
		local radial = nn * cr + (4 - nn) * crEdge
		for z = 1, NZ do
			local axial = (if z > 1 then cz else czEdge) + (if z < NZ then cz else czEdge)
			self.dgeo[(c - 1) * NZ + z] = radial + axial
		end
	end

	-- Per fuel channel data.
	self.fuelCell = L.fuelCells
	self.fuelLoop = table.create(NF, 1)
	self.fuelZone = table.create(NF, 1)
	self.burnup = table.create(NF, 0.5) -- 0 fresh .. 1 ready for discharge
	self.knode = table.create(N, 1.04) -- base multiplication of every fuel node (the burnup map)
	self.fweight = table.create(NF, 1) -- fissile loading relative to average
	self.voidBase = table.create(NF, 0)
	self.voidCoef = table.create(NF, 0)
	self.valve = table.create(NF, 1) -- channel inlet throttle setting
	self.phi2 = table.create(NF, 1) -- two-phase friction multiplier (lagged)
	self.flow = table.create(NF, 0) -- kg/s
	self.power = table.create(NF, 0) -- W generated
	self.heat = table.create(NF, 0) -- W to coolant
	self.xExit = table.create(NF, 0)
	self.tOut = table.create(NF, C.T_REF)
	self.cladT = table.create(NF, C.T_REF)
	self.tfMax = table.create(NF, C.T_REF)
	self.margin = table.create(NF, 99) -- critical power ratio
	self.wear = table.create(NF, 0)
	self.status = table.create(NF, STATUS_OK)
	self.leak = table.create(NF, 0) -- kg/s lost through a ruptured tube
	self.fluxRel = table.create(NF, 1) -- neutron flux relative to the core mean (what in-core detectors see)

	local maxR = 0
	for c = 1, NC do
		maxR = math.max(maxR, math.sqrt(L.cellX[c] ^ 2 + L.cellY[c] ^ 2))
	end
	self.radius = maxR
	local voidAge = Util.lerp(C.VOID_YOUNG, C.VOID_AGED, age)
	self.voidAge = voidAge
	for f = 1, NF do
		local c = L.fuelCells[f]
		self.fuelLoop[f] = L.cellLoop[c]
		self.fuelZone[f] = L.cellZone[c]
		-- On-load refuelling leaves a salt-and-pepper mix of burnups. A young
		-- core is mostly fresh fuel held down by extra absorbers.
		local b = Util.clamp(rng:next() * (0.35 + 0.65 * age) + 0.15 * age * rng:next(), 0, 1)
		self.burnup[f] = b
		self.fweight[f] = 1.12 - 0.24 * b
		self.voidBase[f] = voidAge * (0.65 + 0.7 * b)
		self.voidCoef[f] = self.voidBase[f]
		-- Old tubes are weaker, and a few are much weaker than the rest.
		local w = 0.05 + 0.25 * age * rng:next()
		if rng:next() < 0.012 * (0.5 + age) then
			w += 0.25 + 0.2 * rng:next()
		end
		self.wear[f] = w
	end
	self.kOffset = 0
	self.ormScale = 1

	-- Rod state lives here so the neutronics and the displays can read it.
	-- pos is insertion in metres: 0 = fully withdrawn.
	self.rodPos = table.create(self.NR, 0)
	self.rodCell = table.create(self.NR, 0)
	self.rodIsUSP = table.create(self.NR, false)
	self.rodNeighbors = {} -- fuel cells next to each rod, for worth weighting
	for i, rod in L.rods do
		self.rodCell[i] = rod.cell
		self.rodIsUSP[i] = rod.kind == "USP"
		self.rodPos[i] = if rod.kind == "USP" then R.USP_STROKE else R.STROKE
		local nb = {}
		for d = 1, 4 do
			local o = L.neighbors[(rod.cell - 1) * 4 + d]
			if o > 0 and L.cellKind[o] == 1 then
				table.insert(nb, o)
			end
		end
		self.rodNeighbors[i] = nb
	end
	self.cpsWater = 1 -- 1 = rod channels full of cooling water, 0 = drained
	for f = 1, NF do
		local base = (L.fuelCells[f] - 1) * NZ
		for z = 1, NZ do
			self.absn[base + z] = self.fweight[f]
		end
	end
	for i = 1, self.NR do
		self:updateRod(i)
	end

	-- Kinetics state. Powers are in watts.
	self.beta = C.BETA
	self.betas = {}
	local sumB = 0
	for _, b in BETAS_U235 do
		sumB += b
	end
	for i, b in BETAS_U235 do
		self.betas[i] = b * C.BETA / sumB
	end
	self.keff = 1
	self.rho = 0
	self.fission = 1 -- W
	self.prec = table.create(6, 0)
	self.decay = table.create(#C.DECAY, 0)
	self.decayFrac = 0
	for _, g in C.DECAY do
		self.decayFrac += g[1]
	end
	self.thermalPower = 0 -- W generated (fission + decay heat)
	self.period = math.huge
	self.logRate = 0
	self.destroyed = false

	-- Per-loop aggregates, refreshed by thermal().
	self.loopHeat = { 0, 0 }
	self.loopSteam = { 0, 0 } -- kg/s of steam leaving the channels
	self.loopExitQuality = { 0, 0 }
	self.loopVoidVolume = { 0, 0 } -- m3 of steam in channels + risers
	self.loopConductance = { 1, 1 } -- sum of channel weights (hydraulics)
	self.loopLeak = { 0, 0 } -- kg/s escaping through ruptured tubes
	self.loopDensity = { 1000, 1000 } -- mean coolant density in the channels

	-- Slow diagnostics.
	self.slowClock = 0
	self.orm = 0
	self.axial = table.create(NZ, 0) -- relative power per layer
	self.zonePower = table.create(12, 0) -- fraction of core power per LAR zone
	self.voidCoefCore = 0 -- flux-weighted void effect for 100% voiding
	self.xenonWorth = 0
	self.maxChannelPower = 0
	self.minMargin = 99
	self.maxFuelTemp = C.T_REF
	self.maxCladTemp = C.T_REF
	self.avgFuelTemp = C.T_REF
	self.avgGraphiteTemp = C.T_REF
	self.nRuptured = 0
	self.nFuelDamaged = 0
	self.events = {} -- drained by the plant each tick

	self.sqrtT0 = math.sqrt(C.T_REF + 273.15)
	self.sweepDir = 1
	-- Scratch space for the axial rebalance.
	self._F = table.create(NZ, 0)
	self._T = table.create(NZ, 0)
	self._E = table.create(NZ, 0)
	self._P = table.create(NZ, 0)
	self._f = table.create(NZ, 1)
	self._b = table.create(NZ, 0)
	self._cp = table.create(NZ, 0)
	self._x = table.create(NZ, 0)
	self.layerScale = table.create(NZ, 1)
	self.production = 0

	-- Coarse radial blocks (2 m squares) for the radial rebalance. Blocks
	-- that the core edge cuts down to a few cells are merged inward.
	local BLOCK = 8
	local perSide = math.ceil(L.grid / BLOCK)
	local rawOf = table.create(NC, 0)
	local counts = {}
	for c = 1, NC do
		local bx, by = (L.cellGX[c] - 1) // BLOCK, (L.cellGY[c] - 1) // BLOCK
		rawOf[c] = by * perSide + bx
		counts[rawOf[c]] = (counts[rawOf[c]] or 0) + 1
	end
	local mid = (perSide - 1) / 2
	local idOf = {}
	local nBlocks = 0
	self.blockOf = table.create(NC, 1)
	for c = 1, NC do
		local raw = rawOf[c]
		local guard = 0
		while counts[raw] < 24 and guard < 4 do
			local bx, by = raw % perSide, raw // perSide
			if math.abs(bx - mid) >= math.abs(by - mid) then
				bx += if bx < mid then 1 else -1
			else
				by += if by < mid then 1 else -1
			end
			raw = by * perSide + bx
			guard += 1
		end
		if not idOf[raw] then
			nBlocks += 1
			idOf[raw] = nBlocks
		end
		self.blockOf[c] = idOf[raw]
	end
	self.nBlocks = nBlocks
	self._M = table.create(nBlocks * nBlocks, 0)
	self._Lm = table.create(nBlocks * nBlocks, 0)
	self._FB = table.create(nBlocks, 0)
	self._PB = table.create(nBlocks * NZ, 0)
	self._g = table.create(nBlocks, 1)
	self._gx = table.create(nBlocks, 0)
	self._gb = table.create(nBlocks, 0)
	self.blockScale = table.create(nBlocks, 1)
	return self
end

-- Recompute the absorption of one rod channel from the rod position.
-- Top-entry rods carry a 4.5 m graphite displacer hanging 1.25 m below the
-- absorber, so a withdrawn rod leaves 1.25 m of water at the top and bottom
-- of the core and graphite in between.
function Core.updateRod(self, i: number)
	local NZ, dz = self.NZ, self.dz
	local base = (self.rodCell[i] - 1) * NZ
	local x = self.rodPos[i]
	local absn = self.absn
	local aWater = C.ABS_STEAM + (C.ABS_WATER - C.ABS_STEAM) * self.cpsWater
	local a0, a1, g0, g1
	if self.rodIsUSP[i] then
		-- Enters from below: absorber top is x metres above the core bottom.
		a0 = C.HEIGHT - x
		a1 = a0 + R.USP_ABSORBER_LEN
		g0, g1 = 0, 0
	else
		a1 = x
		a0 = x - R.ABSORBER_LEN
		g0 = x + R.LINK_LEN
		g1 = g0 + R.DISPLACER_LEN
	end
	for z = 1, NZ do
		local top, bot = (z - 1) * dz, z * dz
		local fa = math.max(0, math.min(bot, a1) - math.max(top, a0)) / dz
		local fg = math.max(0, math.min(bot, g1) - math.max(top, g0)) / dz
		local fw = 1 - fa - fg
		absn[base + z] = fa * C.ABS_ABSORBER + fg * C.ABS_GRAPHITE + fw * aWater
	end
end

function Core.setRodPosition(self, i: number, x: number)
	if self.rodPos[i] ~= x then
		self.rodPos[i] = x
		self:updateRod(i)
	end
end

function Core.setCpsWater(self, frac: number)
	frac = Util.clamp(frac, 0, 1)
	if math.abs(frac - self.cpsWater) > 0.002 or (frac ~= self.cpsWater and (frac == 0 or frac == 1)) then
		self.cpsWater = frac
		for i = 1, self.NR do
			self:updateRod(i)
		end
	end
end

-- Fraction of the core height covered by this rod's absorber.
function Core.rodInsertion(self, i: number): number
	if self.rodIsUSP[i] then
		return math.min(self.rodPos[i], R.USP_ABSORBER_LEN) / C.HEIGHT
	end
	return math.min(self.rodPos[i], R.ABSORBER_LEN) / C.HEIGHT
end

-- One Gauss-Seidel sweep of the shape equation and the eigenvalue update.
function Core.sweep(self)
	local NC, NZ = self.NC, self.NZ
	local psi, absn, kinf, dgeo = self.psi, self.absn, self.kinf, self.dgeo
	local nb = self.layout.neighbors
	local cr, cz = self.cr, self.cz
	local invK = 1 / self.keff
	local num, den = 0, 0
	local first, last, step = 1, NC, 1
	if self.sweepDir < 0 then
		first, last, step = NC, 1, -1
	end
	self.sweepDir = -self.sweepDir
	for c = first, last, step do
		local base = (c - 1) * NZ
		local q = (c - 1) * 4
		local b1, b2, b3, b4 = nb[q + 1], nb[q + 2], nb[q + 3], nb[q + 4]
		b1 = if b1 > 0 then (b1 - 1) * NZ else -1
		b2 = if b2 > 0 then (b2 - 1) * NZ else -1
		b3 = if b3 > 0 then (b3 - 1) * NZ else -1
		b4 = if b4 > 0 then (b4 - 1) * NZ else -1
		for z = 1, NZ do
			local n = base + z
			local old = psi[n]
			local prod = kinf[n] * absn[n]
			local sum = 0
			if b1 >= 0 then
				sum += psi[b1 + z]
			end
			if b2 >= 0 then
				sum += psi[b2 + z]
			end
			if b3 >= 0 then
				sum += psi[b3 + z]
			end
			if b4 >= 0 then
				sum += psi[b4 + z]
			end
			sum *= cr
			if z > 1 then
				sum += cz * psi[n - 1]
			end
			if z < NZ then
				sum += cz * psi[n + 1]
			end
			local new = (prod * old * invK + sum) / (absn[n] + dgeo[n])
			psi[n] = new
			if prod > 0 then
				num += new * prod * new
				den += new * prod * old
			end
		end
	end
	if den > 0 then
		local k = self.keff * num / den
		-- Guard against a wild first estimate when the shape is far off.
		self.keff = Util.clamp(k, 0.5, 1.5)
	end
	self.rho = (self.keff - 1) / self.keff
end

-- Coarse-mesh rebalance. One sweep per tick only moves the shape a little,
-- but a core this large is so loosely coupled that a rod movement or a scram
-- shifts power between its regions within a second. So after each sweep the
-- flux is rescaled, layer by layer and block by block, by the best factors a
-- Rayleigh-Ritz step can find on the collapsed problem. That keeps the map
-- honest for the operator and yields a variational, and therefore accurate,
-- eigenvalue for the current shape.
function Core.rebalance(self)
	local NC, NZ = self.NC, self.NZ
	local psi, absn, kinf, dgeo = self.psi, self.absn, self.kinf, self.dgeo
	local nb = self.layout.neighbors
	local cr, cz = self.cr, self.cz
	local F, T, E, P = self._F, self._T, self._E, self._P
	local blockOf, NB = self.blockOf, self.nBlocks
	local M, FB, PB = self._M, self._FB, self._PB
	for z = 1, NZ do
		F[z], T[z], E[z], P[z] = 0, 0, 0, 0
	end
	for i = 1, NB * NB do
		M[i] = 0
	end
	for i = 1, NB do
		FB[i] = 0
	end
	for i = 1, NB * NZ do
		PB[i] = 0
	end
	for c = 1, NC do
		local base = (c - 1) * NZ
		local q = (c - 1) * 4
		local n1, n2, n3, n4 = nb[q + 1], nb[q + 2], nb[q + 3], nb[q + 4]
		local b1 = if n1 > 0 then (n1 - 1) * NZ else -1
		local b2 = if n2 > 0 then (n2 - 1) * NZ else -1
		local b3 = if n3 > 0 then (n3 - 1) * NZ else -1
		local b4 = if n4 > 0 then (n4 - 1) * NZ else -1
		local bc = blockOf[c]
		local pbBase = (bc - 1) * NZ
		local d1, d2, d3, d4 = 0, 0, 0, 0
		local diagAcc, axAcc, fAcc = 0, 0, 0
		for z = 1, NZ do
			local n = base + z
			local v = psi[n]
			local s1 = if b1 >= 0 then psi[b1 + z] else 0
			local s2 = if b2 >= 0 then psi[b2 + z] else 0
			local s3 = if b3 >= 0 then psi[b3 + z] else 0
			local s4 = if b4 >= 0 then psi[b4 + z] else 0
			d1 += v * s1
			d2 += v * s2
			d3 += v * s3
			d4 += v * s4
			local a = absn[n]
			local prod = kinf[n] * a * v
			P[z] += prod
			PB[pbBase + z] += prod
			local pv = prod * v
			F[z] += pv
			fAcc += pv
			local diagTerm = (a + dgeo[n]) * v * v
			diagAcc += diagTerm
			T[z] += diagTerm - cr * (s1 + s2 + s3 + s4) * v
			if z < NZ then
				local e = cz * v * psi[n + 1]
				E[z] += e
				axAcc += e
			end
		end
		FB[bc] += fAcc
		local row = (bc - 1) * NB
		M[row + bc] += diagAcc - 2 * axAcc
		if n1 > 0 then
			M[row + blockOf[n1]] -= cr * d1
		end
		if n2 > 0 then
			M[row + blockOf[n2]] -= cr * d2
		end
		if n3 > 0 then
			M[row + blockOf[n3]] -= cr * d3
		end
		if n4 > 0 then
			M[row + blockOf[n4]] -= cr * d4
		end
	end

	-- Axial: largest eigenvalue of F f = k T f, T tridiagonal with off-diagonal -E.
	local f, b, cp, x = self._f, self._b, self._cp, self._x
	for z = 1, NZ do
		f[z] = 1
	end
	local kAxial = 0
	local ok = true
	for _ = 1, 40 do
		for z = 1, NZ do
			b[z] = F[z] * f[z]
		end
		-- Thomas algorithm.
		local denom = T[1]
		if denom <= 0 then
			ok = false
			break
		end
		cp[1] = -E[1] / denom
		x[1] = b[1] / denom
		for z = 2, NZ do
			denom = T[z] + E[z - 1] * cp[z - 1]
			if denom <= 0 then
				ok = false
				break
			end
			cp[z] = -E[z] / denom
			x[z] = (b[z] + E[z - 1] * x[z - 1]) / denom
		end
		if not ok then
			break
		end
		for z = NZ - 1, 1, -1 do
			x[z] -= cp[z] * x[z + 1]
		end
		local num, den, mean = 0, 0, 0
		for z = 1, NZ do
			num += x[z] * F[z] * x[z]
			den += x[z] * F[z] * f[z]
			mean += x[z]
		end
		if den <= 0 or mean <= 0 then
			ok = false
			break
		end
		kAxial = num / den
		mean /= NZ
		for z = 1, NZ do
			f[z] = x[z] / mean
		end
	end
	local axialOk = ok and kAxial == kAxial and kAxial > 0

	-- Radial: the same problem collapsed onto the blocks, M dense symmetric.
	-- Cholesky factor once, then inverse power iteration.
	local Lm, g, gx, gb = self._Lm, self._g, self._gx, self._gb
	local radialOk = true
	for i = 1, NB do
		local ri = (i - 1) * NB
		for j = 1, i do
			local rj = (j - 1) * NB
			local sum = 0.5 * (M[ri + j] + M[rj + i])
			for k = 1, j - 1 do
				sum -= Lm[ri + k] * Lm[rj + k]
			end
			if i == j then
				if sum <= 0 then
					radialOk = false
					break
				end
				Lm[ri + j] = math.sqrt(sum)
			else
				Lm[ri + j] = sum / Lm[rj + j]
			end
		end
		if not radialOk then
			break
		end
	end
	local kRadial = 0
	if radialOk then
		for i = 1, NB do
			g[i] = 1
		end
		for _ = 1, 60 do
			for i = 1, NB do
				gb[i] = FB[i] * g[i]
			end
			-- Solve L y = b, then L^T x = y.
			for i = 1, NB do
				local ri = (i - 1) * NB
				local sum = gb[i]
				for k = 1, i - 1 do
					sum -= Lm[ri + k] * gx[k]
				end
				gx[i] = sum / Lm[ri + i]
			end
			for i = NB, 1, -1 do
				local sum = gx[i]
				for k = i + 1, NB do
					sum -= Lm[(k - 1) * NB + i] * gx[k]
				end
				gx[i] = sum / Lm[(i - 1) * NB + i]
			end
			local num, den, mean = 0, 0, 0
			for i = 1, NB do
				num += gx[i] * FB[i] * gx[i]
				den += gx[i] * FB[i] * g[i]
				mean += gx[i]
			end
			if den <= 0 or mean <= 0 then
				radialOk = false
				break
			end
			kRadial = num / den
			mean /= NB
			for i = 1, NB do
				g[i] = gx[i] / mean
			end
		end
		radialOk = radialOk and kRadial == kRadial and kRadial > 0
	end

	-- Both estimates are lower bounds on the eigenvalue, so take the larger.
	local k = math.max(if axialOk then kAxial else 0, if radialOk then kRadial else 0)
	if k > 0 then
		self.keff = Util.clamp(k, 0.5, 1.5)
		self.rho = (self.keff - 1) / self.keff
	end
	local scale, blockScale = self.layerScale, self.blockScale
	for z = 1, NZ do
		-- Limit how far one tick may move a layer or a block.
		scale[z] = if axialOk then Util.clamp(f[z], 0.5, 2) else 1
	end
	for i = 1, NB do
		blockScale[i] = if radialOk then Util.clamp(g[i], 0.6, 1.6) else 1
	end
	local total = 0
	for i = 1, NB do
		local base = (i - 1) * NZ
		local sum = 0
		for z = 1, NZ do
			sum += scale[z] * PB[base + z]
		end
		total += blockScale[i] * sum
	end
	self.production = total
end

-- Apply the rebalance factors, normalise the shape, and fill node powers.
function Core.distributePower(self)
	local NC, NZ, NF = self.NC, self.NZ, self.NF
	local psi, absn, kinf, pnode, hist = self.psi, self.absn, self.kinf, self.pnode, self.hist
	local cellKind, cellRef = self.layout.cellKind, self.layout.cellRef
	local scale, blockScale, blockOf = self.layerScale, self.blockScale, self.blockOf
	local total = self.production
	if total <= 0 then
		return
	end
	local decayPower = 0
	for i = 1, #self.decay do
		decayPower += self.decay[i]
	end
	local prompt = self.fission * (1 - self.decayFrac)
	self.thermalPower = prompt + decayPower
	local histTotal = self.histTotal or 0
	-- psi is kept so that the production integral equals the node count.
	local norm = (NF * NZ) / total
	local promptScale = prompt / (NF * NZ)
	local decayScale = if histTotal > 0 then decayPower / histTotal else 0
	local uniformDecay = if histTotal > 0 then 0 else decayPower / (NF * NZ)
	local power = self.power
	local fluxRel = self.fluxRel
	local invNZ = 1 / NZ
	local maxP = 0
	for c = 1, NC do
		local base = (c - 1) * NZ
		local cellNorm = norm * blockScale[blockOf[c]]
		if cellKind[c] == 1 then
			local sum, fis = 0, 0
			for z = 1, NZ do
				local n = base + z
				local v = psi[n] * cellNorm * scale[z]
				psi[n] = v
				local production = kinf[n] * absn[n] * v
				local p = production * promptScale + hist[n] * decayScale + uniformDecay
				pnode[n] = p
				sum += p
				fis += production
			end
			power[cellRef[c]] = sum
			fluxRel[cellRef[c]] = fis * invNZ
			if sum > maxP then
				maxP = sum
			end
		else
			for z = 1, NZ do
				local n = base + z
				psi[n] = psi[n] * cellNorm * scale[z]
			end
		end
	end
	self.maxChannelPower = maxP
	for z = 1, NZ do
		scale[z] = 1
	end
	for i = 1, self.nBlocks do
		blockScale[i] = 1
	end
end

-- Six-group point kinetics, implicit, sub-stepped. Includes an adiabatic
-- fuel-temperature term inside the step so a prompt excursion is checked by
-- Doppler the way a real one is, even between thermal updates.
function Core.kinetics(self, dt: number)
	if self.destroyed then
		self.fission = math.max(self.fission * math.exp(-dt / 2), 1)
		return
	end
	local beta, Lp = self.beta, C.LAMBDA_PROMPT
	local betas, prec = self.betas, self.prec
	local rho0 = self.rho
	local n = self.fission
	local nStart = n
	local remaining = dt
	local fuelHeatCap = self.NF * self.NZ * C.FUEL_C
	local fuelK = math.max(self.avgFuelTemp + 273.15, 300)
	local dopplerPerK = -C.DOPPLER / (2 * math.sqrt(fuelK))
	local fastDT = 0
	local guard = 0
	while remaining > 1e-9 and guard < 400 do
		guard += 1
		local rho = rho0 + dopplerPerK * fastDT
		local h = 0.02
		if rho > beta * 0.6 then
			h = math.min(h, 0.2 * Lp / math.max(rho - beta * 0.6, 1e-5))
		end
		h = math.max(math.min(h, remaining), 1e-4)
		local denom = 1 - h * (rho - beta) / Lp
		local rhs = n + h * C.SOURCE
		for i = 1, 6 do
			local f = 1 / (1 + h * LAMBDAS[i])
			denom -= h * LAMBDAS[i] * h * betas[i] / Lp * f
			rhs += h * LAMBDAS[i] * prec[i] * f
		end
		if denom < 0.02 then
			denom = 0.02
		end
		local nNew = rhs / denom
		for i = 1, 6 do
			prec[i] = (prec[i] + h * betas[i] / Lp * nNew) / (1 + h * LAMBDAS[i])
		end
		-- Heat added beyond what the thermal model already saw this tick.
		fastDT += (0.5 * (n + nNew) - nStart) * h / fuelHeatCap
		if fastDT < 0 then
			fastDT = 0
		end
		n = nNew
		remaining -= h
	end
	if n < 1e-3 then
		n = 1e-3
	end
	local rate = (math.log(n) - math.log(nStart)) / dt
	self.logRate = Util.lag(self.logRate, rate, dt, 0.6)
	self.period = if math.abs(self.logRate) < 1e-5 then math.huge else 1 / self.logRate
	self.fission = n
	for i, g in C.DECAY do
		local target = g[1] * n
		self.decay[i] += (target - self.decay[i]) * (1 - math.exp(-dt / g[2]))
	end
end

-- Put delayed neutron precursors in equilibrium with the current power.
function Core.equilibratePrecursors(self)
	for i = 1, 6 do
		self.prec[i] = self.betas[i] / (C.LAMBDA_PROMPT * LAMBDAS[i]) * self.fission
	end
end

-- Split each loop's flow between its channels.
function Core.distributeFlow(self, cond: LoopConditions)
	local NF = self.NF
	local valve, phi2, flow, loop, status = self.valve, self.phi2, self.flow, self.fuelLoop, self.status
	local sum1, sum2 = 0, 0
	for f = 1, NF do
		-- Most of a channel's pressure drop is across its inlet throttle,
		-- which is what keeps the flow steady when boiling changes the
		-- friction further up.
		local v = valve[f]
		local w = 1 / math.sqrt(0.6 / (v * v) + 0.16 * phi2[f])
		flow[f] = w
		if loop[f] == 1 then
			sum1 += w
		else
			sum2 += w
		end
	end
	self.loopConductance[1], self.loopConductance[2] = sum1, sum2
	local s1 = if sum1 > 0 then cond.flow[1] / sum1 else 0
	local s2 = if sum2 > 0 then cond.flow[2] / sum2 else 0
	local leak1, leak2 = 0, 0
	local leak = self.leak
	for f = 1, NF do
		local g = flow[f] * (if loop[f] == 1 then s1 else s2)
		flow[f] = g
		if status[f] == STATUS_RUPTURED then
			-- A burst tube empties into the reactor space from both ends:
			-- what its inlet throttle passes, and water flashing back down
			-- the outlet pipe from the drum separator.
			local p = cond.pressure[loop[f]]
			local lk = math.min(g, 8) + 16 * math.sqrt(math.max(p - 0.3, 0) / 7)
			leak[f] = lk
			if loop[f] == 1 then
				leak1 += lk
			else
				leak2 += lk
			end
		end
	end
	self.loopLeak[1], self.loopLeak[2] = leak1, leak2
end

-- Channel thermal-hydraulics, fuel and graphite temperatures, feedback, and
-- tube/fuel damage. When `relax` is given the call is one damped iteration
-- toward steady state instead of a time step: fuel moves that fraction of the
-- way to equilibrium and graphite is left alone (the caller sets it).
function Core.thermal(self, dt: number, cond: LoopConditions, relax: number?)
	local NZ, NF = self.NZ, self.NF
	local fuelCell, loopOf = self.fuelCell, self.fuelLoop
	local pnode, tf, tg, void, kinf, xe = self.pnode, self.tf, self.tg, self.void, self.kinf, self.xe
	local knode, voidCoef, flow, phi2 = self.knode, self.voidCoef, self.flow, self.phi2
	local heat, xExit, tOut, cladT, tfMax, margin = self.heat, self.xExit, self.tOut, self.cladT, self.tfMax, self.margin
	local power, status = self.power, self.status
	local gFrac = C.GRAPHITE_HEAT_FRACTION
	local Rf, Cf, Rg, Cg = C.FUEL_R, C.FUEL_C, C.GRAPHITE_R, C.GRAPHITE_C
	local aD, aG, wXe, T0, sqrtT0 = C.DOPPLER, C.GRAPHITE, C.XENON_WORTH, C.T_REF, self.sqrtT0
	local steady = relax ~= nil
	local fuelGain = if relax then 1 - relax else 1 / (1 + dt / (Rf * Cf))
	local graphGain = if relax then 1 else 1 / (1 + dt / (Rg * Cg))
	local phiLag = if relax then relax else dt / (1.0 + dt)
	local cladLag = if relax then 1 else dt / (3.0 + dt)

	-- Per-loop fluid properties.
	local lp = {}
	for l = 1, 2 do
		local p = cond.pressure[l]
		local tsat, hf, hfg, rhof, rhog = Steam.sat(p)
		local hin = cond.inletEnthalpy[l]
		local tin = Steam.tLiquid(math.min(hin, hf))
		local sub = hf - hin
		lp[l] = {
			p = p,
			tsat = tsat,
			hf = hf,
			hfg = hfg,
			rhof = rhof,
			rhog = rhog,
			hin = hin,
			tin = tin,
			-- Liquid temperature and density are linear in enthalpy between
			-- the inlet state and saturation.
			dTdh = if sub > 1 then (tsat - tin) / sub else 0,
			dRdh = if sub > 1 then (rhof - Steam.rhoLiquid(tin)) / sub else 0,
			slip = 1 + 0.12 * math.sqrt(rhof / rhog),
			ratio = rhof / rhog,
		}
	end

	local sumHeat = { 0, 0 }
	local sumSteam = { 0, 0 }
	local sumFlow = { 0, 0 }
	local sumVoidVol = { 0, 0 }
	local sumRho = { 0, 0 }
	local count = { 0, 0 }
	local sumTf, sumTg, maxTf, maxClad, minMargin = 0, 0, 0, 0, 99
	local nodeVolume = 0.0022 * self.dz -- coolant volume per node, m3
	local riserVolume = 0.045 -- m3 of outlet piping per channel

	for f = 1, NF do
		local l = loopOf[f]
		local P = lp[l]
		local tsat, hf, hfg, rhof, rhog = P.tsat, P.hf, P.hfg, P.rhof, P.rhog
		local hg = hf + hfg
		local slipRatio = P.slip * rhog / rhof
		local g = flow[f]
		if g < 0.02 then
			g = 0.02
		end
		local base = (fuelCell[f] - 1) * NZ
		local av = voidCoef[f]
		local h = P.hin
		local dry = cladT[f] > tsat + 80
		local cladHot = cladT[f] - 30
		local q = 0
		local hottest = 0
		local voidSum, rhoSum = 0, 0
		for z = NZ, 1, -1 do
			local n = base + z
			local pn = pnode[n]
			local tc
			if h < hf then
				tc = tsat - (hf - h) * P.dTdh
			elseif h < hg then
				tc = tsat
			else
				tc = tsat + (h - hg) / 2600
			end
			if dry and tc < cladHot then
				tc = cladHot
			end
			-- Implicit Euler; dt -> infinity lands exactly on steady state.
			local tfn = tf[n] * fuelGain + (pn * (1 - gFrac) * Rf + tc) * (1 - fuelGain)
			local tgn = tg[n] * graphGain + (pn * gFrac * Rg + tc) * (1 - graphGain)
			tf[n] = tfn
			tg[n] = tgn
			if tfn > hottest then
				hottest = tfn
			end
			local qn = (tfn - tc) / Rf + (tgn - tc) / Rg
			q += qn
			local h2 = h + qn / g
			local hm = 0.5 * (h + h2)
			local rho
			local alpha = 0
			if hm <= hf then
				rho = rhof - (hf - hm) * P.dRdh
			elseif hm < hg then
				local x = (hm - hf) / hfg
				alpha = x / (x + (1 - x) * slipRatio)
				rho = alpha * rhog + (1 - alpha) * rhof
			else
				alpha = 1
				rho = rhog
			end
			local ve = 1 - rho * 0.001
			void[n] = ve
			voidSum += alpha
			rhoSum += rho
			kinf[n] = knode[n] + av * ve - aD * (math.sqrt(tfn + 273.15) - sqrtT0) + aG * (tgn - T0) - wXe * xe[n]
			sumTf += tfn
			sumTg += tgn
			h = h2
		end
		heat[f] = q
		tfMax[f] = hottest
		local xe_ = (h - hf) / hfg
		xExit[f] = xe_
		tOut[f] = if h < hf then tsat - (hf - h) * P.dTdh elseif h < hg then tsat else tsat + (h - hg) / 2600
		local xq = Util.clamp(xe_, 0, 1)
		local alphaExit = if xq > 0 then xq / (xq + (1 - xq) * slipRatio) else 0
		-- Two-phase friction grows with exit quality; lag it to keep flows calm.
		local phiTarget = math.min(1 + 0.45 * xq * (P.ratio - 1), 30)
		phi2[f] += (phiTarget - phi2[f]) * phiLag

		-- Critical power: dryout when exit quality passes a flow-dependent limit.
		local xCrit = Util.clamp(0.78 - 0.045 * g, 0.30, 0.78)
		local pCrit = g * (xCrit * hfg + math.max(0, hf - P.hin))
		local pw = power[f]
		local m = if pw > 1 then pCrit / pw else 99
		if m > 99 then
			m = 99
		end
		margin[f] = m
		if pw > pCrit and not steady then
			local t = cladT[f] + (pw - pCrit) / C.CHANNEL_HEAT_CAP * dt
			-- Radiation to the graphite caps the runaway.
			cladT[f] = math.min(t, 3200)
		else
			local rest = math.max(tsat, tOut[f]) + 15
			cladT[f] += (rest - cladT[f]) * cladLag
		end
		if cladT[f] > maxClad then
			maxClad = cladT[f]
		end
		if hottest > maxTf then
			maxTf = hottest
		end
		if m < minMargin and pw > 2e4 then
			minMargin = m
		end

		sumHeat[l] += q
		sumFlow[l] += g
		sumSteam[l] += g * xq
		sumVoidVol[l] += voidSum * nodeVolume + alphaExit * riserVolume
		sumRho[l] += rhoSum / NZ
		count[l] += 1
	end

	for l = 1, 2 do
		self.loopHeat[l] = sumHeat[l]
		self.loopSteam[l] = sumSteam[l]
		self.loopExitQuality[l] = if sumFlow[l] > 0 then sumSteam[l] / sumFlow[l] else 0
		self.loopVoidVolume[l] = sumVoidVol[l]
		self.loopDensity[l] = if count[l] > 0 then sumRho[l] / count[l] else 1000
	end
	self.avgFuelTemp = sumTf / (NF * NZ)
	self.avgGraphiteTemp = sumTg / (NF * NZ)
	self.maxFuelTemp = maxTf
	self.maxCladTemp = maxClad
	self.minMargin = minMargin
	if not steady then
		self:_damage(dt, cond)
	end
end

-- Tube ruptures and fuel failures.
function Core._damage(self, dt: number, cond: LoopConditions)
	local NF = self.NF
	local status, cladT, tfMax, wear, loopOf = self.status, self.cladT, self.tfMax, self.wear, self.fuelLoop
	local rng = self.rng
	local powerFrac = self.thermalPower / Config.NOMINAL_THERMAL
	local newRuptures = 0
	local melted = 0
	for f = 1, NF do
		if tfMax[f] > C.FUEL_MELT then
			melted += 1
		end
		if status[f] == STATUS_OK then
			local p = cond.pressure[loopOf[f]]
			local w = wear[f]
			local limit = C.RUPTURE_TEMP + 60 * (7 - p) - 220 * w
			local burst = false
			local why = "overheat"
			if cladT[f] > limit then
				burst = true
			elseif tfMax[f] > C.FUEL_MELT then
				burst = true
				why = "fuel melt"
			elseif p > 9.6 - 2.5 * w then
				burst = true
				why = "overpressure"
			elseif w > 0.3 and p > 1.0 then
				-- Worn tubes can let go on their own. The hazard climbs
				-- steeply with wear, pressure and power.
				local hazard = 2.0e-5 * ((w - 0.3) / 0.3) ^ 3 * (p / 7) ^ 2 * (0.3 + powerFrac)
				if rng:next() < hazard * dt then
					burst = true
					why = "tube failure"
				end
			end
			if burst then
				status[f] = STATUS_RUPTURED
				newRuptures += 1
				table.insert(self.events, { kind = "rupture", channel = f, cause = why })
			end
		end
	end
	if newRuptures > 0 then
		self.nRuptured += newRuptures
	end
	self.nFuelDamaged = math.max(self.nFuelDamaged, melted)
	-- Widespread fuel melting means the core has come apart.
	if melted > 60 and not self.destroyed then
		self.destroyed = true
		table.insert(self.events, { kind = "destroyed", cause = "power excursion" })
	end
end

function Core.destroy(self, cause: string)
	if not self.destroyed then
		self.destroyed = true
		table.insert(self.events, { kind = "destroyed", cause = cause })
	end
end

-- Xenon, iodine, decay-heat shape and the slow diagnostics.
function Core.slow(self, dt: number)
	local NZ, NF = self.NZ, self.NF
	local fuelCell = self.fuelCell
	local pnode, xe, iod, hist, psi = self.pnode, self.xe, self.iod, self.hist, self.psi
	local nominalNode = Config.NOMINAL_THERMAL / (NF * NZ)
	local lamI, lamX, gI, gX, burn = C.LAMBDA_I, C.LAMBDA_XE, C.GAMMA_I, C.GAMMA_XE, C.XE_BURN
	local xeEq = (gI + gX) / (lamX + burn) -- equilibrium xenon at nominal flux
	local histF = 1 - math.exp(-dt / 300)
	local axial = self.axial
	for z = 1, NZ do
		axial[z] = 0
	end
	local zone = self.zonePower
	for i = 1, 12 do
		zone[i] = 0
	end
	local total = 0
	local histTotal = 0
	local xeWeighted, weight = 0, 0
	local voidWeighted = 0
	local void, voidCoef = self.void, self.voidCoef
	for f = 1, NF do
		local base = (fuelCell[f] - 1) * NZ
		local zsum = 0
		local av = voidCoef[f]
		for z = 1, NZ do
			local n = base + z
			local p = pnode[n]
			local phi = p / nominalNode
			-- Iodine and xenon in units where 1 = equilibrium at nominal flux.
			local i0 = iod[n]
			local x0 = xe[n] * xeEq
			local iNew = i0 + dt * (gI * phi - lamI * i0)
			local xNew = x0 + dt * (gX * phi + lamI * i0 - (lamX + burn * phi) * x0)
			if xNew < 0 then
				xNew = 0
			end
			iod[n] = iNew
			xe[n] = xNew / xeEq
			hist[n] += (phi - hist[n]) * histF
			histTotal += hist[n]
			axial[z] += p
			zsum += p
			local w = psi[n] * psi[n]
			xeWeighted += xe[n] * w
			voidWeighted += av * (1 - void[n]) * w
			weight += w
		end
		zone[self.fuelZone[f]] += zsum
		total += zsum
	end
	self.histTotal = histTotal
	if total > 0 then
		for z = 1, NZ do
			axial[z] = axial[z] / total * NZ
		end
		for i = 1, 12 do
			zone[i] /= total
		end
	end
	if weight > 0 then
		self.xenonWorth = -C.XENON_WORTH * xeWeighted / weight
		self.voidCoefCore = voidWeighted / weight
	end

	self:updateVoidCoefficients()
	self:computeOrm()
end

-- Absorber standing near a channel lowers its void effect, which is why
-- running with few rods in the core is dangerous.
function Core.updateVoidCoefficients(self)
	local near = self.layout.rodsNear
	local ins = table.create(self.NR, 0)
	for i = 1, self.NR do
		ins[i] = self:rodInsertion(i)
	end
	local voidBase, voidCoef = self.voidBase, self.voidCoef
	for f = 1, self.NF do
		local list = near[f]
		local s = 0
		for _, r in list do
			s += ins[r]
		end
		local mean = if #list > 0 then s / #list else 0
		voidCoef[f] = voidBase[f] * (1 - C.VOID_ROD_SUPPRESSION * mean)
	end
end

-- Operating reactivity margin in equivalent fully inserted rods, weighted by
-- the flux around each rod the way the plant computer estimates it.
function Core.computeOrm(self)
	local NZ, dz = self.NZ, self.dz
	local psi = self.psi
	local sumAll, nAll = 0, 0
	for f = 1, self.NF do
		local base = (self.fuelCell[f] - 1) * NZ
		for z = 1, NZ do
			local v = psi[base + z]
			sumAll += v * v
		end
		nAll += 1
	end
	local meanRod = sumAll / math.max(nAll, 1) -- flux^2 summed over a full-height average channel
	if meanRod <= 0 then
		self.orm = 0
		return
	end
	local orm = 0
	for i = 1, self.NR do
		local x = self.rodPos[i]
		if x > 0 then
			local a0, a1
			if self.rodIsUSP[i] then
				a0 = C.HEIGHT - x
				a1 = a0 + R.USP_ABSORBER_LEN
			else
				a1 = x
				a0 = x - R.ABSORBER_LEN
			end
			local nb = self.rodNeighbors[i]
			local worth = 0
			for z = 1, NZ do
				local top, bot = (z - 1) * dz, z * dz
				local fa = math.max(0, math.min(bot, a1) - math.max(top, a0)) / dz
				if fa > 0 then
					local s = 0
					for _, c in nb do
						local v = psi[(c - 1) * NZ + z]
						s += v * v
					end
					worth += fa * s / math.max(#nb, 1)
				end
			end
			orm += worth / meanRod
		end
	end
	self.orm = math.min(orm * self.ormScale, self.NR)
end

-- Advance the core by one tick.
function Core.step(self, dt: number, cond: LoopConditions)
	self:sweep()
	self:rebalance()
	self:kinetics(dt)
	self:distributePower()
	self:distributeFlow(cond)
	self:thermal(dt, cond)
	self.slowClock += dt
	if self.slowClock >= 2 then
		self:slow(self.slowClock)
		self.slowClock = 0
	end
end

-- Set xenon and iodine to equilibrium with the present power distribution.
function Core.equilibriumXenon(self)
	local NZ = self.NZ
	local nominalNode = Config.NOMINAL_THERMAL / (self.NF * NZ)
	local xeEq = (C.GAMMA_I + C.GAMMA_XE) / (C.LAMBDA_XE + C.XE_BURN)
	for f = 1, self.NF do
		local base = (self.fuelCell[f] - 1) * NZ
		for z = 1, NZ do
			local n = base + z
			local phi = self.pnode[n] / nominalNode
			self.iod[n] = C.GAMMA_I * phi / C.LAMBDA_I
			self.xe[n] = (C.GAMMA_I + C.GAMMA_XE) * phi / (C.LAMBDA_XE + C.XE_BURN * phi) / xeEq
			self.hist[n] = phi
		end
	end
end

-- Solve for an approximate steady state at the given power and loop
-- conditions with the present rod pattern. Returns k-effective.
--
-- The real core has a slightly positive slow power feedback (graphite), so a
-- plain fixed-point iteration tilts and runs away exactly as the plant would
-- without its local regulators. For a design calculation that is not wanted:
-- graphite is therefore set from the layer-average power, and fuel
-- temperature and xenon are under-relaxed. Used for calibration and tests,
-- never during play.
function Core.solveSteady(self, powerW: number, cond: LoopConditions, opts: { xenon: boolean?, iterations: number? }?)
	local iterations = (opts and opts.iterations) or 40
	local relax = 0.35
	local NZ, NF = self.NZ, self.NF
	self.fission = powerW
	for i, g in C.DECAY do
		self.decay[i] = g[1] * powerW
	end
	local tsat = 0.5 * (Steam.tsat(cond.pressure[1]) + Steam.tsat(cond.pressure[2]))
	local layer = table.create(NZ, 0)
	local nominalNode = Config.NOMINAL_THERMAL / (NF * NZ)
	local xeEq = (C.GAMMA_I + C.GAMMA_XE) / (C.LAMBDA_XE + C.XE_BURN)
	-- First bring the kinf field up for the present rods and temperatures.
	self:updateVoidCoefficients()
	self:distributeFlow(cond)
	self:thermal(0, cond, 0)
	for _ = 1, iterations do
		for _ = 1, 15 do
			self:sweep()
		end
		self:rebalance()
		self:distributePower()
		self:distributeFlow(cond)
		for z = 1, NZ do
			layer[z] = 0
		end
		for f = 1, NF do
			local base = (self.fuelCell[f] - 1) * NZ
			for z = 1, NZ do
				layer[z] += self.pnode[base + z]
			end
		end
		for f = 1, NF do
			local base = (self.fuelCell[f] - 1) * NZ
			for z = 1, NZ do
				local n = base + z
				local target = tsat + layer[z] / NF * C.GRAPHITE_HEAT_FRACTION * C.GRAPHITE_R
				self.tg[n] += relax * (target - self.tg[n])
				if opts and opts.xenon then
					local phi = self.pnode[n] / nominalNode
					local eq = (C.GAMMA_I + C.GAMMA_XE) * phi / (C.LAMBDA_XE + C.XE_BURN * phi) / xeEq
					self.xe[n] += relax * (eq - self.xe[n])
					self.iod[n] = C.GAMMA_I * phi / C.LAMBDA_I
					self.hist[n] = phi
				end
			end
		end
		if opts and opts.xenon then
			self.histTotal = powerW / nominalNode
		end
		self:thermal(0, cond, relax)
	end
	self:slow(0)
	self:equilibratePrecursors()
	return self.keff
end

-- The rod pattern the core is designed around: full power, equilibrium
-- xenon, shutdown rods cocked, regulators mid-travel and a few manual rods
-- holding the operating reactivity margin. (The burnup map is built for
-- this pattern, so it is kept axially neutral: a design with many rods
-- dipped into the top would leave the top of the core over-reactive
-- whenever they were pulled.)
function Core.setDesignPattern(self)
	local rr = 0
	for i, rod in self.layout.rods do
		local x = 0
		if rod.kind == "RR" then
			rr += 1
			if rr % 20 == 0 then
				x = R.STROKE
			elseif rr % 20 == 10 then
				x = 3.0
			end
		elseif rod.kind == "AR" or rod.kind == "LAR" then
			x = 3.25
		elseif rod.kind == "USP" then
			x = 1.75
		end
		self:setRodPosition(i, x)
	end
end

-- Build an "equilibrium" core. Years of on-load refuelling leave a burnup
-- map that makes the full-power flux flat across the plateau, so the design
-- works backwards: choose the flux shape wanted at the design point, work out
-- the feedback (void, fuel and graphite temperature, xenon) that goes with
-- it, and solve the diffusion equation for the multiplication each node must
-- have. Channel-to-channel burnup scatter is then laid on top, the channel
-- throttles are set for the design power, and the whole map is shifted so
-- the design point is exactly critical. `yield` is called between stages so
-- a game server can stay responsive.
function Core.design(self, cond: LoopConditions, yield: (() -> ())?)
	local NZ, NF, NC, N = self.NZ, self.NF, self.NC, self.N
	local L = self.layout
	local pause = yield or function() end
	local psi, absn, dgeo, kinf, knode = self.psi, self.absn, self.dgeo, self.kinf, self.knode
	local nb = L.neighbors
	local cr, cz = self.cr, self.cz

	-- Target flux: gently domed across the plateau, rolling off to the
	-- reflector; axially a flattened cosine. (A perfectly flat plateau
	-- would have no restoring force against tilts at all.)
	local axialT = table.create(NZ, 1)
	for z = 1, NZ do
		axialT[z] = math.sin(math.pi * (z - 0.5) / NZ) ^ 0.55
	end
	local target = table.create(N, 0)
	for f = 1, NF do
		local c = L.fuelCells[f]
		local r = math.sqrt(L.cellX[c] ^ 2 + L.cellY[c] ^ 2) / self.radius
		local t = Util.clamp((r - 0.78) / 0.22, 0, 1)
		local radial = (1 - (self.designDome or 0.15) * r * r) * (1 - (self.designEdge or 0.75) * t * t * (3 - 2 * t))
		local base = (c - 1) * NZ
		for z = 1, NZ do
			target[base + z] = radial * axialT[z]
		end
	end

	-- The multiplication each fuel node needs for the target flux to solve
	-- the diffusion equation with the rods where they presently stand.
	local function required(): { number }
		-- Rod channels make no neutrons; their flux follows from their neighbours.
		for _ = 1, 6 do
			for i = 1, self.NR do
				local c = self.rodCell[i]
				local base = (c - 1) * NZ
				local q = (c - 1) * 4
				for z = 1, NZ do
					local n = base + z
					local sum = 0
					for d = 1, 4 do
						local o = nb[q + d]
						if o > 0 then
							sum += target[(o - 1) * NZ + z]
						end
					end
					sum *= cr
					if z > 1 then
						sum += cz * target[n - 1]
					end
					if z < NZ then
						sum += cz * target[n + 1]
					end
					target[n] = sum / (absn[n] + dgeo[n])
				end
			end
		end
		local out = table.create(N, 0)
		for f = 1, NF do
			local c = L.fuelCells[f]
			local base = (c - 1) * NZ
			local q = (c - 1) * 4
			for z = 1, NZ do
				local n = base + z
				local t = target[n]
				local sum = 0
				for d = 1, 4 do
					local o = nb[q + d]
					if o > 0 then
						sum += target[(o - 1) * NZ + z]
					end
				end
				sum *= cr
				if z > 1 then
					sum += cz * target[n - 1]
				end
				if z < NZ then
					sum += cz * target[n + 1]
				end
				out[n] = ((absn[n] + dgeo[n]) * t - sum) / (absn[n] * t)
			end
		end
		return out
	end

	-- The burnup map reflects where rods usually stand only region by
	-- region, never cell by cell: work the requirement out with every rod
	-- withdrawn, again with the design pattern, and keep just a smoothed
	-- version of the difference.
	for i = 1, self.NR do
		self:setRodPosition(i, 0)
	end
	local reqOut = required()
	self:setDesignPattern()
	local reqPattern = required()
	pause()
	local fx, fy = table.create(NF, 0), table.create(NF, 0)
	for f = 1, NF do
		local c = L.fuelCells[f]
		fx[f], fy[f] = L.cellX[c], L.cellY[c]
	end
	local req = table.create(N, 0)
	-- Channel-to-channel burnup scatter, with its regional average removed:
	-- in a core this loosely coupled a tenth of a percent of regional
	-- imbalance is a large power tilt.
	local scatter = table.create(NF, 0)
	for f = 1, NF do
		local x, y = fx[f], fy[f]
		local list = {}
		local burnSum, members = 0, 0
		for g = 1, NF do
			local dx, dy = fx[g] - x, fy[g] - y
			if dx * dx + dy * dy <= 20.5 then
				list[#list + 1] = (L.fuelCells[g] - 1) * NZ
				burnSum += self.burnup[g]
				members += 1
			end
		end
		scatter[f] = 0.07 * (burnSum / members - self.burnup[f])
		local base = (L.fuelCells[f] - 1) * NZ
		local count = #list
		for z = 1, NZ do
			local sum = 0
			for _, gb in list do
				sum += reqPattern[gb + z] - reqOut[gb + z]
			end
			req[base + z] = reqOut[base + z] + sum / count
		end
	end
	pause()

	-- Design power distribution and the thermal state that goes with it.
	local nominalNode = Config.NOMINAL_THERMAL / (NF * NZ)
	local xeEq = (C.GAMMA_I + C.GAMMA_XE) / (C.LAMBDA_XE + C.XE_BURN)
	local tsat = 0.5 * (Steam.tsat(cond.pressure[1]) + Steam.tsat(cond.pressure[2]))
	local total = 0
	for f = 1, NF do
		local base = (L.fuelCells[f] - 1) * NZ
		for z = 1, NZ do
			total += self.fweight[f] * target[base + z]
		end
	end
	self.fission = Config.NOMINAL_THERMAL
	self.thermalPower = Config.NOMINAL_THERMAL
	for i, g in C.DECAY do
		self.decay[i] = g[1] * Config.NOMINAL_THERMAL
	end
	local avgChannel = Config.NOMINAL_THERMAL / NF
	for f = 1, NF do
		local base = (L.fuelCells[f] - 1) * NZ
		local sum = 0
		for z = 1, NZ do
			local n = base + z
			local p = Config.NOMINAL_THERMAL * self.fweight[f] * target[n] / total
			self.pnode[n] = p
			sum += p
			local phi = p / nominalNode
			self.tg[n] = tsat + p * C.GRAPHITE_HEAT_FRACTION * C.GRAPHITE_R
			self.xe[n] = (C.GAMMA_I + C.GAMMA_XE) * phi / (C.LAMBDA_XE + C.XE_BURN * phi) / xeEq
			self.iod[n] = C.GAMMA_I * phi / C.LAMBDA_I
			self.hist[n] = phi
		end
		self.power[f] = sum
		-- Throttle each channel for its design power, as the real plant
		-- does with its inlet valves.
		self.valve[f] = Util.clamp(0.45 + 0.55 * sum / avgChannel, 0.6, 1.3)
	end
	self.histTotal = NF * NZ
	for _ = 1, 8 do
		self:distributeFlow(cond)
		self:thermal(0, cond, 1)
	end
	pause()

	-- Take the feedback out of the requirement to get the bare burnup map,
	-- and lay the channel-to-channel scatter on top.
	for f = 1, NF do
		local base = (L.fuelCells[f] - 1) * NZ
		for z = 1, NZ do
			local n = base + z
			local feedback = kinf[n] - knode[n]
			knode[n] = Util.clamp(req[n] - feedback, 0.90, self.designKMax or 1.30) + scatter[f]
		end
	end
	for n = 1, N do
		psi[n] = target[n]
	end
	self.keff = 1
	pause()

	-- Converge the real flux on that map, let the feedback follow the real
	-- power shape part of the way, and trim to exactly critical.
	for pass = 1, (self.designPasses or 1) + 1 do
		self:distributeFlow(cond)
		self:thermal(0, cond, 0)
		self:settle(40)
		self:rebalance()
		self:distributePower()
		if pass > (self.designPasses or 1) then
			self:calibrateCritical()
			break
		end
		for f = 1, NF do
			local base = (L.fuelCells[f] - 1) * NZ
			for z = 1, NZ do
				local n = base + z
				local phi = self.pnode[n] / nominalNode
				local eq = (C.GAMMA_I + C.GAMMA_XE) * phi / (C.LAMBDA_XE + C.XE_BURN * phi) / xeEq
				self.xe[n] += 0.5 * (eq - self.xe[n])
				self.iod[n] = C.GAMMA_I * phi / C.LAMBDA_I
				self.hist[n] = phi
				local tgEq = tsat + self.pnode[n] * C.GRAPHITE_HEAT_FRACTION * C.GRAPHITE_R
				self.tg[n] += 0.5 * (tgEq - self.tg[n])
			end
		end
		self:distributeFlow(cond)
		self:thermal(0, cond, 0.5)
		self:settle(15)
		self:calibrateCritical()
		pause()
	end
	self:rebalance()
	self:distributePower()
	self:slow(0)
	self:equilibratePrecursors()

	-- Calibrate the margin estimate against the real thing: pull every rod
	-- with the feedback frozen and see how much reactivity that frees.
	local savedPos = table.clone(self.rodPos)
	local savedPsi = table.clone(self.psi)
	local k0 = self.keff
	self.ormScale = 1
	self:computeOrm()
	local raw = self.orm
	for i = 1, self.NR do
		self:setRodPosition(i, 0)
	end
	local kOut = self:settle(120)
	pause()
	for i = 1, self.NR do
		self:setRodPosition(i, if self.rodIsUSP[i] then R.USP_STROKE else R.STROKE)
	end
	local kIn = self:settle(120)
	pause()
	self.rodWorthTotal = kOut - kIn
	self.rodWorthEach = (kOut - kIn) / self.NR
	if raw > 0.5 then
		self.ormScale = ((kOut - k0) / self.rodWorthEach) / raw
	end
	for i = 1, self.NR do
		self:setRodPosition(i, savedPos[i])
	end
	for n = 1, self.N do
		self.psi[n] = savedPsi[n]
	end
	self.keff = k0
	self.rho = (k0 - 1) / k0
	self:computeOrm()
	-- Reference values other systems calibrate against.
	self.designConductance = { self.loopConductance[1], self.loopConductance[2] }
	self.designVoidVolume = { self.loopVoidVolume[1], self.loopVoidVolume[2] }
	self.designZonePower = table.clone(self.zonePower)
	self.designed = true
end

-- Converge the flux shape with the feedback frozen. Returns k-effective.
function Core.settle(self, sweeps: number): number
	for _ = 1, sweeps do
		self:sweep()
		self:rebalance()
		local total = self.production
		if total > 0 then
			local norm = (self.NF * self.NZ) / total
			local psi, scale, NZ = self.psi, self.layerScale, self.NZ
			local blockScale, blockOf = self.blockScale, self.blockOf
			for c = 1, self.NC do
				local base = (c - 1) * NZ
				local cellNorm = norm * blockScale[blockOf[c]]
				for z = 1, NZ do
					psi[base + z] *= cellNorm * scale[z]
				end
			end
		end
	end
	return self.keff
end

-- Step xenon and iodine through `hours` at a fixed power with the present
-- rod pattern, re-solving the power shape as the poison moves. Used to give
-- the core an operating history.
function Core.evolve(self, hours: number, powerW: number, cond: LoopConditions, stepSeconds: number?)
	local step = stepSeconds or 900
	local remaining = hours * 3600
	while remaining > 0 do
		local h = math.min(step, remaining)
		if powerW > 1e5 then
			self:solveSteady(powerW, cond, { xenon = false, iterations = 4 })
		else
			for n = 1, self.N do
				self.pnode[n] = 0
			end
		end
		-- Explicit steps of at most five minutes keep the poison equations stable.
		local sub = math.ceil(h / 300)
		for _ = 1, sub do
			self:slow(h / sub)
		end
		remaining -= h
	end
end

-- Shift every channel's multiplication so the present state is exactly critical.
function Core.calibrateCritical(self)
	self:shiftK(1 - self.keff)
end

-- Add the same amount to the multiplication of every fuel node.
function Core.shiftK(self, shift: number)
	self.kOffset += shift
	local NZ = self.NZ
	for f = 1, self.NF do
		local base = (self.fuelCell[f] - 1) * NZ
		for z = 1, NZ do
			self.knode[base + z] += shift
			self.kinf[base + z] += shift
		end
	end
end

-- Put every temperature back to cold. The poison (xenon, iodine) and the
-- decay heat are cleared too unless `keepHistory` is set.
function Core.resetCold(self, temperature: number?, keepHistory: boolean?)
	local t = temperature or C.T_REF
	for n = 1, self.N do
		self.tf[n] = t
		self.tg[n] = t
		self.void[n] = 0
		self.pnode[n] = 0
		if not keepHistory then
			self.xe[n] = 0
			self.iod[n] = 0
			self.hist[n] = 0
		end
	end
	for f = 1, self.NF do
		self.cladT[f] = t
		self.phi2[f] = 1
		self.xExit[f] = 0
		self.tOut[f] = t
		self.tfMax[f] = t
	end
	self.fission = 1
	for i = 1, 6 do
		self.prec[i] = 0
	end
	if not keepHistory then
		self.histTotal = 0
		for i = 1, #self.decay do
			self.decay[i] = 0
		end
	end
	self.logRate = 0
	self.period = math.huge
end

return Core
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Electrical</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Electrical system.
--
-- Each turbine-generator connects through its generator breaker (GCB) to a
-- unit bus; the unit bus reaches the 345 kV grid through the main
-- transformer and a switchyard breaker, and feeds two 6.9 kV auxiliary buses
-- through the unit auxiliary transformer. Every auxiliary bus also has a
-- reserve feed from the startup transformer. Three emergency buses hang off
-- auxiliary buses and each has a diesel generator.
--
-- With the switchyard breaker open and the generator breaker closed, a
-- coasting turbine keeps feeding its own auxiliary buses at falling
-- frequency: the "rundown" mode the 1986 test was about.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Electrical = {}
Electrical.__index = Electrical

local HZ = Config.GRID_HZ
local AUX = { "1A", "1B", "2A", "2B" }
local EMERGENCY = { { name = "E1", parent = "1A" }, { name = "E2", parent = "1B" }, { name = "E3", parent = "2A" } }
local RIDE_THROUGH = 1.5 -- seconds a motor stays connected through a dead bus

function Electrical.new(plant)
	local self = setmetatable({}, Electrical)
	self.plant = plant
	self.grid = { live = true, freq = HZ, volts = 1.0 }
	self.gens = {}
	for k = 1, 2 do
		self.gens[k] = {
			field = false,
			vset = 1.0,
			vdir = 0,
			volts = 0,
			freq = 0,
			gcb = false,
			yard = true,
			mode = "open", -- "open" | "grid" | "island"
			pe = 0, -- electrical power drawn from the shaft, W
			mvar = 0,
			angle = 0,
			reverse = 0,
			unitLive = false,
			unitFreq = 0,
			unitLoad = 0,
			tripped = false,
		}
	end
	self.buses = {}
	for i, name in AUX do
		self.buses[name] = {
			unit = if i <= 2 then 1 else 2,
			normal = false,
			reserve = true,
			ats = true,
			live = true,
			freq = HZ,
			dead = 0,
			load = 0,
			loadNext = 0,
			onReserve = true,
		}
	end
	self.ebus = {}
	for i, e in EMERGENCY do
		self.ebus[e.name] = {
			index = i,
			parent = e.parent,
			tie = true,
			live = true,
			freq = HZ,
			dead = 0,
			load = 0,
			loadNext = 0,
			dgMode = 1, -- 0 off, 1 auto, 2 run
			dgState = 0, -- 0 standby, 1 starting, 2 running, 3 failed
			dgSpeed = 0,
			dgBreaker = false,
			dgTimer = 0,
			dgWillFail = false,
			parentBack = 0,
		}
	end
	self.syncSelect = 0
	self.syncBypass = false
	self.gross = 0
	self.aux = 0

	local c = plant.cmd
	for k = 1, 2 do
		local g = self.gens[k]
		local key = "gen." .. k
		c[key .. ".field"] = function(v)
			g.field = v >= 0.5
		end
		c[key .. ".volt"] = function(v)
			g.vdir = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
		end
		c[key .. ".gcb"] = function(v)
			if v >= 0.5 then
				self:closeGcb(k)
			else
				self:openGcb(k, "opened by operator")
			end
		end
		c[key .. ".yard"] = function(v)
			local close = v >= 0.5
			if close and not g.yard and g.gcb and g.mode == "island" then
				-- Reconnecting an islanded unit needs the same care as the
				-- generator breaker.
				if not self:syncOk(k) and not self.syncBypass then
					plant:log(string.format("Switchyard breaker %d blocked by sync check", k))
					return
				end
			end
			if close ~= g.yard then
				g.yard = close
				plant:log(string.format("Switchyard breaker %d %s", k, if close then "closed" else "opened"))
			end
		end
	end
	c["sync.select"] = function(v)
		self.syncSelect = Util.clamp(math.floor(v), 0, 2)
	end
	c["sync.bypass"] = function(v)
		self.syncBypass = v >= 0.5
	end
	for _, name in AUX do
		local b = self.buses[name]
		c["bus." .. name .. ".normal"] = function(v)
			b.normal = v >= 0.5
		end
		c["bus." .. name .. ".reserve"] = function(v)
			b.reserve = v >= 0.5
		end
		c["bus." .. name .. ".ats"] = function(v)
			b.ats = v >= 0.5
		end
	end
	for _, e in EMERGENCY do
		local b = self.ebus[e.name]
		local i = b.index
		c["dg." .. i .. ".mode"] = function(v)
			b.dgMode = Util.clamp(math.floor(v), 0, 2)
		end
		c["ebus." .. i .. ".tie"] = function(v)
			b.tie = v >= 0.5
		end
	end
	return self
end

function Electrical.busLive(self, name: string): boolean
	local b = self.buses[name] or self.ebus[name]
	if not b then
		return false
	end
	return b.live or b.dead < RIDE_THROUGH
end

function Electrical.busFrequency(self, name: string): number
	local b = self.buses[name] or self.ebus[name]
	if not b or not b.live then
		return 0
	end
	return b.freq
end

-- Consumers call this every tick while they are running.
function Electrical.addLoad(self, name: string, watts: number)
	local b = self.buses[name] or self.ebus[name]
	if b then
		b.loadNext += watts
	end
end

function Electrical.syncOk(self, k: number): boolean
	local g = self.gens[k]
	local a = g.angle
	if a > 180 then
		a -= 360
	end
	return math.abs(g.freq - self.grid.freq) < 0.15 and math.abs(a) < 15 and math.abs(g.volts - self.grid.volts) < 0.05
end

function Electrical.closeGcb(self, k: number)
	local g = self.gens[k]
	local plant = self.plant
	if g.gcb then
		return
	end
	if g.volts < 0.8 then
		plant:log(string.format("Generator %d breaker will not close: no field", k))
		return
	end
	local busFromGrid = g.yard and self.grid.live
	if busFromGrid then
		if not self:syncOk(k) then
			if not self.syncBypass then
				plant:log(string.format("Generator %d breaker blocked by sync check", k))
				return
			end
			-- Out-of-phase closure: a violent torque on the shaft.
			local a = math.rad(g.angle)
			local severity = math.abs(math.sin(a / 2)) + math.abs(g.freq - self.grid.freq) / 3
			plant:log(string.format("GENERATOR %d CLOSED OUT OF PHASE", k))
			plant.secondary:shock(k, severity)
			if severity > 0.25 then
				plant.secondary:tripTurbine(k, "generator fault")
				plant:raise("gen." .. k .. ".fault")
				return
			end
		end
	end
	g.gcb = true
	g.reverse = 0
	plant:log(string.format("Generator %d breaker closed%s", k, if busFromGrid then " - synchronised" else " on dead bus"))
	if busFromGrid then
		plant.secondary:onSynchronised(k)
	end
end

function Electrical.openGcb(self, k: number, why: string)
	local g = self.gens[k]
	if g.gcb then
		g.gcb = false
		self.plant:log(string.format("Generator %d breaker %s", k, why))
	end
end

function Electrical.step(self, dt: number)
	local plant = self.plant
	local sec = plant.secondary
	local grid = self.grid

	-- Roll the load accumulators.
	for _, b in self.buses do
		b.load = b.loadNext
		b.loadNext = 0
	end
	for _, b in self.ebus do
		b.load = b.loadNext
		b.loadNext = 0
	end

	-- Generators and unit buses.
	for k = 1, 2 do
		local g = self.gens[k]
		local speed = sec.turbines[k].speed
		g.vset = Util.clamp(g.vset + g.vdir * 0.01 * dt, 0.90, 1.10)
		g.freq = speed * HZ
		-- The regulator holds terminal volts until the machine is too slow.
		local volts = if g.field then g.vset * math.min(1, speed / 0.92) else 0
		g.volts = Util.lag(g.volts, volts, dt, 0.8)
		local gridSide = g.yard and grid.live
		local genSide = g.gcb and g.volts > 0.7
		if g.gcb and gridSide then
			g.mode = "grid"
			g.unitLive, g.unitFreq = true, grid.freq
		elseif genSide then
			g.mode = "island"
			g.unitLive, g.unitFreq = true, g.freq
		else
			g.mode = "open"
			g.unitLive, g.unitFreq = gridSide, if gridSide then grid.freq else 0
		end
		if g.gcb and not g.field and g.mode == "grid" then
			self:openGcb(k, "tripped: loss of field")
			sec:tripTurbine(k, "generator loss of field")
			plant:raise("gen." .. k .. ".fault")
		end
		if g.gcb and g.mode == "open" and not gridSide then
			-- Collapsed island.
			self:openGcb(k, "tripped: undervoltage")
		end
		-- Synchroscope: angle of the machine relative to the system.
		g.angle = (g.angle + (g.freq - grid.freq) * 360 * dt) % 360
	end

	-- Auxiliary buses.
	local unitLoad = { 0, 0 }
	for _, name in AUX do
		local b = self.buses[name]
		local g = self.gens[b.unit]
		local fromUnit = b.normal and g.unitLive
		local fromReserve = b.reserve and grid.live
		if fromReserve then
			b.live, b.freq, b.onReserve = true, grid.freq, true
		elseif fromUnit then
			b.live, b.freq, b.onReserve = true, g.unitFreq, false
		else
			b.live, b.freq = false, 0
		end
		if b.live then
			b.dead = 0
		else
			b.dead += dt
			-- Automatic transfer to the reserve feed.
			if b.ats and grid.live and b.dead > 0.6 and not b.reserve then
				b.reserve = true
				b.normal = false
				plant:log("Bus " .. name .. " transferred to reserve feed")
				plant:raise("bus.reserve")
			end
		end
	end

	-- Emergency buses and diesels.
	for _, e in EMERGENCY do
		local b = self.ebus[e.name]
		local parent = self.buses[b.parent]
		local fromParent = b.tie and parent.live
		-- Diesel state machine.
		local want = b.dgMode == 2 or (b.dgMode == 1 and (not parent.live and parent.dead > 2 or b.dgBreaker))
		if b.dgMode == 0 then
			want = false
		end
		if b.dgState == 0 and want then
			b.dgState = 1
			b.dgTimer = 0
			plant:log(string.format("Diesel generator %d starting", b.index))
		elseif b.dgState == 1 then
			b.dgTimer += dt
			b.dgSpeed = math.min(1, b.dgTimer / 12)
			if b.dgWillFail and b.dgTimer > 4 then
				b.dgState = 3
				b.dgSpeed = 0
				b.dgWillFail = false
				plant:log(string.format("Diesel generator %d FAILED TO START", b.index))
				plant:raise("dg.fail")
			elseif b.dgTimer >= 12 then
				b.dgState = 2
				plant:log(string.format("Diesel generator %d at rated speed", b.index))
			end
			if not want then
				b.dgState = 0
			end
		elseif b.dgState == 2 then
			if not want then
				b.dgState = 0
				b.dgBreaker = false
				plant:log(string.format("Diesel generator %d stopped", b.index))
			end
		elseif b.dgState == 3 and b.dgMode == 0 then
			b.dgState = 0 -- reset by switching to OFF
		end
		if b.dgState ~= 2 and b.dgState ~= 1 then
			b.dgSpeed = math.max(0, b.dgSpeed - dt / 8)
		end
		-- Breaker logic in AUTO: pick up the bus when the parent is dead,
		-- hand it back after the parent has been healthy for a while.
		if b.dgState == 2 and b.dgMode >= 1 and not fromParent and not b.dgBreaker then
			b.tie = false
			b.dgBreaker = true
			plant:log(string.format("Diesel generator %d feeding bus %s", b.index, e.name))
		end
		if b.dgBreaker and parent.live then
			b.parentBack += dt
			if b.parentBack > 30 and b.dgMode == 1 then
				b.dgBreaker = false
				b.tie = true
				plant:log(string.format("Bus %s returned to normal feed", e.name))
			end
		else
			b.parentBack = 0
		end
		if b.dgState ~= 2 then
			b.dgBreaker = false
		end
		if b.dgBreaker then
			b.live, b.freq = true, HZ
		elseif b.tie and parent.live then
			b.live, b.freq = true, parent.freq
		else
			b.live, b.freq = false, 0
		end
		b.dead = if b.live then 0 else b.dead + dt
		if b.live and not b.dgBreaker then
			parent.load += b.load
		end
	end

	-- Power drawn from each unit by its own auxiliaries.
	local aux = 0
	for _, name in AUX do
		local b = self.buses[name]
		aux += b.load
		if b.live and not b.onReserve then
			unitLoad[b.unit] += b.load
		end
	end
	self.aux = aux

	local gross = 0
	for k = 1, 2 do
		local g = self.gens[k]
		local t = sec.turbines[k]
		g.unitLoad = unitLoad[k]
		if g.mode == "grid" then
			g.pe = t.shaftPower
			g.mvar = (g.volts - grid.volts) * 900
			-- Motoring: the reverse power relay opens the breaker.
			if g.pe < -3e6 then
				g.reverse += dt
				if g.reverse > 3 then
					self:openGcb(k, "tripped: reverse power")
				end
			else
				g.reverse = 0
			end
		elseif g.mode == "island" then
			g.pe = unitLoad[k]
			g.mvar = 0
		else
			g.pe = 0
			g.mvar = 0
			g.reverse = 0
		end
		if g.gcb then
			gross += g.pe
		end
	end
	self.gross = gross
end

function Electrical.publish(self, S)
	local running = 0
	for k = 1, 2 do
		local g = self.gens[k]
		local key = "gen." .. k
		S[key .. ".mw"] = if g.gcb then g.pe / 1e6 else 0
		S[key .. ".mvar"] = g.mvar
		S[key .. ".kv"] = g.volts * 22
		S[key .. ".hz"] = g.freq
		S[key .. ".gcb"] = if g.gcb then 1 else 0
		S[key .. ".yard"] = if g.yard then 1 else 0
		S[key .. ".field"] = if g.field then 1 else 0
		S[key .. ".island"] = if g.mode == "island" then 1 else 0
		S[key .. ".unitLive"] = if g.unitLive then 1 else 0
		if g.gcb and g.mode == "grid" then
			running += 1
		end
	end
	S["gen.onGrid"] = running
	local sel = self.gens[self.syncSelect]
	S["sync.select"] = self.syncSelect
	S["sync.bypass"] = if self.syncBypass then 1 else 0
	if sel and sel.volts > 0.5 and sel.yard and self.grid.live and not sel.gcb then
		S["sync.angle"] = sel.angle
		S["sync.df"] = sel.freq - self.grid.freq
		S["sync.dv"] = (sel.volts - self.grid.volts) * 100
		S["sync.ok"] = if self:syncOk(self.syncSelect) then 1 else 0
		S["sync.on"] = 1
	else
		S["sync.angle"] = 0
		S["sync.df"] = 0
		S["sync.dv"] = 0
		S["sync.ok"] = 0
		S["sync.on"] = 0
	end
	local dead = 0
	for _, name in AUX do
		local b = self.buses[name]
		local key = "bus." .. name
		S[key .. ".live"] = if b.live then 1 else 0
		S[key .. ".kv"] = if b.live then 6.9 else 0
		S[key .. ".hz"] = b.freq
		S[key .. ".mw"] = b.load / 1e6
		S[key .. ".normal"] = if b.normal then 1 else 0
		S[key .. ".reserve"] = if b.reserve then 1 else 0
		S[key .. ".ats"] = if b.ats then 1 else 0
		if not b.live then
			dead += 1
		end
	end
	S["bus.dead"] = dead
	for _, e in EMERGENCY do
		local b = self.ebus[e.name]
		local i = b.index
		S["ebus." .. i .. ".live"] = if b.live then 1 else 0
		S["ebus." .. i .. ".tie"] = if b.tie then 1 else 0
		S["dg." .. i .. ".mode"] = b.dgMode
		S["dg." .. i .. ".state"] = b.dgState
		S["dg." .. i .. ".run"] = if b.dgState == 2 then 1 else 0
		S["dg." .. i .. ".hz"] = b.dgSpeed * HZ
		S["dg." .. i .. ".bkr"] = if b.dgBreaker then 1 else 0
	end
	S["grid.live"] = if self.grid.live then 1 else 0
	S["grid.hz"] = self.grid.freq
	S["plant.gross"] = self.gross / 1e6
	S["plant.aux"] = self.aux / 1e6
	S["plant.net"] = (self.gross - self.aux) / 1e6
end

return Electrical
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Failures</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Random equipment failures, wear and aging, and the maintenance that puts
-- things right once the unit is cold.
--
-- Failures arrive at random while the unit is operating, roughly one every
-- half hour, more often on a unit that has been treated roughly. Wear comes
-- from how the plant is run: heating or cooling the circuit faster than the
-- limit weakens every pressure tube, cavitating a pump shortens its life,
-- and loading a cold turbine damages it.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Failures = {}
Failures.__index = Failures

function Failures.new(plant)
	local self = setmetatable({}, Failures)
	self.plant = plant
	self.enabled = true
	self.clock = 0
	self.nextEvent = plant.rng:range(700, 1600)
	self.lastStress = 0
	self.timers = {} -- { remaining, onExpire }
	self.blocked = {} -- fuel channel indices with a restricted inlet
	self.coldTime = 0
	self.count = 0
	return self
end

local function after(self, seconds: number, fn: () -> ())
	table.insert(self.timers, { remaining = seconds, fn = fn })
end

local function runningPump(rng, pumps): any
	local list = {}
	for _, p in pumps do
		if p.on and not p.failed then
			table.insert(list, p)
		end
	end
	if #list == 0 then
		return nil
	end
	return list[rng:int(1, #list)]
end

local function failPump(self, pump, alarm: string, minutes: number)
	pump.on = false
	pump.failed = true
	pump.repair = minutes * 60
	self.plant:log(pump.name .. " tripped: equipment fault (repair about " .. minutes .. " min)")
	self.plant:raise(alarm)
end

-- Each entry: weight and a function that returns true if it did something.
local function eventTable(self)
	local plant = self.plant
	local rng = plant.rng
	local core, pri, sec, elec, rods, safety = plant.core, plant.primary, plant.secondary, plant.elec, plant.rods, plant.safety
	return {
		{ 12, function()
			local l = rng:int(1, 2)
			local pump = runningPump(rng, pri.pumps[l])
			if not pump then return false end
			failPump(self, pump, "mcp.trip", rng:int(4, 8))
			return true
		end },
		{ 10, function()
			local pump = runningPump(rng, sec.feedPumps)
			if not pump then return false end
			failPump(self, pump, "fw.pump", rng:int(3, 6))
			return true
		end },
		{ 6, function()
			local pump = runningPump(rng, sec.condPumps)
			if not pump then return false end
			failPump(self, pump, "cond.pump", rng:int(3, 6))
			return true
		end },
		{ 8, function()
			local list = rods.byKind.RR
			local i = list[rng:int(1, #list)]
			if rods.stuck[i] then return false end
			rods:jam(i)
			plant:log(string.format("Rod %s drive fault: rod will not move", rods.label[i]))
			after(self, rng:range(360, 720), function()
				if not core.destroyed then
					rods.stuck[i] = false
					plant:log(string.format("Rod %s drive repaired", rods.label[i]))
				end
			end)
			return true
		end },
		{ 7, function()
			if rods.arMode == 0 then return false end
			plant:log(string.format("Automatic regulator AR-%d fault: regulator tripped out", rods.arMode))
			rods.arMode = 0
			return true
		end },
		{ 5, function()
			if not rods.larOn then return false end
			rods.larOn = false
			plant:log("Local automatic regulators fault: dropped out")
			plant:raise("lar.dropout")
			return true
		end },
		{ 8, function()
			if core.thermalPower < 0.2 * Config.NOMINAL_THERMAL then return false end
			local f = rng:int(1, core.NF)
			if core.status[f] ~= 0 or self.blocked[f] then return false end
			self.blocked[f] = core.valve[f]
			core.valve[f] *= 0.32
			local c = core.fuelCell[f]
			plant:log(string.format("Channel %02d-%02d: coolant flow dropping (inlet valve fault)", core.layout.cellGX[c], core.layout.cellGY[c]))
			return true
		end },
		{ 7, function()
			local k = rng:int(1, 2)
			local t = sec.turbines[k]
			if t.airLeak > 1 or t.vacBreaker then return false end
			t.airLeak = 5
			plant:log(string.format("Condenser %d: air in-leakage increasing", k))
			after(self, rng:range(300, 600), function()
				t.airLeak = 1
				plant:log(string.format("Condenser %d: air leak sealed", k))
			end)
			return true
		end },
		{ 5, function()
			local names = { "E1", "E2", "E3" }
			local b = elec.ebus[names[rng:int(1, 3)]]
			if b.dgWillFail or b.dgState ~= 0 then return false end
			b.dgWillFail = true -- latent: shows up the next time it is called on
			return true
		end },
		{ 4, function()
			local v = sec.safety[rng:int(1, 3)]
			if v.stuck then return false end
			v.stuck = true -- latent: fails to reseat after it next lifts
			return true
		end },
		{ 7, function()
			local l = rng:int(1, 2)
			local loop = pri.loops[l]
			if loop.levelBias ~= 0 then return false end
			loop.levelBias = (if rng:next() < 0.5 then -1 else 1) * rng:range(120, 260)
			plant:log(string.format("Drum %s narrow-range level transmitter drifting", if l == 1 then "A" else "B"))
			after(self, rng:range(400, 700), function()
				loop.levelBias = 0
				plant:log(string.format("Drum %s level transmitter recalibrated", if l == 1 then "A" else "B"))
			end)
			return true
		end },
		{ 5, function()
			if safety.cpsLeak > 0 then return false end
			safety.cpsLeak = 0.0015
			plant:log("Rod cooling circuit: leak, header tank level falling")
			after(self, rng:range(480, 720), function()
				safety.cpsLeak = 0
				plant:log("Rod cooling circuit: leak isolated")
			end)
			return true
		end },
		{ 2, function()
			if not elec.grid.live then return false end
			elec.grid.live = false
			elec.gens[1].yard = false
			elec.gens[2].yard = false
			plant:log("LOSS OF OFFSITE POWER: switchyard breakers open")
			after(self, rng:range(40, 100), function()
				elec.grid.live = true
				plant:log("Offsite power restored: reclose the switchyard breakers")
			end)
			return true
		end },
		{ 6, function()
			local f = rng:int(1, core.NF)
			core.wear[f] = math.min(1, core.wear[f] + 0.2) -- latent tube weakening
			return true
		end },
		{ 5, function()
			local k = rng:int(1, 2)
			local t = sec.turbines[k]
			if t.speed < 0.5 then return false end
			t.wear += 0.12
			plant:log(string.format("Turbine %d: vibration step change", k))
			return true
		end },
		{ 5, function()
			local l = rng:int(1, 2)
			local lc = sec.level[l]
			if lc.stuck > 0 then return false end
			lc.stuck = rng:range(120, 240)
			plant:log(string.format("Feedwater control valve %s not responding", if l == 1 then "A" else "B"))
			return true
		end },
	}
end

function Failures.trigger(self)
	local events = eventTable(self)
	local total = 0
	for _, e in events do
		total += e[1]
	end
	for _ = 1, 12 do
		local pick = self.plant.rng:next() * total
		for _, e in events do
			pick -= e[1]
			if pick <= 0 then
				if e[2]() then
					self.count += 1
					return
				end
				break
			end
		end
	end
end

-- With the unit cold and shut down the maintenance crews can work.
function Failures.maintenance(self)
	local plant = self.plant
	local core = plant.core
	local replaced, cleared, freed = 0, 0, 0
	for f = 1, core.NF do
		if core.status[f] ~= 0 then
			core.status[f] = 0
			core.leak[f] = 0
			core.wear[f] = 0.05
			replaced += 1
		end
	end
	core.nRuptured = 0
	core.nFuelDamaged = 0
	for f, original in self.blocked do
		core.valve[f] = original
		cleared += 1
	end
	self.blocked = {}
	for i = 1, core.NR do
		if plant.rods.stuck[i] then
			plant.rods.stuck[i] = false
			freed += 1
		end
	end
	if replaced + cleared + freed > 0 then
		plant:log(string.format("Maintenance: %d channels retubed, %d inlet valves cleared, %d rod drives freed", replaced, cleared, freed))
	end
end

function Failures.step(self, dt: number)
	local plant = self.plant
	local core, pri = plant.core, plant.primary

	-- Thermal shock spreads onto every pressure tube.
	local ds = pri.stress - self.lastStress
	if ds > 0.002 then
		self.lastStress = pri.stress
		local add = ds * 0.12
		for f = 1, core.NF do
			local w = core.wear[f] + add
			core.wear[f] = if w > 1 then 1 else w
		end
	end

	for i = #self.timers, 1, -1 do
		local t = self.timers[i]
		t.remaining -= dt
		if t.remaining <= 0 then
			table.remove(self.timers, i)
			t.fn()
		end
	end

	local operating = core.thermalPower > 0.01 * Config.NOMINAL_THERMAL or pri.pressure > 1
	if operating and self.enabled and not core.destroyed then
		-- A battered plant breaks more often.
		local abuse = 1 + Util.clamp(pri.stress * 2, 0, 3)
		self.clock += dt * abuse
		if self.clock >= self.nextEvent then
			self.clock = 0
			self.nextEvent = plant.rng:range(900, 2400)
			self:trigger()
		end
	end

	if not core.destroyed and core.thermalPower < 0.002 * Config.NOMINAL_THERMAL and pri.temp < 80 and plant.rods.allIn then
		self.coldTime += dt
		if self.coldTime > 180 then
			self.coldTime = 0
			self:maintenance()
		end
	else
		self.coldTime = 0
	end
end

function Failures.blockedCount(self): number
	local n = 0
	for _ in self.blocked do
		n += 1
	end
	return n
end

return Failures
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Plant</string>
            <string name="Source"><![CDATA[--!nonstrict
-- The whole unit. Owns every subsystem, steps them in order, and exposes two
-- flat interfaces to the rest of the game:
--
--   plant.S[name]            numbers the control room displays
--   plant:command(name, v)   everything an operator can do
--
-- Nothing in here touches Roblox APIs, so the same code runs under the
-- headless tests.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Config = require(Shared.Config)
local Steam = require(Shared.Steam)
local Util = require(Shared.Util)

local Core = require(script.Parent.Core)
local Rods = require(script.Parent.Rods)
local Primary = require(script.Parent.Primary)
local Secondary = require(script.Parent.Secondary)
local Electrical = require(script.Parent.Electrical)
local Safety = require(script.Parent.Safety)
local Protection = require(script.Parent.Protection)
local Alarms = require(script.Parent.Alarms)
local Failures = require(script.Parent.Failures)

local Plant = {}
Plant.__index = Plant

Plant.MAP_MODES = { "FLUX", "POWER", "MARGIN", "FLOW", "QUALITY", "FUEL T", "XENON", "GRAPHITE" }

export type Options = {
	seed: number?,
	age: number?, -- 0 = young core, 1 = equilibrium burnup
	hoursSinceShutdown: number?, -- sets how much xenon is left at start
	failures: boolean?,
	yield: (() -> ())?,
}

local function nominalConditions()
	local p = Config.Primary.NOMINAL_PRESSURE + Config.Primary.RISER_HEAD
	local hf = Steam.hf(Config.Primary.NOMINAL_PRESSURE)
	local sub = (Config.Secondary.STEAM_NOMINAL / 2) / Config.Primary.LOOP_RATED_FLOW * (hf - Steam.hLiquid(Config.Secondary.FEEDWATER_TEMP))
	return {
		pressure = { p, p },
		inletEnthalpy = { hf - sub, hf - sub },
		flow = { Config.Primary.LOOP_RATED_FLOW, Config.Primary.LOOP_RATED_FLOW },
	}
end
Plant.nominalConditions = nominalConditions

function Plant.new(opts: Options?)
	local o: Options = opts or {}
	local self = setmetatable({}, Plant)
	local seed = o.seed or 1
	self.rng = Util.rng(seed * 7919 + 13)
	self.S = {} :: { [string]: number }
	self.cmd = {} :: { [string]: (v: number, who: any?) -> () }
	self.holds = {} :: { [string]: number }
	self.time = 0
	self.logLines = {} :: { { t: number, text: string } }
	self.logSeq = 0
	self.mapMode = 1
	self.stats = { energy = 0, scrams = 0, autoSeconds = 0, violations = 0 }

	-- The core is designed at full power with equilibrium xenon, then given
	-- its shutdown history and cooled down.
	local age = o.age or self.rng:range(0.55, 1.0)
	self.age = age
	self.core = Core.new({ seed = seed, age = age })
	local core = self.core
	core:design(nominalConditions(), o.yield)

	local hours = o.hoursSinceShutdown or self.rng:range(40, 110)
	self.hoursSinceShutdown = hours
	core:evolve(hours, 0, nominalConditions(), 1800)
	for i, g in Config.Core.DECAY do
		core.decay[i] *= math.exp(-hours * 3600 / g[2])
	end
	if o.yield then
		o.yield()
	end

	self.rods = Rods.new(self)
	for z = 1, 12 do
		self.rods.zoneRef[z] = core.designZonePower[z]
	end
	self.primary = Primary.new(self)
	self.secondary = Secondary.new(self)
	self.elec = Electrical.new(self)
	self.safety = Safety.new(self)
	self.protection = Protection.new(self)
	self.alarms = Alarms.new(self)
	self.failures = Failures.new(self)
	self.failures.enabled = o.failures ~= false

	-- Cold shutdown: every rod in, cooldown system holding temperature.
	local pri = self.primary
	pri.temp = 55
	pri.cooldownOn = true
	core:resetCold(pri.temp, true)
	for i = 1, core.NR do
		core:setRodPosition(i, self.rods.stroke[i])
	end
	local cond = pri:hydraulics(0.1)
	core:distributeFlow(cond)
	core:thermal(0, cond, 0)
	core:settle(80)
	core.fission = math.max(1, Config.Core.SOURCE * Config.Core.LAMBDA_PROMPT / math.max(1e-4, -core.rho))
	core:equilibratePrecursors()
	core:distributePower()
	core:slow(0)

	self.cmd["map.mode"] = function(v)
		self.mapMode = Util.clamp(math.floor(v), 1, #Plant.MAP_MODES)
	end
	self.cmd["failures.enable"] = function(v)
		self.failures.enabled = v >= 0.5
	end

	-- Let natural circulation and the cooldown system find their balance,
	-- then start the clock with a clean log and annunciator board.
	local failuresOn = self.failures.enabled
	self.failures.enabled = false
	for i = 1, 400 do
		self:step(0.1)
		if o.yield and i % 50 == 0 then
			o.yield()
		end
	end
	self.failures.enabled = failuresOn
	self.time = 0
	table.clear(self.logLines)
	table.clear(self.alarms.changed)
	for i in self.alarms.state do
		self.alarms.state[i] = 0
	end
	self.stats = { energy = 0, scrams = 0, autoSeconds = 0, violations = 0 }
	self.rods.autoSeconds = 0
	self.secondary.autoSeconds = 0
	self.primary.stress = 0

	self:log(string.format("Unit in cold shutdown. Core burnup index %.0f%%, %.0f h since shutdown, xenon %.2f%%.", age * 100, hours, core.xenonWorth * 100))
	self:publish()
	return self
end

function Plant.log(self, text: string)
	self.logSeq += 1
	table.insert(self.logLines, { t = self.time, text = text, seq = self.logSeq } :: any)
	if #self.logLines > 250 then
		table.remove(self.logLines, 1)
	end
end

function Plant.raise(self, id: string)
	self.alarms:raise(id)
end

function Plant.busLive(self, name: string): boolean
	return self.elec:busLive(name)
end

function Plant.busFrequency(self, name: string): number
	return self.elec:busFrequency(name)
end

-- Run an operator command. Returns false for an unknown command.
function Plant.command(self, name: string, value: number, who: any?): boolean
	local fn = self.cmd[name]
	if not fn then
		return false
	end
	fn(value, who)
	return true
end

-- A command that is held (a raise/lower switch, the rod motion switch).
-- The control room re-sends it while held; if the refresh stops, it is
-- released here so nothing keeps moving after a player disconnects.
function Plant.hold(self, name: string, value: number, who: any?): boolean
	if not self.cmd[name] then
		return false
	end
	self.cmd[name](value, who)
	self.holds[name] = if value ~= 0 then self.time + 0.8 else nil
	return true
end

function Plant.step(self, dt: number)
	self.time += dt
	for name, expires in self.holds do
		if self.time >= expires then
			self.holds[name] = nil
			self.cmd[name](0)
		end
	end

	local core = self.core
	self.elec:step(dt)
	local cond = self.primary:hydraulics(dt)
	self.rods.drivePower = self:busLive("E1") or self:busLive("E2")
	self.rods:step(dt)
	core:step(dt, cond)
	self.secondary:step(dt)
	self.primary:thermal(dt)
	self.safety:step(dt)
	self.protection:step(dt)
	self.failures:step(dt)

	-- Main circulation pump motors load their buses.
	for l = 1, 2 do
		for _, pump in self.primary.pumps[l] do
			if pump.on then
				self.elec:addLoad(pump.bus, pump.power)
			end
		end
	end

	for _, ev in core.events do
		if ev.kind == "rupture" then
			local c = core.fuelCell[ev.channel]
			self:log(string.format("FUEL CHANNEL %02d-%02d RUPTURED (%s)", core.layout.cellGX[c], core.layout.cellGY[c], ev.cause))
		elseif ev.kind == "destroyed" then
			self:log("REACTOR DESTROYED: " .. ev.cause)
			self.rods:jamAll()
		end
	end
	table.clear(core.events)

	self.stats.energy += self.elec.gross * dt / 3.6e9
	self.stats.scrams = self.protection.scrams
	self.stats.autoSeconds = self.rods.autoSeconds + self.secondary.autoSeconds
	if math.abs(self.primary.heatupRate) > Config.Primary.HEATUP_LIMIT * 1.05 then
		self.stats.violations += dt
	end
	if core.thermalPower > 0.02 * Config.NOMINAL_THERMAL and core.orm < Config.Protection.ORM_SHUTDOWN_LIMIT then
		self.stats.violations += dt
	end

	self:publish()
	self.alarms:step(dt)
end

function Plant.publish(self)
	local S = self.S
	local core = self.core
	local frac = core.fission / Config.NOMINAL_THERMAL
	S["time"] = self.time
	S["n.power"] = frac * 100
	S["n.log"] = math.log10(math.max(frac, 1e-11))
	S["n.cps"] = math.min(1e6, 1.2e10 * frac)
	S["n.logcps"] = math.log10(math.max(1, math.min(1e6, 1.2e10 * frac)))
	local period = core.period
	if period ~= period or math.abs(period) > 999 then
		period = 999
	end
	S["n.period"] = period
	-- Startup rate in decades per minute, the usual control-room form.
	S["n.sur"] = if math.abs(period) >= 999 then 0 else Util.clamp(26.06 / period, -1, 5)
	S["n.thermal"] = core.thermalPower / 1e6
	S["n.heat"] = (core.loopHeat[1] + core.loopHeat[2]) / 1e6
	S["n.rho"] = core.rho / core.beta
	S["core.orm"] = core.orm
	S["core.kr"] = if core.thermalPower > 0 then core.maxChannelPower / (core.thermalPower / core.NF) else 0
	local maxFlux = 0
	for f = 1, core.NF do
		local v = core.fluxRel[f]
		if v > maxFlux then
			maxFlux = v
		end
	end
	S["core.fluxPeak"] = maxFlux
	local kz, top, bottom = 0, 0, 0
	local NZ = core.NZ
	for z = 1, NZ do
		local a = core.axial[z]
		S["core.ax" .. z] = a
		if a > kz then
			kz = a
		end
		if z <= NZ / 2 then
			top += a
		else
			bottom += a
		end
	end
	S["core.kz"] = kz
	S["core.offset"] = if top + bottom > 0 then (top - bottom) / (top + bottom) * 100 else 0
	local tilt = 0
	for z = 1, 12 do
		local ref = self.rods.zoneRef[z]
		local rel = if ref > 0 then core.zonePower[z] / ref else 1
		S["core.zone" .. z] = rel * 100
		tilt = math.max(tilt, math.abs(rel - 1) * 100)
	end
	S["core.tilt"] = tilt
	S["core.xenon"] = core.xenonWorth * 100
	S["core.void"] = core.voidCoefCore / core.beta
	S["core.maxFuel"] = core.maxFuelTemp
	S["core.maxClad"] = core.maxCladTemp
	S["core.minMargin"] = math.min(core.minMargin, 9.9)
	S["core.maxChannel"] = core.maxChannelPower / 1e6
	S["core.fuelT"] = core.avgFuelTemp
	S["core.graphT"] = core.avgGraphiteTemp
	S["core.ruptured"] = core.nRuptured
	S["core.damaged"] = core.nFuelDamaged
	S["core.destroyed"] = if core.destroyed then 1 else 0
	S["core.blocked"] = self.failures:blockedCount()
	S["core.steam"] = (core.loopSteam[1] + core.loopSteam[2]) * 3.6
	S["map.mode"] = self.mapMode
	S["horn"] = if self.alarms.horn then 1 else 0
	S["stats.energy"] = self.stats.energy
	S["stats.scrams"] = self.stats.scrams
	self.rods:publish(S)
	self.primary:publish(S)
	self.secondary:publish(S)
	self.elec:publish(S)
	self.safety:publish(S)
	self.protection:publish(S)
end

-- Put the unit straight into steady operation at the given fraction of full
-- power, with equilibrium xenon and both generators on the grid. Players
-- always begin from cold shutdown; this exists so the test suite (and a
-- future training mode) can reach an operating state without a startup.
function Plant.hotStart(self, powerFraction: number?)
	local frac = Util.clamp(powerFraction or 1, 0.2, 1)
	local core, pri, sec, elec, rods = self.core, self.primary, self.secondary, self.elec, self.rods
	local pressure = Config.Primary.NOMINAL_PRESSURE

	pri.cooldownOn = false
	pri.pressure = pressure
	pri.temp = Steam.tsat(pressure)
	pri.heatupRate = 0
	for l = 1, 2 do
		local loop = pri.loops[l]
		loop.mass = Config.Primary.DRUM_NOMINAL_MASS
		loop.letdownAuto = true
		loop.inletLag = nil
		for i, pump in pri.pumps[l] do
			pump.on = i <= 3
			pump.speed = if i <= 3 then 1 else 0
			pump.valve = 1
		end
	end

	sec.pressSet = pressure
	sec.pressAuto = true
	sec.pressInt = frac
	for k = 1, 2 do
		local t = sec.turbines[k]
		t.tripped, t.tripCause, t.stopOpen = false, "", true
		t.iso, t.cv, t.loadSet, t.speed, t.speedTarget = 1, frac, 1.05, 1, 2
		t.metal = 270
		t.lubeAC, t.turningGear, t.gland, t.sjae, t.vacPump, t.vacBreaker = true, false, true, true, false, false
		t.air, t.condP, t.condT = 0.0004, 0.005, 30
		t.cw[1].on, t.cw[2].on = true, true
		local g = elec.gens[k]
		g.field, g.volts, g.gcb, g.yard, g.mode = true, 1, true, true, "grid"
	end
	for i, pump in sec.feedPumps do
		pump.on = i <= 3
	end
	for i, pump in sec.condPumps do
		pump.on = i <= 2
	end
	for l = 1, 2 do
		local lc = sec.level[l]
		lc.auto, lc.valve, lc.int = true, 0.55 * frac + 0.1, 0
	end
	sec.da.temp, sec.da.peg, sec.da.mass = Config.Secondary.FEEDWATER_TEMP, true, 1.25e5

	core:setDesignPattern()
	local cond = nominalConditions()
	-- Start from a flat flux guess: the shutdown shape is concentrated in a
	-- small part of the core and would take a long time to spread out.
	for n = 1, core.N do
		core.psi[n] = 1
	end
	core.keff = 1
	core:solveSteady(frac * Config.NOMINAL_THERMAL, cond, { xenon = true, iterations = 30 })
	-- Trim to exactly critical at this power with the regulator's own rods mid-travel.
	core:settle(60)
	core:calibrateCritical()
	-- Feedwater is already flowing in the state being entered.
	for l = 1, 2 do
		pri.loops[l].feed = frac * Config.Secondary.STEAM_NOMINAL / 2
		pri.loops[l].feedEnthalpy = Steam.hLiquid(Config.Secondary.FEEDWATER_TEMP)
	end
	rods:resetProtection()
	rods.arMode = 1
	rods.setpoint = frac
	rods.larOn = true
	for _ = 1, 300 do
		self:step(0.1)
	end
	table.clear(self.alarms.changed)
	for i in self.alarms.state do
		self.alarms.state[i] = 0
	end
	self.protection:reset()
	self.primary.stress = 0
	self:log(string.format("Unit placed in operation at %.0f%% power", frac * 100))
end

-- Snapshot of the core for the map display: one byte per lattice cell for
-- the selected quantity, one for its condition, then one flag byte per rod.
function Plant.mapBuffer(self): buffer
	local core = self.core
	local L = core.layout
	local NC, NR, NZ = core.NC, core.NR, core.NZ
	local buf = buffer.create(1 + NC * 2 + NR)
	local mode = self.mapMode
	buffer.writeu8(buf, 0, mode)
	local tsat = Steam.tsat(self.primary.pressure)
	for c = 1, NC do
		local value, flag = 0, 0
		local ref = L.cellRef[c]
		if L.cellKind[c] == 2 then
			value = core.rodPos[ref] / self.rods.stroke[ref] * 255
		else
			local f = ref
			if mode == 1 then
				value = core.fluxRel[f] / 2.5 * 255
			elseif mode == 2 then
				value = core.power[f] / 3.2e6 * 255
			elseif mode == 3 then
				value = core.margin[f] / 4 * 255
			elseif mode == 4 then
				value = core.flow[f] / 9 * 255
			elseif mode == 5 then
				value = core.xExit[f] / 0.4 * 255
			elseif mode == 6 then
				value = core.tfMax[f] / 2000 * 255
			else
				local base = (c - 1) * NZ
				local s = 0
				local arr = if mode == 7 then core.xe else core.tg
				for z = 1, NZ do
					s += arr[base + z]
				end
				value = if mode == 7 then s / NZ / 2.5 * 255 else s / NZ / 800 * 255
			end
			if core.status[f] ~= 0 then
				flag = 1
			elseif self.failures.blocked[f] then
				flag = 2
			elseif core.cladT[f] > tsat + 80 then
				flag = 3
			end
		end
		buffer.writeu8(buf, c, math.floor(Util.clamp(value, 0, 255)))
		buffer.writeu8(buf, NC + c, flag)
	end
	local rods = self.rods
	for i = 1, NR do
		local flag = 0
		if rods.selected[i] then
			flag += 1
		end
		if rods.stuck[i] then
			flag += 2
		end
		local v = rods.velocity[i]
		if v > 0 then
			flag += 4
		elseif v < 0 then
			flag += 8
		end
		if rods:isAuto(i) then
			flag += 16
		end
		buffer.writeu8(buf, 2 * NC + i, flag)
	end
	return buf
end

return Plant
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Primary</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- Main circulation circuit: two loops, each with four main circulation
-- pumps (three run, one is standby) and a pair of drum separators that are
-- lumped into one water inventory per loop. Both loops share one steam space,
-- so there is a single pressure, but each loop has its own flow, inlet
-- subcooling and drum level.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Config = require(Shared.Config)
local Steam = require(Shared.Steam)
local Util = require(Shared.Util)

local P = Config.Primary

local Primary = {}
Primary.__index = Primary

local PUMP_BUS = { "1A", "1B", "2A", "2B" }
local ATMOSPHERE = 0.1013

-- Pump curve: head = H0*w^2 - A*q^2 (MPa, kg/s).
local PUMP_A = (P.PUMP_SHUTOFF_HEAD - P.PUMP_RATED_HEAD) / (P.PUMP_RATED_FLOW ^ 2)
local VALVE_K = 0.08 / (P.PUMP_RATED_FLOW ^ 2)
local CORE_DP_NOMINAL = 0.95
local PIPE_R = 0.50 / (P.LOOP_RATED_FLOW ^ 2)

function Primary.new(plant)
	local self = setmetatable({}, Primary)
	self.plant = plant
	self.core = plant.core
	self.temp = Config.Core.T_REF -- bulk water temperature; saturation once pressurised
	self.pressure = ATMOSPHERE
	self.heatupRate = 0 -- K/s, filtered
	self.stress = 0 -- accumulated thermal-shock damage, feeds the wear model
	self.steamOut = 0 -- kg/s leaving the drums, set by the secondary side
	self.cooldownOn = false
	self.loops = {}
	self.pumps = {}
	self.cond = { pressure = { ATMOSPHERE, ATMOSPHERE }, inletEnthalpy = { 0, 0 }, flow = { 0, 0 } }

	local rhoHot = Steam.rhoLiquid(Steam.tsat(P.NOMINAL_PRESSURE))
	for l = 1, P.N_LOOPS do
		local voidRef = (self.core.designVoidVolume and self.core.designVoidVolume[l]) or 30
		local vRef = P.DRUM_NOMINAL_MASS / rhoHot + voidRef
		self.loops[l] = {
			vRef = vRef,
			-- Start cold with the drums a little under the normal level.
			mass = (vRef - 0.15 * P.DRUM_AREA) * Steam.rhoLiquid(self.temp),
			level = 0,
			flow = 0,
			dp = 0,
			inletEnthalpy = Steam.hLiquid(self.temp),
			inletTemp = self.temp,
			subcool = 0,
			feed = 0, -- kg/s feedwater in, set by the secondary side
			feedEnthalpy = Steam.hLiquid(30),
			eccs = 0, -- kg/s emergency injection
			steam = 0,
			blowdown = 0, -- valve position 0..1
			blowdownDir = 0,
			letdownAuto = false,
			leak = 0, -- kg/s from a pipe break in the compartments
			levelBias = 0, -- mm error on the narrow-range transmitter (instrument fault)
			indicated = 0,
			kc = 1,
			ncHead = 0,
			npsh = 1,
		}
		self.pumps[l] = {}
		for i = 1, P.PUMPS_PER_LOOP do
			self.pumps[l][i] = {
				on = false,
				speed = 0,
				valve = 1, -- throttles stand open in shutdown so the core can thermosiphon
				valveDir = 0,
				bus = PUMP_BUS[i],
				failed = false,
				repair = 0,
				wear = 0,
				cav = 0,
				flow = 0,
				power = 0,
				overload = 0,
				name = string.format("MCP-%d%d", l, i),
			}
		end
	end
	self:calibrate()

	local c = plant.cmd
	for l = 1, P.N_LOOPS do
		for i = 1, P.PUMPS_PER_LOOP do
			local pump = self.pumps[l][i]
			local key = string.format("mcp.%d%d", l, i)
			c[key .. ".sw"] = function(v)
				if v >= 0.5 then
					self:startPump(pump)
				else
					self:stopPump(pump, "stopped by operator")
				end
			end
			c[key .. ".valve"] = function(v)
				pump.valveDir = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
			end
		end
		local loop = self.loops[l]
		c[string.format("loop.%d.blowdown", l)] = function(v)
			loop.blowdownDir = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
		end
		c[string.format("loop.%d.letdownAuto", l)] = function(v)
			loop.letdownAuto = v >= 0.5
		end
	end
	c["pri.cooldown"] = function(v)
		self.cooldownOn = v >= 0.5
	end
	return self
end

-- Tie the channel hydraulic weights to the design pressure drop.
function Primary.calibrate(self)
	for l = 1, P.N_LOOPS do
		local y = (self.core.designConductance and self.core.designConductance[l]) or self.core.loopConductance[l]
		if y <= 0 then
			y = 1
		end
		self.loops[l].kc = P.LOOP_RATED_FLOW / (y * math.sqrt(CORE_DP_NOMINAL))
	end
end

function Primary.startPump(self, pump)
	if pump.on then
		return
	end
	if pump.failed then
		self.plant:log(pump.name .. " will not start: out of service")
		return
	end
	if not self.plant:busLive(pump.bus) then
		self.plant:log(pump.name .. " will not start: bus " .. pump.bus .. " dead")
		return
	end
	pump.on = true
	pump.overload = 0
	if pump.valve > 0.25 then
		-- Starting against an open throttle is hard on the motor.
		pump.wear += 0.03
	end
	self.plant:log(pump.name .. " started")
end

function Primary.stopPump(self, pump, why: string)
	if pump.on then
		pump.on = false
		self.plant:log(pump.name .. " " .. why)
		if string.sub(why, 1, 7) == "tripped" then
			self.plant:raise("mcp.trip")
		end
	end
end

function Primary.runningCount(self, l: number): number
	local n = 0
	for _, pump in self.pumps[l] do
		if pump.on and pump.speed > 0.5 then
			n += 1
		end
	end
	return n
end

-- Pump speeds, loop flows and the inlet conditions the core will see.
function Primary.hydraulics(self, dt: number)
	local plant = self.plant
	local core = self.core
	local tsat, hf, _, rhof, rhog = Steam.sat(self.pressure)
	local hBulk = Steam.hLiquid(self.temp)
	for l = 1, P.N_LOOPS do
		local loop = self.loops[l]
		local pumps = self.pumps[l]

		-- Natural circulation head from the density difference between the
		-- downcomers and the channels plus risers.
		local rhoDown = Steam.rhoLiquid(math.min(loop.inletTemp, self.temp))
		local x = Util.clamp(core.loopExitQuality[l], 0, 1)
		local rhoCore = core.loopDensity[l]
		local rhoRiser = rhoCore
		if x > 0 then
			local slip = 1 + 0.12 * math.sqrt(rhof / rhog)
			local alpha = x / (x + (1 - x) * slip * rhog / rhof)
			rhoRiser = alpha * rhog + (1 - alpha) * rhof
		end
		local nc = 9.81e-6 * ((rhoDown - rhoCore) * 7 + (rhoDown - rhoRiser) * 18)
		if nc < 0 then
			nc = 0
		end
		loop.ncHead = nc

		local maxHead = 0
		for _, pump in pumps do
			local live = plant:busLive(pump.bus)
			if pump.on and not live then
				self:stopPump(pump, "tripped: bus undervoltage")
			end
			if pump.repair > 0 then
				pump.repair -= dt
				if pump.repair <= 0 then
					pump.failed = false
					plant:log(pump.name .. " returned to service")
				end
			end
			if pump.on then
				local target = plant:busFrequency(pump.bus) / Config.GRID_HZ
				pump.speed += (target - pump.speed) * (1 - math.exp(-dt / 4))
			else
				-- Coastdown on the flywheel.
				local s = pump.speed
				s -= (s * s / P.PUMP_COASTDOWN + 0.004) * dt
				pump.speed = math.max(s, 0)
			end
			pump.valve = Util.clamp(pump.valve + pump.valveDir * 0.05 * dt, 0, 1)
			local head = P.PUMP_SHUTOFF_HEAD * pump.speed * pump.speed * (1 - 0.5 * pump.cav)
			pump._head = head
			-- A stopped rotor is a much bigger obstruction than a turning one.
			local a = if pump.speed < 0.05 then PUMP_A * 4 else PUMP_A
			pump._res = if pump.valve < 0.01 then math.huge else a + VALVE_K * (1 / (pump.valve * pump.valve) - 1)
			if head > maxHead then
				maxHead = head
			end
		end

		local y = core.loopConductance[l]
		local rCore = if y > 0 then 1 / ((loop.kc * y) ^ 2) else math.huge
		local rSys = rCore + PIPE_R
		local function imbalance(dp: number): (number, number)
			local supply = 0
			for _, pump in pumps do
				local h = pump._head - dp
				if h > 0 and pump._res < math.huge then
					supply += math.sqrt(h / pump._res)
				end
			end
			local demand = if dp + nc > 0 then math.sqrt((dp + nc) / rSys) else 0
			return supply - demand, supply
		end
		local lo, hi = -nc, maxHead + 1e-6
		local flow = 0
		for _ = 1, 28 do
			local mid = 0.5 * (lo + hi)
			local f, supply = imbalance(mid)
			flow = supply
			if f > 0 then
				lo = mid
			else
				hi = mid
			end
		end
		local dp = 0.5 * (lo + hi)
		loop.flow = flow
		loop.dp = math.max(dp, 0)

		-- Feedwater mixes with the saturated water coming down from the drums.
		local hin = hBulk
		if flow > 1 then
			local fwFrac = math.min(1, loop.feed / flow)
			hin -= fwFrac * (hBulk - loop.feedEnthalpy)
			local eccsFrac = math.min(1, loop.eccs / flow)
			hin -= eccsFrac * (hBulk - Steam.hLiquid(40))
		end
		local tSuction = Steam.tLiquid(hin)
		local psatSuction = Steam.psat(tSuction)
		local npsh = self.pressure + P.DRUM_ELEVATION_HEAD - psatSuction - 0.15 * (flow / P.LOOP_RATED_FLOW) ^ 2
		-- A badly low drum level starves the suction as well.
		if loop.level < -900 then
			npsh -= 0.0004 * (-900 - loop.level)
		end
		loop.npsh = npsh

		local pumpHeat = 0
		for _, pump in pumps do
			local q = 0
			local h = pump._head - dp
			if h > 0 and pump._res < math.huge then
				q = math.sqrt(h / pump._res)
			end
			pump.flow = q
			local qr = q / P.PUMP_RATED_FLOW
			local margin = npsh - 0.11 * qr * qr
			local severity = if margin < 0 and pump.speed > 0.3 then Util.clamp(-margin / 0.05, 0, 1) else 0
			pump.cav = Util.lag(pump.cav, severity, dt, 2)
			if pump.cav > 0.1 then
				pump.wear += pump.cav * dt * 4e-4
			end
			local w = pump.speed
			pump.power = if pump.on then P.PUMP_MOTOR_MW * 1e6 * w * w * (0.45 * w + 0.55 * qr) else 0
			pumpHeat += 0.9 * pump.power
			-- Sustained overload trips the motor.
			if pump.power > 1.22 * P.PUMP_MOTOR_MW * 1e6 then
				pump.overload += dt
				if pump.overload > 12 then
					self:stopPump(pump, "tripped: motor overload")
				end
			else
				pump.overload = math.max(0, pump.overload - dt)
			end
			if pump.on and loop.level < -1300 then
				self:stopPump(pump, "tripped: drum level low-low")
			end
		end
		loop.pumpHeat = pumpHeat
		if flow > 1 then
			-- (Capped: a pump spinning up against almost no flow would
			-- otherwise appear to flash the water in its casing.)
			hin += math.min(pumpHeat / flow, 2.0e4)
		end
		hin = math.max(hin, Steam.hLiquid(15))
		-- A change in feedwater takes several seconds to work its way down
		-- the downcomers and through the pumps to the channel inlets.
		if loop.inletLag then
			hin = Util.lag(loop.inletLag, hin, dt, 7)
		end
		loop.inletLag = hin
		loop.inletEnthalpy = hin
		loop.inletTemp = Steam.tLiquid(math.min(hin, hf))
		loop.subcool = math.max(0, tsat - loop.inletTemp)
		-- The channels sit under the static head of the risers, so they
		-- boil at a slightly higher temperature than the drums.
		self.cond.pressure[l] = self.pressure + P.RISER_HEAD
		self.cond.inletEnthalpy[l] = math.min(hin, hf + 1e5)
		self.cond.flow[l] = flow
	end
	return self.cond
end

-- Energy and mass balance: pressure/temperature and the drum levels.
function Primary.thermal(self, dt: number)
	local core = self.core
	local _, _, hfg = Steam.sat(self.pressure)
	local hBulk = Steam.hLiquid(self.temp)
	local qIn = core.loopHeat[1] + core.loopHeat[2]
	local qOut = self.steamOut * hfg
	local genTotal = core.loopSteam[1] + core.loopSteam[2]
	for l = 1, P.N_LOOPS do
		local loop = self.loops[l]
		qIn += loop.pumpHeat or 0
		qOut += loop.feed * math.max(0, hBulk - loop.feedEnthalpy)
		qOut += loop.eccs * math.max(0, hBulk - Steam.hLiquid(40))
	end
	-- Standing losses, and the cooldown heat exchangers when in service.
	qOut += 2.5e6 * (self.temp - 30) / 250
	if self.cooldownOn then
		qOut += 90e6 * math.max(0, self.temp - 30) / 250
	end
	local dT = (qIn - qOut) / P.THERMAL_MASS * dt
	self.temp = Util.clamp(self.temp + dT, 15, 360)
	self.pressure = math.max(ATMOSPHERE, Steam.psat(self.temp))
	local rate = dT / dt
	self.heatupRate = Util.lag(self.heatupRate, rate, dt, 15)
	local over = math.abs(self.heatupRate) / P.HEATUP_LIMIT - 1
	if over > 0 then
		self.stress += over * dt / 600
	end

	local rho = Steam.rhoLiquid(self.temp)
	for l = 1, P.N_LOOPS do
		local loop = self.loops[l]
		local share = if genTotal > 1 then core.loopSteam[l] / genTotal else 0.5
		loop.steam = self.steamOut * share
		loop.blowdown = Util.clamp(loop.blowdown + loop.blowdownDir * 0.1 * dt, 0, 1)
		local letdown = loop.blowdown * 30
		if loop.letdownAuto and loop.level > 60 then
			letdown = math.max(letdown, Util.clamp((loop.level - 60) / 100, 0, 1) * 30)
		end
		loop.letdown = letdown
		local tubeLeak = core.loopLeak[l]
		loop.mass += (loop.feed + loop.eccs - loop.steam - letdown - tubeLeak - loop.leak) * dt
		if loop.mass < 1000 then
			loop.mass = 1000
		end
		local volume = loop.mass / rho + core.loopVoidVolume[l]
		loop.level = Util.clamp((volume - loop.vRef) / P.DRUM_AREA * 1000, -2000, 1500)
		loop.indicated = loop.level + loop.levelBias
	end
end

function Primary.publish(self, S)
	S["pri.press"] = self.pressure
	S["pri.temp"] = self.temp
	S["pri.heatup"] = self.heatupRate * 60
	S["pri.cooldown"] = if self.cooldownOn then 1 else 0
	S["pri.stress"] = self.stress
	local total = 0
	for l = 1, P.N_LOOPS do
		local loop = self.loops[l]
		local k = "loop." .. l
		S[k .. ".flow"] = loop.flow * 3.6
		S[k .. ".level"] = loop.indicated
		S[k .. ".levelWide"] = loop.level
		S[k .. ".dp"] = loop.dp
		S[k .. ".subcool"] = loop.subcool
		S[k .. ".tin"] = loop.inletTemp
		S[k .. ".steam"] = loop.steam * 3.6
		S[k .. ".feed"] = loop.feed * 3.6
		S[k .. ".blowdown"] = loop.blowdown * 100
		S[k .. ".letdownAuto"] = if loop.letdownAuto then 1 else 0
		S[k .. ".npsh"] = loop.npsh
		S[k .. ".running"] = self:runningCount(l)
		total += loop.flow
		local rho = Steam.rhoLiquid(loop.inletTemp)
		for i, pump in self.pumps[l] do
			local pk = string.format("mcp.%d%d", l, i)
			S[pk .. ".run"] = if pump.on then 1 else 0
			S[pk .. ".flow"] = pump.flow / rho * 3600
			S[pk .. ".speed"] = pump.speed * 100
			S[pk .. ".amps"] = pump.power / (P.PUMP_MOTOR_MW * 1e6) * 100
			-- Motor current in amperes: a 6 kV induction motor at 0.88 power factor.
			S[pk .. ".current"] = pump.power / (math.sqrt(3) * 6000 * 0.88)
			S[pk .. ".valve"] = pump.valve * 100
			S[pk .. ".cav"] = if pump.cav > 0.15 then 1 else 0
			S[pk .. ".fail"] = if pump.failed then 1 else 0
		end
	end
	S["pri.flow"] = total * 3.6
end

return Primary
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Protection</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Emergency protection logic. Five levels, as on the unit:
--
--   AZ-5  full shutdown: every top-entry rod driven in, latched
--   AZ-4  all rods inserted for as long as the signal lasts
--   AZ-3  runback to 20% power
--   AZ-2  runback to 50% power
--   AZ-1  runback to 60% power
--
-- Several trips can be bypassed from the control room with key switches,
-- exactly as the pre-1986 plant allowed.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Config = require(Shared.Config)

local Protection = {}
Protection.__index = Protection

local Pr = Config.Protection

-- id, level, bypass key (or nil when the trip cannot be bypassed), description
Protection.SIGNALS = {
	{ id = "manual", level = 5, text = "Manual AZ-5" },
	{ id = "overpower", level = 5, text = "Neutron power high" },
	{ id = "period", level = 5, bypass = "period", text = "Reactor period short" },
	{ id = "press", level = 5, bypass = "press", text = "Drum pressure high" },
	{ id = "levelLow", level = 5, bypass = "level", text = "Drum level low" },
	{ id = "levelHigh", level = 5, bypass = "level", text = "Drum level high" },
	{ id = "feed", level = 5, bypass = "feed", text = "Feedwater flow low" },
	{ id = "mcp", level = 5, bypass = "mcp", text = "Main circulation flow low" },
	{ id = "turbines", level = 5, bypass = "turbines", text = "Both turbines tripped" },
	{ id = "rs", level = 5, text = "Reactor space pressure high" },
	{ id = "cps", level = 5, bypass = "cps", text = "Rod cooling lost" },
	{ id = "power", level = 5, text = "Loss of auxiliary power" },
	{ id = "eccs", level = 5, text = "ECCS actuation" },
	{ id = "period4", level = 4, bypass = "period", text = "Reactor period short (warning band)" },
	{ id = "deviation", level = 4, text = "Power above regulator setpoint" },
	{ id = "loadReject", level = 3, bypass = "turbines", text = "No generator on the grid" },
	{ id = "oneTurbine", level = 2, bypass = "turbines", text = "One turbine out" },
	{ id = "oneMcp", level = 1, bypass = "mcp", text = "Main circulation pump out" },
	{ id = "feedPump", level = 1, bypass = "feed", text = "Feedwater pump out" },
}

Protection.BYPASS_KEYS = { "period", "press", "level", "feed", "mcp", "turbines", "cps" }

function Protection.new(plant)
	local self = setmetatable({}, Protection)
	self.plant = plant
	self.active = {} -- condition present right now
	self.latched = {} -- has fired since the last reset
	self.bypass = {}
	self.timer = {}
	for _, sig in Protection.SIGNALS do
		self.active[sig.id] = false
		self.latched[sig.id] = false
		self.timer[sig.id] = 0
	end
	for _, key in Protection.BYPASS_KEYS do
		self.bypass[key] = false
	end
	self.manual = false
	self.firstOut = 0 -- index of the signal that started the present AZ-5
	self.scrams = 0

	local c = plant.cmd
	c["az5.button"] = function()
		self.manual = true
	end
	c["az.reset"] = function()
		self:reset()
	end
	for _, key in Protection.BYPASS_KEYS do
		c["prot.bypass." .. key] = function(v)
			local on = v >= 0.5
			if on ~= self.bypass[key] then
				self.bypass[key] = on
				plant:log(string.format("Protection %s: %s", if on then "BYPASSED" else "restored", key))
			end
		end
	end
	return self
end

function Protection.reset(self)
	local plant = self.plant
	for _, sig in Protection.SIGNALS do
		if sig.level == 5 and self.active[sig.id] and not (sig.bypass and self.bypass[sig.bypass]) then
			plant:log("Protection will not reset: " .. sig.text)
			return
		end
	end
	for _, sig in Protection.SIGNALS do
		self.latched[sig.id] = false
	end
	self.firstOut = 0
	plant.rods:resetProtection()
	plant:log("Protection reset")
end

-- True once a condition has held for `seconds`.
local function held(self, id: string, cond: boolean, seconds: number, dt: number): boolean
	if cond then
		self.timer[id] += dt
	else
		self.timer[id] = 0
	end
	return self.timer[id] >= seconds
end

function Protection.step(self, dt: number)
	local plant = self.plant
	local core, pri, sec, elec, rods, safety = plant.core, plant.primary, plant.secondary, plant.elec, plant.rods, plant.safety
	local power = core.fission / Config.NOMINAL_THERMAL
	local period = core.period
	local a = self.active

	local lowLevel = math.min(pri.loops[1].level, pri.loops[2].level)
	local highLevel = math.max(pri.loops[1].level, pri.loops[2].level)
	local minRunning = math.min(pri:runningCount(1), pri:runningCount(2))
	local minFlow = math.min(pri.loops[1].flow, pri.loops[2].flow) / Config.Primary.LOOP_RATED_FLOW
	local tripped = (if sec.turbines[1].tripped then 1 else 0) + (if sec.turbines[2].tripped then 1 else 0)
	local onGrid = (if elec.gens[1].mode == "grid" then 1 else 0) + (if elec.gens[2].mode == "grid" then 1 else 0)
	local feedRunning = 0
	for _, pump in sec.feedPumps do
		if pump.on then
			feedRunning += 1
		end
	end
	local deadBuses = 0
	for _, name in { "1A", "1B", "2A", "2B" } do
		if not elec.buses[name].live then
			deadBuses += 1
		end
	end
	local startupRange = power > 3e-8 and power < 0.10

	a.manual = self.manual
	self.manual = false
	a.overpower = power > Pr.OVERPOWER
	a.period = startupRange and period > 0 and period < Pr.PERIOD_TRIP
	a.press = pri.pressure > Pr.PRESSURE_HIGH
	a.levelLow = held(self, "levelLow", lowLevel < Pr.LEVEL_LOW, 2, dt)
	a.levelHigh = held(self, "levelHigh", highLevel > Pr.LEVEL_HIGH, 2, dt)
	a.feed = held(self, "feed", power > 0.30 and sec.feedTotal < 0.5 * sec.steamTotal, 10, dt)
	a.mcp = (power > 0.05 and minRunning < 2) or (power > 0.50 and minFlow < 0.55)
	a.turbines = power > 0.25 and tripped == 2
	a.rs = safety.rsPress > 5
	a.cps = held(self, "cps", safety.cpsFlow < 0.5 and power > 0.01, 15, dt) or safety.cpsTank < 0.6
	a.power = held(self, "power", deadBuses >= 2, 1.5, dt)
	a.eccs = safety.eccsActive
	a.period4 = startupRange and period > 0 and period < 15 and not a.period
	-- (Not during a runback, when the setpoint has just been stepped down on purpose.)
	a.deviation = (rods.arMode > 0 or rods.larOn) and power > 0.10 and power - rods.setpoint > 0.07 and (rods.runback == 0 or rods.runbackDone)
	a.loadReject = power > 0.25 and onGrid == 0 and tripped < 2
	a.oneTurbine = power > 0.52 and onGrid == 1
	a.oneMcp = power > 0.62 and minRunning < 3
	a.feedPump = power > 0.62 and feedRunning < 3

	local az4 = false
	for index, sig in Protection.SIGNALS do
		local on = a[sig.id] and not (sig.bypass ~= nil and self.bypass[sig.bypass])
		if on then
			if not self.latched[sig.id] then
				self.latched[sig.id] = true
				plant:log(string.format("AZ-%d: %s", sig.level, sig.text))
				if sig.level == 5 and not rods.az5 then
					self.firstOut = index
					self.scrams += 1
				end
			end
			if sig.level == 5 then
				rods:tripAz5()
			elseif sig.level == 4 then
				az4 = true
			else
				rods:tripRunback(sig.level)
			end
		end
	end
	rods:setAz4(az4)
end

function Protection.publish(self, S)
	local anyBypass = 0
	for _, key in Protection.BYPASS_KEYS do
		local on = self.bypass[key]
		S["prot.bypass." .. key] = if on then 1 else 0
		if on then
			anyBypass = 1
		end
	end
	S["prot.anyBypass"] = anyBypass
	S["prot.firstOut"] = self.firstOut
	for _, sig in Protection.SIGNALS do
		-- 0 normal, 1 latched but cleared, 2 present now
		S["prot." .. sig.id] = if self.active[sig.id] then 2 elseif self.latched[sig.id] then 1 else 0
	end
end

return Protection
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Rods</string>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- Control and protection system: rod drives, manual selection and motion,
-- the automatic regulators (AR-1/2/3 and the twelve local regulators), the
-- AZ protection actions and the clutch release key (KOM).
--
-- Pre-1986 behaviour is kept on purpose: rods travel at 0.4 m/s whatever
-- the emergency, the shortened bottom-entry rods (USP) do not move on AZ-5,
-- and the regulator setpoint does not follow the reactor when a regulator
-- is switched off, so engaging one with a mismatch drags the power with it.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local R = Config.Rods

local Rods = {}
Rods.__index = Rods

local RUNBACK_TARGET = { 0.60, 0.50, 0.20 } -- AZ-1, AZ-2, AZ-3

function Rods.new(plant)
	local self = setmetatable({}, Rods)
	local core = plant.core
	local L = core.layout
	self.plant = plant
	self.core = core
	self.NR = core.NR
	self.kind = {}
	self.group = {}
	self.label = {}
	self.stroke = {}
	self.selected = table.create(self.NR, false)
	self.selCount = 0
	self.stuck = table.create(self.NR, false)
	self.velocity = table.create(self.NR, 0)
	self.byKind = { RR = {}, AR = {}, LAR = {}, AZ = {}, USP = {} }
	self.arGroups = { {}, {}, {} }
	self.larRod = table.create(12, 0)
	for i, rod in L.rods do
		self.kind[i] = rod.kind
		self.group[i] = rod.group
		self.label[i] = rod.label
		self.stroke[i] = if rod.kind == "USP" then R.USP_STROKE else R.STROKE
		table.insert(self.byKind[rod.kind], i)
		if rod.kind == "AR" then
			table.insert(self.arGroups[rod.group], i)
		elseif rod.kind == "LAR" then
			self.larRod[rod.group] = i
		end
	end

	self.manual = 0 -- -1 withdraw, +1 insert
	self.quadSelect = false
	self.az5 = false
	self.az4 = false
	self.runback = 0 -- 0 none, 1..3 = AZ-1..AZ-3 latched
	self.runbackDone = true
	self.kom = false
	self.drivePower = true
	self.arMode = 0 -- 0 off, 1..3
	self.setpoint = 0 -- fraction of nominal power
	self.setpointDir = 0
	self.arError = 0
	self.arAtLimit = false
	self.larOn = false
	self.larAtLimit = false
	self.zoneRef = table.create(12, 1 / 12)
	self.zoneAbs = table.create(12, 0)
	self.blockBypass = false
	self.azInterlockBypass = false
	self.rodBlock = 0 -- 0 none, otherwise a reason code
	self.azRodsOut = false
	self.allIn = true
	self.autoSeconds = 0 -- time spent under automatic regulation (for scoring)

	local c = plant.cmd
	c["rod.select"] = function(v)
		self:toggleSelect(math.floor(v))
	end
	c["rod.clear"] = function()
		self:clearSelection()
	end
	c["rod.group"] = function(v)
		local names = { "AZ", "USP", "AR", "LAR" }
		self:selectKind(names[math.floor(v)] or "")
	end
	c["rod.quad"] = function(v)
		self.quadSelect = v >= 0.5
	end
	c["rod.move"] = function(v)
		self.manual = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
	end
	c["rod.blockBypass"] = function(v)
		self.blockBypass = v >= 0.5
	end
	c["rod.azInterlockBypass"] = function(v)
		self.azInterlockBypass = v >= 0.5
	end
	c["kom"] = function(v)
		local on = v >= 0.5
		if on and not self.kom then
			plant:log("KOM: rod drive clutches de-energised")
		end
		self.kom = on
	end
	c["ar.mode"] = function(v)
		local mode = Util.clamp(math.floor(v), 0, 3)
		if mode ~= self.arMode then
			self.arMode = mode
			plant:log(if mode == 0 then "Automatic regulator OFF" else string.format("Automatic regulator AR-%d ON", mode))
		end
	end
	c["ar.sp"] = function(v)
		self.setpointDir = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
	end
	c["lar.sw"] = function(v)
		local on = v >= 0.5
		if on ~= self.larOn then
			self.larOn = on
			plant:log(if on then "Local automatic regulators ON" else "Local automatic regulators OFF")
		end
	end
	return self
end

function Rods.clearSelection(self)
	for i = 1, self.NR do
		self.selected[i] = false
	end
	self.selCount = 0
end

local function addSel(self, i: number)
	if not self.selected[i] then
		self.selected[i] = true
		self.selCount += 1
	end
end

-- The three other rods of the same kind closest to this rod's position
-- turned through 90, 180 and 270 degrees about the core centre.
function Rods.quadPartners(self, i: number): { number }
	local L = self.core.layout
	local cell = L.rods[i].cell
	local x, y = L.cellX[cell], L.cellY[cell]
	local out = {}
	local used = { [i] = true }
	for _, t in { { -y, x }, { -x, -y }, { y, -x } } do
		local best, bestD = 0, math.huge
		for _, j in self.byKind[self.kind[i]] do
			if not used[j] then
				local c = L.rods[j].cell
				local dx, dy = L.cellX[c] - t[1], L.cellY[c] - t[2]
				local d = dx * dx + dy * dy
				if d < bestD then
					best, bestD = j, d
				end
			end
		end
		if best > 0 and bestD <= 8 then
			used[best] = true
			table.insert(out, best)
		end
	end
	return out
end

function Rods.toggleSelect(self, i: number)
	if i < 1 or i > self.NR then
		return
	end
	local members = { i }
	if self.quadSelect then
		for _, j in self:quadPartners(i) do
			table.insert(members, j)
		end
	end
	if self.selected[i] then
		for _, j in members do
			if self.selected[j] then
				self.selected[j] = false
				self.selCount -= 1
			end
		end
		return
	end
	for _, j in members do
		if self.selCount < R.MAX_SELECTED then
			addSel(self, j)
		end
	end
end

-- Group buttons select a whole family at once (used to cock the shutdown
-- rods or to move the shortened rods together).
function Rods.selectKind(self, kind: string)
	local list = self.byKind[kind]
	if not list then
		return
	end
	self:clearSelection()
	for _, i in list do
		addSel(self, i)
	end
end

function Rods.isAuto(self, i: number): boolean
	local k = self.kind[i]
	if k == "AR" then
		return self.arMode == self.group[i]
	elseif k == "LAR" then
		return self.larOn
	end
	return false
end

-- Protection actions, called by the protection logic.
function Rods.tripAz5(self)
	self.az5 = true
end

function Rods.setAz4(self, active: boolean)
	self.az4 = active
end

function Rods.tripRunback(self, level: number)
	if level > self.runback then
		self.runback = level
		self.runbackDone = false
		self.setpoint = math.min(self.setpoint, RUNBACK_TARGET[level])
	end
end

function Rods.resetProtection(self)
	self.az5 = false
	self.runback = 0
	self.runbackDone = true
end

function Rods.jam(self, i: number)
	self.stuck[i] = true
end

function Rods.jamAll(self)
	for i = 1, self.NR do
		self.stuck[i] = true
	end
end

function Rods.step(self, dt: number)
	local core = self.core
	local NR = self.NR
	local power = core.fission / Config.NOMINAL_THERMAL
	local pos = core.rodPos

	-- Regulator setpoint device: about 15% of nominal per minute, slower
	-- in the low range where a small change is a big ratio.
	if self.setpointDir ~= 0 then
		local rate = if self.setpoint < 0.05 then math.max(self.setpoint, 0.0005) * 0.06 else 0.0025
		self.setpoint = Util.clamp(self.setpoint + self.setpointDir * rate * dt, 0, 1.10)
	end

	-- Zone powers for the local regulators.
	local zoneAbs = self.zoneAbs
	for z = 1, 12 do
		zoneAbs[z] = 0
	end
	local fuelZone, chPower = core.fuelZone, core.power
	for f = 1, core.NF do
		zoneAbs[fuelZone[f]] += chPower[f]
	end
	local nominal = Config.NOMINAL_THERMAL

	-- Automatic regulator demand, metres per second (+ = insert).
	local arSpeed = 0
	self.arError = power - self.setpoint
	if self.arMode == 3 then
		local sp = math.max(self.setpoint, 1e-6)
		local e = (power - sp) / sp
		if math.abs(e) > 0.02 then
			arSpeed = Util.clamp(e * 2.0, -1, 1) * R.SPEED_AUTO
		end
	elseif self.arMode > 0 then
		local e = power - self.setpoint
		if math.abs(e) > 0.003 then
			arSpeed = Util.clamp(e * 50, -1, 1) * R.SPEED_AUTO
		end
	end
	-- The regulators are period-limited: they stop pulling when power is
	-- already climbing quickly and push in if it climbs faster still.
	local period = core.period
	if period > 0 and power < 0.10 then
		if period < 22 then
			arSpeed = R.SPEED_AUTO
		elseif period < 35 and arSpeed < 0 then
			arSpeed = 0
		end
	end
	-- The local regulators need a few percent of power to see anything.
	if self.larOn and power < 0.06 then
		self.larOn = false
		self.plant:log("Local automatic regulators dropped out: power below range")
		self.plant:raise("lar.dropout")
	end

	local gravity = self.kom or not self.drivePower
	local runbackActive = false
	if self.runback > 0 and not self.runbackDone then
		if power > RUNBACK_TARGET[self.runback] + 0.01 then
			runbackActive = true
		else
			self.runbackDone = true
		end
	end

	-- Withdrawal permissives for manual motion.
	local block = 0
	if self.az5 or self.az4 or runbackActive then
		block = 1
	elseif gravity then
		block = 2
	elseif not self.blockBypass and core.period > 0 and core.period < Config.Protection.PERIOD_ALARM then
		block = 3
	elseif not self.blockBypass and power > 1.05 then
		block = 4
	end
	local azOut = true
	for _, i in self.byKind.AZ do
		if pos[i] > 0.05 then
			azOut = false
			break
		end
	end
	self.azRodsOut = azOut

	local arLimit, larLimit = false, false
	local allIn = true
	local manual = self.manual
	local anyAuto = false
	for i = 1, NR do
		local kind = self.kind[i]
		local usp = kind == "USP"
		local v = 0
		if self.stuck[i] then
			v = 0
		elseif gravity and not usp then
			v = R.SPEED_GRAVITY
		elseif self.az5 and not usp then
			v = R.SPEED_AZ
		elseif self.az4 and not usp then
			v = R.SPEED_MANUAL
		elseif runbackActive and (kind == "AR" or kind == "LAR") then
			v = R.SPEED_MANUAL
		elseif kind == "AR" and self.arMode == self.group[i] then
			v = arSpeed
			anyAuto = true
			if (pos[i] < 0.8 and v < 0) or (pos[i] > 5.7 and v > 0) then
				arLimit = true
			end
			if pos[i] < 0.5 and v < 0 then
				v = 0
			elseif pos[i] > 6.0 and v > 0 then
				v = 0
			end
		elseif kind == "LAR" and self.larOn then
			local z = self.group[i]
			local ref = self.zoneRef[z] * math.max(self.setpoint, 0.02) * nominal
			local e = (zoneAbs[z] - ref) / ref
			anyAuto = true
			if math.abs(e) > 0.015 then
				v = Util.clamp(e * 3, -1, 1) * R.SPEED_AUTO
			end
			if (pos[i] < 0.8 and v < 0) or (pos[i] > 5.7 and v > 0) then
				larLimit = true
			end
			if pos[i] < 0.5 and v < 0 then
				v = 0
			elseif pos[i] > 6.0 and v > 0 then
				v = 0
			end
		elseif self.selected[i] and manual ~= 0 then
			if manual > 0 then
				v = R.SPEED_MANUAL
			else
				local blocked = block ~= 0
				if not blocked and kind ~= "AZ" and not usp and not azOut and not self.azInterlockBypass then
					blocked = true
					block = 5
				end
				if not blocked then
					v = -R.SPEED_MANUAL
				end
			end
		end
		-- USP rods are driven from below: "insert" raises them into the core.
		self.velocity[i] = v
		if v ~= 0 then
			local x = Util.clamp(pos[i] + v * dt, 0, self.stroke[i])
			if x ~= pos[i] then
				core:setRodPosition(i, x)
			end
		end
		if not usp and pos[i] < self.stroke[i] - 0.02 then
			allIn = false
		end
	end
	self.rodBlock = block
	self.arAtLimit = arLimit
	self.larAtLimit = larLimit
	self.allIn = allIn
	if anyAuto then
		self.autoSeconds += dt
	end
end

-- Capture the present zone split as the local regulators' reference.
function Rods.captureZoneReference(self)
	local total = 0
	for z = 1, 12 do
		total += self.core.zonePower[z]
	end
	if total > 0 then
		for z = 1, 12 do
			self.zoneRef[z] = self.core.zonePower[z] / total
		end
	end
end

function Rods.groupMean(self, list: { number }): number
	local s = 0
	for _, i in list do
		s += self.core.rodPos[i]
	end
	return if #list > 0 then s / #list else 0
end

function Rods.publish(self, S)
	local core = self.core
	S["rod.selCount"] = self.selCount
	local selPos, n, first = 0, 0, 0
	for i = 1, self.NR do
		if self.selected[i] then
			selPos += core.rodPos[i]
			n += 1
			if first == 0 then
				first = i
			end
		end
	end
	S["rod.selPos"] = if n > 0 then selPos / n else 0
	S["rod.selFirst"] = first
	S["rod.moving"] = self.manual
	S["rod.block"] = self.rodBlock
	S["rod.blockBypass"] = if self.blockBypass then 1 else 0
	S["rod.azInterlockBypass"] = if self.azInterlockBypass then 1 else 0
	S["rod.quad"] = if self.quadSelect then 1 else 0
	S["rod.azOut"] = if self.azRodsOut then 1 else 0
	S["rod.allIn"] = if self.allIn then 1 else 0
	S["rod.meanRR"] = self:groupMean(self.byKind.RR)
	S["rod.meanAZ"] = self:groupMean(self.byKind.AZ)
	S["rod.meanUSP"] = self:groupMean(self.byKind.USP)
	S["rod.meanLAR"] = self:groupMean(self.byKind.LAR)
	for g = 1, 3 do
		S["ar.pos" .. g] = self:groupMean(self.arGroups[g])
	end
	S["ar.mode"] = self.arMode
	S["ar.setpoint"] = self.setpoint * 100
	S["ar.error"] = self.arError * 100
	S["ar.limit"] = if self.arAtLimit then 1 else 0
	S["lar.on"] = if self.larOn then 1 else 0
	S["lar.limit"] = if self.larAtLimit then 1 else 0
	S["kom"] = if self.kom then 1 else 0
	S["az5.active"] = if self.az5 then 1 else 0
	S["az4.active"] = if self.az4 then 1 else 0
	S["az1.active"] = if self.runback == 1 then 1 else 0
	S["az2.active"] = if self.runback == 2 then 1 else 0
	S["az3.active"] = if self.runback == 3 then 1 else 0
	local stuck = 0
	for i = 1, self.NR do
		if self.stuck[i] then
			stuck += 1
		end
	end
	S["rod.stuck"] = stuck
end

return Rods
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Safety</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Reactor auxiliaries and safety systems: the rod-channel (CPS) cooling
-- circuit, the reactor space around the graphite stack, emergency core
-- cooling, the suppression pool and the activity monitors.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Safety = {}
Safety.__index = Safety

local LID_LIFT = 180 -- kPa gauge in the reactor space that lifts the upper plate
local RELIEF = 45 -- kg/s the relief pipes pass at 100 kPa

function Safety.new(plant)
	local self = setmetatable({}, Safety)
	self.plant = plant
	-- Rod channel cooling.
	self.cpsPumps = {
		{ name = "CPS-1", bus = "E1", on = true, failed = false, repair = 0 },
		{ name = "CPS-2", bus = "E2", on = false, failed = false, repair = 0 },
	}
	self.cpsFlow = 1
	self.cpsTank = 1 -- header tank level, 0..1
	self.cpsLeak = 0 -- fraction per second, set by faults
	self.cpsMakeup = false
	self.cpsTemp = 45
	self.cpsNoFlow = 0
	-- Reactor space.
	self.rsPress = 0
	self.activity = 1
	-- Emergency core cooling.
	self.eccsAuto = true
	self.eccsActive = false
	self.eccsAccum = 1.6e5 -- kg in the accumulators
	self.eccsPumps = {
		{ name = "ECCS-1", bus = "E1", on = false, manual = false, failed = false, repair = 0 },
		{ name = "ECCS-2", bus = "E2", on = false, manual = false, failed = false, repair = 0 },
		{ name = "ECCS-3", bus = "E3", on = false, manual = false, failed = false, repair = 0 },
	}
	self.eccsFlow = 0
	self.poolTemp = 30
	self.compartmentLeak = false

	local c = plant.cmd
	for i, pump in self.cpsPumps do
		c["cps.pump." .. i] = function(v)
			local on = v >= 0.5
			if on and not pump.on then
				if pump.failed or not plant:busLive(pump.bus) then
					plant:log(pump.name .. " will not start")
					return
				end
				pump.on = true
				plant:log(pump.name .. " started")
			elseif not on and pump.on then
				pump.on = false
				plant:log(pump.name .. " stopped")
			end
		end
	end
	c["cps.makeup"] = function(v)
		self.cpsMakeup = v >= 0.5
	end
	c["eccs.auto"] = function(v)
		local on = v >= 0.5
		if on ~= self.eccsAuto then
			self.eccsAuto = on
			plant:log(if on then "ECCS automatic actuation armed" else "ECCS AUTOMATIC ACTUATION DISABLED")
		end
	end
	c["eccs.manual"] = function()
		self:actuate("manual")
	end
	c["eccs.reset"] = function()
		if self.eccsActive then
			self.eccsActive = false
			plant:log("ECCS reset")
		end
	end
	for i, pump in self.eccsPumps do
		c["eccs.pump." .. i] = function(v)
			pump.manual = v >= 0.5
		end
	end
	return self
end

function Safety.actuate(self, why: string)
	if not self.eccsActive then
		self.eccsActive = true
		self.plant:log("ECCS ACTUATED: " .. why)
		self.plant:raise("eccs")
	end
end

function Safety.step(self, dt: number)
	local plant = self.plant
	local core = plant.core
	local pri = plant.primary
	local elec = plant.elec
	local power = core.thermalPower / Config.NOMINAL_THERMAL

	-- Rod channel cooling circuit.
	local flowing = false
	for _, pump in self.cpsPumps do
		if pump.on and not plant:busLive(pump.bus) then
			pump.on = false
			plant:log(pump.name .. " tripped: bus undervoltage")
		end
		if pump.repair > 0 then
			pump.repair -= dt
			if pump.repair <= 0 then
				pump.failed = false
			end
		end
		if pump.on then
			flowing = true
			elec:addLoad(pump.bus, 0.4e6)
		end
	end
	self.cpsFlow = Util.lag(self.cpsFlow, if flowing and self.cpsTank > 0.15 then 1 else 0, dt, 3)
	self.cpsTank = Util.clamp(self.cpsTank - self.cpsLeak * dt + (if self.cpsMakeup then 0.004 * dt else 0), 0, 1)
	-- With no flow the water in the rod channels heats up and boils away.
	if self.cpsFlow > 0.5 then
		self.cpsTemp = Util.lag(self.cpsTemp, 45 + 25 * power, dt, 20)
		self.cpsNoFlow = 0
	else
		self.cpsTemp = math.min(self.cpsTemp + (0.02 + 1.5 * power) * dt, 400)
		self.cpsNoFlow += dt
	end
	local water = Util.clamp(self.cpsTank / 0.5, 0, 1)
	if self.cpsTemp > 105 then
		water = math.min(water, Util.clamp(1 - (self.cpsTemp - 105) / 120, 0, 1))
	end
	core:setCpsWater(water)
	-- Dry, hot guide tubes distort and seize the rods in them.
	if self.cpsTemp > 250 and plant.rng:next() < 0.02 * dt then
		local i = plant.rng:int(1, core.NR)
		if not plant.rods.stuck[i] then
			plant.rods:jam(i)
			plant:log(string.format("Rod %s seized: guide tube overheated", plant.rods.label[i]))
		end
	end

	-- Reactor space: steam from burst tubes against the relief pipes.
	local inflow = core.loopLeak[1] + core.loopLeak[2]
	local equilibrium = math.min(600, 100 * (inflow / RELIEF) ^ 2)
	self.rsPress = Util.lag(self.rsPress, equilibrium, dt, 2.5)
	if self.rsPress > LID_LIFT and not core.destroyed then
		core:destroy("reactor space overpressure lifted the upper plate")
	end
	local activity = 1 + 40 * core.nFuelDamaged + 6 * core.nRuptured + (if core.maxCladTemp > Config.Core.CLAD_FAIL then 200 else 0)
	if core.destroyed then
		activity = 1e5
	end
	self.activity = Util.lag(self.activity, activity, dt, 10)

	-- Emergency core cooling.
	local low = math.min(pri.loops[1].level, pri.loops[2].level)
	if self.eccsAuto and not self.eccsActive then
		if low < -1000 then
			self:actuate("drum level low-low")
		elseif (self.rsPress > 20 or self.compartmentLeak) and low < -600 then
			self:actuate("loss of coolant")
		end
	end
	local flow = 0
	if self.eccsActive and self.eccsAccum > 0 and pri.pressure < 9 then
		local q = math.min(300, self.eccsAccum / dt)
		self.eccsAccum -= q * dt
		flow += q
	end
	for _, pump in self.eccsPumps do
		local want = pump.manual or self.eccsActive
		if want and not pump.on and not pump.failed and plant:busLive(pump.bus) then
			pump.on = true
			plant:log(pump.name .. " started")
		elseif pump.on and (not want or not plant:busLive(pump.bus)) then
			pump.on = false
		end
		if pump.on then
			elec:addLoad(pump.bus, 1.4e6)
			if pri.pressure < 8.5 then
				flow += 110
			end
		end
	end
	self.eccsFlow = flow
	-- Inject into whichever loop is lower.
	local a, b = pri.loops[1], pri.loops[2]
	if a.level < b.level - 100 then
		a.eccs, b.eccs = flow * 0.7, flow * 0.3
	elseif b.level < a.level - 100 then
		a.eccs, b.eccs = flow * 0.3, flow * 0.7
	else
		a.eccs, b.eccs = flow * 0.5, flow * 0.5
	end

	-- Suppression pool soaks up safety valve discharge.
	self.poolTemp += plant.secondary.poolHeat / (3.0e6 * 4200) * dt
	self.poolTemp += (30 - self.poolTemp) * dt / 20000
end

function Safety.publish(self, S)
	-- Motor currents in amperes, for the board ammeters.
	local cpsRunning = 0
	for _, pump in self.cpsPumps do
		if pump.on then
			cpsRunning += 1
		end
	end
	for i, pump in self.cpsPumps do
		S["cps.pump." .. i .. ".run"] = if pump.on then 1 else 0
		S["cps.pump." .. i .. ".current"] = if pump.on then 38 + 30 * math.clamp(self.cpsFlow / math.max(cpsRunning, 1), 0, 1.2) else 0
	end
	S["cps.flow"] = self.cpsFlow * 100
	S["cps.tank"] = self.cpsTank * 100
	S["cps.temp"] = self.cpsTemp
	S["cps.makeup"] = if self.cpsMakeup then 1 else 0
	S["rs.press"] = self.rsPress
	S["rad.gas"] = self.activity
	S["eccs.auto"] = if self.eccsAuto then 1 else 0
	S["eccs.active"] = if self.eccsActive then 1 else 0
	S["eccs.accum"] = self.eccsAccum / 1.6e5 * 100
	S["eccs.flow"] = self.eccsFlow * 3.6
	for i, pump in self.eccsPumps do
		S["eccs.pump." .. i .. ".run"] = if pump.on then 1 else 0
		S["eccs.pump." .. i .. ".sw"] = if pump.manual then 1 else 0
		S["eccs.pump." .. i .. ".current"] = if pump.on then 70 + 110 * math.clamp(self.eccsFlow / 230, 0, 1.1) else 0
	end
	S["pool.temp"] = self.poolTemp
end

return Safety
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Secondary</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Steam and feedwater side: the pressure regulator and turbine bypass, two
-- 400 MWe turbines with their condensers, the condensate system, the
-- deaerator, the feedwater pumps and the drum level controllers, and the
-- main safety valves.
--
-- Steam control follows the boiling-water-reactor pattern this control room
-- is styled on: one pressure regulator produces a total steam-flow demand,
-- each turbine takes the smaller of its share of that demand and its own
-- speed/load demand, and whatever is left over goes to the bypass valves.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Config = require(Shared.Config)
local Steam = require(Shared.Steam)
local Util = require(Shared.Util)

local Sec = Config.Secondary

local Secondary = {}
Secondary.__index = Secondary

local NOMINAL_P = Config.Primary.NOMINAL_PRESSURE
local RATED = Config.NOMINAL_ELECTRIC / 2 -- W per machine
local STEAM_WORK = 650e3 -- J per kg of steam at design conditions (31% gross cycle efficiency)
local ROTOR_ENERGY = 2.7e9 -- J at rated speed
local WINDAGE = 6e6 -- W at rated speed
local FEED_BUS = { "1A", "1B", "2A", "2B" }
local COND_BUS = { "1A", "2A", "1B" }
local AUX_FEED_BUS = { "E1", "E2", "E3" }
local FEED_H0 = 9.5 -- MPa shutoff head
local FEED_A = 1.2 / (Sec.FEED_PUMP_FLOW ^ 2)
local FEED_CV = 651
local CP = 4300

local function newPump(name: string, bus: string)
	return { name = name, bus = bus, on = false, failed = false, repair = 0, flow = 0 }
end

function Secondary.new(plant)
	local self = setmetatable({}, Secondary)
	self.plant = plant
	self.pressSet = 6.9
	self.pressDir = 0
	self.pressInt = 0
	self.pressAuto = true
	self.demand = 0 -- total steam demand, fraction of nominal flow
	self.steamTotal = 0
	self.auxSteam = 0
	self.turbines = {}
	for k = 1, 2 do
		self.turbines[k] = {
			index = k,
			speed = 0,
			tripped = true,
			tripCause = "not latched",
			stopOpen = false,
			iso = 0, -- main steam isolation valve
			isoDir = 0,
			cv = 0,
			loadSet = 0, -- fraction of machine rating
			loadDir = 0,
			speedTarget = 0, -- 0, 1 = 500 rpm, 2 = 1800 rpm
			speedRef = 0,
			speedInt = 0,
			steam = 0,
			shaftPower = 0,
			metal = 40,
			wear = 0,
			bow = 0,
			vib = 0,
			lubeAC = false,
			lube = 0,
			turningGear = false,
			gland = false,
			bypass = 0,
			bypassAuto = true,
			bypassDir = 0,
			bypassFlow = 0,
			-- condenser
			cw = { newPump(string.format("CW-%dA", k), if k == 1 then "1A" else "2A"), newPump(string.format("CW-%dB", k), if k == 1 then "1B" else "2B") },
			vacPump = false,
			sjae = false,
			vacBreaker = true,
			air = 0.1013,
			condP = 0.1013,
			condT = 25,
			airLeak = 1, -- multiplier, raised by faults
			hotwell = 0.6,
			bearingDamage = 0,
		}
	end
	self.safety = {}
	for g = 1, 3 do
		self.safety[g] = { open = false, manual = false, stuck = false, flow = 0 }
	end
	self.feedPumps = {}
	for i = 1, Sec.N_FEED_PUMPS do
		self.feedPumps[i] = newPump("FWP-" .. i, FEED_BUS[i])
	end
	self.auxFeed = {}
	for i = 1, Sec.N_AUX_FEED_PUMPS do
		self.auxFeed[i] = newPump("AFWP-" .. i, AUX_FEED_BUS[i])
	end
	self.auxFeedAuto = true
	self.condPumps = {}
	for i = 1, Sec.N_COND_PUMPS do
		self.condPumps[i] = newPump("CP-" .. i, COND_BUS[i])
	end
	self.feedHeader = 0
	self.feedTotal = 0
	self.level = {}
	for l = 1, 2 do
		self.level[l] = { auto = false, valve = 0, dir = 0, set = 0, int = 0, autoSeconds = 0, stuck = 0, lastFeed = 0, demand = 0 }
	end
	self.da = { mass = 1.2e5, temp = 35, peg = false, levelAuto = true, valve = 0, dir = 0, pegFlow = 0 }
	self.condFlow = 0
	self.poolHeat = 0 -- W dumped into the suppression pool this tick
	self.autoSeconds = 0

	local c = plant.cmd
	c["ehc.press"] = function(v)
		self.pressDir = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
	end
	c["ehc.pressAuto"] = function(v)
		self.pressAuto = v >= 0.5
	end
	for k = 1, 2 do
		local t = self.turbines[k]
		local key = "tg." .. k
		c[key .. ".trip"] = function()
			self:tripTurbine(k, "manual trip")
		end
		c[key .. ".reset"] = function()
			self:resetTurbine(k)
		end
		c[key .. ".iso"] = function(v)
			t.isoDir = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
		end
		c[key .. ".load"] = function(v)
			t.loadDir = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
		end
		c[key .. ".speed"] = function(v)
			t.speedTarget = Util.clamp(math.floor(v), 0, 2)
		end
		c[key .. ".lube"] = function(v)
			t.lubeAC = v >= 0.5
		end
		c[key .. ".tgear"] = function(v)
			t.turningGear = v >= 0.5
		end
		c[key .. ".gland"] = function(v)
			t.gland = v >= 0.5
		end
		c[key .. ".bypassAuto"] = function(v)
			t.bypassAuto = v >= 0.5
		end
		c[key .. ".bypass"] = function(v)
			t.bypassDir = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
		end
		c[key .. ".vacPump"] = function(v)
			t.vacPump = v >= 0.5
		end
		c[key .. ".sjae"] = function(v)
			t.sjae = v >= 0.5
		end
		c[key .. ".vacBreaker"] = function(v)
			t.vacBreaker = v >= 0.5
		end
		for j = 1, 2 do
			c[key .. ".cw" .. j] = function(v)
				self:switchPump(t.cw[j], v >= 0.5)
			end
		end
	end
	for g = 1, 3 do
		c["srv." .. g] = function(v)
			self.safety[g].manual = v >= 0.5
		end
	end
	for i, pump in self.feedPumps do
		c["fw.pump." .. i] = function(v)
			self:switchPump(pump, v >= 0.5)
		end
	end
	for i, pump in self.auxFeed do
		c["afw.pump." .. i] = function(v)
			self:switchPump(pump, v >= 0.5)
		end
	end
	c["afw.auto"] = function(v)
		self.auxFeedAuto = v >= 0.5
	end
	for i, pump in self.condPumps do
		c["cond.pump." .. i] = function(v)
			self:switchPump(pump, v >= 0.5)
		end
	end
	for l = 1, 2 do
		local lc = self.level[l]
		c["lvl." .. l .. ".auto"] = function(v)
			local on = v >= 0.5
			if on and not lc.auto then
				lc.int = 0
			end
			lc.auto = on
		end
		c["lvl." .. l .. ".valve"] = function(v)
			lc.dir = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
		end
	end
	c["da.peg"] = function(v)
		self.da.peg = v >= 0.5
	end
	c["da.levelAuto"] = function(v)
		self.da.levelAuto = v >= 0.5
	end
	c["da.valve"] = function(v)
		self.da.dir = if v > 0.5 then 1 elseif v < -0.5 then -1 else 0
	end
	return self
end

function Secondary.switchPump(self, pump, on: boolean)
	local plant = self.plant
	if on then
		if pump.on then
			return
		end
		if pump.failed then
			plant:log(pump.name .. " will not start: out of service")
			return
		end
		if not plant:busLive(pump.bus) then
			plant:log(pump.name .. " will not start: bus " .. pump.bus .. " dead")
			return
		end
		pump.on = true
		plant:log(pump.name .. " started")
	elseif pump.on then
		pump.on = false
		plant:log(pump.name .. " stopped")
	end
end

local function servicePump(self, pump, dt: number, alarm: string?)
	if pump.on and not self.plant:busLive(pump.bus) then
		pump.on = false
		self.plant:log(pump.name .. " tripped: bus undervoltage")
		if alarm then
			self.plant:raise(alarm)
		end
	end
	if pump.repair > 0 then
		pump.repair -= dt
		if pump.repair <= 0 then
			pump.failed = false
			self.plant:log(pump.name .. " returned to service")
		end
	end
end

function Secondary.tripTurbine(self, k: number, cause: string)
	local t = self.turbines[k]
	if not t.tripped then
		t.tripped = true
		t.tripCause = cause
		t.stopOpen = false
		t.speedTarget = 0
		self.plant:log(string.format("TURBINE %d TRIP: %s", k, cause))
		self.plant:raise("tg." .. k .. ".trip")
	end
end

function Secondary.resetTurbine(self, k: number)
	local t = self.turbines[k]
	local plant = self.plant
	if not t.tripped then
		return
	end
	if t.condP > 0.030 then
		plant:log(string.format("Turbine %d will not latch: condenser vacuum low", k))
		return
	end
	if t.lube < 0.5 then
		plant:log(string.format("Turbine %d will not latch: lube oil pressure low", k))
		return
	end
	if t.bearingDamage >= 1 then
		plant:log(string.format("Turbine %d will not latch: bearing damage", k))
		return
	end
	t.tripped = false
	t.tripCause = ""
	t.stopOpen = true
	t.speedInt = 0
	t.speedRef = t.speed
	plant:log(string.format("Turbine %d latched, stop valves open", k))
end

-- Mechanical shock from a bad synchronisation.
function Secondary.shock(self, k: number, severity: number)
	self.turbines[k].wear += 0.15 * severity
end

-- The governor picks up a little load the moment the breaker closes so the
-- machine does not motor.
function Secondary.onSynchronised(self, k: number)
	local t = self.turbines[k]
	t.loadSet = math.max(t.loadSet, 0.04)
end

function Secondary.step(self, dt: number)
	local plant = self.plant
	local pri = plant.primary
	local elec = plant.elec
	local P = pri.pressure
	local pRatio = math.max(0, P - 0.12) / NOMINAL_P
	local tSteam = Steam.tsat(P)

	-- Pressure regulator.
	self.pressSet = Util.clamp(self.pressSet + self.pressDir * 0.02 * dt, 0.3, 7.2)
	local err = P - self.pressSet
	if self.pressAuto then
		self.pressInt = Util.clamp(self.pressInt + err * 0.35 * dt, 0, 1.4)
		self.demand = Util.clamp(err * 4 + self.pressInt, 0, 1.45)
		self.autoSeconds += dt
	else
		self.pressInt = 0
		self.demand = 1.45 -- regulator out of service: turbines follow load set alone
	end

	-- Speed / load demand of each machine.
	local limits = {}
	local order = {}
	for k = 1, 2 do
		local t = self.turbines[k]
		local gen = elec.gens[k]
		t.iso = Util.clamp(t.iso + t.isoDir * dt / 20, 0, 1)
		t.loadSet = Util.clamp(t.loadSet + t.loadDir * 0.01 * dt, 0, 1.08)
		local s = 0
		if t.stopOpen and t.iso > 0.02 then
			if gen.mode == "grid" then
				s = t.loadSet
			elseif gen.mode == "island" then
				-- Isolated: hold frequency with a 5% droop.
				s = Util.clamp(t.loadSet + (1 - t.speed) / 0.05, 0, 1.08)
			else
				local target = if t.speedTarget == 2 then 1 elseif t.speedTarget == 1 then 500 / Config.TURBINE_RPM else 0
				-- Speed reference ramps at 150 rpm per minute... per second it is quicker than a real unit.
				t.speedRef = Util.approach(t.speedRef, target, dt * (if target > t.speedRef then 1 / 90 else 1 / 30))
				local e = t.speedRef - t.speed
				t.speedInt = Util.clamp(t.speedInt + e * 0.05 * dt, 0, 0.08)
				s = Util.clamp(e * 1.2 + t.speedInt, 0, 0.12)
				if t.speedTarget == 0 then
					s = 0
				end
			end
		else
			t.speedInt = 0
			t.speedRef = t.speed
		end
		limits[k] = s
		order[k] = k
	end
	if limits[order[1]] > limits[order[2]] then
		order[1], order[2] = order[2], order[1]
	end
	-- Hand out the regulator's demand, most restricted machine first.
	local remaining = self.demand
	local turbineSteamFrac = 0
	for n, k in order do
		local t = self.turbines[k]
		local share = remaining / (3 - n) -- fraction of total nominal flow
		local cvDemand = math.min(limits[k], share / 0.5)
		if not t.stopOpen then
			cvDemand = 0
		end
		-- Control valves stroke in about three seconds, shut much faster.
		t.cv = Util.approach(t.cv, cvDemand, dt * (if cvDemand < t.cv then 2 else 0.35))
		local isoFactor = math.min(1, t.iso * 3)
		t.steam = if t.stopOpen then Sec.TURBINE_STEAM * t.cv * pRatio * isoFactor else 0
		local frac = t.steam / Sec.STEAM_NOMINAL
		remaining = math.max(0, remaining - cvDemand * 0.5)
		turbineSteamFrac += frac
	end

	-- Bypass takes the surplus, if the condenser can accept it.
	local surplus = if self.pressAuto then math.max(0, self.demand - turbineSteamFrac / math.max(pRatio, 0.05)) else 0
	local available = 0
	for k = 1, 2 do
		local t = self.turbines[k]
		if t.bypassAuto and t.condP < 0.040 then
			available += 1
		end
	end
	local steamTotal = 0
	local aux = 0
	for k = 1, 2 do
		local t = self.turbines[k]
		local gen = elec.gens[k]
		local target
		if t.condP >= 0.040 then
			target = 0 -- vacuum interlock
		elseif t.bypassAuto then
			target = if available > 0 then Util.clamp(surplus / available / Sec.BYPASS_CAPACITY, 0, 1) else 0
		else
			t.bypass = Util.clamp(t.bypass + t.bypassDir * 0.1 * dt, 0, 1)
			target = t.bypass
		end
		t.bypass = Util.approach(t.bypass, target, dt * 1.5)
		t.bypassFlow = Sec.BYPASS_CAPACITY * Sec.STEAM_NOMINAL * t.bypass * pRatio

		-- Shaft.
		local vacFactor = Util.clamp(1 - 1.2 * (t.condP - 0.005) / 0.1, 0.3, 1.02)
		local flowFrac = t.steam / Sec.TURBINE_STEAM
		local eff = (1 - 0.12 * (1 - math.min(flowFrac, 1)) ^ 2) * vacFactor * (math.max(P, 0.2) / NOMINAL_P) ^ 0.12
		local mech = t.steam * STEAM_WORK * eff
		local loss = WINDAGE * t.speed * t.speed * (0.4 + 0.6 * t.speed)
		if gen.mode == "grid" then
			t.speed = elec.grid.freq / Config.GRID_HZ
			t.shaftPower = mech - loss
		else
			local net = mech - loss - gen.pe
			t.speed = math.max(0, t.speed + net / (2 * ROTOR_ENERGY * math.max(t.speed, 0.03)) * dt)
			t.shaftPower = mech - loss
			if t.turningGear and t.lube > 0.5 and t.speed < 0.004 and plant:busLive("E1") then
				t.speed = 0.002
			end
		end

		-- Lube oil: shaft pump near rated speed, AC pump, or the DC standby.
		local lube = 0
		if t.speed > 0.9 then
			lube = 1
		elseif t.lubeAC and plant:busLive("E" .. k) then
			lube = 1
			elec:addLoad("E" .. k, 0.2e6)
		else
			lube = 0.75 -- battery-driven emergency pump cuts in by itself
		end
		if t.bearingDamage >= 1 then
			lube = 0.2
		end
		t.lube = Util.lag(t.lube, lube, dt, 1.5)

		-- Metal temperature and thermal stress.
		local warmRate = (0.012 + flowFrac) / 60
		local steamAtInlet = if t.steam > 0.5 then tSteam else math.max(t.metal - 40, 35)
		local stress = math.abs(tSteam - t.metal) * flowFrac
		t.metal += (steamAtInlet - t.metal) * (1 - math.exp(-warmRate * dt))
		if stress > 60 and t.steam > 1 then
			t.wear += (stress / 60 - 1) * dt / 900
		end
		t.stress = stress

		-- A hot rotor left standing sags; turning gear straightens it again.
		if t.speed < 0.001 and t.metal > 150 then
			t.bow = math.min(1, t.bow + dt / 600)
		elseif t.speed > 0.0015 then
			t.bow = math.max(0, t.bow - dt / 500)
		end
		local critical = math.exp(-((t.speed - 0.55) / 0.07) ^ 2)
		local vib = 1.2 + 9 * t.wear + 3.5 * critical * (0.4 + t.speed) + 7 * t.bow * math.min(1, t.speed * 3) + 10 * t.bearingDamage
		if t.speed < 0.01 then
			vib = 0
		end
		t.vib = Util.lag(t.vib, vib, dt, 1.5)

		-- Condenser.
		local cwFrac = 0
		for _, pump in t.cw do
			servicePump(self, pump, dt)
			if pump.on then
				cwFrac += 0.6
				elec:addLoad(pump.bus, 2.2e6)
			end
		end
		cwFrac = math.min(cwFrac, 1)
		local rejected = (t.steam * (1 - 0.3 * eff) + t.bypassFlow) * 2.2e6
		local qFrac = rejected / (Sec.TURBINE_STEAM * 2.2e6)
		local condT = 18 + 10 * qFrac / math.max(cwFrac, 0.04) + 4 * math.sqrt(qFrac)
		t.condT = Util.lag(t.condT, math.min(condT, 140), dt, 20)
		local leak = t.airLeak * (if t.gland and P > 0.5 then 1 else 5)
		local airTarget, tau
		if t.vacBreaker then
			airTarget, tau = 0.1013, 6
		elseif t.sjae and P > 1.0 then
			airTarget, tau = 0.0003 * leak, 45
			aux += 2
		elseif t.vacPump and plant:busLive(t.cw[1].bus) then
			airTarget, tau = 0.004 + 0.0015 * leak, 70
			elec:addLoad(t.cw[1].bus, 0.3e6)
		else
			airTarget, tau = 0.1013, 1500 / leak
		end
		t.air = Util.lag(t.air, airTarget, dt, tau)
		t.condP = math.min(0.1013, t.air + Steam.psat(t.condT))
		if t.gland and P > 0.5 then
			aux += 1.5
		end

		-- Turbine protection.
		if not t.tripped then
			if t.speed > 1.10 then
				self:tripTurbine(k, "overspeed")
				t.wear += 0.05
			elseif t.condP > 0.030 and t.speed > 0.05 then
				self:tripTurbine(k, "condenser vacuum low")
			elseif t.lube < 0.5 and t.speed > 0.02 then
				self:tripTurbine(k, "lube oil pressure low")
			elseif t.vib > 11.8 then
				self:tripTurbine(k, "vibration high")
			elseif math.max(pri.loops[1].level, pri.loops[2].level) > 700 then
				self:tripTurbine(k, "drum level high (water carryover)")
			end
		end
		-- Running a bearing with no oil ruins it.
		if t.lube < 0.4 and t.speed > 0.05 then
			t.bearingDamage = math.min(1, t.bearingDamage + dt / 60)
		end
		steamTotal += t.steam + t.bypassFlow
	end

	-- Main safety valves, three groups, blowing down to the suppression pool.
	local poolSteam = 0
	for g = 1, 3 do
		local v = self.safety[g]
		local set = Sec.SAFETY_VALVE_SETPOINTS[g]
		if P > set then
			if not v.open then
				plant:log(string.format("Safety valve group %d lifted at %.2f MPa", g, P))
			end
			v.open = true
		elseif P < set - 0.35 and not v.stuck then
			v.open = false
		elseif v.stuck and v.open and P < 4.0 then
			-- A valve that failed to reseat finally closes at low pressure.
			v.stuck = false
			v.open = false
			plant:log(string.format("Safety valve group %d reseated", g))
		end
		local isOpen = v.open or v.manual
		v.flow = if isOpen then Sec.SAFETY_VALVE_CAPACITY * Sec.STEAM_NOMINAL * pRatio else 0
		poolSteam += v.flow
	end
	steamTotal += poolSteam
	local _, _, hfgNow = Steam.sat(P)
	self.poolHeat = poolSteam * (hfgNow + 4.2e5)

	-- Condensate and deaerator.
	local da = self.da
	local condCapacity = 0
	for _, pump in self.condPumps do
		servicePump(self, pump, dt, "cond.pump")
		if pump.on then
			condCapacity += Sec.COND_PUMP_FLOW
			elec:addLoad(pump.bus, 1.2e6)
		end
	end
	local daLevel = da.mass / 2.5e5
	if da.levelAuto then
		da.valve = Util.clamp(da.valve + ((0.50 - daLevel) * 0.8 - (da.valve - 0.5) * 0.02) * dt, 0, 1)
	else
		da.valve = Util.clamp(da.valve + da.dir * 0.1 * dt, 0, 1)
	end
	local condFlow = math.min(condCapacity, da.valve * 1600)
	if daLevel > 0.98 then
		condFlow = 0
	end
	self.condFlow = condFlow
	local loadFrac = (self.turbines[1].steam + self.turbines[2].steam) / Sec.STEAM_NOMINAL
	local condTemp = 0.5 * (self.turbines[1].condT + self.turbines[2].condT) + 70 * loadFrac
	-- Heating steam: turbine extraction first, then pegging steam from the main header.
	local target = Sec.FEEDWATER_TEMP
	local need = condFlow * CP * math.max(0, target - condTemp) + da.mass * CP * (target - da.temp) / 400
	local extraction = loadFrac * Sec.STEAM_NOMINAL * 0.13 * 2.0e6
	-- Pegging steam comes off the main header through a pressure interlock:
	-- below 6 MPa it shuts, so a shut-down reactor is not bled cold to keep
	-- the feedwater warm.
	local pegAvail = if da.peg and P > 6.0 then 110e6 else 0
	local heat = Util.clamp(need, 0, extraction + pegAvail)
	da.pegFlow = math.max(0, heat - extraction) / 2.0e6
	aux += da.pegFlow
	da.temp += (condFlow * CP * (condTemp - da.temp) + heat) / (da.mass * CP) * dt
	da.temp = Util.clamp(da.temp, 20, 175)
	self.auxSteam = aux
	steamTotal += aux
	self.steamTotal = steamTotal
	pri.steamOut = steamTotal

	-- Feedwater pumps.
	local running = 0
	for _, pump in self.feedPumps do
		servicePump(self, pump, dt, "fw.pump")
		if pump.on and daLevel < 0.08 then
			pump.on = false
			plant:log(pump.name .. " tripped: deaerator level low")
			plant:raise("fw.pump")
		end
		if pump.on then
			running += 1
		end
	end
	local suction = math.max(Steam.psat(da.temp), 0.1) + 0.2

	-- Drum level controllers, three-element: the level error trims a feed
	-- flow demand that otherwise follows steam flow, and the valve is moved
	-- until measured feed flow meets that demand.
	for l = 1, 2 do
		local lc = self.level[l]
		local loop = pri.loops[l]
		if lc.stuck > 0 then
			-- Valve actuator fault: it stays where it is.
			lc.stuck -= dt
		elseif lc.auto then
			local e = (lc.set - loop.indicated) / 1000 -- metres
			-- No integrating against a valve that is already hard closed or open.
			if not ((lc.valve <= 0.001 and e < 0) or (lc.valve >= 0.999 and e > 0)) then
				lc.int = Util.clamp(lc.int + e * 4 * dt, -40, 40)
			end
			-- The level trim has limited authority, so the shrink after a
			-- scram is refilled gently rather than by flooding the drums
			-- with cold water.
			local demand = math.max(0, loop.steam + Util.clamp(350 * e + lc.int, -45, 45))
			lc.demand = demand
			if running > 0 then
				lc.valve = Util.clamp(lc.valve + Util.clamp((demand - lc.lastFeed) / 900, -0.15, 0.15) * dt, 0, 1)
			else
				lc.valve = Util.approach(lc.valve, 0.05, 0.05 * dt)
			end
			lc.autoSeconds += dt
			self.autoSeconds += dt * 0.5
		else
			lc.valve = Util.clamp(lc.valve + lc.dir * 0.05 * dt, 0, 1)
		end
	end

	-- Header pressure where pump supply meets valve demand.
	local feed = { 0, 0 }
	local header = suction
	if running > 0 then
		local lo, hi = P, suction + FEED_H0
		for _ = 1, 24 do
			local mid = 0.5 * (lo + hi)
			local supply = running * math.sqrt(math.max(0, suction + FEED_H0 - mid) / FEED_A)
			local demand = 0
			for l = 1, 2 do
				local dp = mid - P - 0.2
				if dp > 0 then
					demand += FEED_CV * (self.level[l].valve ^ 1.5) * math.sqrt(dp)
				end
			end
			if supply > demand then
				lo = mid
			else
				hi = mid
			end
		end
		header = 0.5 * (lo + hi)
		for l = 1, 2 do
			local dp = header - P - 0.2
			feed[l] = if dp > 0 then FEED_CV * (self.level[l].valve ^ 1.5) * math.sqrt(dp) else 0
		end
		-- Pumps run out at about 120% of rated flow.
		local limit = running * Sec.FEED_PUMP_FLOW * 1.2
		local sum = feed[1] + feed[2]
		if sum > limit then
			feed[1] *= limit / sum
			feed[2] *= limit / sum
		end
	end
	self.level[1].lastFeed = feed[1]
	self.level[2].lastFeed = feed[2]
	self.feedHeader = header
	local mainFeed = feed[1] + feed[2]
	for _, pump in self.feedPumps do
		pump.flow = if pump.on then mainFeed / running else 0
		if pump.on then
			elec:addLoad(pump.bus, 4.2e6 * (0.45 + 0.55 * pump.flow / Sec.FEED_PUMP_FLOW))
		end
	end

	-- Emergency feed pumps.
	local lowLevel = math.min(pri.loops[1].level, pri.loops[2].level) < -500
	local auxFlow = 0
	for _, pump in self.auxFeed do
		servicePump(self, pump, dt)
		if self.auxFeedAuto and lowLevel and not pump.on and not pump.failed and plant:busLive(pump.bus) then
			pump.on = true
			plant:log(pump.name .. " auto-started on low drum level")
		end
		if pump.on then
			if daLevel > 0.03 and P < 8.5 then
				auxFlow += Sec.AUX_FEED_FLOW
				pump.flow = Sec.AUX_FEED_FLOW
			else
				pump.flow = 0
			end
			elec:addLoad(pump.bus, 0.9e6)
		else
			pump.flow = 0
		end
	end
	local hFeed = Steam.hLiquid(da.temp)
	for l = 1, 2 do
		local loop = pri.loops[l]
		loop.feed = feed[l] + auxFlow / 2
		loop.feedEnthalpy = hFeed
	end
	self.feedTotal = mainFeed + auxFlow
	da.mass = Util.clamp(da.mass + (condFlow + heat / 2.2e6 - self.feedTotal) * dt, 0, 2.5e5)

	-- Hotwells: condensed steam in, condensate out, automatic makeup and reject.
	for k = 1, 2 do
		local t = self.turbines[k]
		local inflow = t.steam + t.bypassFlow
		local level = t.hotwell + (inflow - condFlow / 2) * dt / 6.0e4
		level += (0.6 - level) * math.min(1, dt / 40)
		t.hotwell = Util.clamp(level, 0, 1)
	end
end

function Secondary.publish(self, S)
	local plant = self.plant
	S["ehc.pressSet"] = self.pressSet
	S["ehc.pressAuto"] = if self.pressAuto then 1 else 0
	S["ehc.demand"] = self.demand * 100
	S["steam.total"] = self.steamTotal * 3.6
	S["steam.aux"] = self.auxSteam * 3.6
	local tripped = 0
	for k = 1, 2 do
		local t = self.turbines[k]
		local key = "tg." .. k
		S[key .. ".rpm"] = t.speed * Config.TURBINE_RPM
		S[key .. ".trip"] = if t.tripped then 1 else 0
		S[key .. ".stop"] = if t.stopOpen then 1 else 0
		S[key .. ".iso"] = t.iso * 100
		S[key .. ".cv"] = t.cv * 100
		S[key .. ".load"] = t.loadSet * 100
		S[key .. ".speedTarget"] = t.speedTarget
		S[key .. ".steam"] = t.steam * 3.6
		S[key .. ".bypass"] = t.bypass * 100
		S[key .. ".bypassAuto"] = if t.bypassAuto then 1 else 0
		S[key .. ".vac"] = t.condP * 1000
		S[key .. ".condT"] = t.condT
		S[key .. ".vib"] = t.vib
		S[key .. ".metal"] = t.metal
		S[key .. ".stress"] = t.stress or 0
		S[key .. ".lube"] = t.lube * 0.25
		S[key .. ".lubeAC"] = if t.lubeAC then 1 else 0
		S[key .. ".tgear"] = if t.turningGear then 1 else 0
		S[key .. ".gland"] = if t.gland then 1 else 0
		S[key .. ".vacPump"] = if t.vacPump then 1 else 0
		S[key .. ".sjae"] = if t.sjae then 1 else 0
		S[key .. ".vacBreaker"] = if t.vacBreaker then 1 else 0
		S[key .. ".hotwell"] = t.hotwell * 100
		S[key .. ".wear"] = t.wear
		for j = 1, 2 do
			S[key .. ".cw" .. j] = if t.cw[j].on then 1 else 0
		end
		if t.tripped then
			tripped += 1
		end
	end
	S["tg.tripped"] = tripped
	for g = 1, 3 do
		local v = self.safety[g]
		S["srv." .. g .. ".open"] = if v.open or v.manual then 1 else 0
		S["srv." .. g .. ".sw"] = if v.manual then 1 else 0
	end
	local feedRunning = 0
	-- Motor currents, in amperes, for the board ammeters: no-load current
	-- plus a share that follows the pump's flow.
	local function amps(on: boolean, noLoad: number, full: number, frac: number): number
		return if on then noLoad + (full - noLoad) * math.clamp(frac, 0, 1.2) else 0
	end
	for i, pump in self.feedPumps do
		S["fw.pump." .. i .. ".run"] = if pump.on then 1 else 0
		S["fw.pump." .. i .. ".flow"] = pump.flow * 3.6
		S["fw.pump." .. i .. ".current"] = amps(pump.on, 150, 560, pump.flow / Sec.FEED_PUMP_FLOW)
		if pump.on then
			feedRunning += 1
		end
	end
	S["fw.running"] = feedRunning
	S["fw.header"] = self.feedHeader
	S["fw.total"] = self.feedTotal * 3.6
	S["fw.temp"] = self.da.temp
	for i, pump in self.auxFeed do
		S["afw.pump." .. i .. ".run"] = if pump.on then 1 else 0
		S["afw.pump." .. i .. ".current"] = amps(pump.on, 40, 120, pump.flow / Sec.AUX_FEED_FLOW)
	end
	S["afw.auto"] = if self.auxFeedAuto then 1 else 0
	local condRunning = 0
	local condCapacity = 0
	for _, pump in self.condPumps do
		if pump.on then
			condCapacity += Sec.COND_PUMP_FLOW
		end
	end
	for i, pump in self.condPumps do
		S["cond.pump." .. i .. ".run"] = if pump.on then 1 else 0
		S["cond.pump." .. i .. ".current"] = amps(pump.on, 45, 140, if condCapacity > 0 then self.condFlow / condCapacity else 0)
		if pump.on then
			condRunning += 1
		end
	end
	S["cond.running"] = condRunning
	S["cond.flow"] = self.condFlow * 3.6
	for l = 1, 2 do
		local lc = self.level[l]
		S["lvl." .. l .. ".auto"] = if lc.auto then 1 else 0
		S["lvl." .. l .. ".valve"] = lc.valve * 100
	end
	S["da.level"] = self.da.mass / 2.5e5 * 100
	S["da.temp"] = self.da.temp
	S["da.peg"] = if self.da.peg then 1 else 0
	S["da.levelAuto"] = if self.da.levelAuto then 1 else 0
	S["da.valve"] = self.da.valve * 100
	local _ = plant
end

return Secondary
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="27">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="28">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="29">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">RBMKClient</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Controls</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Mouse interaction with the panels and the seated "panel view" camera.
--
-- Every control is a region on a panel face. A ray from the camera through
-- the mouse finds the face and the point on it, and the region under that
-- point decides what a click does. Pressing E near a benchboard locks the
-- camera onto it for precise work.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Config = require(Shared.Config)
local PanelLayout = require(Shared.PanelLayout)

local Controls = {}

local REACH = 40 -- studs
local HOLD_REFRESH = 0.25
local VIEWS = { "bench", "board", "wide" }

function Controls.start(built: any, ctx: any)
	local player = Players.LocalPlayer
	local camera = workspace.CurrentCamera :: Camera
	local faceParts: { Instance } = {}
	for part in built.faces do
		table.insert(faceParts, part)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = faceParts

	-- Heads-up elements: tooltip and key hints.
	local gui = Instance.new("ScreenGui")
	gui.Name = "RBMKHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 5
	gui.Parent = player:WaitForChild("PlayerGui")
	local tip = Instance.new("TextLabel")
	tip.BackgroundColor3 = Color3.fromRGB(20, 22, 24)
	tip.BackgroundTransparency = 0.1
	tip.BorderSizePixel = 0
	tip.TextColor3 = Color3.fromRGB(240, 240, 230)
	tip.Font = Enum.Font.SourceSans
	tip.TextSize = 17
	tip.TextXAlignment = Enum.TextXAlignment.Left
	tip.AutomaticSize = Enum.AutomaticSize.XY
	tip.Visible = false
	tip.ZIndex = 10
	tip.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 5)
	pad.PaddingBottom = UDim.new(0, 5)
	pad.Parent = tip
	local hint = Instance.new("TextLabel")
	hint.BackgroundColor3 = Color3.fromRGB(20, 22, 24)
	hint.BackgroundTransparency = 0.35
	hint.BorderSizePixel = 0
	hint.AnchorPoint = Vector2.new(0.5, 1)
	hint.Position = UDim2.new(0.5, 0, 1, -12)
	hint.Size = UDim2.fromOffset(860, 26)
	hint.TextColor3 = Color3.fromRGB(235, 235, 225)
	hint.Font = Enum.Font.SourceSans
	hint.TextSize = 16
	hint.Parent = gui
	local HINT_WALK = "[E] sit at the nearest panel     [P] procedures     click any control; hover for details; guarded buttons: click lifts the cover"
	local HINT_VIEW = "[A] [D] next panel     [W] [S] bench / board / wide     [wheel] zoom     [E] stand up"
	hint.Text = HINT_WALK
	-- Which version is running, small in the corner.
	local version = Instance.new("TextLabel")
	version.Name = "Version"
	version.BackgroundTransparency = 1
	version.AnchorPoint = Vector2.new(1, 1)
	version.Position = UDim2.new(1, -10, 1, -6)
	version.Size = UDim2.fromOffset(420, 16)
	version.TextXAlignment = Enum.TextXAlignment.Right
	version.TextColor3 = Color3.fromRGB(200, 200, 190)
	version.TextTransparency = 0.35
	version.Font = Enum.Font.SourceSans
	version.TextSize = 14
	version.Text = "RBMK-800 version " .. Config.VERSION
	version.Parent = gui

	-- What is under the mouse?
	local function pick(): (any, number, number)
		local m = UserInputService:GetMouseLocation()
		local ray = camera:ViewportPointToRay(m.X, m.Y)
		local hit = workspace:Raycast(ray.Origin, ray.Direction * REACH, params)
		if not hit then
			return nil, 0, 0
		end
		local face = built.faces[hit.Instance]
		if not face then
			return nil, 0, 0
		end
		local u, v = PanelLayout.toFace(face, hit.Position)
		local best: any = nil
		for _, r in built.regions[hit.Instance] do
			if u >= r.x and u <= r.x + r.w and v >= r.y and v <= r.y + r.h then
				if not best or r.w * r.h < best.w * best.h then
					best = r
				end
			end
		end
		return best, u, v
	end

	-- A control being held: a raise/lower button, the rod movement switch,
	-- an annunciator TEST. Held commands are re-sent until release.
	local holding: { cmd: string?, value: number, onRelease: (() -> ())? }? = nil
	local holdClock = 0

	local function release()
		local h = holding
		if h then
			holding = nil
			if h.cmd then
				ctx.send(h.cmd, 0)
			end
			if h.onRelease then
				h.onRelease()
			end
		end
	end

	local function press(button: number)
		local r, u, v = pick()
		if not r or not r.press then
			return
		end
		local result = r.press(button, u, v)
		if result and (result.hold or result.onRelease) then
			release()
			holding = { cmd = result.hold, value = result.value or 0, onRelease = result.onRelease }
			holdClock = 0
			if result.hold then
				ctx.send(result.hold, result.value)
			end
		end
	end

	-- Panel view.
	local viewing: number? = nil
	local view = 2
	local targetCF: CFrame? = nil

	local function aim()
		if not viewing then
			return
		end
		local origin, _, back = PanelLayout.panelFrame(viewing)
		local up = Vector3.new(0, 1, 0)
		-- A point above the floor and in front of the bench, in board units.
		local function at(height: number, out: number): Vector3
			return origin + (up * height + back * out) * PanelLayout.SCALE
		end
		local mode = VIEWS[view]
		if mode == "bench" then
			local bench = PanelLayout.face(viewing, "bench")
			targetCF = CFrame.lookAt(at(11.3, 2.6), bench.center)
		elseif mode == "board" then
			local board = PanelLayout.face(viewing, "vert")
			targetCF = CFrame.lookAt(at(10.5, 6.4), board.center)
		else
			-- Stand back far enough to take in the whole section.
			targetCF = CFrame.lookAt(at(11.4, 14 * PanelLayout.panels[viewing].width / PanelLayout.PANEL_WIDTH), at(9.1, 0))
		end
	end

	local function nearestPanel(): number?
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return nil
		end
		local best, bestD = nil, 26 * PanelLayout.SCALE
		for _, p in PanelLayout.panels do
			local origin, _, back = PanelLayout.panelFrame(p.index)
			local d = (root.Position - (origin + back * 4 * PanelLayout.SCALE)).Magnitude
			if d < bestD then
				best, bestD = p.index, d
			end
		end
		return best
	end

	local function keys(_name: string, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin and viewing then
			local key = input.KeyCode
			if key == Enum.KeyCode.A or key == Enum.KeyCode.Left then
				viewing = math.max(1, viewing - 1)
			elseif key == Enum.KeyCode.D or key == Enum.KeyCode.Right then
				viewing = math.min(#PanelLayout.panels, viewing + 1)
			elseif key == Enum.KeyCode.W or key == Enum.KeyCode.Up then
				view = math.min(#VIEWS, view + 1)
			elseif key == Enum.KeyCode.S or key == Enum.KeyCode.Down then
				view = math.max(1, view - 1)
			end
			aim()
		end
		return Enum.ContextActionResult.Sink
	end

	local function leaveView()
		if not viewing then
			return
		end
		viewing = nil
		targetCF = nil
		ContextActionService:UnbindAction("RBMKPanelKeys")
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = 70
		hint.Text = HINT_WALK
	end

	local function enterView()
		local index = nearestPanel()
		if not index then
			return
		end
		viewing = index
		view = 2
		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = 60
		aim()
		ContextActionService:BindActionAtPriority(
			"RBMKPanelKeys",
			keys,
			false,
			Enum.ContextActionPriority.High.Value,
			Enum.KeyCode.W,
			Enum.KeyCode.A,
			Enum.KeyCode.S,
			Enum.KeyCode.D,
			Enum.KeyCode.Up,
			Enum.KeyCode.Down,
			Enum.KeyCode.Left,
			Enum.KeyCode.Right,
			Enum.KeyCode.Space
		)
		hint.Text = HINT_VIEW
	end

	-- Walking about, the right button also turns the camera: there a right
	-- click works a control only if the camera did not turn while it was
	-- down. Seated at a panel the camera is fixed and it works at once.
	local rightDown: { look: Vector3, at: number }? = nil
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not processed then
			press(1)
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 and not processed then
			if viewing then
				press(2)
			else
				rightDown = { look = camera.CFrame.LookVector, at = os.clock() }
			end
		elseif input.KeyCode == Enum.KeyCode.E and not processed then
			if viewing then
				leaveView()
			else
				enterView()
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			release()
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
			local down = rightDown
			rightDown = nil
			if down and not viewing and os.clock() - down.at < 0.6 and camera.CFrame.LookVector:Dot(down.look) > 0.9995 then
				-- The button is already up: whatever it does is momentary.
				press(2)
			end
			release()
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if viewing and input.UserInputType == Enum.UserInputType.MouseWheel then
			camera.FieldOfView = math.clamp(camera.FieldOfView - input.Position.Z * 5, 18, 75)
		end
	end)
	UserInputService.WindowFocusReleased:Connect(release)

	RunService.RenderStepped:Connect(function(dt: number)
		if viewing and targetCF then
			camera.CFrame = camera.CFrame:Lerp(targetCF, math.min(1, dt * 10))
		end
		if holding and holding.cmd then
			holdClock += dt
			if holdClock >= HOLD_REFRESH then
				holdClock = 0
				ctx.send(holding.cmd, holding.value)
			end
		end
		-- Tooltip.
		local r, u, v = pick()
		local textOut: string? = nil
		if r then
			local kind = r.widget.kind
			if r.tipAt then
				textOut = r.tipAt(u, v)
			elseif kind == "coremap" and built.mapCellAt then
				textOut = built.mapInfo(built.mapCellAt(u, v))
			elseif kind == "rodmatrix" and built.rodAt then
				textOut = built.rodAt(u, v)
			end
			if not textOut and r.tip then
				textOut = r.tip()
			end
		end
		if textOut then
			local m = UserInputService:GetMouseLocation()
			tip.Text = textOut
			tip.Position = UDim2.fromOffset(m.X + 18, m.Y + 14)
			tip.Visible = true
		else
			tip.Visible = false
		end
	end)

	return { gui = gui, leaveView = leaveView }
end

return Controls
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="32">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Client entry point: dresses the panels, keeps them in step with the
-- server's plant, and handles the player's input.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("RBMK")
local Config = require(Shared.Config)
local PanelLayout = require(Shared.PanelLayout)
local Panels = require(script.Parent.Panels)
local Controls = require(script.Parent.Controls)
local ProcedureGui = require(script.Parent.ProcedureGui)

local player = Players.LocalPlayer
local room = workspace:WaitForChild("ControlRoom")
local remotes = ReplicatedStorage:WaitForChild("RBMKRemotes")
local commandEvent = remotes:WaitForChild("Command") :: RemoteEvent
local snapshotEvent = remotes:WaitForChild("Snapshot") :: RemoteEvent
local mapEvent = remotes:WaitForChild("CoreMap") :: RemoteEvent
local alarmEvent = remotes:WaitForChild("Alarm") :: RemoteEvent
local logEvent = remotes:WaitForChild("Log") :: RemoteEvent
local helloFunction = remotes:WaitForChild("Hello") :: RemoteFunction

-- Sounds.
local function sound(id: string, volume: number, looped: boolean): Sound
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume
	s.Looped = looped
	s.Parent = SoundService
	return s
end
local clickSound = sound(Config.Sounds.CLICK, 0.5, false)
local hornSound = sound(Config.Sounds.ALARM, 0.35, true)

-- Latest plant values, indexed as in PanelLayout.signals.
local signalIndex = PanelLayout.signalIndex
local values = table.create(#PanelLayout.signals, 0)
local ctx = {
	get = function(name: string): number
		local i = signalIndex[name]
		return if i then values[i] else 0
	end,
	send = function(name: string, value: number)
		commandEvent:FireServer(name, value)
	end,
	click = function()
		clickSound:Play()
	end,
}

local built = Panels.build(room, ctx)
Controls.start(built, ctx)
ProcedureGui.start()

-- On the operators' desk: a green-screen terminal with a live summary, and
-- the alarm teleprinter, which prints the event log on its paper.
local function surface(target: Instance, pixelsPerStud: number): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 0
	gui.Adornee = target :: any
	gui.Parent = target
	return gui
end
local function typed(gui: SurfaceGui, size: number, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -14, 1, -10)
	label.Position = UDim2.fromOffset(7, 5)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Code
	label.TextSize = size
	label.TextColor3 = color
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextWrapped = true
	label.Text = ""
	label.Parent = gui
	return label
end
local terminalText: TextLabel? = nil
local alarmText: TextLabel? = nil
local paperText: TextLabel? = nil
local boardText: TextLabel? = nil
do
	local screenPart = room:WaitForChild("DeskScreen1", 10)
	if screenPart then
		terminalText = typed(surface(screenPart, 330), 14, Color3.fromRGB(110, 255, 140))
		terminalText.Text = "SKALA\nNOT READY"
	end
	local alarmPart = room:WaitForChild("DeskScreen2", 10)
	if alarmPart then
		alarmText = typed(surface(alarmPart, 330), 13, Color3.fromRGB(110, 255, 140))
		alarmText.Text = "ALARM SUMMARY\nNOT READY"
	end
	local paperPart = room:WaitForChild("PrinterPaper", 10)
	if paperPart then
		paperText = typed(surface(paperPart, 220), 11, Color3.fromRGB(30, 30, 34))
		paperText.TextYAlignment = Enum.TextYAlignment.Bottom
	end
	-- The shift chalkboard, kept up by the operators.
	local boardPart = room:WaitForChild("StatusBoard", 10)
	if boardPart then
		boardText = typed(surface(boardPart, 60), 20, Color3.fromRGB(236, 236, 226))
		boardText.Font = Enum.Font.PatrickHand
		boardText.Position = UDim2.fromOffset(18, 10)
		boardText.Size = UDim2.new(1, -30, 1, -16)
	end
end
-- What the shift board says the unit is doing.
local function unitMode(g: (string) -> number): string
	if g("core.destroyed") >= 0.5 then
		return "REACTOR DESTROYED"
	elseif g("n.power") < 0.05 and g("pri.temp") < 100 then
		return "COLD SHUTDOWN"
	elseif g("n.power") < 0.05 then
		return "HOT SHUTDOWN"
	elseif g("plant.gross") > 1 then
		return "POWER OPERATION"
	end
	return "STARTUP"
end
local function refreshDesk()
	local g = ctx.get
	local t = math.floor(g("time"))
	if alarmText then
		local lines = { "ALARM SUMMARY", "" }
		for _, tile in built.annTiles do
			if tile.state > 0 and #lines < 13 then
				local mark = if tile.state == 1 then "* " elseif tile.state == 3 then "- " else "  "
				table.insert(lines, mark .. string.upper(string.gsub(tile.label.Text, "\n", " ")))
			end
		end
		if #lines == 2 then
			table.insert(lines, "NO ALARMS")
		end
		alarmText.Text = table.concat(lines, "\n")
	end
	if boardText then
		boardText.Text = string.format(
			"UNIT 1 - SHIFT STATUS\nMODE:  %s\nREACTOR:  %.0f MWt  (%.1f %%)\nGROSS:  %.0f MWe\nORM:  %.0f RODS   (MIN 26)\nDRUMS:  %.2f MPa  %.0f C\nSCRAMS THIS SHIFT:  %d",
			unitMode(g), g("n.thermal"), g("n.power"), g("plant.gross"), g("core.orm"), g("pri.press"), g("pri.temp"), g("stats.scrams")
		)
	end
	if terminalText then
		terminalText.Text = string.format(
			"RBMK-800 UNIT 1   %02d:%02d:%02d\n\nPOWER  %7.2f %%  %5.0f MWT\nPERIOD %7.0f S\nMARGIN %7.0f RODS\nPRESS  %7.2f MPA %4.0f C\nFLOW   %7.0f T/H\nSTEAM  %7.0f  FEED %5.0f\nGROSS  %7.0f MWE",
			t // 3600, (t // 60) % 60, t % 60, g("n.power"), g("n.thermal"), g("n.period"), g("core.orm"), g("pri.press"), g("pri.temp"), g("pri.flow"), g("steam.total"), g("fw.total"), g("plant.gross")
		)
	end
	if paperText then
		local lines = built.logLines
		local shown = {}
		for i = math.max(1, #lines - 11), #lines do
			table.insert(shown, string.upper(lines[i]))
		end
		paperText.Text = table.concat(shown, "\n")
	end
end

-- Status banner: shown until the plant model is running, and when it is lost.
local screen = Instance.new("ScreenGui")
screen.Name = "RBMKStatus"
screen.ResetOnSpawn = false
screen.IgnoreGuiInset = true
screen.DisplayOrder = 20
screen.Parent = player:WaitForChild("PlayerGui")
local banner = Instance.new("TextLabel")
banner.AnchorPoint = Vector2.new(0.5, 0)
banner.Position = UDim2.new(0.5, 0, 0, 60)
banner.Size = UDim2.fromOffset(620, 54)
banner.BackgroundColor3 = Color3.fromRGB(20, 22, 24)
banner.BackgroundTransparency = 0.15
banner.BorderSizePixel = 0
banner.TextColor3 = Color3.fromRGB(240, 240, 230)
banner.Font = Enum.Font.SourceSansBold
banner.TextSize = 22
banner.Text = "Commissioning the unit: calculating the core..."
banner.Parent = screen
local flashOverlay = Instance.new("Frame")
flashOverlay.Size = UDim2.fromScale(1, 1)
flashOverlay.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
flashOverlay.BackgroundTransparency = 1
flashOverlay.BorderSizePixel = 0
flashOverlay.Parent = screen

local function stamp(t: number): string
	local s = math.floor(t)
	return string.format("%02d:%02d:%02d", s // 3600, (s // 60) % 60, s % 60)
end

local function addLog(lines: { any })
	for _, l in lines do
		table.insert(built.logLines, stamp(l.t) .. " " .. l.text)
	end
	while #built.logLines > 80 do
		table.remove(built.logLines, 1)
	end
end

local gotSnapshot = false
local snapshotCount = 0
local hornOn = false
local wasDestroyed = false
local destroyedAt = 0

snapshotEvent.OnClientEvent:Connect(function(buf: buffer)
	local n = math.min(#values, buffer.len(buf) // 4)
	for i = 1, n do
		values[i] = buffer.readf32(buf, (i - 1) * 4)
	end
	if not gotSnapshot then
		gotSnapshot = true
		banner.Visible = false
	end
	built.refresh()
	snapshotCount += 1
	if snapshotCount % 5 == 1 then
		refreshDesk()
	end

	local horn = ctx.get("horn") >= 0.5
	if horn ~= hornOn then
		hornOn = horn
		if horn then
			hornSound:Play()
		else
			hornSound:Stop()
		end
	end

	local destroyed = ctx.get("core.destroyed") >= 0.5
	if destroyed and not wasDestroyed then
		destroyedAt = os.clock()
		banner.Text = "THE REACTOR HAS BEEN DESTROYED\nA new unit will be commissioned shortly."
		banner.TextColor3 = Color3.fromRGB(255, 90, 70)
		banner.Visible = true
		flashOverlay.BackgroundTransparency = 0
	elseif not destroyed and wasDestroyed then
		banner.Visible = false
		banner.TextColor3 = Color3.fromRGB(240, 240, 230)
		table.clear(built.logLines)
	end
	wasDestroyed = destroyed
end)

mapEvent.OnClientEvent:Connect(function(buf: buffer)
	if built.setMap then
		built.setMap(buf)
	end
	if built.setRods then
		built.setRods(buf)
	end
end)

alarmEvent.OnClientEvent:Connect(function(index: number, state: number)
	built.setAlarm(index, state)
end)

logEvent.OnClientEvent:Connect(addLog)

-- Ask for the standing state; keep asking while the unit is still being built.
task.spawn(function()
	while true do
		local ok, state = pcall(function()
			return helloFunction:InvokeServer()
		end)
		if ok and state and state.ready then
			for i, s in state.alarms do
				built.setAlarm(i, s)
			end
			addLog(state.log)
			break
		end
		task.wait(1.5)
	end
end)

-- Annunciator flash, the camera shake of a destroyed core, and the fading flash.
local camera = workspace.CurrentCamera
local flashClock = 0
RunService.RenderStepped:Connect(function(dt: number)
	flashClock += dt
	built.flash(flashClock % 0.5 < 0.25, flashClock % 1.6 < 0.8)
	if wasDestroyed then
		local age = os.clock() - destroyedAt
		flashOverlay.BackgroundTransparency = math.clamp(age / 2.5, 0, 1)
		if age < 6 and camera then
			local k = 0.3 * (1 - age / 6)
			camera.CFrame *= CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Dresses the benchboards: every instrument, lamp, switch and display in the
-- shared layout is drawn here, on each player's own machine. The flat
-- artwork goes on a SurfaceGui per panel face. The hardware standing proud
-- of the panel (pushbuttons and their guards, lamps, switch handles, keys,
-- knobs) is built from parts.
--
-- build() returns the list of things that need refreshing when a new
-- snapshot arrives and the list of clickable regions on each face.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("RBMK")
local PanelLayout = require(Shared.PanelLayout)
local CoreLayout = require(Shared.CoreLayout)
local AlarmList = require(Shared.AlarmList)

local Panels = {}

local PPS = PanelLayout.PIXELS_PER_STUD
-- Widgets are placed and sized in board units; parts are made in studs.
local S = PanelLayout.SCALE

local INK = Color3.fromRGB(24, 26, 28)
local PAPER = Color3.fromRGB(232, 224, 198)
-- Soviet hardware of the period: numeric readouts are orange gas-discharge
-- indicators, the SKALA computer shows on a green-phosphor tube, and
-- nothing has a colour screen.
local SCREEN = Color3.fromRGB(18, 9, 5)
local DIGIT = Color3.fromRGB(255, 132, 40)
local DIGIT_DIM = Color3.fromRGB(52, 22, 10)
local TUBE = Color3.fromRGB(8, 18, 12)
local PHOSPHOR = Color3.fromRGB(110, 255, 140)
local LAMP = {
	red = { Color3.fromRGB(255, 50, 40), Color3.fromRGB(70, 22, 20) },
	green = { Color3.fromRGB(60, 240, 90), Color3.fromRGB(20, 60, 28) },
	amber = { Color3.fromRGB(255, 180, 40), Color3.fromRGB(74, 54, 18) },
	blue = { Color3.fromRGB(80, 150, 255), Color3.fromRGB(22, 40, 78) },
	white = { Color3.fromRGB(250, 250, 240), Color3.fromRGB(80, 80, 76) },
}
local BUTTON = {
	red = Color3.fromRGB(200, 30, 26),
	green = Color3.fromRGB(40, 150, 60),
	blue = Color3.fromRGB(50, 90, 190),
	yellow = Color3.fromRGB(225, 190, 40),
	white = Color3.fromRGB(235, 235, 228),
	black = Color3.fromRGB(34, 34, 36),
}
local PEN = { red = Color3.fromRGB(200, 30, 30), blue = Color3.fromRGB(30, 60, 200), green = Color3.fromRGB(20, 140, 50), violet = Color3.fromRGB(120, 40, 150) }
-- Mimic line colours, after the Soviet pipeline colour standard: water
-- green, steam red; emergency core cooling orange so it stands apart, and
-- electrical lines black.
local MIMIC = {
	water = Color3.fromRGB(34, 120, 60),
	steam = Color3.fromRGB(196, 44, 36),
	feed = Color3.fromRGB(70, 150, 70),
	eccs = Color3.fromRGB(226, 128, 24),
	power = Color3.fromRGB(28, 28, 30),
}
-- Lettering: condensed capitals like the stencilled and engraved labels on
-- Soviet boards, and a narrow face for the figures on scales.
local PLATE_FONT = Enum.Font.Oswald
local FIGURE_FONT = Enum.Font.RobotoCondensed
local ROD_COLOR = {
	RR = Color3.fromRGB(200, 200, 200),
	AR = Color3.fromRGB(70, 220, 100),
	LAR = Color3.fromRGB(240, 210, 60),
	AZ = Color3.fromRGB(240, 70, 60),
	USP = Color3.fromRGB(90, 150, 255),
}

export type Region = {
	x: number,
	y: number,
	w: number,
	h: number,
	widget: any,
	press: ((button: number, u: number, v: number) -> any)?,
	tip: (() -> string)?,
}

export type Context = {
	get: (name: string) -> number,
	send: (name: string, value: number) -> (),
	click: () -> (),
}

local function px(studs: number): number
	return math.floor(studs * PPS + 0.5)
end

local function box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.Position = UDim2.fromOffset(px(x), px(y))
	f.Size = UDim2.fromOffset(math.max(1, px(w)), math.max(1, px(h)))
	f.Parent = parent
	return f
end

local function text(parent: Instance, x: number, y: number, w: number, h: number, str: string, size: number, color: Color3?, font: Enum.Font?): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.BorderSizePixel = 0
	t.Position = UDim2.fromOffset(px(x), px(y))
	t.Size = UDim2.fromOffset(px(w), px(h))
	t.Font = font or Enum.Font.SourceSansBold
	t.TextSize = math.max(6, px(size))
	t.TextColor3 = color or INK
	t.TextWrapped = true
	t.Text = str
	t.Parent = parent
	return t
end

-- Engraved plastic nameplates: condensed white capitals on black for each
-- device, cream on dark brown-gray for system titles and panel names.
local PLATE = Color3.fromRGB(28, 28, 28)
local PLATE_TEXT = Color3.fromRGB(232, 230, 220)
local TITLE_PLATE = Color3.fromRGB(46, 42, 36)
local TITLE_TEXT = Color3.fromRGB(236, 226, 198)
local function plate(parent: Instance, x: number, y: number, w: number, h: number, str: string, size: number, dark: boolean?): TextLabel
	local t = text(parent, x, y, w, h, str, size, if dark then TITLE_TEXT else PLATE_TEXT, PLATE_FONT)
	t.BackgroundTransparency = 0
	t.BackgroundColor3 = if dark then TITLE_PLATE else PLATE
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 2)
	c.Parent = t
	if not dark then
		local edge = Instance.new("UIStroke")
		edge.Color = Color3.fromRGB(64, 62, 58)
		edge.Thickness = 1
		edge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		edge.Parent = t
	end
	return t
end

local function round(f: GuiObject)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = f
end

local function outline(f: GuiObject, color: Color3, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Parent = f
end

-- Small parts standing on a panel face.
local function basePart(folder: Instance, size: Vector3, color: Color3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = size * S
	p.Parent = folder
	return p
end

local function cylinder(folder: Instance, face: PanelLayout.Face, x: number, y: number, diameter: number, height: number, color: Color3): Part
	local p = basePart(folder, Vector3.new(height, diameter, diameter), color)
	p.Shape = Enum.PartType.Cylinder
	p.CFrame = CFrame.fromMatrix(PanelLayout.toWorld(face, x, y, height / 2), face.normal, face.up, -face.right)
	return p
end

-- A block lying on the face, turned `angle` degrees clockwise as the operator sees it.
local function blockCFrame(face: PanelLayout.Face, x: number, y: number, lift: number, angle: number): CFrame
	return CFrame.fromMatrix(PanelLayout.toWorld(face, x, y, lift), face.right, face.up, face.normal) * CFrame.Angles(0, 0, -math.rad(angle))
end

local function block(folder: Instance, face: PanelLayout.Face, x: number, y: number, w: number, h: number, depth: number, color: Color3, angle: number?): Part
	local p = basePart(folder, Vector3.new(w, h, depth), color)
	p.CFrame = blockCFrame(face, x, y, depth / 2, angle or 0)
	return p
end

-- A raised rectangular frame: four bars standing around a rectangle on the face.
local function bezel(folder: Instance, face: PanelLayout.Face, x: number, y: number, w: number, h: number, depth: number, color: Color3, thickness: number?)
	local t = thickness or 0.05
	block(folder, face, x + w / 2, y - t / 2, w + 2 * t, t, depth, color)
	block(folder, face, x + w / 2, y + h + t / 2, w + 2 * t, t, depth, color)
	block(folder, face, x - t / 2, y + h / 2, t, h, depth, color)
	block(folder, face, x + w + t / 2, y + h / 2, t, h, depth, color)
end

-- ---------------------------------------------------------------- hardware
-- The hardware standing proud of the panels is built from parts in the
-- frame of each device: X to the operator's right, Y up the panel, Z out of
-- it, in board units, with the origin at the device's mounting point on the
-- panel face. It follows Soviet control-room hardware, simplified: square
-- signal lamps and square pushbuttons in black housings, control keys with
-- black bar handles on square mounting plates, a big round AZ-5 under a
-- hinged cover. Blocks and cylinders only, no spheres.
local CHROME = Color3.fromRGB(200, 202, 206)
local PHENOLIC = Color3.fromRGB(22, 22, 24) -- black bakelite handles and knobs
local HOUSING = Color3.fromRGB(46, 48, 50) -- lamp and button housings, mounting plates
local BRASS = Color3.fromRGB(200, 168, 84)
local BEZEL = Color3.fromRGB(34, 35, 38)
local INDEX_WHITE = Color3.fromRGB(236, 236, 228)
local GUARD_BASE = Color3.fromRGB(40, 42, 44)
local COVER_RED = Color3.fromRGB(214, 44, 30)
local COVER_TRANSPARENCY = 0.45
local COVER_OPEN = 100 -- degrees a lifted guard cover stands open
local METAL = Enum.Material.Metal
local GLASS = Enum.Material.Glass

-- Turns a cylinder part, whose axis is its own X, to stand out of the panel.
local OUT_OF_PANEL = CFrame.Angles(0, -math.pi / 2, 0)

local function v3(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end

-- One part of a device, centred at `at`. `kind` is "block"; "disc", a
-- cylinder standing out of the panel (size: diameter, diameter, height);
-- or "rod", a cylinder lying along X (size: length, diameter, diameter).
-- Returns the part and where it sits in the device frame.
local function piece(folder: Instance, frame: CFrame, kind: string, size: Vector3, at: Vector3, color: Color3, material: Enum.Material?, transparency: number?): (Part, CFrame)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Transparency = transparency or 0
	local rel = CFrame.new(at * S)
	if kind == "disc" then
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(size.Z, size.Y, size.X) * S
		rel *= OUT_OF_PANEL
	elseif kind == "rod" then
		p.Shape = Enum.PartType.Cylinder
		p.Size = size * S
	else
		p.Size = size * S
	end
	p.CFrame = frame * rel
	p.Parent = folder
	return p, rel
end

-- Parts that move together in the device frame: a switch handle, a key, a
-- knob's pointer, a button's cap, a guard's cover. `move` places the whole
-- assembly by a CFrame in studs, in the device frame.
type Assembly = {
	add: (kind: string, size: Vector3, at: Vector3, color: Color3, material: Enum.Material?, transparency: number?) -> Part,
	move: (t: CFrame) -> (),
	parts: { Part },
}
local function assembly(folder: Instance, frame: CFrame): Assembly
	local parts: { Part } = {}
	local rels: { CFrame } = {}
	local self: any = { parts = parts }
	function self.add(kind: string, size: Vector3, at: Vector3, color: Color3, material: Enum.Material?, transparency: number?): Part
		local p, rel = piece(folder, frame, kind, size, at, color, material, transparency)
		table.insert(parts, p)
		table.insert(rels, rel)
		return p
	end
	function self.move(t: CFrame)
		for i, p in parts do
			p.CFrame = frame * t * rels[i]
		end
	end
	return self
end

-- A turn of `angle` degrees clockwise, as the operator sees it, about the
-- device's own axis.
local function turned(angle: number): CFrame
	return CFrame.Angles(0, 0, -math.rad(angle))
end

-- A signal lamp: a square coloured lens with a raised face in a square black
-- housing; glass when dark, glowing when lit. `size` is the lens's side.
local function lens(folder: Instance, face: PanelLayout.Face, x: number, y: number, size: number, colors: { Color3 }): (boolean) -> ()
	local frame = blockCFrame(face, x, y, 0, 0)
	local d = size
	piece(folder, frame, "block", v3(d + 0.09, d + 0.09, 0.035), v3(0, 0, 0.0175), HOUSING)
	piece(folder, frame, "block", v3(d + 0.04, d + 0.04, 0.055), v3(0, 0, 0.0275), PHENOLIC)
	local body = piece(folder, frame, "block", v3(d, d, 0.075), v3(0, 0, 0.0375), colors[2], GLASS)
	local top = piece(folder, frame, "block", v3(d * 0.7, d * 0.7, 0.02), v3(0, 0, 0.085), colors[2], GLASS)
	return function(on: boolean)
		for _, p in { body, top } do
			p.Color = colors[if on then 1 else 2]
			p.Material = if on then Enum.Material.Neon else GLASS
		end
	end
end

-- A pushbutton standing at `frame`: a square coloured cap with a raised
-- face in a square black housing. Returns the cap, which moves in when the
-- button is pressed.
local function pushbutton(folder: Instance, frame: CFrame, color: Color3): Assembly
	piece(folder, frame, "block", v3(0.4, 0.4, 0.035), v3(0, 0, 0.0175), HOUSING)
	piece(folder, frame, "block", v3(0.33, 0.33, 0.06), v3(0, 0, 0.03), PHENOLIC)
	local cap = assembly(folder, frame)
	cap.add("block", v3(0.27, 0.27, 0.12), v3(0, 0, 0.06), color)
	cap.add("block", v3(0.2, 0.2, 0.025), v3(0, 0, 0.1325), color)
	return cap
end

-- The AZ-5 button: a big round red button in a black ring, stepped in
-- towards its face.
local function scramButton(folder: Instance, frame: CFrame, color: Color3): Assembly
	piece(folder, frame, "disc", v3(0.6, 0.6, 0.035), v3(0, 0, 0.0175), PHENOLIC)
	piece(folder, frame, "disc", v3(0.52, 0.52, 0.08), v3(0, 0, 0.04), HOUSING)
	local cap = assembly(folder, frame)
	cap.add("disc", v3(0.44, 0.44, 0.2), v3(0, 0, 0.1), color)
	cap.add("disc", v3(0.34, 0.34, 0.04), v3(0, 0, 0.22), color)
	return cap
end

-- A guard for a protective pushbutton, `k` times the size of a standard
-- one: a base plate with rounded corners, two screws and hinge knuckles
-- along its top edge, under a hinged box of translucent red plastic with a
-- tab to lift it by. The button stands on the base. Returns the base's
-- thickness, the cover, and a function that swings the cover open by an
-- angle in degrees.
local function guard(folder: Instance, frame: CFrame, k: number, baseColor: Color3, coverHeight: number): (number, Assembly, (number) -> ())
	local half, base, r = 0.31 * k, 0.05 * k, 0.06 * k
	-- Two crossed blocks and four corner discs make the rounded plate.
	piece(folder, frame, "block", v3(2 * half, 2 * (half - r), base), v3(0, 0, base / 2), baseColor)
	piece(folder, frame, "block", v3(2 * (half - r), 2 * half, base), v3(0, 0, base / 2), baseColor)
	for _, sx in { -1, 1 } do
		for _, sy in { -1, 1 } do
			piece(folder, frame, "disc", v3(2 * r, 2 * r, base), v3(sx * (half - r), sy * (half - r), base / 2), baseColor)
		end
		piece(folder, frame, "disc", v3(0.06 * k, 0.06 * k, 0.012 * k), v3(sx * (half - 0.075 * k), -(half - 0.075 * k), base + 0.006 * k), CHROME, METAL)
		piece(folder, frame, "rod", v3(0.11 * k, 0.06 * k, 0.06 * k), v3(sx * 0.205 * k, half, base), baseColor)
	end
	local cover = assembly(folder, frame)
	local w, h, t = 2 * half - 0.03 * k, 2 * half - 0.05 * k, 0.02 * k
	local cy = -0.012 * k
	local top = base + coverHeight
	local wallH = coverHeight - t
	local wallZ = base + wallH / 2
	local function wall(size: Vector3, at: Vector3)
		cover.add("block", size, at, COVER_RED, GLASS, COVER_TRANSPARENCY)
	end
	wall(v3(w, h, t), v3(0, cy, top - t / 2))
	wall(v3(t, h, wallH), v3(-(w - t) / 2, cy, wallZ))
	wall(v3(t, h, wallH), v3((w - t) / 2, cy, wallZ))
	wall(v3(w - 2 * t, t, wallH), v3(0, cy - (h - t) / 2, wallZ))
	wall(v3(w - 2 * t, t, wallH), v3(0, cy + (h - t) / 2, wallZ))
	-- The lifting tab, the strap out to the hinge, and the hinge barrel.
	wall(v3(0.24 * k, 0.07 * k, t), v3(0, cy - h / 2 - 0.025 * k, top - 0.03 * k))
	wall(v3(0.28 * k, 0.05 * k, t), v3(0, half - 0.03 * k, base + 0.012 * k))
	cover.add("rod", v3(0.29 * k, 0.056 * k, 0.056 * k), v3(0, half, base), COVER_RED, GLASS, COVER_TRANSPARENCY)
	local function swing(angle: number)
		local hy, hz = half * S, base * S
		cover.move(CFrame.new(0, hy, hz) * CFrame.Angles(-math.rad(angle), 0, 0) * CFrame.new(0, -hy, -hz))
	end
	return base, cover, swing
end

-- Second switch positions that mean a piece of equipment is energised,
-- running or open: these switches get red and green lamps.
local EQUIPMENT_STATES = { ON = true, OPEN = true, CLOSE = true, RUN = true, START = true }
-- Annunciator windows are milky white plastic, lit from behind.
-- Light boxes stay dark until they light: smoked windows with their
-- legends faintly visible.
local ANN_DARK = Color3.fromRGB(62, 58, 50)
local ANN_DARK_TEXT = Color3.fromRGB(156, 148, 124)
local ANN_SPARE = Color3.fromRGB(50, 47, 41)

local function cleanLabel(s: string?): string
	return (string.gsub(s or "", "\n", " "))
end

-- A seven-segment display of the period: each digit is drawn segment by
-- segment, with the unlit segments faintly visible behind the glass, the
-- way a gas-discharge or LED panel meter looks. Returns a function that
-- shows a formatted number, right-aligned.
local SEGMENTS = {
	["0"] = "abcdef", ["1"] = "bc", ["2"] = "abdeg", ["3"] = "abcdg", ["4"] = "bcfg",
	["5"] = "acdfg", ["6"] = "acdefg", ["7"] = "abc", ["8"] = "abcdefg", ["9"] = "abcdfg",
	["-"] = "g", ["E"] = "adefg", ["r"] = "eg",
}
local function sevenSeg(parent: Instance, x: number, y: number, w: number, h: number, cells: number, lit: Color3, unlit: Color3): (string) -> ()
	local pad = h * 0.16
	local ch = h - 2 * pad
	local pitch = math.min((w - 2 * pad) / cells, ch * 0.68)
	local cw = pitch * 0.7
	local t = math.max(ch * 0.12, 0.022)
	local x0 = x + w - pad - pitch * cells + (pitch - cw) / 2
	local y0 = y + pad
	local half = ch / 2
	local shapes = {
		a = { t * 0.6, 0, cw - 1.2 * t, t },
		g = { t * 0.6, half - t / 2, cw - 1.2 * t, t },
		d = { t * 0.6, ch - t, cw - 1.2 * t, t },
		f = { 0, t * 0.55, t, half - t * 1.05 },
		e = { 0, half + t * 0.5, t, half - t * 1.05 },
		b = { cw - t, t * 0.55, t, half - t * 1.05 },
		c = { cw - t, half + t * 0.5, t, half - t * 1.05 },
	}
	local digits = {}
	for k = 1, cells do
		local cx = x0 + (k - 1) * pitch
		local segs = {}
		for name, r in shapes do
			local f = box(parent, cx + r[1], y0 + r[2], r[3], r[4], unlit)
			f.ZIndex = 3
			segs[name] = f
		end
		local dp = box(parent, cx + cw + (pitch - cw) / 2 - t / 2, y0 + ch - t, t, t, unlit)
		dp.ZIndex = 3
		digits[k] = { segs = segs, dp = dp }
	end
	local shown = ""
	return function(str: string)
		if str == shown then
			return
		end
		shown = str
		local chars: { { c: string, dp: boolean } } = {}
		for i = 1, #str do
			local c = string.sub(str, i, i)
			if c == "." then
				if #chars > 0 then
					chars[#chars].dp = true
				else
					table.insert(chars, { c = " ", dp = true })
				end
			else
				table.insert(chars, { c = c, dp = false })
			end
		end
		if #chars > cells then
			-- Over range: the display shows dashes.
			chars = {}
			for _ = 1, cells do
				table.insert(chars, { c = "-", dp = false })
			end
		end
		local offset = cells - #chars
		for k = 1, cells do
			local cell = chars[k - offset]
			local on = if cell then SEGMENTS[cell.c] or "" else ""
			for name, f in digits[k].segs do
				f.BackgroundColor3 = if string.find(on, name, 1, true) then lit else unlit
			end
			digits[k].dp.BackgroundColor3 = if cell and cell.dp then lit else unlit
		end
	end
end

-- The channel cartogram is a mosaic of lamps, one per channel, and a lamp
-- has only a handful of states: dark, dim green, green, yellow, amber, red.
local LAMP_STEPS = {
	{ 0.10, Color3.fromRGB(34, 36, 34) },
	{ 0.30, Color3.fromRGB(26, 84, 40) },
	{ 0.50, Color3.fromRGB(58, 214, 84) },
	{ 0.65, Color3.fromRGB(238, 220, 60) },
	{ 0.80, Color3.fromRGB(255, 150, 40) },
	{ 2.00, Color3.fromRGB(255, 52, 40) },
}
local PALETTE: { Color3 } = {}
for i = 0, 31 do
	local t = (i + 0.5) / 32
	for _, step in LAMP_STEPS do
		if t < step[1] then
			PALETTE[i + 1] = step[2]
			break
		end
	end
end

function Panels.build(room: Instance, ctx: Context)
	local get = ctx.get
	local updaters: { () -> () } = {}
	local regions: { [Instance]: { Region } } = {}
	local faces: { [Instance]: PanelLayout.Face } = {}
	local annTiles: { [number]: any } = {}
	local logLines: { string } = {}
	local out: any = { updaters = updaters, regions = regions, faces = faces, annTiles = annTiles, logLines = logLines }

	local controls = Instance.new("Folder")
	controls.Name = "PanelControls"
	controls.Parent = room
	-- Displays fed from the rod section of the core map buffer.
	local rodListeners: { (buf: buffer) -> () } = {}
	-- Panels whose annunciator TEST button is held.
	local testing: { [string]: boolean } = {}

	-- A pane of glass over an instrument window.
	local function glassOver(face: PanelLayout.Face, cx: number, cy: number, w: number, h: number)
		local g = basePart(controls, Vector3.new(w, h, 0.01), Color3.fromRGB(214, 226, 236))
		g.CFrame = blockCFrame(face, cx, cy, 0.1, 0)
		g.Material = Enum.Material.Glass
		g.Transparency = 0.9
		g.Reflectance = 0.1
	end

	-- A display that gives its own light (digits, the cartogram, the
	-- computer's tube) is drawn on a thin part just in front of the board,
	-- with a GUI that ignores the room lighting; everything printed or
	-- engraved on the board itself is lit like the board. Returns a canvas
	-- placed so that face coordinates can be used for drawing on it.
	local overlayCount = 0
	local function overlay(face: PanelLayout.Face, part: Instance, x: number, y: number, w: number, h: number): Frame
		overlayCount += 1
		local p = Instance.new("Part")
		p.Name = "Display"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Transparency = 1
		p.Size = Vector3.new(w * S, h * S, 0.02)
		local z = -face.normal
		local yv = face.up
		p.CFrame = CFrame.fromMatrix(PanelLayout.toWorld(face, x + w / 2, y + h / 2, 0.012), yv:Cross(z), yv, z)
		p:SetAttribute("Overlay", true)
		p:SetAttribute("Panel", part:GetAttribute("Panel"))
		p:SetAttribute("Face", tostring(part:GetAttribute("Face")) .. "_d" .. overlayCount)
		p.Parent = controls
		local g = Instance.new("SurfaceGui")
		g.Face = Enum.NormalId.Front
		g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		g.PixelsPerStud = PPS / S
		g.LightInfluence = 0
		g.ResetOnSpawn = false
		g.Adornee = p
		g.Parent = p
		local canvas = Instance.new("Frame")
		canvas.BackgroundTransparency = 1
		canvas.BorderSizePixel = 0
		canvas.Position = UDim2.fromOffset(-px(x), -px(y))
		canvas.Size = UDim2.fromOffset(px(face.width), px(face.height))
		canvas.Parent = g
		return canvas
	end

	local builders: { [string]: (gui: SurfaceGui, face: PanelLayout.Face, part: Instance, w: any) -> () } = {}

	local function region(part: Instance, w: any, press: any, tip: any)
		table.insert(regions[part], { x = w.x, y = w.y, w = w.w, h = w.h, widget = w, press = press, tip = tip })
	end

	local function valueTip(w: any): () -> string
		return function()
			local s = string.format("%s: " .. (w.fmt or "%.1f") .. " %s", cleanLabel(w.label), get(w.sig), w.unit or "")
			if w.tip then
				s ..= "\n" .. w.tip
			end
			return s
		end
	end

	-- Group nameplate: white letters on a black plate, centred over the
	-- devices of one system. Boards of the period had no outline boxes; the
	-- grouping is carried by these plates and by the spacing.
	builders.section = function(gui, _face, _part, w)
		if w.label ~= "" then
			local pw = math.min(w.w, #w.label * 0.072 + 0.4)
			plate(gui, w.x + (w.w - pw) / 2, w.y + 0.02, pw, 0.22, w.label, 0.1, true)
		end
	end

	builders.label = function(gui, _face, _part, w)
		if w.title then
			-- The panel number and name on a modest plate centred at the top.
			local pw = math.min(w.w, #w.label * 0.15 + 0.8)
			plate(gui, w.x + (w.w - pw) / 2, w.y + 0.02, pw, w.h - 0.06, w.label, 0.22, true)
			return
		end
		local t = text(gui, w.x, w.y, w.w, w.h, w.label, if w.small then 0.16 else 0.18, INK)
		if w.small then
			t.TextXAlignment = Enum.TextXAlignment.Left
			t.TextYAlignment = Enum.TextYAlignment.Top
			t.Font = Enum.Font.SourceSans
		end
	end

	-- An edgewise meter of the GE type 180 kind: a narrow black case with a
	-- white scale behind glass, graduated in twenty divisions with figures at
	-- every fifth, the unit printed at the foot, coloured bands for the
	-- limits, and a red pointer. Its nameplate sits above it.
	builders.meter = function(gui, face, part, w)
		-- Every meter's nameplate is the same height, so a row lines up.
		local plateH = 0.3
		plate(gui, w.x - 0.02, w.y, w.w + 0.04, plateH, w.label, 0.08)
		local cy0 = w.y + plateH + 0.05
		local ch = w.h - plateH - 0.05
		box(gui, w.x, cy0, w.w, ch, Color3.fromRGB(24, 24, 26))
		local inset = 0.055
		local sx, sy, sw, sh = w.x + inset, cy0 + inset, w.w - 2 * inset, ch - 2 * inset
		box(gui, sx, sy, sw, sh, PAPER)
		local hasUnit = (w.unit or "") ~= ""
		local top, bottom = sy + 0.09, sy + sh - (if hasUnit then 0.24 else 0.09)
		local gh = bottom - top
		local span = w.hi - w.lo
		local function yOf(f: number): number
			return bottom - gh * f
		end
		local function band(from: number, to: number, color: Color3)
			local a = math.clamp((from - w.lo) / span, 0, 1)
			local b = math.clamp((to - w.lo) / span, 0, 1)
			if b > a then
				box(gui, sx + sw * 0.78, yOf(b), sw * 0.22, gh * (b - a), color)
			end
		end
		if w.amber then
			band(w.amber, w.red or w.hi, Color3.fromRGB(240, 180, 40))
		end
		if w.red then
			band(w.red, w.hi, Color3.fromRGB(214, 44, 36))
		end
		if w.low then
			band(w.lo, w.low, Color3.fromRGB(214, 44, 36))
		end
		box(gui, sx + 0.012, top, 0.01, gh, INK).ZIndex = 2
		for i = 0, 20 do
			local ty = yOf(i / 20)
			local major = i % 5 == 0
			local tick = box(gui, sx + 0.012, ty - (if major then 0.008 else 0.004), sw * (if major then 0.3 else 0.16), if major then 0.016 else 0.008, INK)
			tick.ZIndex = 2
			if major then
				local v = w.lo + span * i / 20
				local label
				if math.abs(v) >= 1000 then
					label = if v % 1000 == 0 then string.format("%.0fk", v / 1000) else string.format("%.1fk", v / 1000)
				elseif span < 2 then
					label = string.format("%.2f", v)
				elseif span < 20 and v % 1 ~= 0 then
					label = string.format("%.1f", v)
				else
					label = string.format("%.0f", v)
				end
				local n = text(gui, sx + sw * 0.36, ty - 0.065, sw * 0.5, 0.13, label, 0.074, INK, FIGURE_FONT)
				n.TextXAlignment = Enum.TextXAlignment.Left
				n.ZIndex = 2
			end
		end
		if hasUnit then
			local u = text(gui, sx, bottom + 0.08, sw, 0.13, w.unit, 0.072, Color3.fromRGB(50, 50, 50), PLATE_FONT)
			u.ZIndex = 2
		end
		-- The case flange and the glass are parts standing off the board.
		bezel(controls, face, w.x + 0.02, cy0 + 0.02, w.w - 0.04, ch - 0.04, 0.12, BEZEL, 0.04)
		glassOver(face, sx + sw / 2, sy + sh / 2, sw, sh)
		local needle = block(controls, face, sx + sw / 2, bottom, sw + 0.02, 0.03, 0.025, Color3.fromRGB(205, 22, 22))
		local last = math.huge
		table.insert(updaters, function()
			local v = get(w.sig)
			if v ~= last then
				last = v
				local f = math.clamp((v - w.lo) / span, 0, 1)
				needle.CFrame = blockCFrame(face, sx + sw / 2, yOf(f), 0.05, 0)
			end
		end)
		region(part, w, nil, valueTip(w))
	end

	-- A horizontal edgewise meter: nameplate above, a black case with a white
	-- scale behind glass, graduated in ten, and a red pointer.
	builders.hmeter = function(gui, face, part, w)
		plate(gui, w.x + 0.04, w.y, w.w - 0.08, 0.2, w.label, 0.072)
		local mx, my, mw, mh = w.x + 0.07, w.y + 0.27, w.w - 0.14, w.h - 0.31
		box(gui, mx - 0.045, my - 0.045, mw + 0.09, mh + 0.09, Color3.fromRGB(24, 24, 26))
		box(gui, mx, my, mw, mh, PAPER)
		local span = w.hi - w.lo
		local function xOf(v: number): number
			return mx + 0.05 + (mw - 0.1) * math.clamp((v - w.lo) / span, 0, 1)
		end
		if w.red then
			box(gui, xOf(w.red), my, xOf(w.hi) - xOf(w.red), 0.05, Color3.fromRGB(214, 44, 36)).ZIndex = 2
		end
		if w.low then
			box(gui, xOf(w.lo), my, xOf(w.low) - xOf(w.lo), 0.05, Color3.fromRGB(214, 44, 36)).ZIndex = 2
		end
		for i = 0, 10 do
			local major = i % 5 == 0
			box(gui, mx + 0.05 + (mw - 0.1) * i / 10 - 0.004, my + mh - (if major then 0.12 else 0.065), 0.008, if major then 0.12 else 0.065, INK).ZIndex = 2
		end
		local lo = text(gui, mx + 0.02, my + 0.03, 0.45, 0.1, string.format("%g", w.lo), 0.068, INK, FIGURE_FONT)
		lo.TextXAlignment = Enum.TextXAlignment.Left
		lo.ZIndex = 2
		local hi = text(gui, mx + mw - 0.47, my + 0.03, 0.45, 0.1, string.format("%g", w.hi), 0.068, INK, FIGURE_FONT)
		hi.TextXAlignment = Enum.TextXAlignment.Right
		hi.ZIndex = 2
		if (w.unit or "") ~= "" then
			text(gui, mx + mw / 2 - 0.3, my + 0.03, 0.6, 0.1, w.unit, 0.062, Color3.fromRGB(70, 70, 70), PLATE_FONT).ZIndex = 2
		end
		bezel(controls, face, mx - 0.025, my - 0.025, mw + 0.05, mh + 0.05, 0.08, BEZEL, 0.03)
		glassOver(face, mx + mw / 2, my + mh / 2, mw, mh)
		local pointer = block(controls, face, mx, my + mh / 2, 0.022, mh + 0.01, 0.025, Color3.fromRGB(205, 22, 22))
		local last = math.huge
		table.insert(updaters, function()
			local v = get(w.sig)
			if v ~= last then
				last = v
				pointer.CFrame = blockCFrame(face, xOf(v), my + mh / 2, 0.05, 0)
			end
		end)
		region(part, w, nil, valueTip(w))
	end

	-- A digital panel meter of the late 1970s: a black bezel with red LED
	-- digits, or, with `counter`, a mechanical counter of white figures on
	-- black drums. The nameplate above gives the quantity and unit.
	builders.digital = function(gui, face, part, w)
		local name = if (w.unit or "") ~= "" then w.label .. ", " .. w.unit else w.label
		plate(gui, w.x, w.y, w.w, 0.2, name, 0.075)
		local bx, by, bw, bh = w.x, w.y + 0.24, w.w, w.h - 0.24
		local cells = w.cells or #(string.gsub(string.format(w.fmt, -8888.88), "[%.%+]", ""))
		box(gui, bx, by, bw, bh, Color3.fromRGB(26, 26, 28))
		bezel(controls, face, bx + 0.015, by + 0.015, bw - 0.03, bh - 0.03, 0.07, BEZEL, 0.03)
		local show: (string) -> ()
		if w.counter then
			-- White figures on black drums, each in its own window.
			local cw = math.min((bw - 0.12) / cells, (bh - 0.1) * 0.7)
			local x0 = bx + bw - 0.06 - cw * cells
			local drums = {}
			for k = 1, cells do
				local d = text(gui, x0 + (k - 1) * cw + 0.008, by + 0.06, cw - 0.016, bh - 0.12, "0", (bh - 0.12) * 0.8, Color3.fromRGB(236, 236, 228), PLATE_FONT)
				d.BackgroundTransparency = 0
				d.BackgroundColor3 = Color3.fromRGB(12, 12, 14)
				d.ZIndex = 2
				drums[k] = d
			end
			show = function(str: string)
				local digits = string.gsub(str, "[^%d]", "")
				digits = string.rep("0", math.max(0, cells - #digits)) .. digits
				digits = string.sub(digits, -cells)
				for k = 1, cells do
					drums[k].Text = string.sub(digits, k, k)
				end
			end
		else
			local canvas = overlay(face, part, bx + 0.05, by + 0.05, bw - 0.1, bh - 0.1)
			box(canvas, bx + 0.05, by + 0.05, bw - 0.1, bh - 0.1, SCREEN)
			show = sevenSeg(canvas, bx + 0.05, by + 0.05, bw - 0.1, bh - 0.1, cells, DIGIT, DIGIT_DIM)
		end
		local last = math.huge
		table.insert(updaters, function()
			local v = get(w.sig)
			if v ~= last then
				last = v
				show((string.gsub(string.format(w.fmt, v), "%+", "")))
			end
		end)
		region(part, w, nil, valueTip(w))
	end

	-- An indicating light: a domed lens in a black bezel, with its legend
	-- on a nameplate beside it.
	builders.lamp = function(gui, face, part, w)
		local d = math.min(0.2, w.h - 0.1)
		local setLens = lens(controls, face, w.x + 0.05 + d / 2, w.y + w.h / 2, d, LAMP[w.color])
		plate(gui, w.x + d + 0.15, w.y + (w.h - 0.2) / 2, w.w - d - 0.17, 0.2, w.label, 0.075)
		local lastOn: boolean? = nil
		local function isOn(): boolean
			local v = get(w.sig)
			if w.eq then
				return v == w.eq
			elseif w.lt then
				return v < w.lt
			end
			return v > (w.gt or 0.5)
		end
		table.insert(updaters, function()
			local on = isOn()
			if on ~= lastOn then
				lastOn = on
				setLens(on)
			end
		end)
		region(part, w, nil, function()
			return cleanLabel(w.label) .. (if isOn() then ": ON" else ": off")
		end)
	end

	-- A pushbutton with its nameplate below. The protective functions (AZ-5,
	-- ECCS initiation, the turbine trips) are guarded: the button stands on
	-- a guard base under a hinged translucent cover, which has to be lifted
	-- before the button can be pressed, as the AZ-5 cover was on the real
	-- unit. AZ-5 itself is a big round red button with a red nameplate.
	builders.button = function(gui, face, part, w)
		local big, guarded = w.big, w.guard
		local k = if big then 1.65 else 1
		local half = 0.31 * k
		local ring = if big then 0.3 else 0.2 -- half the width of the housing
		local cx = w.x + w.w / 2
		local cy = if guarded then w.y + half + 0.07 else w.y + ring + 0.02
		local mount = blockCFrame(face, cx, cy, 0, 0)
		local color = BUTTON[w.color]
		local seat = mount
		local swing: (number) -> () = function(_angle: number) end
		if guarded then
			local base, cover, swingCover = guard(controls, mount, k, GUARD_BASE, if big then 0.36 else 0.24)
			seat = mount * CFrame.new(0, 0, base * S)
			swing = swingCover
			cover.parts[1]:SetAttribute("Guard", w.cmd)
		end
		local cap = if big then scramButton(controls, seat, color) else pushbutton(controls, seat, color)
		local plateY = (if guarded then cy + half else cy + ring) + 0.05
		local name = plate(gui, w.x - 0.02, plateY, w.w + 0.04, math.min(0.3, w.y + w.h - plateY), w.label, if big then 0.13 else 0.075)
		if big then
			name.BackgroundColor3 = Color3.fromRGB(176, 30, 26)
			name.TextColor3 = Color3.fromRGB(250, 250, 244)
		end

		-- The cover swings about the hinge along the top edge of the guard.
		local open = false
		local angle = 0
		local swings = 0
		local function swingTo(target: number)
			swings += 1
			local mine = swings
			local from = angle
			task.spawn(function()
				for step = 1, 8 do
					if swings ~= mine then
						return
					end
					angle = from + (target - from) * step / 8
					swing(angle)
					task.wait(0.02)
				end
			end)
		end

		region(part, w, function(button: number)
			if guarded then
				if button == 2 then
					if open then
						open = false
						ctx.click()
						swingTo(0)
					end
					return nil
				elseif not open then
					open = true
					ctx.click()
					swingTo(COVER_OPEN)
					return nil
				end
			elseif button == 2 then
				return nil
			end
			ctx.click()
			cap.move(CFrame.new(0, 0, -0.05 * S))
			task.delay(0.15, function()
				cap.move(CFrame.new())
			end)
			if w.hold then
				return { hold = w.cmd, value = w.value }
			end
			ctx.send(w.cmd, w.value)
			return nil
		end, function()
			local name = cleanLabel(w.label)
			if guarded then
				return if open
					then name .. " (cover lifted)\nclick to press, right-click to close the cover"
					else name .. " (guarded)\nclick to lift the cover"
			end
			return name .. (if w.hold then " (hold)" else "")
		end)
	end

	-- A control key of the Soviet kind, pointing up and turned `angle`
	-- degrees, `k` times the standard size; returns a function that turns
	-- it. A square black mounting plate and a round boss carry a flat black
	-- bar handle, rounded at the end that points at the position and marked
	-- along it with a white line.
	local function controlKey(face: PanelLayout.Face, hx: number, hy: number, angle: number, k: number?): (number) -> ()
		local s = k or 1
		local frame = blockCFrame(face, hx, hy, 0, 0)
		piece(controls, frame, "block", v3(0.34 * s, 0.34 * s, 0.03), v3(0, 0, 0.015), HOUSING)
		piece(controls, frame, "disc", v3(0.2 * s, 0.2 * s, 0.06), v3(0, 0, 0.03), PHENOLIC)
		local handle = assembly(controls, frame)
		local z = 0.06 + 0.04 * s
		handle.add("block", v3(0.11 * s, 0.4 * s, 0.08 * s), v3(0, 0.07 * s, z), PHENOLIC)
		handle.add("disc", v3(0.11 * s, 0.11 * s, 0.08 * s), v3(0, 0.27 * s, z), PHENOLIC)
		handle.add("block", v3(0.024 * s, 0.2 * s, 0.082 * s), v3(0, 0.17 * s, z), INDEX_WHITE)
		local function turn(a: number)
			handle.move(turned(a))
		end
		turn(angle)
		return turn
	end

	-- A control switch module: nameplate, a pair of indicating lamps, and
	-- a black escutcheon engraved with the two positions, carrying either a
	-- pistol-grip handle or a key lock. Returns a function that sets it.
	local function controlModule(gui: Instance, face: PanelLayout.Face, w: any, key: boolean?, lamps: { { Color3 } }?): (boolean) -> ()
		-- One nameplate height for every module, so a row lines up.
		local plateH = 0.28
		if w.label ~= "" then
			plate(gui, w.x + 0.02, w.y, w.w - 0.04, plateH, w.label, 0.075)
		end
		local cx = w.x + w.w / 2
		local setA, setB
		local ey = w.y + plateH + 0.06
		if lamps then
			local ly = w.y + plateH + 0.15
			setA = lens(controls, face, cx - 0.2, ly, 0.15, lamps[1])
			setB = lens(controls, face, cx + 0.2, ly, 0.15, lamps[2])
			ey = ly + 0.13
		end
		local ew = math.min(w.w - 0.06, 0.74)
		local eh = math.min(0.62, w.y + w.h - ey - 0.02)
		box(gui, cx - ew / 2, ey, ew, eh, Color3.fromRGB(22, 22, 24))
		local white = Color3.fromRGB(232, 232, 224)
		local pos = w.positions or { "OFF", "ON" }
		local left = text(gui, cx - ew / 2 + 0.03, ey + 0.025, ew / 2 - 0.03, 0.11, pos[1], 0.062, white, PLATE_FONT)
		left.TextXAlignment = Enum.TextXAlignment.Left
		left.TextWrapped = false
		local right = text(gui, cx, ey + 0.025, ew / 2 - 0.03, 0.11, pos[2], 0.062, white, PLATE_FONT)
		right.TextXAlignment = Enum.TextXAlignment.Right
		right.TextWrapped = false
		local hx, hy = cx, ey + eh * 0.62
		local set: (boolean) -> ()
		if key then
			-- A chrome lock cylinder with a brass key standing in it.
			local frame = blockCFrame(face, hx, hy, 0, 0)
			piece(controls, frame, "disc", v3(0.3, 0.3, 0.025), v3(0, 0, 0.0125), CHROME, METAL)
			piece(controls, frame, "disc", v3(0.25, 0.25, 0.07), v3(0, 0, 0.035), CHROME, METAL)
			piece(controls, frame, "disc", v3(0.16, 0.16, 0.074), v3(0, 0, 0.037), Color3.fromRGB(150, 151, 155), METAL)
			local keyParts = assembly(controls, frame)
			keyParts.add("block", v3(0.03, 0.08, 0.06), v3(0, 0, 0.1), BRASS, METAL)
			keyParts.add("block", v3(0.034, 0.13, 0.03), v3(0, 0, 0.14), BRASS, METAL)
			keyParts.add("rod", v3(0.03, 0.2, 0.2), v3(0, 0, 0.25), BRASS, METAL)
			set = function(on: boolean)
				keyParts.move(turned(if on then 45 else -45))
			end
		else
			local turn = controlKey(face, hx, hy, -45, 0.78)
			set = function(on: boolean)
				turn(if on then 45 else -45)
			end
		end
		return function(on: boolean)
			set(on)
			if setA then
				setA(not on)
				setB(on)
			end
		end
	end

	builders.toggle = function(gui, face, part, w)
		local lamps = nil
		if not w.key then
			local equipment = EQUIPMENT_STATES[w.positions[2]] == true
			lamps = if equipment then { LAMP.green, LAMP.red } else { LAMP.white, LAMP.white }
		end
		local set = controlModule(gui, face, w, w.key, lamps)
		local last: boolean? = nil
		table.insert(updaters, function()
			local on = get(w.sig) >= 0.5
			if on ~= last then
				last = on
				set(on)
			end
		end)
		region(part, w, function(_button: number)
			ctx.click()
			ctx.send(w.cmd, if get(w.sig) >= 0.5 then 0 else 1)
			return nil
		end, function()
			return cleanLabel(w.label) .. ": " .. (if get(w.sig) >= 0.5 then w.positions[2] else w.positions[1]) .. (if w.key then " (key switch)" else "")
		end)
	end

	-- A pump motor's breaker control switch: green lamp stopped, red running.
	builders.pump = function(gui, face, part, w)
		w.positions = w.positions or { "STOP", "START" }
		local set = controlModule(gui, face, w, false, { LAMP.green, LAMP.red })
		local last: boolean? = nil
		table.insert(updaters, function()
			local on = get(w.sig) >= 0.5
			if on ~= last then
				last = on
				set(on)
			end
		end)
		region(part, w, function(_button: number)
			ctx.click()
			ctx.send(w.cmd, if get(w.sig) >= 0.5 then 0 else 1)
			return nil
		end, function()
			return cleanLabel(w.label) .. (if get(w.sig) >= 0.5 then ": RUNNING" else ": stopped")
		end)
	end

	-- A rotary selector: a black knob with a white pointer line, and a
	-- legend window under it showing the selected position.
	builders.selector = function(gui, face, part, w)
		if w.label ~= "" then
			plate(gui, w.x + 0.03, w.y, w.w - 0.06, 0.2, w.label, 0.075)
		end
		local cx, cy = w.x + w.w / 2, w.y + 0.56
		local esc = box(gui, cx - 0.32, cy - 0.3, 0.64, 0.6, Color3.fromRGB(22, 22, 24))
		local _ = esc
		local n = #w.positions
		-- A black knob: a skirt, a body with a stepped top, and a bar across
		-- it, rounded at the ends, with a white line on the end that points.
		local frame = blockCFrame(face, cx, cy, 0, 0)
		piece(controls, frame, "disc", v3(0.44, 0.44, 0.035), v3(0, 0, 0.0175), PHENOLIC)
		piece(controls, frame, "disc", v3(0.34, 0.34, 0.11), v3(0, 0, 0.055), PHENOLIC)
		piece(controls, frame, "disc", v3(0.28, 0.28, 0.02), v3(0, 0, 0.12), PHENOLIC)
		local pointer = assembly(controls, frame)
		pointer.add("block", v3(0.08, 0.34, 0.05), v3(0, 0.02, 0.14), PHENOLIC)
		pointer.add("disc", v3(0.08, 0.08, 0.05), v3(0, 0.19, 0.14), PHENOLIC)
		pointer.add("disc", v3(0.08, 0.08, 0.05), v3(0, -0.15, 0.14), PHENOLIC)
		pointer.add("block", v3(0.024, 0.15, 0.052), v3(0, 0.105, 0.14), Color3.fromRGB(235, 235, 228))
		local readout = plate(gui, w.x + 0.08, w.y + 0.93, w.w - 0.16, 0.26, "", 0.12, true)
		local function index(): number
			return math.clamp(math.floor(get(w.sig) - w.base + 1.5), 1, n)
		end
		local last = 0
		table.insert(updaters, function()
			local i = index()
			if i ~= last then
				last = i
				local angle = if n > 1 then -120 + (i - 1) / (n - 1) * 240 else 0
				pointer.move(turned(angle))
				readout.Text = w.positions[i]
			end
		end)
		region(part, w, function(button: number)
			ctx.click()
			local i = math.clamp(index() + (if button == 2 then -1 else 1), 1, n)
			ctx.send(w.cmd, w.base + i - 1)
			return nil
		end, function()
			return cleanLabel(w.label) .. ": " .. w.positions[index()] .. "\nleft click = next, right click = previous"
		end)
	end

	-- A raise/lower control: a spring-return switch engraved LOWER and
	-- RAISE under a small horizontal position meter (or, for a setpoint, a
	-- digital readout). Hold the handle to one side; it springs back.
	builders.jog = function(gui, face, part, w)
		plate(gui, w.x + 0.04, w.y, w.w - 0.08, 0.2, w.label, 0.075)
		local suffix = if w.unit ~= "" then " " .. w.unit else ""
		local mx, my, mw, mh = w.x + 0.08, w.y + 0.27, w.w - 0.16, 0.3
		local show: (number) -> ()
		box(gui, mx - 0.04, my - 0.04, mw + 0.08, mh + 0.08, Color3.fromRGB(24, 24, 26))
		if w.digits then
			local canvas = overlay(face, part, mx, my, mw, mh)
			box(canvas, mx, my, mw, mh, SCREEN)
			local seg = sevenSeg(canvas, mx, my, mw, mh, #(string.gsub(string.format(w.fmt, -888.88), "[%.%+]", "")), DIGIT, DIGIT_DIM)
			show = function(v: number)
				seg((string.gsub(string.format(w.fmt, v), "%+", "")))
			end
		else
			box(gui, mx, my, mw, mh, PAPER)
			for i = 0, 10 do
				local major = i % 5 == 0
				box(gui, mx + 0.05 + (mw - 0.1) * i / 10 - 0.004, my + mh - (if major then 0.13 else 0.07), 0.008, if major then 0.13 else 0.07, INK).ZIndex = 2
			end
			local lo = text(gui, mx + 0.02, my + 0.015, 0.4, 0.11, string.format("%g", w.lo or 0), 0.072, INK, FIGURE_FONT)
			lo.TextXAlignment = Enum.TextXAlignment.Left
			lo.ZIndex = 2
			local hi = text(gui, mx + mw - 0.42, my + 0.015, 0.4, 0.11, string.format("%g", w.hi or 100), 0.072, INK, FIGURE_FONT)
			hi.TextXAlignment = Enum.TextXAlignment.Right
			hi.ZIndex = 2
			if w.unit ~= "" then
				text(gui, mx + mw / 2 - 0.3, my + 0.015, 0.6, 0.11, w.unit, 0.066, Color3.fromRGB(70, 70, 70), PLATE_FONT).ZIndex = 2
			end
			bezel(controls, face, mx - 0.02, my - 0.02, mw + 0.04, mh + 0.04, 0.08, BEZEL, 0.03)
			glassOver(face, mx + mw / 2, my + mh / 2, mw, mh)
			local pointer = block(controls, face, mx, my + mh / 2, 0.025, mh + 0.02, 0.025, Color3.fromRGB(205, 22, 22))
			local span = (w.hi or 100) - (w.lo or 0)
			show = function(v: number)
				local f = math.clamp((v - (w.lo or 0)) / span, 0, 1)
				pointer.CFrame = blockCFrame(face, mx + 0.05 + (mw - 0.1) * f, my + mh / 2, 0.05, 0)
			end
		end
		-- The spring-return switch.
		local cx = w.x + w.w / 2
		local ey = my + mh + 0.12
		local ew, eh = math.min(w.w - 0.1, 0.9), math.max(0.4, w.y + w.h - ey - 0.02)
		box(gui, cx - ew / 2, ey, ew, eh, Color3.fromRGB(22, 22, 24))
		local white = Color3.fromRGB(232, 232, 224)
		local l = text(gui, cx - ew / 2 + 0.03, ey + 0.02, ew / 2, 0.11, "LESS", 0.066, white, PLATE_FONT)
		l.TextXAlignment = Enum.TextXAlignment.Left
		local r = text(gui, cx - 0.03, ey + 0.02, ew / 2, 0.11, "MORE", 0.066, white, PLATE_FONT)
		r.TextXAlignment = Enum.TextXAlignment.Right
		local turn = controlKey(face, cx, ey + eh * 0.66, 0, 0.85)
		local last = math.huge
		table.insert(updaters, function()
			local v = get(w.sig)
			if v ~= last then
				last = v
				show(v)
			end
		end)
		region(part, w, function(_button: number, u: number)
			ctx.click()
			local up = u > cx
			turn(if up then 40 else -40)
			return {
				hold = w.cmd,
				value = if up then 1 else -1,
				onRelease = function()
					turn(0)
				end,
			}
		end, function()
			return string.format("%s: " .. w.fmt .. "%s\nhold the key to the left for LESS, to the right for MORE", cleanLabel(w.label), get(w.sig), suffix)
		end)
	end

	-- A strip-chart recorder: a dark case with a glazed door, chart paper
	-- ruled in ten divisions, and pens that write along a line near the top
	-- of the window while the paper carries the trace down and away. A
	-- legend under the window names each pen and its range.
	builders.recorder = function(gui, face, part, w)
		plate(gui, w.x + 0.1, w.y, w.w - 0.2, 0.22, w.label, 0.115)
		local cx, cy, cw, ch = w.x, w.y + 0.27, w.w, w.h - 0.27
		local case = box(gui, cx, cy, cw, ch, Color3.fromRGB(58, 60, 62))
		outline(case, Color3.fromRGB(30, 30, 32), 2)
		bezel(controls, face, cx, cy, cw, ch, 0.16, Color3.fromRGB(44, 46, 48), 0.07)
		local legendH = 0.12 * #w.pens + 0.08
		local gx, gy, gw, gh = cx + 0.12, cy + 0.1, cw - 0.24, ch - 0.22 - legendH
		box(gui, gx, gy, gw, gh, Color3.fromRGB(240, 241, 230))
		bezel(controls, face, gx, gy, gw, gh, 0.05, Color3.fromRGB(24, 24, 26), 0.03)
		-- Ruling: ten value divisions, a heavier line every fifth, and time
		-- lines across the paper.
		for i = 0, 10 do
			local line = box(gui, gx + gw * i / 10 - 0.006, gy, 0.012, gh, if i % 5 == 0 then Color3.fromRGB(122, 162, 126) else Color3.fromRGB(184, 206, 184))
			line.ZIndex = 2
		end
		for i = 1, 7 do
			local line = box(gui, gx, gy + gh * i / 8, gw, 0.01, Color3.fromRGB(196, 214, 196))
			line.ZIndex = 2
		end
		-- Scale figures along the top edge, for the first pen's range.
		local first = w.pens[1]
		for i = 0, 2 do
			local v = first.lo + (first.hi - first.lo) * i / 2
			local label = text(gui, gx + gw * i / 2 - 0.3, gy + 0.02, 0.6, 0.12, string.format(if math.abs(v) >= 100 or v % 1 == 0 then "%.0f" else "%.1f", v), 0.09, Color3.fromRGB(70, 96, 72), Enum.Font.SourceSans)
			label.ZIndex = 3
		end
		-- Glass in the door.
		local glass = block(controls, face, gx + gw / 2, gy + gh / 2, gw, gh, 0.02, Color3.fromRGB(200, 220, 230))
		glass.CFrame = blockCFrame(face, gx + gw / 2, gy + gh / 2, 0.12, 0)
		glass.Material = Enum.Material.Glass
		glass.Transparency = 0.88
		glass.Reflectance = 0.08
		-- Door latch.
		cylinder(controls, face, cx + cw - 0.06, cy + ch / 2, 0.07, 0.1, Color3.fromRGB(150, 150, 150)).Material = Enum.Material.Metal
		local penY = gy + 0.16
		local N = 48
		local stepY = (gh - 0.2) / N
		local pens = {}
		for k, pen in w.pens do
			local legend = text(gui, cx + 0.12, gy + gh + 0.04 + (k - 1) * 0.12, cw - 0.24, 0.12, string.format("%s  %s  %g to %g %s", string.upper(pen.color), pen.name or "", pen.lo, pen.hi, pen.unit or ""), 0.085, Color3.fromRGB(226, 226, 218), Enum.Font.SourceSans)
			legend.TextXAlignment = Enum.TextXAlignment.Left
			legend.TextWrapped = false
			local dots = table.create(N)
			for i = 1, N do
				local d = box(gui, gx, gy, 0.03, stepY + 0.012, PEN[pen.color])
				d.Visible = false
				d.ZIndex = 4
				dots[i] = d
			end
			local index = box(gui, gx, penY - 0.07, 0.05, 0.14, PEN[pen.color])
			index.ZIndex = 5
			table.insert(pens, { def = pen, dots = dots, index = index, values = {} :: { number } })
		end
		local lastSample = -math.huge
		table.insert(updaters, function()
			local now = os.clock()
			local sample = now - lastSample >= 5
			if sample then
				lastSample = now
			end
			for _, pen in pens do
				local f = math.clamp((get(pen.def.sig) - pen.def.lo) / (pen.def.hi - pen.def.lo), 0, 1)
				pen.index.Position = UDim2.fromOffset(px(gx + gw * f - 0.025), px(penY - 0.07))
				if sample then
					local values = pen.values
					if #values == 0 then
						-- The chart has been running all along: start with a
						-- steady trace at the present value.
						for _ = 1, N - 1 do
							table.insert(values, f)
						end
					end
					table.insert(values, 1, f)
					if #values > N then
						table.remove(values)
					end
					for i, v in values do
						local d = pen.dots[i]
						d.Visible = true
						d.Position = UDim2.fromOffset(px(gx + gw * v - 0.015), px(penY + (i - 1) * stepY))
					end
				end
			end
		end)
		region(part, w, nil, function()
			local parts = { cleanLabel(w.label) }
			for _, pen in w.pens do
				table.insert(parts, string.format("%s pen, %s: %.1f %s", pen.color, pen.name or pen.sig, get(pen.sig), pen.unit or ""))
			end
			return table.concat(parts, "\n")
		end)
	end

	-- Mimic lines: coloured strips painted on the board that trace a flow
	-- path between the switches of the equipment on it.
	builders.mimic = function(gui, _face, _part, w)
		local t = w.width or 0.07
		local pts = w.pts
		for i = 1, #pts - 1 do
			local x1, y1, x2, y2 = pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2]
			local seg = box(gui, math.min(x1, x2) - t / 2, math.min(y1, y2) - t / 2, math.abs(x2 - x1) + t, math.abs(y2 - y1) + t, MIMIC[w.color] or INK)
			seg.ZIndex = 0
		end
	end

	builders.ann = function(gui, face, part, w)
		local cols, rows = math.max(4, math.floor(w.w / 1.6 + 0.5)), 3
		local panelId = part:GetAttribute("Panel")
		local tw, th = w.w / cols, w.h / rows
		-- Window frames: each legend sits in its own recess.
		for c = 0, cols do
			block(controls, face, math.clamp(c * tw, 0.04, w.w - 0.04), w.h / 2, 0.08, w.h, 0.14, BEZEL)
		end
		for r = 0, rows do
			block(controls, face, w.w / 2, math.clamp(r * th, 0.04, w.h - 0.04), w.w, 0.08, 0.14, BEZEL)
		end
		for i, alarm in w.alarms do
			local c, r = (i - 1) % cols, (i - 1) // cols
			if r < rows then
				local tile = box(gui, c * tw + 0.04, r * th + 0.04, tw - 0.08, th - 0.08, ANN_DARK)
				local label = text(gui, c * tw + 0.06, r * th + 0.05, tw - 0.12, th - 0.1, alarm.text, 0.14, ANN_DARK_TEXT, PLATE_FONT)
				local index = AlarmList.index[alarm.id]
				local urgent = alarm.id == "az5" or alarm.id == "chan.rupture" or alarm.id == "core.damage" or alarm.id == "rs.press"
				annTiles[index] = { tile = tile, label = label, state = 0, urgent = urgent, panel = panelId }
			end
		end
		for i = #w.alarms + 1, cols * rows do
			local c, r = (i - 1) % cols, (i - 1) // cols
			box(gui, c * tw + 0.04, r * th + 0.04, tw - 0.08, th - 0.08, ANN_SPARE)
		end
		table.insert(regions[part], {
			x = 0,
			y = 0,
			w = w.w,
			h = w.h,
			widget = w,
			press = function()
				ctx.click()
				ctx.send("ann.ack", 1)
				return nil
			end,
			tip = function()
				return "Annunciators: click to acknowledge. Fast flash = new alarm, steady = acknowledged,\nslow flash = cleared, waiting for RESET."
			end,
		})
	end

	-- Core map: one coloured cell per lattice position.
	builders.coremap = function(gui, face, part, w)
		gui = overlay(face, part, w.x, w.y, w.w, w.h)
		bezel(controls, face, w.x, w.y, w.w, w.h, 0.14, BEZEL, 0.08)
		local L = CoreLayout.get()
		local G = L.grid
		local cell = math.floor((w.w - 0.1) * PPS / G)
		local size = cell * G
		local ox = px(w.x) + (px(w.w) - size) // 2
		local oy = px(w.y) + px(0.3)
		local back = box(gui, w.x, w.y, w.w, w.h, Color3.fromRGB(14, 14, 16))
		local _ = back
		local title = plate(gui, w.x + 0.06, w.y + 0.04, w.w - 0.12, 0.22, "CHANNEL CARTOGRAM", 0.13, true)
		local frames = table.create(L.nCells)
		local lastByte = table.create(L.nCells, -1)
		for c = 1, L.nCells do
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.BackgroundColor3 = PALETTE[1]
			f.Position = UDim2.fromOffset(ox + (L.cellGX[c] - 1) * cell, oy + (L.cellGY[c] - 1) * cell)
			f.Size = UDim2.fromOffset(cell - 1, cell - 1)
			f.Parent = gui
			frames[c] = f
		end
		local modeNames = { "FLUX", "POWER", "DRYOUT MARGIN", "CHANNEL FLOW", "EXIT QUALITY", "FUEL TEMP", "XENON", "GRAPHITE TEMP" }
		local scales = { { 2.5, "x mean" }, { 3.2, "MW" }, { 4, "" }, { 9 * 3.6, "t/h" }, { 40, "%" }, { 2000, "C" }, { 2.5, "x equil." }, { 800, "C" } }
		local current: buffer? = nil
		out.setMap = function(buf: buffer)
			current = buf
			local mode = buffer.readu8(buf, 0)
			title.Text = string.format("CHANNEL CARTOGRAM   %s   RED LAMP = %g %s", modeNames[mode] or "?", scales[mode] and scales[mode][1] or 0, scales[mode] and scales[mode][2] or "")
			local NC = L.nCells
			for c = 1, NC do
				local v = buffer.readu8(buf, c)
				local flag = buffer.readu8(buf, NC + c)
				local key = v + flag * 256
				if key ~= lastByte[c] then
					lastByte[c] = key
					local color
					if L.cellKind[c] == 2 then
						-- Rod channel: light when withdrawn, dark when inserted, tinted by type.
						local rod = L.rods[L.cellRef[c]]
						color = ROD_COLOR[rod.kind]:Lerp(Color3.new(0, 0, 0), v / 255 * 0.8)
					elseif flag == 1 then
						color = Color3.fromRGB(255, 0, 255)
					elseif flag == 3 then
						color = Color3.fromRGB(255, 255, 255)
					else
						color = PALETTE[v // 8 + 1]
					end
					frames[c].BackgroundColor3 = color
				end
			end
		end
		table.insert(regions[part], {
			x = w.x,
			y = w.y,
			w = w.w,
			h = w.h,
			widget = w,
			tip = function()
				return "Channel cartogram: one lamp per channel, dark through green, yellow and amber to red.\nRod channels are tinted by type and darken as the rod goes in.\nMagenta = ruptured channel, white = channel in dryout."
			end,
		} :: any)
		out.mapCellAt = function(u: number, v: number): number
			local gx = (px(u) - ox) // cell + 1
			local gy = (px(v) - oy) // cell + 1
			if gx < 1 or gx > G or gy < 1 or gy > G then
				return 0
			end
			return L.gridToCell[(gy - 1) * G + gx]
		end
		out.mapInfo = function(c: number): string?
			local buf = current
			if c == 0 or not buf then
				return nil
			end
			local mode = buffer.readu8(buf, 0)
			local v = buffer.readu8(buf, c)
			local label = string.format("%02d-%02d", L.cellGX[c], L.cellGY[c])
			if L.cellKind[c] == 2 then
				local rod = L.rods[L.cellRef[c]]
				return string.format("Rod %s (%s): %.0f%% inserted", label, rod.kind, v / 255 * 100)
			end
			local sc = scales[mode]
			local flag = buffer.readu8(buf, L.nCells + c)
			local note = if flag == 1 then "  RUPTURED" elseif flag == 2 then "  FLOW RESTRICTED" elseif flag == 3 then "  DRYOUT" else ""
			return string.format("Channel %s: %s %.2f %s%s", label, modeNames[mode] or "", v / 255 * (sc and sc[1] or 1), sc and sc[2] or "", note)
		end
	end

	-- Rod select matrix: one button per rod, laid out as in the core.
	builders.rodmatrix = function(gui, face, part, w)
		bezel(controls, face, w.x, w.y, w.w, w.h, 0.1, BEZEL, 0.07)
		local L = CoreLayout.get()
		local G = L.grid
		local pitch = (w.w - 0.1) * PPS / G
		local ox, oy = px(w.x + 0.05), px(w.y + 0.3)
		local scaleY = (w.h - 0.35) * PPS / G
		local back = box(gui, w.x, w.y, w.w, w.h, Color3.fromRGB(26, 28, 30))
		outline(back, Color3.fromRGB(90, 92, 90), 2)
		local title = text(gui, w.x + 0.1, w.y + 0.03, w.w - 0.2, 0.25, "ROD SELECT   white RR  green AR  yellow LAR  red AZ  blue USP   lit = selected", 0.105, Color3.fromRGB(230, 230, 220))
		title.TextXAlignment = Enum.TextXAlignment.Left
		local size = math.max(6, math.floor(pitch * 1.9))
		local buttons = table.create(L.nRods)
		local centers = table.create(L.nRods)
		for i, rod in L.rods do
			local cx = ox + (rod.gx - 0.5) * pitch
			local cy = oy + (rod.gy - 0.5) * scaleY
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.BackgroundColor3 = ROD_COLOR[rod.kind]:Lerp(Color3.fromRGB(30, 30, 30), 0.5)
			f.Position = UDim2.fromOffset(math.floor(cx - size / 2), math.floor(cy - size / 2))
			f.Size = UDim2.fromOffset(size, size)
			f.Parent = gui
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 2
			stroke.Color = Color3.fromRGB(255, 255, 255)
			stroke.Enabled = false
			stroke.Parent = f
			buttons[i] = { frame = f, stroke = stroke, flag = -1, depth = -1 }
			centers[i] = { cx / PPS, cy / PPS }
		end
		-- Each button is a backlit pushbutton tinted by rod type; it lights up
		-- when its rod is selected.
		table.insert(rodListeners, function(buf: buffer)
			local NC = L.nCells
			for i, rod in L.rods do
				local b = buttons[i]
				local flag = buffer.readu8(buf, 2 * NC + i)
				local depth = buffer.readu8(buf, rod.cell)
				if flag ~= b.flag or depth ~= b.depth then
					b.flag = flag
					b.depth = depth
					local selected = flag % 2 == 1
					b.stroke.Enabled = selected
					b.frame.BackgroundColor3 = if selected then ROD_COLOR[rod.kind]:Lerp(Color3.new(1, 1, 1), 0.55) else ROD_COLOR[rod.kind]:Lerp(Color3.fromRGB(30, 30, 30), 0.5)
				end
			end
		end)
		local function nearest(u: number, v: number): number
			local best, bestD = 0, (size / PPS) ^ 2
			for i, c in centers do
				local d = (c[1] - u) ^ 2 + (c[2] - v) ^ 2
				if d < bestD then
					best, bestD = i, d
				end
			end
			return best
		end
		table.insert(regions[part], {
			x = w.x,
			y = w.y,
			w = w.w,
			h = w.h,
			widget = w,
			press = function(_button: number, u: number, v: number)
				local i = nearest(u, v)
				if i > 0 then
					ctx.click()
					ctx.send("rod.select", i)
				end
				return nil
			end,
			tip = function()
				return "Rod select matrix: one pushbutton per rod, laid out as in the core. Click a rod to select or deselect it; a selected rod's button lights."
			end,
		} :: any)
		out.rodAt = function(u: number, v: number): string?
			local i = nearest(u, v)
			if i == 0 then
				return nil
			end
			local rod = L.rods[i]
			local b = buttons[i]
			local full = if rod.kind == "USP" then 3.5 else 6.5
			return string.format("Rod %s (%s): %.2f m inserted", rod.label, rod.kind, math.max(b.depth, 0) / 255 * full)
		end
	end

	-- The rod position board: a synchro dial for every rod, laid out as in
	-- the core, as on the RBMK. Each dial reads metres inserted, 0 at the
	-- top-left of its scale; its rim is coloured by rod type; a red lamp
	-- lights at full out and a green one at full in.
	builders.rodpos = function(gui, face, part, w)
		bezel(controls, face, w.x, w.y, w.w, w.h, 0.14, BEZEL, 0.08)
		box(gui, w.x, w.y, w.w, w.h, Color3.fromRGB(52, 48, 42))
		plate(gui, w.x + 0.06, w.y + 0.04, w.w - 0.12, 0.22, "ROD POSITION INDICATORS   METRES INSERTED", 0.115, true)
		local L = CoreLayout.get()
		local G = L.grid
		local size = math.min(w.w - 0.1, w.h - 0.36)
		local cell = size / G
		local ox, oy = w.x + (w.w - size) / 2, w.y + 0.31
		local d = cell * 2.45
		local dials = table.create(L.nRods)
		local centers = table.create(L.nRods)
		for i, rod in L.rods do
			local cx, cy = ox + (rod.gx - 0.5) * cell, oy + (rod.gy - 0.5) * cell
			local dial = box(gui, cx - d / 2, cy - d / 2, d, d, PAPER)
			round(dial)
			local rim = Instance.new("UIStroke")
			rim.Thickness = 2
			rim.Color = ROD_COLOR[rod.kind]:Lerp(Color3.fromRGB(40, 40, 40), 0.25)
			rim.Parent = dial
			local pivot = Instance.new("Frame")
			pivot.BackgroundTransparency = 1
			pivot.BorderSizePixel = 0
			pivot.AnchorPoint = Vector2.new(0.5, 0.5)
			pivot.Position = UDim2.fromOffset(px(cx), px(cy))
			pivot.Size = UDim2.fromOffset(2, math.max(4, px(d * 0.82)))
			pivot.Rotation = -135
			pivot.ZIndex = 3
			pivot.Parent = gui
			local hand = Instance.new("Frame")
			hand.BorderSizePixel = 0
			hand.BackgroundColor3 = INK
			hand.Size = UDim2.fromScale(1, 0.5)
			hand.ZIndex = 3
			hand.Parent = pivot
			local outLamp = box(gui, cx - d * 0.42, cy - d * 0.42, d * 0.18, d * 0.18, Color3.fromRGB(70, 22, 20))
			outLamp.ZIndex = 4
			local inLamp = box(gui, cx - d * 0.42, cy + d * 0.24, d * 0.18, d * 0.18, Color3.fromRGB(20, 60, 28))
			inLamp.ZIndex = 4
			dials[i] = { pivot = pivot, outLamp = outLamp, inLamp = inLamp, depth = -1 }
			centers[i] = { cx, cy }
		end
		table.insert(rodListeners, function(buf: buffer)
			for i, rod in L.rods do
				local dial = dials[i]
				local depth = buffer.readu8(buf, rod.cell)
				if depth ~= dial.depth then
					dial.depth = depth
					dial.pivot.Rotation = -135 + 270 * depth / 255
					dial.outLamp.BackgroundColor3 = if depth <= 2 then LAMP.red[1] else LAMP.red[2]
					dial.inLamp.BackgroundColor3 = if depth >= 253 then LAMP.green[1] else LAMP.green[2]
				end
			end
		end)
		table.insert(regions[part], {
			x = w.x,
			y = w.y,
			w = w.w,
			h = w.h,
			widget = w,
			tip = function()
				return "Rod position indicators: one synchro dial per rod, laid out as in the core, reading metres inserted.\nRed lamp: rod fully withdrawn. Green lamp: rod fully inserted. The rim colour is the rod type."
			end,
			tipAt = function(u: number, v: number): string?
				local best, bestD = 0, (d * 0.7) ^ 2
				for i, c in centers do
					local dd = (c[1] - u) ^ 2 + (c[2] - v) ^ 2
					if dd < bestD then
						best, bestD = i, dd
					end
				end
				if best == 0 then
					return nil
				end
				local rod = L.rods[best]
				local full = if rod.kind == "USP" then 3.5 else 6.5
				local depth = math.max(dials[best].depth, 0)
				local state = if depth >= 253 then "  FULL IN" elseif depth <= 2 then "  FULL OUT" else ""
				return string.format("Rod %s (%s): %.2f m inserted%s", rod.label, rod.kind, depth / 255 * full, state)
			end,
		} :: any)
	end

	-- The four-rod display: for up to four selected rods, the rod's
	-- coordinates, its position in metres inserted, and FULL IN / FULL OUT /
	-- STUCK lamps.
	builders.fourrod = function(gui, face, part, w)
		gui = overlay(face, part, w.x, w.y, w.w, w.h)
		bezel(controls, face, w.x, w.y, w.w, w.h, 0.08, BEZEL, 0.05)
		box(gui, w.x, w.y, w.w, w.h, Color3.fromRGB(44, 46, 48))
		local L = CoreLayout.get()
		local cw = w.w / 4
		local columns = {}
		for k = 1, 4 do
			local x0 = w.x + (k - 1) * cw
			local id = text(gui, x0 + 0.08, w.y + 0.08, cw - 0.16, 0.28, "--", 0.17, Color3.fromRGB(236, 236, 226), PLATE_FONT)
			id.BackgroundTransparency = 0
			id.BackgroundColor3 = Color3.fromRGB(14, 14, 16)
			local screen = box(gui, x0 + 0.08, w.y + 0.44, cw - 0.16, 0.6, SCREEN)
			outline(screen, Color3.fromRGB(70, 70, 70), 1)
			local show = sevenSeg(gui, x0 + 0.08, w.y + 0.44, cw - 0.16, 0.6, 3, DIGIT, DIGIT_DIM)
			local lamps = {}
			for j, def in { { "IN", LAMP.green }, { "OUT", LAMP.red }, { "STUCK", LAMP.amber } } do
				local lx = x0 + 0.1 + (j - 1) * (cw - 0.2) / 3
				local bulb = box(gui, lx + (cw - 0.2) / 6 - 0.08, w.y + 1.16, 0.16, 0.16, def[2][2])
				outline(bulb, Color3.fromRGB(20, 20, 22), 2)
				local t = text(gui, lx, w.y + 1.36, (cw - 0.2) / 3, 0.14, def[1], 0.075, Color3.fromRGB(210, 210, 200), PLATE_FONT)
				t.TextWrapped = false
				lamps[j] = { bulb = bulb, colors = def[2] }
			end
			columns[k] = { id = id, show = show, lamps = lamps }
		end
		local shown: { number } = {}
		table.insert(rodListeners, function(buf: buffer)
			local NC = L.nCells
			table.clear(shown)
			for i in L.rods do
				if buffer.readu8(buf, 2 * NC + i) % 2 == 1 and #shown < 4 then
					table.insert(shown, i)
				end
			end
			for k, col in columns do
				local i = shown[k]
				if i then
					local rod = L.rods[i]
					local flag = buffer.readu8(buf, 2 * NC + i)
					local depth = buffer.readu8(buf, rod.cell)
					local full = if rod.kind == "USP" then 3.5 else 6.5
					col.id.Text = rod.label
					col.show(string.format("%.2f", depth / 255 * full))
					local on = { depth >= 253, depth <= 2, (flag // 2) % 2 == 1 }
					for j, lampDef in col.lamps do
						lampDef.bulb.BackgroundColor3 = lampDef.colors[if on[j] then 1 else 2]
					end
				else
					col.id.Text = "--"
					col.show("")
					for _, lampDef in col.lamps do
						lampDef.bulb.BackgroundColor3 = lampDef.colors[2]
					end
				end
			end
		end)
		region(part, w, nil, function()
			return "Four rod display: the rods selected for movement (up to four), with their coordinates and metres inserted.\nLamps: FULL IN, FULL OUT, STUCK."
		end)
	end

	-- The rod movement switch: a pistol grip that springs back to OFF. Hold
	-- it to the left to insert the selected rods, to the right to withdraw.
	builders.rodswitch = function(gui, face, part, w)
		plate(gui, w.x + 0.05, w.y, w.w - 0.1, 0.22, w.label, 0.085)
		-- A large engraved escutcheon: INSERT to the left, OFF at the top,
		-- WITHDRAW to the right; the pistol grip springs back to OFF.
		local cx = w.x + w.w / 2
		local ey, ew, eh = w.y + 0.3, math.min(w.w - 0.06, 1.3), w.h - 0.32
		box(gui, cx - ew / 2, ey, ew, eh, Color3.fromRGB(22, 22, 24))
		local white = Color3.fromRGB(232, 232, 224)
		local l = text(gui, cx - ew / 2 + 0.04, ey + eh - 0.2, ew / 2, 0.13, w.positions[1], 0.075, white, PLATE_FONT)
		l.TextXAlignment = Enum.TextXAlignment.Left
		text(gui, cx - 0.3, ey + 0.03, 0.6, 0.13, w.positions[2], 0.075, white, PLATE_FONT)
		local r = text(gui, cx - 0.04, ey + eh - 0.2, ew / 2, 0.13, w.positions[3], 0.075, white, PLATE_FONT)
		r.TextXAlignment = Enum.TextXAlignment.Right
		local turn = controlKey(face, cx, ey + eh * 0.62, 0, 1.25)
		region(part, w, function(_button: number, u: number)
			ctx.click()
			local insert = u < cx
			turn(if insert then -45 else 45)
			return {
				hold = w.cmd,
				value = if insert then 1 else -1,
				onRelease = function()
					turn(0)
				end,
			}
		end, function()
			return "Rod movement switch: hold to the left to INSERT, to the right to WITHDRAW the selected rods.\nIt springs back to OFF when released."
		end)
	end

	-- A manual/automatic control station: process scale with setpoint index,
	-- AUTO and MAN lamps, an output meter, and A / M / lower / raise buttons.
	builders.station = function(gui, face, part, w)
		plate(gui, w.x, w.y, w.w, 0.22, w.label, 0.1)
		local x0, y0, cw, ch = w.x, w.y + 0.26, w.w, w.h - 0.26
		local case = box(gui, x0, y0, cw, ch, Color3.fromRGB(70, 72, 74))
		outline(case, Color3.fromRGB(30, 30, 32), 2)
		bezel(controls, face, x0, y0, cw, ch, 0.12, BEZEL, 0.05)
		local sx, sy, sw, sh = x0 + 0.1, y0 + 0.1, 0.5, 0.88
		box(gui, sx, sy, sw, sh, PAPER)
		local span = w.hi - w.lo
		local function yOf(v: number): number
			return sy + 0.07 + (sh - 0.14) * (1 - math.clamp((v - w.lo) / span, 0, 1))
		end
		for i = 0, 10 do
			local major = i % 5 == 0
			local tw = if major then 0.2 else 0.12
			box(gui, sx + sw - tw, yOf(w.lo + span * i / 10) - 0.005, tw, 0.01, INK).ZIndex = 2
		end
		local hiText = text(gui, sx + 0.03, yOf(w.hi) - 0.02, 0.3, 0.1, string.format("%g", w.hi), 0.075, INK, FIGURE_FONT)
		hiText.TextXAlignment = Enum.TextXAlignment.Left
		hiText.ZIndex = 2
		local loText = text(gui, sx + 0.03, yOf(w.lo) - 0.08, 0.3, 0.1, string.format("%g", w.lo), 0.075, INK, FIGURE_FONT)
		loText.TextXAlignment = Enum.TextXAlignment.Left
		loText.ZIndex = 2
		local unitText = text(gui, sx + 0.03, sy + sh / 2 - 0.05, 0.3, 0.1, w.unit, 0.07, Color3.fromRGB(70, 70, 70), PLATE_FONT)
		unitText.TextXAlignment = Enum.TextXAlignment.Left
		unitText.ZIndex = 2
		local spMark = box(gui, sx, sy, 0.09, 0.05, Color3.fromRGB(215, 30, 26))
		spMark.ZIndex = 3
		spMark.Visible = w.sp ~= nil or w.spValue ~= nil
		local pointer = block(controls, face, sx + sw / 2, yOf(w.lo), sw + 0.02, 0.03, 0.03, Color3.fromRGB(20, 20, 20))
		local setAuto = lens(controls, face, x0 + 1.02, y0 + 0.28, 0.16, LAMP.white)
		local setMan = lens(controls, face, x0 + 1.02, y0 + 0.66, 0.16, LAMP.amber)
		local light = Color3.fromRGB(220, 220, 210)
		text(gui, x0 + 0.74, y0 + 0.4, 0.56, 0.1, "AUTO", 0.07, light, PLATE_FONT).ZIndex = 2
		text(gui, x0 + 0.74, y0 + 0.78, 0.56, 0.1, "MAN", 0.07, light, PLATE_FONT).ZIndex = 2
		-- Output meter, 0 to 100 per cent.
		local ox, oy, ow, oh = x0 + 0.1, y0 + 1.04, cw - 0.2, 0.18
		box(gui, ox, oy, ow, oh, PAPER)
		for i = 0, 4 do
			box(gui, ox + 0.04 + (ow - 0.08) * i / 4 - 0.005, oy + oh - (if i % 2 == 0 then 0.1 else 0.06), 0.01, if i % 2 == 0 then 0.1 else 0.06, INK).ZIndex = 2
		end
		local outLabel = text(gui, ox + 0.03, oy + 0.01, 0.6, 0.08, "OUTPUT %", 0.06, Color3.fromRGB(70, 70, 70), PLATE_FONT)
		outLabel.TextXAlignment = Enum.TextXAlignment.Left
		outLabel.ZIndex = 2
		local outPointer = block(controls, face, ox, oy + oh / 2, 0.025, oh + 0.02, 0.03, Color3.fromRGB(215, 25, 25))
		-- Pushbuttons.
		local legends = { "A", "M", "<", ">" }
		local capColors = { BUTTON.white, Color3.fromRGB(230, 170, 40), BUTTON.black, BUTTON.black }
		local bw = (cw - 0.2) / 4
		local caps = {}
		for k = 1, 4 do
			local bx = x0 + 0.1 + (k - 0.5) * bw
			text(gui, bx - bw / 2, y0 + 1.25, bw, 0.1, legends[k], 0.09, light, PLATE_FONT).ZIndex = 2
			caps[k] = block(controls, face, bx, y0 + 1.47, bw - 0.06, 0.16, 0.05, capColors[k])
		end
		local last = ""
		table.insert(updaters, function()
			local v = get(w.sig)
			local sp = if w.sp then get(w.sp) else w.spValue
			local out = get(w.out)
			local auto = get(w.auto) >= 0.5
			local key = string.format("%.4g|%s|%.3g|%s", v, tostring(sp), out, tostring(auto))
			if key == last then
				return
			end
			last = key
			pointer.CFrame = blockCFrame(face, sx + sw / 2, yOf(v), 0.05, 0)
			if sp then
				spMark.Position = UDim2.fromOffset(px(sx), px(yOf(sp) - 0.025))
			end
			outPointer.CFrame = blockCFrame(face, ox + 0.04 + (ow - 0.08) * math.clamp(out / 100, 0, 1), oy + oh / 2, 0.05, 0)
			setAuto(auto)
			setMan(not auto)
		end)
		region(part, w, function(_button: number, u: number, v: number)
			if v < y0 + 1.22 then
				return nil
			end
			local k = math.clamp(math.floor((u - x0 - 0.1) / bw) + 1, 1, 4)
			ctx.click()
			local cap = caps[k]
			local home = cap.CFrame
			cap.CFrame = home - face.normal * 0.03 * S
			if k <= 2 then
				task.delay(0.15, function()
					cap.CFrame = home
				end)
				ctx.send(w.autoCmd, if k == 1 then 1 else 0)
				return nil
			end
			return {
				hold = w.cmd,
				value = if k == 4 then 1 else -1,
				onRelease = function()
					cap.CFrame = home
				end,
			}
		end, function()
			local sp = if w.sp then get(w.sp) else w.spValue
			local spText = if sp then string.format(", setpoint " .. w.fmt, sp) else ""
			return string.format("%s: " .. w.fmt .. " %s%s, output %.0f%%, %s\nA = automatic, M = manual. The arrows move the %s.%s", cleanLabel(w.label), get(w.sig), w.unit, spText, get(w.out), if get(w.auto) >= 0.5 then "AUTO" else "MANUAL", string.lower(w.adjusts), if w.tip then "\n" .. w.tip else "")
		end)
	end

	-- Annunciator TEST: lights every window on this panel while held.
	builders.lamptest = function(gui, face, part, w)
		local d = 0.3
		local cx, cy = w.x + w.w / 2, w.y + d / 2 + 0.09
		local cap = pushbutton(controls, blockCFrame(face, cx, cy, 0, 0), BUTTON.white)
		local plateY = cy + d / 2 + 0.12
		plate(gui, w.x - 0.02, plateY, w.w + 0.04, math.min(0.3, w.y + w.h - plateY), w.label, 0.075)
		local panelId = part:GetAttribute("Panel")
		region(part, w, function()
			ctx.click()
			cap.move(CFrame.new(0, 0, -0.05 * S))
			testing[panelId] = true
			return {
				onRelease = function()
					testing[panelId] = nil
					cap.move(CFrame.new())
				end,
			}
		end, function()
			return "Annunciator TEST: hold to light every window on this panel."
		end)
	end

	builders.axial = function(gui, face, part, w)
		gui = overlay(face, part, w.x, w.y, w.w, w.h)
		bezel(controls, face, w.x, w.y, w.w, w.h, 0.14, BEZEL, 0.08)
		box(gui, w.x, w.y, w.w, w.h, Color3.fromRGB(14, 14, 16))
		plate(gui, w.x + 0.06, w.y + 0.04, w.w - 0.12, 0.22, "AXIAL", 0.13, true)
		text(gui, w.x, w.y + 0.3, w.w, 0.18, "TOP", 0.11, Color3.fromRGB(190, 190, 180))
		text(gui, w.x, w.y + w.h - 0.2, w.w, 0.18, "BOTTOM", 0.11, Color3.fromRGB(190, 190, 180))
		local N = 14
		local y0, rowH = w.y + 0.5, (w.h - 0.75) / N
		local bars = {}
		for z = 1, N do
			local bar = box(gui, w.x + 0.06, y0 + (z - 1) * rowH + 0.03, 0.1, rowH - 0.06, Color3.fromRGB(255, 120, 40))
			bars[z] = bar
		end
		local maxW = w.w - 0.12
		table.insert(updaters, function()
			for z = 1, N do
				local v = get("core.ax" .. z)
				bars[z].Size = UDim2.fromOffset(math.max(1, px(maxW * math.clamp(v / 2, 0, 1))), px(rowH - 0.06))
				-- Neon bargraph: orange, burning brighter and redder as a layer peaks.
				bars[z].BackgroundColor3 = if v > 1.6 then Color3.fromRGB(255, 50, 36) elseif v > 1.4 then Color3.fromRGB(255, 176, 60) else Color3.fromRGB(255, 120, 40)
			end
		end)
		region(part, w, nil, function()
			return string.format("Axial power shape, top of core at the top.\nPeak %.2f, offset %+.0f%% (positive = top-heavy)", get("core.kz"), get("core.offset"))
		end)
	end

	builders.computer = function(gui, face, part, w)
		gui = overlay(face, part, w.x, w.y, w.w, w.h)
		bezel(controls, face, w.x, w.y, w.w, w.h, 0.16, BEZEL, 0.09)
		local screen = box(gui, w.x, w.y, w.w, w.h, TUBE)
		outline(screen, Color3.fromRGB(60, 60, 60), 3)
		local left = text(gui, w.x + 0.1, w.y + 0.06, 3.5, w.h - 0.12, "", 0.165, PHOSPHOR, Enum.Font.Code)
		left.TextXAlignment = Enum.TextXAlignment.Left
		left.TextYAlignment = Enum.TextYAlignment.Top
		left.TextWrapped = false
		local right = text(gui, w.x + 3.65, w.y + 0.06, w.w - 3.75, w.h - 0.12, "", 0.14, Color3.fromRGB(84, 214, 112), Enum.Font.Code)
		right.TextXAlignment = Enum.TextXAlignment.Left
		right.TextYAlignment = Enum.TextYAlignment.Top
		local function clock(t: number): string
			local s = math.floor(t)
			return string.format("%02d:%02d:%02d", s // 3600, (s // 60) % 60, s % 60)
		end
		local tickCount = 0
		table.insert(updaters, function()
			tickCount += 1
			if tickCount % 3 ~= 1 then
				return
			end
			left.Text = table.concat({
				string.format("RBMK-800 UNIT   T+%s", clock(get("time"))),
				string.format("THERMAL %6.0f MW %6.2f%%", get("n.thermal"), get("n.power")),
				string.format("GROSS   %6.0f MW  NET %4.0f", get("plant.gross"), get("plant.net")),
				string.format("MARGIN  %6.0f RODS", get("core.orm")),
				string.format("XENON   %+6.2f %%dk", get("core.xenon")),
				string.format("VOID    %+6.2f BETA", get("core.void")),
				string.format("PEAKING R %.2f  Z %.2f", get("core.fluxPeak"), get("core.kz")),
				string.format("TILT %3.0f%%  OFFSET %+3.0f%%", get("core.tilt"), get("core.offset")),
				string.format("FUEL MAX %5.0f C  CLAD %4.0f", get("core.maxFuel"), get("core.maxClad")),
				string.format("DRYOUT MARGIN  %5.2f", get("core.minMargin")),
				string.format("ENERGY %7.1f MWh  SCRAMS %d", get("stats.energy"), get("stats.scrams")),
			}, "\n")
			local n = #logLines
			local shown = {}
			for i = math.max(1, n - 8), n do
				table.insert(shown, logLines[i])
			end
			right.Text = table.concat(shown, "\n")
		end)
		region(part, w, nil, function()
			return "Unit computer: calculated core parameters on the left, the event log on the right.\nThe reactivity margin (ORM) must stay above 26 rods; below 15 the reactor must be shut down."
		end)
	end

	builders.sync = function(gui, face, part, w)
		local frame = box(gui, w.x, w.y, w.w, w.h, Color3.new(0, 0, 0))
		frame.BackgroundTransparency = 1
		outline(frame, Color3.fromRGB(70, 74, 70), 2)
		plate(gui, w.x + 0.7, w.y + 0.05, w.w - 1.4, 0.22, "SYNCHROSCOPE", 0.13)
		local d = 1.9
		local cx, cy = w.x + w.w / 2, w.y + 0.36 + d / 2
		local dial = box(gui, cx - d / 2, cy - d / 2, d, d, PAPER)
		round(dial)
		bezel(controls, face, cx - d / 2 - 0.06, cy - d / 2 - 0.06, d + 0.12, d + 0.12, 0.12, BEZEL, 0.07)
		outline(dial, Color3.fromRGB(30, 30, 30), 3)
		box(gui, cx - 0.02, cy - d / 2, 0.04, 0.2, INK)
		text(gui, cx - d / 2 + 0.1, cy - 0.12, 0.6, 0.24, "SLOW", 0.12, Color3.fromRGB(80, 80, 80))
		text(gui, cx + d / 2 - 0.7, cy - 0.12, 0.6, 0.24, "FAST", 0.12, Color3.fromRGB(80, 80, 80))
		-- A rotated frame turns about its centre, so the hand is the top half
		-- of an invisible pivot twice its length.
		local pivot = Instance.new("Frame")
		pivot.BackgroundTransparency = 1
		pivot.BorderSizePixel = 0
		pivot.AnchorPoint = Vector2.new(0.5, 0.5)
		pivot.Position = UDim2.fromOffset(px(cx), px(cy))
		pivot.Size = UDim2.fromOffset(px(0.05), px(d - 0.24))
		pivot.ZIndex = 3
		pivot.Parent = gui
		local hand = Instance.new("Frame")
		hand.BorderSizePixel = 0
		hand.BackgroundColor3 = Color3.fromRGB(200, 20, 20)
		hand.Size = UDim2.fromScale(1, 0.5)
		hand.ZIndex = 3
		hand.Parent = pivot
		local okBulb = box(gui, w.x + 0.2, w.y + w.h - 0.62, 0.24, 0.24, LAMP.green[2])
		round(okBulb)
		local okText = text(gui, w.x + 0.5, w.y + w.h - 0.66, 1.1, 0.3, "IN SYNC", 0.14)
		okText.TextXAlignment = Enum.TextXAlignment.Left
		local info = text(gui, w.x + 1.5, w.y + w.h - 0.7, w.w - 1.6, 0.6, "", 0.14, INK, Enum.Font.Code)
		table.insert(updaters, function()
			local on = get("sync.on") >= 0.5
			pivot.Visible = on
			pivot.Rotation = get("sync.angle")
			okBulb.BackgroundColor3 = LAMP.green[if get("sync.ok") >= 0.5 then 1 else 2]
			info.Text = if on then string.format("%+.2f Hz\n%+.1f %% V", get("sync.df"), get("sync.dv")) else "scope off"
		end)
		region(part, w, nil, function()
			return "Synchroscope. Select a generator, bring it to 1800 rpm with the field on, and close the\ngenerator breaker as the hand passes slowly through the top with the IN SYNC lamp lit."
		end)
	end

	for _, p in PanelLayout.panels do
		local guis: { [string]: SurfaceGui } = {}
		local faceGeom: { [string]: PanelLayout.Face } = {}
		local faceParts: { [string]: Instance } = {}
		for _, faceName in { "bench", "vert", "ann" } do
			local part = room:WaitForChild(p.id .. "_" .. faceName) :: BasePart
			local gui = Instance.new("SurfaceGui")
			gui.Name = "Artwork"
			gui.Face = Enum.NormalId.Front
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = PPS / S
			gui.LightInfluence = if faceName == "ann" then 0 else 1
			gui.ResetOnSpawn = false
			gui.Adornee = part
			gui.Parent = part
			guis[faceName] = gui
			faceGeom[faceName] = PanelLayout.face(p.index, faceName)
			faceParts[faceName] = part
			faces[part] = faceGeom[faceName]
			regions[part] = {}
		end
		for _, w in p.widgets do
			local builder = builders[w.kind]
			if builder then
				builder(guis[w.face], faceGeom[w.face], faceParts[w.face], w)
			end
		end
	end

	-- Annunciator windows: 0 dark, 1 new (flashing), 2 acknowledged (steady).
	out.setAlarm = function(index: number, state: number)
		local t = annTiles[index]
		if t then
			t.state = state
		end
	end
	out.flash = function(fast: boolean, slow: boolean?)
		for _, t in annTiles do
			local lit = testing[t.panel] == true or t.state == 2 or (t.state == 1 and fast) or (t.state == 3 and slow == true)
			if lit ~= t.lit then
				t.lit = lit
				if lit then
					t.tile.BackgroundColor3 = if t.urgent then Color3.fromRGB(236, 40, 30) else Color3.fromRGB(255, 212, 70)
					t.label.TextColor3 = if t.urgent then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(14, 12, 8)
				else
					t.tile.BackgroundColor3 = ANN_DARK
					t.label.TextColor3 = ANN_DARK_TEXT
				end
			end
		end
	end
	out.setRods = function(buf: buffer)
		for _, fn in rodListeners do
			fn(buf)
		end
	end
	out.refresh = function()
		for _, fn in updaters do
			fn()
		end
	end
	return out
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">ProcedureGui</string>
            <string name="Source"><![CDATA[--!nonstrict
-- The procedures binder: press P to open or close it.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("RBMK")
local Procedures = require(Shared.Procedures)

local ProcedureGui = {}

function ProcedureGui.start()
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = "RBMKProcedures"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 8
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local binder = Instance.new("Frame")
	binder.AnchorPoint = Vector2.new(1, 0.5)
	binder.Position = UDim2.new(1, -16, 0.5, 0)
	binder.Size = UDim2.new(0, 640, 0.86, 0)
	binder.BackgroundColor3 = Color3.fromRGB(238, 234, 220)
	binder.BorderSizePixel = 0
	binder.Parent = gui

	local tabs = Instance.new("Frame")
	tabs.Size = UDim2.new(1, 0, 0, 34)
	tabs.BackgroundColor3 = Color3.fromRGB(60, 70, 84)
	tabs.BorderSizePixel = 0
	tabs.Parent = binder
	local tabLayout = Instance.new("UIListLayout")
	tabLayout.FillDirection = Enum.FillDirection.Horizontal
	tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabLayout.Parent = tabs

	local scroll = Instance.new("ScrollingFrame")
	scroll.Position = UDim2.fromOffset(0, 34)
	scroll.Size = UDim2.new(1, 0, 1, -34)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 8
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.Parent = binder
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 2)
	list.Parent = scroll
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 16)
	pad.Parent = scroll

	local ticked: { [string]: boolean } = {}

	local function show(pageIndex: number)
		for _, child in scroll:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local page = Procedures.pages[pageIndex]
		for i, line in page.lines do
			local isStep = string.sub(line, 1, 3) == "[ ]"
			local key = pageIndex .. ":" .. i
			local row: any = Instance.new(if isStep then "TextButton" else "TextLabel")
			row.LayoutOrder = i
			row.BackgroundTransparency = 1
			row.Size = UDim2.new(1, 0, 0, 0)
			row.AutomaticSize = Enum.AutomaticSize.Y
			row.Font = Enum.Font.Code
			row.TextSize = 15
			row.TextWrapped = true
			row.TextXAlignment = Enum.TextXAlignment.Left
			row.TextColor3 = Color3.fromRGB(24, 26, 30)
			local function paint()
				if isStep then
					row.Text = (if ticked[key] then "[x]" else "[ ]") .. string.sub(line, 4)
					row.TextColor3 = if ticked[key] then Color3.fromRGB(120, 120, 112) else Color3.fromRGB(24, 26, 30)
				else
					row.Text = if line == "" then " " else line
				end
			end
			paint()
			if isStep then
				row.AutoButtonColor = false
				row.MouseButton1Click:Connect(function()
					ticked[key] = not ticked[key]
					paint()
				end)
			end
			row.Parent = scroll
		end
		scroll.CanvasPosition = Vector2.new(0, 0)
	end

	for i, page in Procedures.pages do
		local tab = Instance.new("TextButton")
		tab.LayoutOrder = i
		tab.Size = UDim2.new(1 / #Procedures.pages, 0, 1, 0)
		tab.BackgroundColor3 = Color3.fromRGB(60, 70, 84)
		tab.BorderSizePixel = 0
		tab.Font = Enum.Font.SourceSansBold
		tab.TextSize = 14
		tab.TextColor3 = Color3.fromRGB(240, 240, 235)
		tab.Text = page.title
		tab.Parent = tabs
		tab.MouseButton1Click:Connect(function()
			show(i)
		end)
	end
	show(1)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if input.KeyCode == Enum.KeyCode.P and not processed then
			gui.Enabled = not gui.Enabled
		end
	end)
	return gui
end

return ProcedureGui
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="35">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>